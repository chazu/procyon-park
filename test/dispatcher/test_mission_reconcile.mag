"Integration tests for Dispatcher>>maybeReconcileMissions — the Decide->Act
 bridge (Phase B v1 tracer bullet) that materializes an epic when a human
 approves a mission and stamps the mission's epic_id.

 Invariants under test:
   MR-a  An approved mission with no epic_id -> EXACTLY ONE epic work-item,
         typed 'epic', status 'ready', stamped mission_id, and mission.epic_id
         is set to that epic's id.
   MR-b  Idempotency: repeated sweeps never spawn a second epic (the epic_id
         guard + the deterministic epic-<mission_id> id).
   MR-c  Only approved missions reconcile: researching / awaiting-approval /
         rejected missions spawn NOTHING.
   MR-d  Non-fatal: a malformed mission tuple in the scan does not abort the
         sweep or escape; a valid approved mission alongside it still fires.
   MR-e  Decompose: an approved mission carrying payload.breakdown materializes
         one story per entry under the epic — deterministic ids, parent=epic,
         mission_id stamped, wave carried, depends_on (1-based idx) mapped to
         sibling story ids.
   MR-f  Idempotent with breakdown: re-sweep never duplicates stories.
   MR-g  Back-compat: an approved mission with NO breakdown -> epic only.
   MR-h  Rollup: an in-progress mission whose every item is done -> 'done'.
   MR-i  Rollup holds while any item is unfinished.
   MR-j  Rollup never declares a no-item in-progress mission done.
   MR-k  Rollup fires only from in-progress (approved w/ done items untouched).

 Real BBS (BBS withDataDir:) is used so the full scan + upsertPinned + update:
 path runs end-to-end against a ganso/SQLite tuplespace, exercising the new
 ix_mission column."

"--- Runner ---"
MRRunner subclass: Object
  instanceVars: passed failed failures

  classMethod: new [ ^super new init ]

  method: init [
    passed := 0.
    failed := 0.
    failures := Array new: 0
  ]

  method: assert: cond message: msg [
    cond ifTrue: [passed := passed + 1]
         ifFalse: [
           failed := failed + 1.
           failures := failures copyWith: msg.
           ('FAIL: ', msg) println
         ]
  ]

  method: assertEqual: actual to: expected message: msg [
    (actual = expected) ifTrue: [passed := passed + 1]
                        ifFalse: [
                          failed := failed + 1.
                          failures := failures copyWith: msg.
                          ('FAIL: ', msg, ' (got: ', actual printString,
                           ' expected: ', expected printString, ')') println
                        ]
  ]

  method: report [
    '=== Dispatcher mission-reconcile Test Results ===' println.
    ('Passed: ', passed printString) println.
    ('Failed: ', failed printString) println.
    failed > 0 ifTrue: [
      'Failures:' println.
      failures do: [:f | ('  - ', f) println]
    ].
    failed = 0
      ifTrue: ['ALL TESTS PASSED' println]
      ifFalse: ['SOME TESTS FAILED' println]
  ]

  method: failed [ ^failed ]

"--- Helpers ---"
MRHelper subclass: Object

  classMethod: makeTempDir [
    | proc args |
    proc := ExternalProcess command: '/bin/sh'.
    args := Array new: 0.
    args := args copyWith: '-c'.
    args := args copyWith: 'mktemp -d'.
    proc args: args.
    proc run.
    ^proc stdout trimBoth
  ]

  classMethod: seedMission: bbs scope: scope identity: id status: status [
    "Write a mission tuple (no epic_id) in `scope`."
    | p |
    p := Dictionary new.
    p at: 'brief' put: ('brief for ', id).
    p at: 'plan' put: 'the plan'.
    p at: 'status' put: status.
    p at: 'created_at' put: DateTime now epochSeconds.
    bbs out: 'mission' scope: scope identity: id payload: p
  ]

  classMethod: seedMissionWithBreakdown: bbs scope: scope identity: id breakdown: bd [
    "Write an approved mission carrying a structured payload.breakdown."
    | p |
    p := Dictionary new.
    p at: 'brief' put: ('brief for ', id).
    p at: 'plan' put: 'the plan'.
    p at: 'status' put: 'approved'.
    p at: 'breakdown' put: bd.
    p at: 'created_at' put: DateTime now epochSeconds.
    bbs out: 'mission' scope: scope identity: id payload: p
  ]

  classMethod: seedInProgressMission: bbs scope: scope identity: id [
    "An in-progress (dispatched) mission with an epic pointer."
    | p |
    p := Dictionary new.
    p at: 'brief' put: ('brief for ', id).
    p at: 'status' put: 'in-progress'.
    p at: 'epic_id' put: ('epic-', id).
    p at: 'created_at' put: DateTime now epochSeconds.
    bbs out: 'mission' scope: scope identity: id payload: p
  ]

  classMethod: seedItem: bbs scope: scope identity: wid mission: mid status: status [
    "A mission-stamped work-item at a given status."
    | p |
    p := Dictionary new.
    p at: 'title' put: wid.
    p at: 'type' put: 'story'.
    p at: 'status' put: status.
    p at: 'mission_id' put: mid.
    bbs outPinned: 'workitem' scope: scope identity: wid payload: p
  ]

  classMethod: missionStatus: bbs scope: scope identity: id [
    | m |
    m := bbs rdp: 'mission' scope: scope identity: id.
    ^m isNil ifTrue: [nil] ifFalse: [(m at: 'payload' ifAbsent: [Dictionary new]) at: 'status' ifAbsent: [nil]]
  ]

  classMethod: itemsForMission: bbs mission: id [
    "All 'workitem' tuples whose payload.mission_id = id (the blast-radius query)."
    ^(bbs scanAll: 'workitem') select: [:t |
      ((t at: 'payload' ifAbsent: [Dictionary new]) at: 'mission_id' ifAbsent: [nil]) = id
    ]
  ]

  classMethod: storiesForMission: bbs mission: id [
    "Mission work-items of type 'story' (excludes the epic)."
    ^(self itemsForMission: bbs mission: id) select: [:t |
      ((t at: 'payload' ifAbsent: [Dictionary new]) at: 'type' ifAbsent: [nil]) = 'story'
    ]
  ]

  classMethod: itemById: bbs id: wid [
    "One workitem tuple by identity, or nil."
    | hit |
    hit := nil.
    (bbs scanAll: 'workitem') do: [:t |
      (t at: 'identity' ifAbsent: [nil]) = wid ifTrue: [hit := t]
    ].
    ^hit
  ]

  classMethod: mkStory: title wave: wave dependsOn: deps [
    "Build one breakdown entry Dictionary (no dict literals in Maggie)."
    | e |
    e := Dictionary new.
    e at: 'title' put: title.
    e at: 'wave' put: wave.
    e at: 'depends_on' put: deps.
    ^e
  ]

  classMethod: missionEpicId: bbs scope: scope identity: id [
    | m |
    m := bbs rdp: 'mission' scope: scope identity: id.
    ^m isNil
      ifTrue: [nil]
      ifFalse: [(m at: 'payload' ifAbsent: [Dictionary new]) at: 'epic_id' ifAbsent: [nil]]
  ]

"=== Tests ==="
TestMissionReconcile subclass: Object

  classMethod: run: t [
    self testApprovedSpawnsOneEpic: t.
    self testIdempotentSweeps: t.
    self testOnlyApprovedReconciles: t.
    self testNonFatalMalformedMission: t.
    self testBreakdownMaterializesStories: t.
    self testBreakdownIdempotent: t.
    self testNoBreakdownEpicOnly: t.
    self testRollupAllDone: t.
    self testRollupNotAllDone: t.
    self testRollupNoItems: t.
    self testRollupOnlyInProgress: t
  ]

  classMethod: testApprovedSpawnsOneEpic: t [
    | tempDir bbs disp epics ep |
    '--- MR-a: approved mission spawns exactly one stamped epic ---' println.
    tempDir := MRHelper makeTempDir.
    bbs := BBS withDataDir: tempDir.
    MRHelper seedMission: bbs scope: 'repoA' identity: 'msn-1' status: 'approved'.
    disp := Dispatcher on: bbs harnessFactory: nil.
    disp maybeReconcileMissions.

    epics := MRHelper itemsForMission: bbs mission: 'msn-1'.
    t assertEqual: epics size to: 1 message: 'MR-a: exactly one epic for the mission'.
    epics size = 1 ifTrue: [
      | p |
      ep := epics at: 1.
      p := ep at: 'payload'.
      t assertEqual: (ep at: 'identity') to: 'epic-msn-1' message: 'MR-a: deterministic epic id'.
      t assertEqual: (p at: 'type' ifAbsent: [nil]) to: 'epic' message: 'MR-a: type=epic'.
      t assertEqual: (p at: 'status' ifAbsent: [nil]) to: 'ready' message: 'MR-a: status=ready (not dispatched)'.
      t assertEqual: (p at: 'mission_id' ifAbsent: [nil]) to: 'msn-1' message: 'MR-a: mission_id stamped'
    ].
    t assertEqual: (MRHelper missionEpicId: bbs scope: 'repoA' identity: 'msn-1') to: 'epic-msn-1'
      message: 'MR-a: mission.epic_id stamped'
  ]

  classMethod: testIdempotentSweeps: t [
    | tempDir bbs disp |
    '--- MR-b: repeated sweeps never spawn a second epic ---' println.
    tempDir := MRHelper makeTempDir.
    bbs := BBS withDataDir: tempDir.
    MRHelper seedMission: bbs scope: 'repoA' identity: 'msn-2' status: 'approved'.
    disp := Dispatcher on: bbs harnessFactory: nil.
    disp maybeReconcileMissions.
    disp maybeReconcileMissions.
    disp maybeReconcileMissions.

    t assertEqual: (MRHelper itemsForMission: bbs mission: 'msn-2') size to: 1
      message: 'MR-b: still exactly one epic after three sweeps'
  ]

  classMethod: testOnlyApprovedReconciles: t [
    | tempDir bbs disp |
    '--- MR-c: non-approved missions spawn nothing ---' println.
    tempDir := MRHelper makeTempDir.
    bbs := BBS withDataDir: tempDir.
    MRHelper seedMission: bbs scope: 'repoA' identity: 'msn-r' status: 'researching'.
    MRHelper seedMission: bbs scope: 'repoA' identity: 'msn-w' status: 'awaiting-approval'.
    MRHelper seedMission: bbs scope: 'repoA' identity: 'msn-x' status: 'rejected'.
    disp := Dispatcher on: bbs harnessFactory: nil.
    disp maybeReconcileMissions.

    t assertEqual: (MRHelper itemsForMission: bbs mission: 'msn-r') size to: 0
      message: 'MR-c: researching does not reconcile'.
    t assertEqual: (MRHelper itemsForMission: bbs mission: 'msn-w') size to: 0
      message: 'MR-c: awaiting-approval does not reconcile'.
    t assertEqual: (MRHelper itemsForMission: bbs mission: 'msn-x') size to: 0
      message: 'MR-c: rejected does not reconcile'.
    t assert: (MRHelper missionEpicId: bbs scope: 'repoA' identity: 'msn-w') isNil
      message: 'MR-c: awaiting-approval mission keeps epic_id nil'
  ]

  classMethod: testNonFatalMalformedMission: t [
    | tempDir bbs disp threw |
    '--- MR-d: malformed mission does not abort or escape the sweep ---' println.
    tempDir := MRHelper makeTempDir.
    bbs := BBS withDataDir: tempDir.
    "A mission whose payload is a String, not a Dictionary — the status read
     throws inside the per-mission guard."
    bbs out: 'mission' scope: 'repoA' identity: 'msn-bad' payload: 'not-a-dict'.
    MRHelper seedMission: bbs scope: 'repoA' identity: 'msn-ok' status: 'approved'.
    disp := Dispatcher on: bbs harnessFactory: nil.
    threw := false.
    [disp maybeReconcileMissions] on: Exception do: [:e | threw := true].

    t assert: threw not message: 'MR-d: malformed mission did not escape the sweep'.
    t assertEqual: (MRHelper itemsForMission: bbs mission: 'msn-ok') size to: 1
      message: 'MR-d: valid approved mission still fired despite malformed neighbour'
  ]

  classMethod: testBreakdownMaterializesStories: t [
    | tempDir bbs disp bd s1 s2 s3 stories st1 st3 |
    '--- MR-e: approved mission with breakdown materializes a story tree ---' println.
    tempDir := MRHelper makeTempDir.
    bbs := BBS withDataDir: tempDir.
    s1 := MRHelper mkStory: 'Story one' wave: 1 dependsOn: (Array new: 0).
    s2 := MRHelper mkStory: 'Story two' wave: 1 dependsOn: (Array new: 0).
    s3 := MRHelper mkStory: 'Story three' wave: 2 dependsOn: ((Array new: 0) copyWith: 1).
    bd := (((Array new: 0) copyWith: s1) copyWith: s2) copyWith: s3.
    MRHelper seedMissionWithBreakdown: bbs scope: 'repoA' identity: 'msn-bd' breakdown: bd.
    disp := Dispatcher on: bbs harnessFactory: nil.
    disp maybeReconcileMissions.

    t assertEqual: (MRHelper itemsForMission: bbs mission: 'msn-bd') size to: 4
      message: 'MR-e: epic + 3 stories materialized'.
    stories := MRHelper storiesForMission: bbs mission: 'msn-bd'.
    t assertEqual: stories size to: 3 message: 'MR-e: exactly 3 stories'.

    st1 := MRHelper itemById: bbs id: 'story-msn-bd-1'.
    t assert: st1 notNil message: 'MR-e: deterministic story id story-msn-bd-1'.
    st1 notNil ifTrue: [
      | p |
      p := st1 at: 'payload'.
      t assertEqual: (p at: 'type' ifAbsent: [nil]) to: 'story' message: 'MR-e: story type'.
      t assertEqual: (p at: 'parent' ifAbsent: [nil]) to: 'epic-msn-bd' message: 'MR-e: parent=epic-msn-bd'.
      t assertEqual: (p at: 'mission_id' ifAbsent: [nil]) to: 'msn-bd' message: 'MR-e: story mission_id stamped'.
      t assertEqual: (p at: 'wave' ifAbsent: [nil]) to: 1 message: 'MR-e: wave carried'.
      t assertEqual: (p at: 'status' ifAbsent: [nil]) to: 'ready' message: 'MR-e: story status=ready'
    ].
    st3 := MRHelper itemById: bbs id: 'story-msn-bd-3'.
    t assert: st3 notNil message: 'MR-e: story-msn-bd-3 exists'.
    st3 notNil ifTrue: [
      | p deps |
      p := st3 at: 'payload'.
      t assertEqual: (p at: 'wave' ifAbsent: [nil]) to: 2 message: 'MR-e: story 3 wave=2'.
      deps := p at: 'depends_on' ifAbsent: [Array new: 0].
      t assertEqual: deps size to: 1 message: 'MR-e: story 3 has one dep'.
      t assert: (deps includes: 'story-msn-bd-1')
        message: 'MR-e: depends_on index 1 mapped to sibling story id'
    ]
  ]

  classMethod: testBreakdownIdempotent: t [
    | tempDir bbs disp bd s1 s2 |
    '--- MR-f: re-sweep with breakdown does not duplicate stories ---' println.
    tempDir := MRHelper makeTempDir.
    bbs := BBS withDataDir: tempDir.
    s1 := MRHelper mkStory: 'A' wave: 1 dependsOn: (Array new: 0).
    s2 := MRHelper mkStory: 'B' wave: 1 dependsOn: (Array new: 0).
    bd := ((Array new: 0) copyWith: s1) copyWith: s2.
    MRHelper seedMissionWithBreakdown: bbs scope: 'repoA' identity: 'msn-bd2' breakdown: bd.
    disp := Dispatcher on: bbs harnessFactory: nil.
    disp maybeReconcileMissions.
    disp maybeReconcileMissions.

    t assertEqual: (MRHelper storiesForMission: bbs mission: 'msn-bd2') size to: 2
      message: 'MR-f: still exactly 2 stories after re-sweep'.
    t assertEqual: (MRHelper itemsForMission: bbs mission: 'msn-bd2') size to: 3
      message: 'MR-f: epic + 2 stories, no duplicates'
  ]

  classMethod: testNoBreakdownEpicOnly: t [
    | tempDir bbs disp |
    '--- MR-g: approved mission WITHOUT breakdown -> epic only (back-compat) ---' println.
    tempDir := MRHelper makeTempDir.
    bbs := BBS withDataDir: tempDir.
    MRHelper seedMission: bbs scope: 'repoA' identity: 'msn-nb' status: 'approved'.
    disp := Dispatcher on: bbs harnessFactory: nil.
    disp maybeReconcileMissions.

    t assertEqual: (MRHelper storiesForMission: bbs mission: 'msn-nb') size to: 0
      message: 'MR-g: no stories when breakdown is absent'.
    t assertEqual: (MRHelper itemsForMission: bbs mission: 'msn-nb') size to: 1
      message: 'MR-g: just the epic'
  ]

  classMethod: testRollupAllDone: t [
    | tempDir bbs disp |
    '--- MR-h: in-progress mission with all items done -> done ---' println.
    tempDir := MRHelper makeTempDir.
    bbs := BBS withDataDir: tempDir.
    MRHelper seedInProgressMission: bbs scope: 'repoA' identity: 'msn-ip'.
    MRHelper seedItem: bbs scope: 'repoA' identity: 'epic-msn-ip' mission: 'msn-ip' status: 'done'.
    MRHelper seedItem: bbs scope: 'repoA' identity: 'story-msn-ip-1' mission: 'msn-ip' status: 'done'.
    disp := Dispatcher on: bbs harnessFactory: nil.
    disp maybeRollupMissions.

    t assertEqual: (MRHelper missionStatus: bbs scope: 'repoA' identity: 'msn-ip') to: 'done'
      message: 'MR-h: mission rolled to done when all items done'
  ]

  classMethod: testRollupNotAllDone: t [
    | tempDir bbs disp |
    '--- MR-i: in-progress mission with an unfinished item stays in-progress ---' println.
    tempDir := MRHelper makeTempDir.
    bbs := BBS withDataDir: tempDir.
    MRHelper seedInProgressMission: bbs scope: 'repoA' identity: 'msn-ip2'.
    MRHelper seedItem: bbs scope: 'repoA' identity: 'story-msn-ip2-1' mission: 'msn-ip2' status: 'done'.
    MRHelper seedItem: bbs scope: 'repoA' identity: 'story-msn-ip2-2' mission: 'msn-ip2' status: 'in-progress'.
    disp := Dispatcher on: bbs harnessFactory: nil.
    disp maybeRollupMissions.

    t assertEqual: (MRHelper missionStatus: bbs scope: 'repoA' identity: 'msn-ip2') to: 'in-progress'
      message: 'MR-i: mission stays in-progress while an item is unfinished'
  ]

  classMethod: testRollupNoItems: t [
    | tempDir bbs disp |
    '--- MR-j: in-progress mission with NO items is not declared done ---' println.
    tempDir := MRHelper makeTempDir.
    bbs := BBS withDataDir: tempDir.
    MRHelper seedInProgressMission: bbs scope: 'repoA' identity: 'msn-ip3'.
    disp := Dispatcher on: bbs harnessFactory: nil.
    disp maybeRollupMissions.

    t assertEqual: (MRHelper missionStatus: bbs scope: 'repoA' identity: 'msn-ip3') to: 'in-progress'
      message: 'MR-j: no-item mission is not spuriously rolled to done'
  ]

  classMethod: testRollupOnlyInProgress: t [
    | tempDir bbs disp |
    '--- MR-k: only in-progress missions roll up (approved w/ done items untouched) ---' println.
    tempDir := MRHelper makeTempDir.
    bbs := BBS withDataDir: tempDir.
    "An approved (not yet run) mission whose items happen to be done must NOT
     jump to done — rollup fires only from in-progress."
    MRHelper seedMission: bbs scope: 'repoA' identity: 'msn-ap' status: 'approved'.
    MRHelper seedItem: bbs scope: 'repoA' identity: 'epic-msn-ap' mission: 'msn-ap' status: 'done'.
    disp := Dispatcher on: bbs harnessFactory: nil.
    disp maybeRollupMissions.

    t assertEqual: (MRHelper missionStatus: bbs scope: 'repoA' identity: 'msn-ap') to: 'approved'
      message: 'MR-k: approved mission not rolled to done'
  ]

"=== Main ==="
MissionReconcileMain subclass: Object
  classMethod: start [
    | t |
    t := MRRunner new.
    TestMissionReconcile run: t.
    t report.
    ^t failed
  ]
