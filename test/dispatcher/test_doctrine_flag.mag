"Tests for the doctrine feedback SURFACING layer:
   (1) DoctrineCLI show/list render vote tallies (formatVoteTallyLine: /
       formatVoteColumn:), computed at the doctrine's canonical doctrine_scope.
   (2) Dispatcher>>maybeFlagDislikedDoctrine — the off-critical-path sweep that
       FLAGS (never auto-retires) consistently net-disliked ACTIVE doctrine for
       human review via a warn notification, idempotently.

 Invariants under test:
   DF1  show renders 'votes: up N / down M / net K'; list renders a '+N/-M' column.
   DF2  Sweep flags an ACTIVE doctrine with net <= -3 AND total >= 3 -> exactly one
        warn notification + a 'doctrine-feedback-flagged:<id>' marker signal.
   DF3  Idempotent: a second sweep does NOT re-notify (no new notification) unless
        the net drops further; a further downvote -> exactly one MORE notification.
   DF4  Below minVotes (total < 3) -> NO flag even if net <= -3.
   DF5  Active-only: proposed/retired doctrine is never flagged.
   DF6  Disabled via config -> never flags.
   DF7  Non-fatal: a malformed feedback (or doctrine) tuple cannot abort the sweep.
   DF8  NEVER auto-retires: the flagged doctrine's maturity stays 'active'.

 Real BBS (BBS withDataDir:) is used so the full scan + notify + upsertSignal path
 runs end-to-end against an in-memory tuplespace. Config is overridden via a
 Dispatcher subclass so the suite is hermetic (no ambient env dependency)."

"--- Deterministic-config Dispatcher (mirrors AutoSynthTestDispatcher) ---"
FlagTestDispatcher subclass: Dispatcher
  instanceVars: cfgEnabled cfgRetireNet cfgMinVotes dvgEnabled dvgPos dvgNeg dvgMinN dvgLow dvgHigh

  method: cfgEnabled: e retireNet: rn minVotes: mv [
    cfgEnabled := e.
    cfgRetireNet := rn.
    cfgMinVotes := mv
  ]

  method: feedbackFlagEnabled [ ^cfgEnabled ]
  method: feedbackRetireNet [ ^cfgRetireNet ]
  method: feedbackMinVotes [ ^cfgMinVotes ]

  "--- Deterministic divergence-backstop config (mirrors the feedback cfg) ---"
  method: dvgEnabled: e pos: pv neg: nv minN: mn low: lo high: hi [
    dvgEnabled := e.
    dvgPos := pv.
    dvgNeg := nv.
    dvgMinN := mn.
    dvgLow := lo.
    dvgHigh := hi
  ]

  method: divergenceBackstopEnabled [ ^dvgEnabled ]
  method: divergencePosVotes [ ^dvgPos ]
  method: divergenceNegVotes [ ^dvgNeg ]
  method: divergenceMinN [ ^dvgMinN ]
  method: divergenceLowOutcome [ ^dvgLow ]
  method: divergenceHighOutcome [ ^dvgHigh ]

"--- A DoctrineCLI subclass whose read seams are backed by an in-memory BBS, so
 feedbackTallyFor: / the show/list formatters run END-TO-END without a server. ---"
FlagTestCLI subclass: DoctrineCLI
  instanceVars: tbbs

  classMethod: onBbs: aBbs [
    | c |
    c := self new.
    c bindBbs: aBbs.
    ^c
  ]

  method: bindBbs: aBbs [ tbbs := aBbs ]

  method: rdpDoctrine: id [
    ^tbbs rdp: 'doctrine' scope: 'global' identity: id
  ]

  method: scanFeedback: aScope [
    ^tbbs scan: 'doctrine-feedback' scope: aScope
  ]

  "Signal reads (outcome stats + divergence marker) backed by the in-memory BBS."
  method: rdpSignal: identity scope: aScope [
    ^tbbs rdp: 'signal' scope: aScope identity: identity
  ]

  method: outcomeStatsFor: doctrineId scope: aScope [
    ^tbbs outcomeStatsFor: doctrineId scope: aScope
  ]

"--- Runner ---"
DflagRunner subclass: Object
  instanceVars: passed failed failures

  classMethod: new [ ^super new init ]

  method: init [
    passed := 0.
    failed := 0.
    failures := Array new: 0
  ]

  method: assert: cond message: msg [
    cond ifTrue: [passed := passed + 1] ifFalse: [
      failed := failed + 1.
      failures := failures copyWith: msg.
      ('FAIL: ', msg) println
    ]
  ]

  method: assertEqual: actual to: expected message: msg [
    (actual = expected) ifTrue: [passed := passed + 1] ifFalse: [
      failed := failed + 1.
      failures := failures copyWith: msg.
      ('FAIL: ', msg, ' (got: ', actual printString, ' expected: ', expected printString, ')') println
    ]
  ]

  method: report [
    '=== Doctrine Feedback Flag Test Results ===' println.
    ('Passed: ', passed printString) println.
    ('Failed: ', failed printString) println.
    failed > 0 ifTrue: [
      'Failures:' println.
      failures do: [:f | ('  - ', f) println]
    ].
    failed = 0
      ifTrue: ['ALL TESTS PASSED' println]
      ifFalse: ['SOME TESTS FAILED' println]
  ]

  method: failed [ ^failed ]

"--- Helpers ---"
DflagHelper subclass: Object

  classMethod: makeTempDir [
    | proc args |
    proc := ExternalProcess command: '/bin/sh'.
    args := Array new: 0.
    args := args copyWith: '-c'.
    args := args copyWith: 'mktemp -d'.
    proc args: args.
    proc run.
    ^proc stdout trimBoth
  ]

  classMethod: now [ ^DateTime now epochSeconds ]

  classMethod: seedDoctrine: bbs id: id scope: dscope key: key maturity: maturity [
    "Seed a doctrine at storage scope 'global' (mirrors routing/feedback tests)
     whose payload doctrine_scope is dscope — the canonical feedback scope."
    | p |
    p := Dictionary new.
    p at: 'key' put: key.
    p at: 'doctrine_scope' put: dscope.
    p at: 'maturity' put: maturity.
    bbs out: 'doctrine' scope: 'global' identity: id payload: p
  ]

  classMethod: seedVotes: bbs doctrine: id scope: dscope up: nUp down: nDown [
    "Append nUp 'up' + nDown 'down' feedback tuples for doctrine id at dscope."
    1 to: nUp do: [:i |
      | p |
      p := Dictionary new.
      p at: 'doctrine_id' put: id.
      p at: 'verdict' put: 'up'.
      bbs out: 'doctrine-feedback' scope: dscope identity: ('dfb-', id, '-u', i printString) payload: p
    ].
    1 to: nDown do: [:i |
      | p |
      p := Dictionary new.
      p at: 'doctrine_id' put: id.
      p at: 'verdict' put: 'down'.
      bbs out: 'doctrine-feedback' scope: dscope identity: ('dfb-', id, '-d', i printString) payload: p
    ]
  ]

  classMethod: notificationsIn: bbs scope: scope [
    ^bbs scan: 'notification' scope: scope
  ]

  classMethod: flagMarkerIn: bbs scope: scope doctrine: id [
    ^bbs rdp: 'signal' scope: scope identity: ('doctrine-feedback-flagged:', id)
  ]

  classMethod: divMarkerIn: bbs scope: scope doctrine: id [
    ^bbs rdp: 'signal' scope: scope identity: ('doctrine-divergence-flagged:', id)
  ]

  classMethod: dispatcherOn: bbs enabled: e retireNet: rn minVotes: mv [
    | d |
    d := FlagTestDispatcher on: bbs harnessFactory: nil.
    d cfgEnabled: e retireNet: rn minVotes: mv.
    ^d
  ]

  classMethod: seedOutcome: bbs doctrine: id scope: dscope n: n ewma: ewma nSuccess: ns [
    "Seed the per-doctrine outcome-stats signal at the canonical doctrine_scope.
     ewma is integer MILLI-units [0,1000] (mirrors the real fold)."
    | p |
    p := Dictionary new.
    p at: 'n' put: n.
    p at: 'ewma_score' put: ewma.
    p at: 'n_success' put: ns.
    bbs upsertSignal: dscope identity: ('doctrine-outcome-stats:', id) payload: p
  ]

  classMethod: divMarkerPayloadClass: class [
    "A minimal divergence-marker payload carrying just the class — for testing the
     CLI divergence-note formatter without running the dispatcher sweep."
    | p |
    p := Dictionary new.
    p at: 'class' put: class.
    p at: 'net' put: 5.
    p at: 'ewma_score' put: 300.
    ^p
  ]

  classMethod: divergenceDispatcherOn: bbs enabled: e pos: pv neg: nv minN: mn low: lo high: hi [
    | d |
    d := FlagTestDispatcher on: bbs harnessFactory: nil.
    "Feedback sweep is irrelevant here but its config must be set; disable it."
    d cfgEnabled: false retireNet: -3 minVotes: 3.
    d dvgEnabled: e pos: pv neg: nv minN: mn low: lo high: hi.
    ^d
  ]

"=== Tests ==="
TestDoctrineFlag subclass: Object

  classMethod: run: t [
    self testShowListRenderTallies: t.
    self testSweepFlagsDislikedActive: t.
    self testIdempotentNoReflagUnlessWorse: t.
    self testBelowMinVotesNoFlag: t.
    self testActiveOnly: t.
    self testDisabledNeverFlags: t.
    self testNonFatalMalformedTuple: t.
    "--- Divergence backstop (the 'lie-detector') ---"
    self testDivergenceSuspectFlags: t.
    self testDivergenceUnderAppreciatedFlags: t.
    self testDivergenceAgreementNoFlag: t.
    self testDivergenceInsufficientEvidenceNoFlag: t.
    self testDivergenceIdempotent: t.
    self testDivergenceActiveOnly: t.
    self testDivergenceDisabledNeverFlags: t.
    self testDivergenceNonFatal: t.
    self testShowRendersOutcomeAndDivergence: t
  ]

  classMethod: testShowListRenderTallies: t [
    "DF1: show/list formatters render the tally; tally computed at canonical scope."
    | bbs cli tally |
    '--- DF1: show/list render vote tallies ---' println.
    bbs := BBS withDataDir: DflagHelper makeTempDir.
    DflagHelper seedDoctrine: bbs id: 'dctr-show' scope: 'global' key: 'k-show' maturity: 'active'.
    DflagHelper seedVotes: bbs doctrine: 'dctr-show' scope: 'global' up: 3 down: 1.
    cli := FlagTestCLI onBbs: bbs.

    tally := cli feedbackTallyFor: 'dctr-show' scope: 'global'.
    t assertEqual: (cli formatVoteColumn: tally) to: '+3/-1'
      message: 'DF1: list vote column is +3/-1'.
    t assertEqual: (cli formatVoteTallyLine: tally) to: 'up 3 / down 1 / net 2'
      message: 'DF1: show tally line renders up/down/net'.

    "Empty/no-feedback doctrine renders zeros, not a crash."
    t assertEqual: (cli formatVoteColumn: (cli feedbackTallyFor: 'dctr-none' scope: 'global'))
      to: '+0/-0'
      message: 'DF1: no-feedback doctrine renders +0/-0'
  ]

  classMethod: testSweepFlagsDislikedActive: t [
    "DF2: net <= -3 AND total >= 3 on an ACTIVE doctrine -> one warn notification
     + a flag marker. DF8: maturity stays 'active' (never auto-retired)."
    | bbs disp notes marker dctr |
    '--- DF2/DF8: sweep flags net-disliked active doctrine, never retires ---' println.
    bbs := BBS withDataDir: DflagHelper makeTempDir.
    "net = 1 - 4 = -3, total = 5."
    DflagHelper seedDoctrine: bbs id: 'dctr-bad' scope: 'global' key: 'k-bad' maturity: 'active'.
    DflagHelper seedVotes: bbs doctrine: 'dctr-bad' scope: 'global' up: 1 down: 4.
    disp := DflagHelper dispatcherOn: bbs enabled: true retireNet: -3 minVotes: 3.
    disp maybeFlagDislikedDoctrine.

    notes := DflagHelper notificationsIn: bbs scope: 'global'.
    t assertEqual: notes size to: 1
      message: 'DF2: exactly one notification emitted for the disliked doctrine'.
    notes size = 1 ifTrue: [
      | np |
      np := (notes at: 1) at: 'payload'.
      t assertEqual: (np at: 'severity' ifAbsent: [nil]) to: 'warn'
        message: 'DF2: notification severity is warn'.
      t assert: ((np at: 'message' ifAbsent: ['']) includes: 'dctr-bad')
        message: 'DF2: notification message names the doctrine id'.
      t assert: ((np at: 'message' ifAbsent: ['']) includes: 'retire')
        message: 'DF2: notification recommends retire (human-gated)'
    ].
    marker := DflagHelper flagMarkerIn: bbs scope: 'global' doctrine: 'dctr-bad'.
    t assert: marker notNil
      message: 'DF2: idempotency marker signal was written'.
    marker notNil ifTrue: [
      t assertEqual: ((marker at: 'payload') at: 'net' ifAbsent: [nil]) to: -3
        message: 'DF2: marker carries the net at flag time'
    ].

    "DF8: the doctrine must NOT have been retired — flag-only, human-gated."
    dctr := bbs rdp: 'doctrine' scope: 'global' identity: 'dctr-bad'.
    t assertEqual: ((dctr at: 'payload') at: 'maturity' ifAbsent: [nil]) to: 'active'
      message: 'DF8: doctrine maturity stays active (never auto-retired)'
  ]

  classMethod: testIdempotentNoReflagUnlessWorse: t [
    "DF3: a second sweep does NOT re-notify; a further downvote (net drops) does."
    | bbs disp |
    '--- DF3: idempotent — re-notify only when net drops further ---' println.
    bbs := BBS withDataDir: DflagHelper makeTempDir.
    DflagHelper seedDoctrine: bbs id: 'dctr-idem' scope: 'global' key: 'k-idem' maturity: 'active'.
    DflagHelper seedVotes: bbs doctrine: 'dctr-idem' scope: 'global' up: 1 down: 4.
    disp := DflagHelper dispatcherOn: bbs enabled: true retireNet: -3 minVotes: 3.

    disp maybeFlagDislikedDoctrine.
    t assertEqual: (DflagHelper notificationsIn: bbs scope: 'global') size to: 1
      message: 'DF3: first sweep notifies once'.
    "Second + third sweep with unchanged votes -> NO new notification."
    disp maybeFlagDislikedDoctrine.
    disp maybeFlagDislikedDoctrine.
    t assertEqual: (DflagHelper notificationsIn: bbs scope: 'global') size to: 1
      message: 'DF3: repeated sweeps do NOT re-notify (idempotent)'.

    "Net drops further (one more downvote: net -3 -> -4) -> exactly one more notify."
    DflagHelper seedVotes: bbs doctrine: 'dctr-idem' scope: 'global' up: 0 down: 1.
    disp maybeFlagDislikedDoctrine.
    t assertEqual: (DflagHelper notificationsIn: bbs scope: 'global') size to: 2
      message: 'DF3: a further net drop re-notifies exactly once more'.
    "And no re-notify again at the new (worse) floor."
    disp maybeFlagDislikedDoctrine.
    t assertEqual: (DflagHelper notificationsIn: bbs scope: 'global') size to: 2
      message: 'DF3: stable again at the worsened net (no extra notify)'
  ]

  classMethod: testBelowMinVotesNoFlag: t [
    "DF4: net <= -3 but total < minVotes -> NO flag."
    | bbs disp |
    '--- DF4: below minVotes -> no flag ---' println.
    bbs := BBS withDataDir: DflagHelper makeTempDir.
    "net = 0 - 2 = -2? No — make net <= -3 but total small is impossible with
     down-only at total<3. Use minVotes=5 so total=4 (net -4) is below it."
    DflagHelper seedDoctrine: bbs id: 'dctr-few' scope: 'global' key: 'k-few' maturity: 'active'.
    DflagHelper seedVotes: bbs doctrine: 'dctr-few' scope: 'global' up: 0 down: 4.
    disp := DflagHelper dispatcherOn: bbs enabled: true retireNet: -3 minVotes: 5.
    disp maybeFlagDislikedDoctrine.

    t assertEqual: (DflagHelper notificationsIn: bbs scope: 'global') size to: 0
      message: 'DF4: total(4) < minVotes(5) -> no notification'.
    t assert: (DflagHelper flagMarkerIn: bbs scope: 'global' doctrine: 'dctr-few') isNil
      message: 'DF4: no flag marker written below minVotes'
  ]

  classMethod: testActiveOnly: t [
    "DF5: proposed/retired doctrine is never flagged even when net-disliked."
    | bbs disp |
    '--- DF5: active-only (proposed/retired ignored) ---' println.
    bbs := BBS withDataDir: DflagHelper makeTempDir.
    DflagHelper seedDoctrine: bbs id: 'dctr-prop' scope: 'global' key: 'k-prop' maturity: 'proposed'.
    DflagHelper seedVotes: bbs doctrine: 'dctr-prop' scope: 'global' up: 0 down: 5.
    DflagHelper seedDoctrine: bbs id: 'dctr-ret' scope: 'global' key: 'k-ret' maturity: 'retired'.
    DflagHelper seedVotes: bbs doctrine: 'dctr-ret' scope: 'global' up: 0 down: 5.
    disp := DflagHelper dispatcherOn: bbs enabled: true retireNet: -3 minVotes: 3.
    disp maybeFlagDislikedDoctrine.

    t assertEqual: (DflagHelper notificationsIn: bbs scope: 'global') size to: 0
      message: 'DF5: neither proposed nor retired doctrine is flagged'
  ]

  classMethod: testDisabledNeverFlags: t [
    "DF6: disabled config never flags, even with a strongly net-disliked active."
    | bbs disp |
    '--- DF6: disabled config never flags ---' println.
    bbs := BBS withDataDir: DflagHelper makeTempDir.
    DflagHelper seedDoctrine: bbs id: 'dctr-off' scope: 'global' key: 'k-off' maturity: 'active'.
    DflagHelper seedVotes: bbs doctrine: 'dctr-off' scope: 'global' up: 0 down: 10.
    disp := DflagHelper dispatcherOn: bbs enabled: false retireNet: -3 minVotes: 3.
    disp maybeFlagDislikedDoctrine.

    t assertEqual: (DflagHelper notificationsIn: bbs scope: 'global') size to: 0
      message: 'DF6: no notification when disabled'.
    t assert: (DflagHelper flagMarkerIn: bbs scope: 'global' doctrine: 'dctr-off') isNil
      message: 'DF6: no marker written when disabled'
  ]

  classMethod: testNonFatalMalformedTuple: t [
    "DF7: a malformed feedback/doctrine tuple cannot abort the sweep — a valid
     net-disliked doctrine elsewhere is still flagged."
    | bbs disp threw |
    '--- DF7: malformed tuple does not abort the sweep ---' println.
    bbs := BBS withDataDir: DflagHelper makeTempDir.
    "A doctrine whose payload is a String, not a Dictionary."
    bbs out: 'doctrine' scope: 'global' identity: 'dctr-garbage' payload: 'not-a-dict'.
    "A feedback tuple whose payload is a String (read inside the tally)."
    bbs out: 'doctrine-feedback' scope: 'global' identity: 'dfb-garbage' payload: 'not-a-dict'.
    "A valid, net-disliked active doctrine that SHOULD still flag."
    DflagHelper seedDoctrine: bbs id: 'dctr-ok' scope: 'global' key: 'k-ok' maturity: 'active'.
    DflagHelper seedVotes: bbs doctrine: 'dctr-ok' scope: 'global' up: 1 down: 5.
    disp := DflagHelper dispatcherOn: bbs enabled: true retireNet: -3 minVotes: 3.

    threw := false.
    [disp maybeFlagDislikedDoctrine] on: Exception do: [:e | threw := true].
    t assert: threw not
      message: 'DF7: malformed tuple did not escape the sweep'.
    t assertEqual: (DflagHelper notificationsIn: bbs scope: 'global') size to: 1
      message: 'DF7: valid disliked doctrine still flagged despite malformed tuples'
  ]

  classMethod: testDivergenceSuspectFlags: t [
    "DV1: net loved (>=pos) BUT outcomes underperforming (ewma<=low), enough N
     on BOTH sides -> ONE warn flag 'loved but underperforming'; never retires."
    | bbs disp notes marker dctr |
    '--- DV1: SUSPECT (loved but underperforming) flags ---' println.
    bbs := BBS withDataDir: DflagHelper makeTempDir.
    DflagHelper seedDoctrine: bbs id: 'dctr-syc' scope: 'global' key: 'k-syc' maturity: 'active'.
    DflagHelper seedVotes: bbs doctrine: 'dctr-syc' scope: 'global' up: 5 down: 0.
    DflagHelper seedOutcome: bbs doctrine: 'dctr-syc' scope: 'global' n: 6 ewma: 300 nSuccess: 2.
    disp := DflagHelper divergenceDispatcherOn: bbs enabled: true pos: 3 neg: -3 minN: 5 low: 400 high: 750.
    disp maybeFlagDoctrineDivergence.

    notes := DflagHelper notificationsIn: bbs scope: 'global'.
    t assertEqual: notes size to: 1
      message: 'DV1: exactly one notification for the suspect doctrine'.
    notes size = 1 ifTrue: [
      | np msg |
      np := (notes at: 1) at: 'payload'.
      msg := np at: 'message' ifAbsent: [''].
      t assertEqual: (np at: 'severity' ifAbsent: [nil]) to: 'warn'
        message: 'DV1: notification severity is warn'.
      t assert: (msg includes: 'dctr-syc')
        message: 'DV1: message names the doctrine id'.
      t assert: (msg includes: 'loved but underperforming')
        message: 'DV1: message states the SUSPECT class'
    ].
    marker := DflagHelper divMarkerIn: bbs scope: 'global' doctrine: 'dctr-syc'.
    t assert: marker notNil message: 'DV1: divergence marker written'.
    marker notNil ifTrue: [
      t assertEqual: ((marker at: 'payload') at: 'class' ifAbsent: [nil]) to: 'suspect'
        message: 'DV1: marker carries class=suspect'
    ].
    "Flag-only: maturity stays active."
    dctr := bbs rdp: 'doctrine' scope: 'global' identity: 'dctr-syc'.
    t assertEqual: ((dctr at: 'payload') at: 'maturity' ifAbsent: [nil]) to: 'active'
      message: 'DV1: doctrine maturity stays active (never auto-acted)'
  ]

  classMethod: testDivergenceUnderAppreciatedFlags: t [
    "DV2: net disliked (<=neg) BUT outcomes effective (ewma>=high) -> ONE warn
     flag 'disliked but effective'."
    | bbs disp notes marker |
    '--- DV2: UNDER-APPRECIATED (disliked but effective) flags ---' println.
    bbs := BBS withDataDir: DflagHelper makeTempDir.
    DflagHelper seedDoctrine: bbs id: 'dctr-und' scope: 'global' key: 'k-und' maturity: 'active'.
    DflagHelper seedVotes: bbs doctrine: 'dctr-und' scope: 'global' up: 0 down: 5.
    DflagHelper seedOutcome: bbs doctrine: 'dctr-und' scope: 'global' n: 6 ewma: 820 nSuccess: 5.
    disp := DflagHelper divergenceDispatcherOn: bbs enabled: true pos: 3 neg: -3 minN: 5 low: 400 high: 750.
    disp maybeFlagDoctrineDivergence.

    notes := DflagHelper notificationsIn: bbs scope: 'global'.
    t assertEqual: notes size to: 1
      message: 'DV2: exactly one notification for the under-appreciated doctrine'.
    notes size = 1 ifTrue: [
      | mp msg |
      mp := (notes at: 1) at: 'payload'.
      msg := mp at: 'message' ifAbsent: [''].
      t assert: (msg includes: 'disliked but effective')
        message: 'DV2: message states the UNDER-APPRECIATED class'
    ].
    marker := DflagHelper divMarkerIn: bbs scope: 'global' doctrine: 'dctr-und'.
    t assert: (marker notNil and: [((marker at: 'payload') at: 'class' ifAbsent: [nil]) = 'under-appreciated'])
      message: 'DV2: marker carries class=under-appreciated'
  ]

  classMethod: testDivergenceAgreementNoFlag: t [
    "DV3: votes and outcomes AGREE (loved+effective, disliked+underperforming)
     -> NO flag. Agreement is silent."
    | bbs disp |
    '--- DV3: agreement is silent (no flag) ---' println.
    bbs := BBS withDataDir: DflagHelper makeTempDir.
    "Loved AND effective."
    DflagHelper seedDoctrine: bbs id: 'dctr-good' scope: 'global' key: 'k-good' maturity: 'active'.
    DflagHelper seedVotes: bbs doctrine: 'dctr-good' scope: 'global' up: 5 down: 0.
    DflagHelper seedOutcome: bbs doctrine: 'dctr-good' scope: 'global' n: 6 ewma: 850 nSuccess: 6.
    "Disliked AND underperforming."
    DflagHelper seedDoctrine: bbs id: 'dctr-bad2' scope: 'global' key: 'k-bad2' maturity: 'active'.
    DflagHelper seedVotes: bbs doctrine: 'dctr-bad2' scope: 'global' up: 0 down: 5.
    DflagHelper seedOutcome: bbs doctrine: 'dctr-bad2' scope: 'global' n: 6 ewma: 200 nSuccess: 1.
    disp := DflagHelper divergenceDispatcherOn: bbs enabled: true pos: 3 neg: -3 minN: 5 low: 400 high: 750.
    disp maybeFlagDoctrineDivergence.

    t assertEqual: (DflagHelper notificationsIn: bbs scope: 'global') size to: 0
      message: 'DV3: aligned votes/outcomes produce no notification'
  ]

  classMethod: testDivergenceInsufficientEvidenceNoFlag: t [
    "DV4: below min outcome n OR below the vote threshold -> NO flag, even when the
     other side looks divergent."
    | bbs disp |
    '--- DV4: insufficient evidence on either side -> no flag ---' println.
    bbs := BBS withDataDir: DflagHelper makeTempDir.
    "Suspect-shaped votes + low ewma, but n(3) < minN(5)."
    DflagHelper seedDoctrine: bbs id: 'dctr-thinN' scope: 'global' key: 'k-thinN' maturity: 'active'.
    DflagHelper seedVotes: bbs doctrine: 'dctr-thinN' scope: 'global' up: 5 down: 0.
    DflagHelper seedOutcome: bbs doctrine: 'dctr-thinN' scope: 'global' n: 3 ewma: 300 nSuccess: 1.
    "Low ewma + enough n, but net(2) < posVotes(3)."
    DflagHelper seedDoctrine: bbs id: 'dctr-thinV' scope: 'global' key: 'k-thinV' maturity: 'active'.
    DflagHelper seedVotes: bbs doctrine: 'dctr-thinV' scope: 'global' up: 2 down: 0.
    DflagHelper seedOutcome: bbs doctrine: 'dctr-thinV' scope: 'global' n: 8 ewma: 300 nSuccess: 2.
    disp := DflagHelper divergenceDispatcherOn: bbs enabled: true pos: 3 neg: -3 minN: 5 low: 400 high: 750.
    disp maybeFlagDoctrineDivergence.

    t assertEqual: (DflagHelper notificationsIn: bbs scope: 'global') size to: 0
      message: 'DV4: thin evidence on either side -> no notification'.
    t assert: (DflagHelper divMarkerIn: bbs scope: 'global' doctrine: 'dctr-thinN') isNil
      message: 'DV4: no marker when outcome n below minN'.
    t assert: (DflagHelper divMarkerIn: bbs scope: 'global' doctrine: 'dctr-thinV') isNil
      message: 'DV4: no marker when net below posVotes'
  ]

  classMethod: testDivergenceIdempotent: t [
    "DV5: a second sweep does NOT re-notify; only a WORSENING divergence does."
    | bbs disp |
    '--- DV5: idempotent — re-notify only when divergence worsens ---' println.
    bbs := BBS withDataDir: DflagHelper makeTempDir.
    DflagHelper seedDoctrine: bbs id: 'dctr-idv' scope: 'global' key: 'k-idv' maturity: 'active'.
    DflagHelper seedVotes: bbs doctrine: 'dctr-idv' scope: 'global' up: 5 down: 0.
    DflagHelper seedOutcome: bbs doctrine: 'dctr-idv' scope: 'global' n: 6 ewma: 300 nSuccess: 2.
    disp := DflagHelper divergenceDispatcherOn: bbs enabled: true pos: 3 neg: -3 minN: 5 low: 400 high: 750.

    disp maybeFlagDoctrineDivergence.
    t assertEqual: (DflagHelper notificationsIn: bbs scope: 'global') size to: 1
      message: 'DV5: first sweep notifies once'.
    "Unchanged -> no re-notify."
    disp maybeFlagDoctrineDivergence.
    disp maybeFlagDoctrineDivergence.
    t assertEqual: (DflagHelper notificationsIn: bbs scope: 'global') size to: 1
      message: 'DV5: repeated sweeps do not re-notify (idempotent)'.
    "Outcome worsens (ewma 300 -> 150) -> one more notify."
    DflagHelper seedOutcome: bbs doctrine: 'dctr-idv' scope: 'global' n: 8 ewma: 150 nSuccess: 2.
    disp maybeFlagDoctrineDivergence.
    t assertEqual: (DflagHelper notificationsIn: bbs scope: 'global') size to: 2
      message: 'DV5: a worsened divergence re-notifies once more'.
    disp maybeFlagDoctrineDivergence.
    t assertEqual: (DflagHelper notificationsIn: bbs scope: 'global') size to: 2
      message: 'DV5: stable again at the worsened divergence (no extra notify)'
  ]

  classMethod: testDivergenceActiveOnly: t [
    "DV6: proposed/retired doctrine is never flagged even when divergent."
    | bbs disp |
    '--- DV6: active-only (proposed/retired ignored) ---' println.
    bbs := BBS withDataDir: DflagHelper makeTempDir.
    DflagHelper seedDoctrine: bbs id: 'dctr-pv' scope: 'global' key: 'k-pv' maturity: 'proposed'.
    DflagHelper seedVotes: bbs doctrine: 'dctr-pv' scope: 'global' up: 5 down: 0.
    DflagHelper seedOutcome: bbs doctrine: 'dctr-pv' scope: 'global' n: 6 ewma: 300 nSuccess: 1.
    disp := DflagHelper divergenceDispatcherOn: bbs enabled: true pos: 3 neg: -3 minN: 5 low: 400 high: 750.
    disp maybeFlagDoctrineDivergence.

    t assertEqual: (DflagHelper notificationsIn: bbs scope: 'global') size to: 0
      message: 'DV6: proposed doctrine is not flagged'
  ]

  classMethod: testDivergenceDisabledNeverFlags: t [
    "DV7: disabled backstop never flags, even on a stark divergence."
    | bbs disp |
    '--- DV7: disabled backstop never flags ---' println.
    bbs := BBS withDataDir: DflagHelper makeTempDir.
    DflagHelper seedDoctrine: bbs id: 'dctr-dis' scope: 'global' key: 'k-dis' maturity: 'active'.
    DflagHelper seedVotes: bbs doctrine: 'dctr-dis' scope: 'global' up: 10 down: 0.
    DflagHelper seedOutcome: bbs doctrine: 'dctr-dis' scope: 'global' n: 9 ewma: 100 nSuccess: 0.
    disp := DflagHelper divergenceDispatcherOn: bbs enabled: false pos: 3 neg: -3 minN: 5 low: 400 high: 750.
    disp maybeFlagDoctrineDivergence.

    t assertEqual: (DflagHelper notificationsIn: bbs scope: 'global') size to: 0
      message: 'DV7: no notification when disabled'.
    t assert: (DflagHelper divMarkerIn: bbs scope: 'global' doctrine: 'dctr-dis') isNil
      message: 'DV7: no marker written when disabled'
  ]

  classMethod: testDivergenceNonFatal: t [
    "DV8: a malformed doctrine/feedback tuple cannot abort the divergence sweep —
     a valid divergent doctrine elsewhere is still flagged."
    | bbs disp threw |
    '--- DV8: malformed tuple does not abort the divergence sweep ---' println.
    bbs := BBS withDataDir: DflagHelper makeTempDir.
    bbs out: 'doctrine' scope: 'global' identity: 'dctr-garb' payload: 'not-a-dict'.
    bbs out: 'doctrine-feedback' scope: 'global' identity: 'dfb-garb' payload: 'not-a-dict'.
    DflagHelper seedDoctrine: bbs id: 'dctr-okv' scope: 'global' key: 'k-okv' maturity: 'active'.
    DflagHelper seedVotes: bbs doctrine: 'dctr-okv' scope: 'global' up: 5 down: 0.
    DflagHelper seedOutcome: bbs doctrine: 'dctr-okv' scope: 'global' n: 6 ewma: 300 nSuccess: 2.
    disp := DflagHelper divergenceDispatcherOn: bbs enabled: true pos: 3 neg: -3 minN: 5 low: 400 high: 750.

    threw := false.
    [disp maybeFlagDoctrineDivergence] on: Exception do: [:e | threw := true].
    t assert: threw not
      message: 'DV8: malformed tuple did not escape the sweep'.
    t assertEqual: (DflagHelper notificationsIn: bbs scope: 'global') size to: 1
      message: 'DV8: valid divergent doctrine still flagged despite malformed tuples'
  ]

  classMethod: testShowRendersOutcomeAndDivergence: t [
    "DV9: show renders the outcome-stats line and the one-line divergence note —
     agreement when unflagged, the flagged class when a marker exists."
    | bbs cli stats noteAgree marker noteFlagged |
    '--- DV9: show renders outcome stats + divergence note ---' println.
    bbs := BBS withDataDir: DflagHelper makeTempDir.
    DflagHelper seedDoctrine: bbs id: 'dctr-sh' scope: 'global' key: 'k-sh' maturity: 'active'.
    DflagHelper seedOutcome: bbs doctrine: 'dctr-sh' scope: 'global' n: 6 ewma: 300 nSuccess: 3.
    cli := FlagTestCLI onBbs: bbs.

    "Outcome stats line surfaces n + ewma/1000 + success/1000."
    stats := cli outcomeStatsFor: 'dctr-sh' scope: 'global'.
    t assertEqual: (stats at: 'n') to: 6
      message: 'DV9: outcomeStatsFor reads n from the signal'.
    t assertEqual: (cli formatOutcomeStatsLine: stats) to: 'n 6 / ewma 300/1000 / success 500/1000'
      message: 'DV9: outcome-stats line renders n / ewma/1000 / success/1000'.

    "Unflagged -> agreement note."
    noteAgree := cli formatDivergenceNote: nil.
    t assert: (noteAgree includes: 'agreement')
      message: 'DV9: unflagged doctrine renders an agreement note'.

    "Seed a SUSPECT divergence marker -> the note names the class as FLAGGED."
    bbs upsertSignal: 'global' identity: 'doctrine-divergence-flagged:dctr-sh'
      payload: (DflagHelper divMarkerPayloadClass: 'suspect').
    marker := cli divergenceMarkerFor: 'dctr-sh' scope: 'global'.
    t assert: marker notNil message: 'DV9: divergence marker is read back'.
    noteFlagged := cli formatDivergenceNote: marker.
    t assert: (noteFlagged includes: 'SUSPECT')
      message: 'DV9: flagged doctrine renders the SUSPECT class note'.
    t assert: (noteFlagged includes: 'FLAGGED')
      message: 'DV9: divergence note marks it FLAGGED for review'
  ]

"=== Main ==="
DoctrineFlagMain subclass: Object
  classMethod: start [
    | t |
    t := DflagRunner new.
    [TestDoctrineFlag run: t] on: Exception do: [:e |
      ('TestDoctrineFlag CRASHED: ', e messageText) println.
      t assert: false message: 'TestDoctrineFlag crashed'
    ].
    t report.
    ^t failed
  ]
