"Tests for the dashboard Missions panel + the mission plan-gate routes:
   DashboardSSE>>renderMissionsHtml:  (panel render)
   POST /api/mission/approve | /api/mission/reject
        (handleMissionDecisionScope:identity:to:reason: + isLoopbackHost: gate)

 A mission is the high-level Auftragstaktik intent artifact. The dashboard
 surfaces missions awaiting approval with their plan rendered and approve/reject
 controls; approving/rejecting flips status, mirroring the `pp mission` CLI (W1).

 Invariants under test:
   MP1  renderMissionsHtml: emits one card per mission, foregrounds
        awaiting-approval, renders the plan markdown into HTML, and attaches
        approve/reject controls ONLY to awaiting-approval missions.
   MP2  a MALFORMED mission tuple is SKIPPED — the panel still renders the
        well-formed siblings (per-card exception guard).
   MP3  renderMarkdownPlan: promotes headings + bullet lists and HTML-escapes
        every line (no raw HTML injection from plan content).
   MP4  /api/mission/approve flips awaiting-approval -> approved (200).
   MP5  /api/mission/reject flips awaiting-approval -> rejected + records reason.
   MP6  approve/reject on a NON-awaiting mission is REFUSED (409, unchanged) —
        mirroring the CLI's status guard.
   MP7  decision on a missing mission -> 404.
   MP8  the routes are loopback-gated (isLoopbackHost: reused from cancel)."

MsnPanelRunner subclass: Object
  instanceVars: passed failed failures

  classMethod: new [ ^super new init ]

  method: init [
    passed := 0.
    failed := 0.
    failures := Array new: 0
  ]

  method: assert: cond message: msg [
    cond ifTrue: [passed := passed + 1]
         ifFalse: [
           failed := failed + 1.
           failures := failures copyWith: msg.
           ('FAIL: ', msg) println
         ]
  ]

  method: assertEqual: actual to: expected message: msg [
    (actual = expected) ifTrue: [passed := passed + 1]
                         ifFalse: [
                           failed := failed + 1.
                           failures := failures copyWith: msg.
                           ('FAIL: ', msg,
                            ' (got: ', actual printString,
                            ' expected: ', expected printString, ')') println
                         ]
  ]

  method: report [
    '=== Mission Panel Test Results ===' println.
    ('Passed: ', passed printString) println.
    ('Failed: ', failed printString) println.
    failed > 0 ifTrue: [
      'Failures:' println.
      failures do: [:f | ('  - ', f) println]
    ].
    failed = 0
      ifTrue: ['ALL TESTS PASSED' println]
      ifFalse: ['SOME TESTS FAILED' println]
  ]

  method: failed [ ^failed ]

"--- Helpers ---"
MsnPanelHelper subclass: Object

  classMethod: makeTempDir [
    | proc args |
    proc := ExternalProcess command: '/bin/sh'.
    args := Array new: 0.
    args := args copyWith: '-c'.
    args := args copyWith: 'mktemp -d'.
    proc args: args.
    proc run.
    ^proc stdout trimBoth
  ]

  classMethod: newServer: bbs [
    | dispatcher server |
    dispatcher := Dispatcher on: bbs harnessFactory: nil.
    server := ApiServer on: 0 bbs: bbs dispatcher: dispatcher.
    ^server
  ]

  classMethod: seedMission: bbs id: id status: status brief: brief plan: plan [
    | p |
    p := Dictionary new.
    p at: 'brief' put: brief.
    p at: 'intent' put: nil.
    p at: 'plan' put: plan.
    p at: 'status' put: status.
    p at: 'workflow_instance' put: nil.
    p at: 'created_at' put: 1700000000.
    bbs out: 'mission' scope: 'default' identity: id payload: p
  ]

  classMethod: seedMissionWithEpic: bbs id: id epic: epicId [
    "An approved mission whose epic has been materialized (epic_id stamped) —
     i.e. runnable / Execute-eligible."
    | p |
    p := Dictionary new.
    p at: 'brief' put: 'ready mission'.
    p at: 'status' put: 'approved'.
    p at: 'epic_id' put: epicId.
    p at: 'created_at' put: 1700000000.
    bbs out: 'mission' scope: 'default' identity: id payload: p
  ]

  classMethod: seedMission: bbs id: id status: status epic: epicId [
    "Seed a mission with a given status AND a stamped epic_id — used to prove
     an ARCHIVED (non-approved) mission with a materialized epic still emits
     NO tree."
    | p |
    p := Dictionary new.
    p at: 'brief' put: 'mission with epic'.
    p at: 'status' put: status.
    p at: 'epic_id' put: epicId.
    p at: 'created_at' put: 1700000000.
    bbs out: 'mission' scope: 'default' identity: id payload: p
  ]

  classMethod: seedWorkitem: bbs id: id type: type parent: parent title: title status: status wave: wave [
    "Seed one workitem tuple (epic or story) mirroring the payload shape
     Dispatcher>>materializeStory: writes. Epics carry parent=nil; stories
     carry parent=<epicId>."
    | p |
    p := Dictionary new.
    p at: 'type' put: type.
    p at: 'parent' put: parent.
    p at: 'title' put: title.
    p at: 'status' put: status.
    p at: 'wave' put: wave.
    bbs out: 'workitem' scope: 'default' identity: id payload: p
  ]

  classMethod: contains: haystack sub: needle [
    ^(haystack indexOf: needle) > 0
  ]

  classMethod: lf [
    ^(Character lf) asString
  ]

  classMethod: count: needle in: haystack [
    "Count non-overlapping occurrences of needle in haystack (Maggie has no
     occurrencesOfSubstring:). indexOf: is 1-based and returns 0 when absent."
    | n rest pos |
    n := 0.
    rest := haystack.
    [pos := rest indexOf: needle. pos > 0] whileTrue: [
      n := n + 1.
      rest := rest copyFrom: pos + needle size to: rest size
    ].
    ^n
  ]

"=== MP1: panel render — one card per mission, controls only on awaiting ==="
TestMissionPanelRender subclass: Object
  classMethod: run: t [
    | tempDir bbs sse snap html lf plan |
    '--- MP1: renderMissionsHtml: foregrounds awaiting + controls ---' println.
    tempDir := MsnPanelHelper makeTempDir.
    bbs := BBS withDataDir: tempDir.
    lf := MsnPanelHelper lf.
    plan := '# Plan', lf, '## Work', lf, '- do the thing'.
    MsnPanelHelper seedMission: bbs id: 'msn-await' status: 'awaiting-approval'
      brief: 'Ship the mission panel' plan: plan.
    MsnPanelHelper seedMission: bbs id: 'msn-approved' status: 'approved'
      brief: 'Already decided' plan: '# Old plan'.

    sse := DashboardSSE on: bbs.
    snap := sse computeSnapshot.
    html := snap at: 'missionsHtml'.

    t assert: (MsnPanelHelper contains: html sub: 'id="dashboard-missions"')
      message: 'MP1: panel uses the expected root id'.
    t assert: (MsnPanelHelper contains: html sub: 'msn-await')
      message: 'MP1: awaiting mission rendered'.
    t assert: (MsnPanelHelper contains: html sub: 'msn-approved')
      message: 'MP1: decided mission rendered too'.
    t assert: (MsnPanelHelper contains: html sub: 'Awaiting approval')
      message: 'MP1: awaiting-approval group is foregrounded'.
    "Plan markdown rendered into HTML (heading + list)."
    t assert: (MsnPanelHelper contains: html sub: '<h3>Plan</h3>')
      message: 'MP1: plan heading rendered'.
    t assert: (MsnPanelHelper contains: html sub: '<li>do the thing</li>')
      message: 'MP1: plan bullet rendered'.
    "Controls appear for the awaiting mission only — exactly one approve button."
    t assertEqual: (MsnPanelHelper count: 'class="mission-approve"' in: html) to: 1
      message: 'MP1: exactly one approve control (awaiting only)'.
    t assertEqual: (MsnPanelHelper count: 'class="mission-reject"' in: html) to: 1
      message: 'MP1: exactly one reject control (awaiting only)'.
    t assert: (MsnPanelHelper contains: html sub: 'data-mission-id="msn-await"')
      message: 'MP1: approve/reject carry the mission id for the POST'
  ]

"=== MP2: a malformed mission tuple is skipped; panel still renders ==="
TestMissionPanelMalformed subclass: Object
  classMethod: run: t [
    | tempDir bbs sse snap html badPayload |
    '--- MP2: malformed mission tuple is skipped ---' println.
    tempDir := MsnPanelHelper makeTempDir.
    bbs := BBS withDataDir: tempDir.
    "A well-formed awaiting mission..."
    MsnPanelHelper seedMission: bbs id: 'msn-good' status: 'awaiting-approval'
      brief: 'Good one' plan: '# Plan'.
    "...and a malformed one whose status is a non-string (breaks comparisons)."
    badPayload := Dictionary new.
    badPayload at: 'status' put: 12345.
    badPayload at: 'brief' put: 999.
    bbs out: 'mission' scope: 'default' identity: 'msn-bad' payload: badPayload.

    sse := DashboardSSE on: bbs.
    snap := sse computeSnapshot.
    html := snap at: 'missionsHtml'.

    t assert: (html notNil and: [html isEmpty not])
      message: 'MP2: panel still renders despite a malformed tuple'.
    t assert: (MsnPanelHelper contains: html sub: 'id="dashboard-missions"')
      message: 'MP2: panel root present (not blanked)'.
    t assert: (MsnPanelHelper contains: html sub: 'msn-good')
      message: 'MP2: well-formed sibling still rendered'
  ]

"=== MP3: renderMarkdownPlan: escapes HTML + promotes structure ==="
TestMissionPlanMarkdown subclass: Object
  classMethod: run: t [
    | tempDir bbs sse html lf md |
    '--- MP3: plan markdown escaped + structured ---' println.
    tempDir := MsnPanelHelper makeTempDir.
    bbs := BBS withDataDir: tempDir.
    sse := DashboardSSE on: bbs.

    lf := MsnPanelHelper lf.
    md := '## Heading', lf, '- item one', lf, 'A <script>alert(1)</script> line'.
    html := sse renderMarkdownPlan: md.
    t assert: (MsnPanelHelper contains: html sub: '<h4>Heading</h4>')
      message: 'MP3: ## promoted to <h4>'.
    t assert: (MsnPanelHelper contains: html sub: '<li>item one</li>')
      message: 'MP3: bullet promoted to <li>'.
    t assert: (MsnPanelHelper contains: html sub: '&lt;script&gt;')
      message: 'MP3: raw HTML in the plan is escaped (no injection)'.
    t assert: (MsnPanelHelper contains: html sub: '<script>') not
      message: 'MP3: no unescaped <script> survives'.
    t assertEqual: (sse renderMarkdownPlan: nil) to: ''
      message: 'MP3: non-string plan -> empty string'
  ]

"=== MP4: approve flips awaiting-approval -> approved ==="
TestMissionApprove subclass: Object
  classMethod: run: t [
    | tempDir bbs server resp item |
    '--- MP4: approve -> approved ---' println.
    tempDir := MsnPanelHelper makeTempDir.
    bbs := BBS withDataDir: tempDir.
    server := MsnPanelHelper newServer: bbs.
    MsnPanelHelper seedMission: bbs id: 'msn-ap' status: 'awaiting-approval' brief: 'b' plan: '# p'.

    resp := server handleMissionDecisionScope: 'default' identity: 'msn-ap'
      to: 'approved' reason: nil.
    t assertEqual: resp status to: 200 message: 'MP4: approve -> 200'.
    item := bbs rdp: 'mission' scope: 'default' identity: 'msn-ap'.
    t assertEqual: ((item at: 'payload') at: 'status' ifAbsent: [nil]) to: 'approved'
      message: 'MP4: status flipped to approved'
  ]

"=== MP5: reject flips awaiting-approval -> rejected + reason ==="
TestMissionReject subclass: Object
  classMethod: run: t [
    | tempDir bbs server resp item |
    '--- MP5: reject -> rejected + reason ---' println.
    tempDir := MsnPanelHelper makeTempDir.
    bbs := BBS withDataDir: tempDir.
    server := MsnPanelHelper newServer: bbs.
    MsnPanelHelper seedMission: bbs id: 'msn-rj' status: 'awaiting-approval' brief: 'b' plan: '# p'.

    resp := server handleMissionDecisionScope: 'default' identity: 'msn-rj'
      to: 'rejected' reason: 'scope too broad'.
    t assertEqual: resp status to: 200 message: 'MP5: reject -> 200'.
    item := bbs rdp: 'mission' scope: 'default' identity: 'msn-rj'.
    t assertEqual: ((item at: 'payload') at: 'status' ifAbsent: [nil]) to: 'rejected'
      message: 'MP5: status flipped to rejected'.
    t assertEqual: ((item at: 'payload') at: 'reason' ifAbsent: [nil]) to: 'scope too broad'
      message: 'MP5: reason recorded on the mission'
  ]

"=== MP6: decision refused on a non-awaiting mission (409, unchanged) ==="
TestMissionRefusedWhenNotAwaiting subclass: Object
  classMethod: run: t [
    | tempDir bbs server resp item |
    '--- MP6: decision refused when not awaiting-approval ---' println.
    tempDir := MsnPanelHelper makeTempDir.
    bbs := BBS withDataDir: tempDir.
    server := MsnPanelHelper newServer: bbs.
    MsnPanelHelper seedMission: bbs id: 'msn-res' status: 'researching' brief: 'b' plan: nil.

    resp := server handleMissionDecisionScope: 'default' identity: 'msn-res'
      to: 'approved' reason: nil.
    t assertEqual: resp status to: 409 message: 'MP6: approve on researching -> 409'.
    item := bbs rdp: 'mission' scope: 'default' identity: 'msn-res'.
    t assertEqual: ((item at: 'payload') at: 'status' ifAbsent: [nil]) to: 'researching'
      message: 'MP6: status unchanged after refused approve'.

    resp := server handleMissionDecisionScope: 'default' identity: 'msn-res'
      to: 'rejected' reason: 'no'.
    t assertEqual: resp status to: 409 message: 'MP6: reject on researching -> 409'.
    item := bbs rdp: 'mission' scope: 'default' identity: 'msn-res'.
    t assert: ((item at: 'payload') at: 'reason' ifAbsent: ['sentinel']) = 'sentinel'
      message: 'MP6: refused reject did NOT record a reason'
  ]

"=== MP7: decision on a missing mission -> 404 ==="
TestMissionMissing subclass: Object
  classMethod: run: t [
    | tempDir bbs server resp |
    '--- MP7: missing mission -> 404 ---' println.
    tempDir := MsnPanelHelper makeTempDir.
    bbs := BBS withDataDir: tempDir.
    server := MsnPanelHelper newServer: bbs.

    resp := server handleMissionDecisionScope: 'default' identity: 'msn-ghost'
      to: 'approved' reason: nil.
    t assertEqual: resp status to: 404 message: 'MP7: missing mission -> 404'
  ]

"=== MP8: loopback gate reused from cancel (equivalence + allowlist) ==="
TestMissionLoopbackGate subclass: Object
  classMethod: run: t [
    | tempDir bbs server |
    '--- MP8: loopback gate ---' println.
    tempDir := MsnPanelHelper makeTempDir.
    bbs := BBS withDataDir: tempDir.
    server := MsnPanelHelper newServer: bbs.

    "Existing loopback spellings must stay green."
    t assert: (server isLoopbackHost: 'localhost') message: 'MP8: localhost accepted'.
    t assert: (server isLoopbackHost: 'localhost:7777') message: 'MP8: localhost:port accepted'.
    t assert: (server isLoopbackHost: '127.0.0.1') message: 'MP8: 127.0.0.1 accepted'.
    t assert: (server isLoopbackHost: '127.0.0.1:7777') message: 'MP8: 127.0.0.1:port accepted'.
    t assert: (server isLoopbackHost: '::1') message: 'MP8: ::1 accepted'.
    t assert: (server isLoopbackHost: '[::1]:7777') message: 'MP8: [::1]:port accepted'.

    "New genuine-local authorities now accepted."
    t assert: (server isLoopbackHost: '0.0.0.0') message: 'MP8: 0.0.0.0 accepted'.
    t assert: (server isLoopbackHost: '0.0.0.0:7777') message: 'MP8: 0.0.0.0:port accepted'.
    t assert: (server isLoopbackHost: 'localhost.') message: 'MP8: trailing-dot localhost accepted'.
    t assert: (server isLoopbackHost: 'localhost.:7777') message: 'MP8: trailing-dot localhost:port accepted'.
    t assert: (server isLoopbackHost: '[::ffff:127.0.0.1]') message: 'MP8: IPv4-mapped IPv6 loopback accepted'.
    t assert: (server isLoopbackHost: '[::ffff:127.0.0.1]:7777') message: 'MP8: IPv4-mapped IPv6 loopback:port accepted'.

    "Tightened 127. check: a spoofed hostname under 127. is REJECTED."
    t assert: (server isLoopbackHost: '127.evil.com') not message: 'MP8: 127.evil.com rejected (tightened)'.
    t assert: (server isLoopbackHost: '127.evil.com:7777') not message: 'MP8: 127.evil.com:port rejected'.

    "Non-loopback authority rejected while allowlist is unset (default behavior)."
    t assert: (server isLoopbackHost: '192.168.1.5:7777') not message: 'MP8: LAN IP rejected (allowlist unset)'.
    t assert: (server isLoopbackHost: 'mymac.local:7777') not message: 'MP8: hostname rejected (allowlist unset)'.

    "Opt-in allowlist: a configured host passes; others still 403."
    server allowDashboardHosts: 'mymac.local:7777, 192.168.1.50:7777'.
    t assert: (server isLoopbackHost: 'mymac.local:7777') message: 'MP8: allowlisted host accepted'.
    t assert: (server isLoopbackHost: 'MyMac.local:7777') message: 'MP8: allowlist match is case-insensitive'.
    t assert: (server isLoopbackHost: '192.168.1.50:7777') message: 'MP8: second allowlisted host accepted'.
    t assert: (server isLoopbackHost: '10.0.0.9:7777') not message: 'MP8: non-allowlisted non-loopback still rejected'
  ]

"=== MP9: deterministic identity order so unchanged HTML is byte-stable ==="
TestMissionPanelStableOrder subclass: Object
  classMethod: run: t [
    | tempDir bbs sse html1 html2 ia ib ic |
    '--- MP9: missions render in a stable identity order ---' println.
    tempDir := MsnPanelHelper makeTempDir.
    bbs := BBS withDataDir: tempDir.
    "Seed in NON-sorted id order; the panel must still render them sorted so
     scanAll bucket-ordering churn cannot change the HTML tick-to-tick."
    MsnPanelHelper seedMission: bbs id: 'msn-c' status: 'awaiting-approval' brief: 'c' plan: '# p'.
    MsnPanelHelper seedMission: bbs id: 'msn-a' status: 'awaiting-approval' brief: 'a' plan: '# p'.
    MsnPanelHelper seedMission: bbs id: 'msn-b' status: 'awaiting-approval' brief: 'b' plan: '# p'.

    sse := DashboardSSE on: bbs.
    html1 := (sse computeSnapshot) at: 'missionsHtml'.
    html2 := (sse computeSnapshot) at: 'missionsHtml'.

    t assertEqual: html1 to: html2
      message: 'MP9: two consecutive renders of unchanged state are byte-identical'.

    ia := html1 indexOf: 'data-mission-id="msn-a"'.
    ib := html1 indexOf: 'data-mission-id="msn-b"'.
    ic := html1 indexOf: 'data-mission-id="msn-c"'.
    t assert: (ia > 0 and: [ib > ia and: [ic > ib]])
      message: 'MP9: cards ordered by identity ascending (a < b < c)'
  ]

"=== MP10: archived missions partitioned out of 'Other missions' ==="
TestMissionPanelArchived subclass: Object
  classMethod: run: t [
    | tempDir bbs sse html othersIdx archIdx |
    '--- MP10: archived partitioned into an Archived section, not Other ---' println.
    tempDir := MsnPanelHelper makeTempDir.
    bbs := BBS withDataDir: tempDir.
    "A decided (approved) mission lands in Other; an archived one must NOT."
    MsnPanelHelper seedMission: bbs id: 'msn-other' status: 'approved'
      brief: 'A decided mission' plan: '# p'.
    MsnPanelHelper seedMission: bbs id: 'msn-arch' status: 'archived'
      brief: 'A retired mission' plan: '# p'.

    sse := DashboardSSE on: bbs.
    html := (sse computeSnapshot) at: 'missionsHtml'.

    t assert: (MsnPanelHelper contains: html sub: 'Other missions')
      message: 'MP10: Other missions group present (the approved mission)'.
    t assert: (MsnPanelHelper contains: html sub: 'mission-group--archived')
      message: 'MP10: Archived section rendered'.
    t assert: (MsnPanelHelper contains: html sub: 'msn-arch')
      message: 'MP10: archived mission is still rendered (tuple preserved)'.
    "The archived card must appear AFTER the Other-missions group, i.e. NOT
     inside it — assert the archived id renders past the Archived <details>."
    othersIdx := html indexOf: 'Other missions'.
    archIdx := html indexOf: 'mission-group--archived'.
    t assert: (archIdx > othersIdx)
      message: 'MP10: Archived section rendered after the Other-missions group'.
    "And the archived id lives past the Archived boundary, not in Other."
    t assert: ((html indexOf: 'msn-arch') > archIdx)
      message: 'MP10: archived mission card is inside the Archived section'
  ]

"=== MP11: an archived-only scope still renders (empty-state guard) ==="
TestMissionPanelArchivedOnly subclass: Object
  classMethod: run: t [
    | tempDir bbs sse html |
    '--- MP11: archived-only scope still renders (not No missions yet) ---' println.
    tempDir := MsnPanelHelper makeTempDir.
    bbs := BBS withDataDir: tempDir.
    MsnPanelHelper seedMission: bbs id: 'msn-onlyarch' status: 'archived'
      brief: 'The only mission' plan: '# p'.

    sse := DashboardSSE on: bbs.
    html := (sse computeSnapshot) at: 'missionsHtml'.

    t assert: (MsnPanelHelper contains: html sub: 'No missions yet') not
      message: 'MP11: archived-only scope is NOT the empty state'.
    t assert: (MsnPanelHelper contains: html sub: 'mission-group--archived')
      message: 'MP11: the Archived section renders for an archived-only scope'.
    t assert: (MsnPanelHelper contains: html sub: 'msn-onlyarch')
      message: 'MP11: the archived mission card renders'
  ]

"=== MP12: mission Execute (run) guards + Execute control render ==="
TestMissionRun subclass: Object
  classMethod: run: t [
    "Guards for handleMissionRunScope: + the Execute button render rule. The
     happy path (200 + full-pipeline dispatch) needs a template registry and is
     covered by the live e2e, not here."
    | tempDir bbs server resp html |
    '--- MP12: mission run guards + Execute control ---' println.
    tempDir := MsnPanelHelper makeTempDir.
    bbs := BBS withDataDir: tempDir.
    server := MsnPanelHelper newServer: bbs.

    "Missing mission -> 404."
    resp := server handleMissionRunScope: 'default' identity: 'msn-ghost'.
    t assertEqual: resp status to: 404 message: 'MP12: run missing mission -> 404'.

    "Non-approved (awaiting-approval) -> 409, unchanged."
    MsnPanelHelper seedMission: bbs id: 'msn-wait' status: 'awaiting-approval' brief: 'b' plan: '# p'.
    resp := server handleMissionRunScope: 'default' identity: 'msn-wait'.
    t assertEqual: resp status to: 409 message: 'MP12: run non-approved -> 409'.
    t assertEqual: (((bbs rdp: 'mission' scope: 'default' identity: 'msn-wait') at: 'payload') at: 'status' ifAbsent: [nil])
      to: 'awaiting-approval' message: 'MP12: non-approved mission unchanged'.

    "Approved but NO epic_id (not yet decomposed) -> 409, unchanged, nothing dispatched."
    MsnPanelHelper seedMission: bbs id: 'msn-noepic' status: 'approved' brief: 'b' plan: '# p'.
    resp := server handleMissionRunScope: 'default' identity: 'msn-noepic'.
    t assertEqual: resp status to: 409 message: 'MP12: run approved-without-epic -> 409'.
    t assertEqual: (((bbs rdp: 'mission' scope: 'default' identity: 'msn-noepic') at: 'payload') at: 'status' ifAbsent: [nil])
      to: 'approved' message: 'MP12: approved-without-epic mission unchanged'.
    t assertEqual: (bbs scanAll: 'workflow') size to: 0
      message: 'MP12: no workflow started on a guard failure'.

    "Render: an approved mission WITH an epic_id shows the Execute control; the
     approved one WITHOUT an epic does not."
    MsnPanelHelper seedMissionWithEpic: bbs id: 'msn-ready' epic: 'epic-msn-ready'.
    html := ((DashboardSSE on: bbs) computeSnapshot) at: 'missionsHtml'.
    t assert: (MsnPanelHelper contains: html sub: 'class="mission-execute" data-mission-id="msn-ready"')
      message: 'MP12: approved+epic mission renders an Execute button'.
    t assertEqual: (MsnPanelHelper count: 'class="mission-execute"' in: html) to: 1
      message: 'MP12: exactly one Execute button (only the epic-materialized mission)'
  ]

"=== MP13: mission tree — epic + child stories rendered under non-archived cards ==="
TestMissionTreeRender subclass: Object
  classMethod: run: t [
    "Under each NON-ARCHIVED mission card, an indented tree of the mission's
     epic and its child stories (title/status/wave) is rendered ENTIRELY from
     the cached tick snapshot. Stories order by wave (numeric) then identity.
     Archived missions with an epic_id emit NO tree."
    | tempDir bbs sse html iLo iMidA iMidB iHi |
    '--- MP13: mission epic/story tree render ---' println.
    tempDir := MsnPanelHelper makeTempDir.
    bbs := BBS withDataDir: tempDir.

    "A non-archived (approved) mission with a materialized epic."
    MsnPanelHelper seedMissionWithEpic: bbs id: 'msn-tree' epic: 'epic-tree'.
    MsnPanelHelper seedWorkitem: bbs id: 'epic-tree' type: 'epic' parent: nil
      title: 'Tree Epic Title' status: 'ready' wave: 1.
    "Child stories on DISTINCT waves, seeded out of order. Expected render
     order (wave numeric asc, then identity asc):
       st-lo (w1), st-mid-a (w2), st-mid-b (w2, id b), st-hi (w3)."
    MsnPanelHelper seedWorkitem: bbs id: 'st-hi' type: 'story' parent: 'epic-tree'
      title: 'High Wave' status: 'ready' wave: 3.
    MsnPanelHelper seedWorkitem: bbs id: 'st-lo' type: 'story' parent: 'epic-tree'
      title: 'Low Wave' status: 'blocked' wave: 1.
    MsnPanelHelper seedWorkitem: bbs id: 'st-mid-b' type: 'story' parent: 'epic-tree'
      title: 'Mid B' status: 'ready' wave: 2.
    MsnPanelHelper seedWorkitem: bbs id: 'st-mid-a' type: 'story' parent: 'epic-tree'
      title: 'Mid A' status: 'done' wave: 2.
    "An XSS-laden story title must be escaped."
    MsnPanelHelper seedWorkitem: bbs id: 'st-xss' type: 'story' parent: 'epic-tree'
      title: '<script>alert(1)</script>' status: 'ready' wave: 4.

    "An ARCHIVED mission with an epic_id + a child story must emit NO tree."
    MsnPanelHelper seedMission: bbs id: 'msn-arch-tree' status: 'archived' epic: 'epic-arch'.
    MsnPanelHelper seedWorkitem: bbs id: 'epic-arch' type: 'epic' parent: nil
      title: 'Archived Epic Title' status: 'ready' wave: 1.
    MsnPanelHelper seedWorkitem: bbs id: 'st-arch' type: 'story' parent: 'epic-arch'
      title: 'ArchivedOnlyStory' status: 'ready' wave: 1.

    sse := DashboardSSE on: bbs.
    html := (sse computeSnapshot) at: 'missionsHtml'.

    "(1) tree markup rendered under the non-archived card."
    t assert: (MsnPanelHelper contains: html sub: 'class="mission-tree"')
      message: 'MP13: mission-tree markup rendered'.
    t assert: (MsnPanelHelper contains: html sub: 'Tree Epic Title')
      message: 'MP13: epic title rendered in the tree'.
    "(2) each story row shows title + status + wave."
    t assert: (MsnPanelHelper contains: html sub: 'class="mission-story"')
      message: 'MP13: mission-story rows rendered'.
    t assert: (MsnPanelHelper contains: html sub: 'Low Wave')
      message: 'MP13: story title rendered'.
    t assert: (MsnPanelHelper contains: html sub: 'blocked')
      message: 'MP13: story status rendered'.
    t assert: (MsnPanelHelper contains: html sub: 'wave 1')
      message: 'MP13: story wave 1 rendered'.
    t assert: (MsnPanelHelper contains: html sub: 'wave 3')
      message: 'MP13: story wave 3 rendered'.
    "(3) wave-then-identity ordering via substring-index checks."
    iLo := html indexOf: 'Low Wave'.
    iMidA := html indexOf: 'Mid A'.
    iMidB := html indexOf: 'Mid B'.
    iHi := html indexOf: 'High Wave'.
    t assert: (iLo > 0 and: [iMidA > iLo and: [iMidB > iMidA and: [iHi > iMidB]]])
      message: 'MP13: stories ordered by wave numeric asc, identity tiebreak (lo<midA<midB<hi)'.
    "(4) XSS title escaped; no raw <script> survives."
    t assert: (MsnPanelHelper contains: html sub: '&lt;script&gt;')
      message: 'MP13: XSS story title HTML-escaped'.
    t assert: (MsnPanelHelper contains: html sub: '<script>') not
      message: 'MP13: no raw <script> survives in the panel'.
    "(5) archived mission with an epic_id emits NO tree (its story is absent)."
    t assert: (MsnPanelHelper contains: html sub: 'ArchivedOnlyStory') not
      message: 'MP13: archived mission emits no tree (child story not rendered)'.
    t assert: (MsnPanelHelper contains: html sub: 'Archived Epic Title') not
      message: 'MP13: archived mission emits no tree (epic title not rendered)'
  ]

"=== Main ==="
MissionPanelMain subclass: Object
  classMethod: run [
    | t |
    t := MsnPanelRunner new.
    [TestMissionPanelRender run: t] on: Exception do: [:e |
      ('TestMissionPanelRender CRASHED: ', e messageText) println.
      t assert: false message: 'TestMissionPanelRender crashed'].
    [TestMissionPanelMalformed run: t] on: Exception do: [:e |
      ('TestMissionPanelMalformed CRASHED: ', e messageText) println.
      t assert: false message: 'TestMissionPanelMalformed crashed'].
    [TestMissionPlanMarkdown run: t] on: Exception do: [:e |
      ('TestMissionPlanMarkdown CRASHED: ', e messageText) println.
      t assert: false message: 'TestMissionPlanMarkdown crashed'].
    [TestMissionApprove run: t] on: Exception do: [:e |
      ('TestMissionApprove CRASHED: ', e messageText) println.
      t assert: false message: 'TestMissionApprove crashed'].
    [TestMissionReject run: t] on: Exception do: [:e |
      ('TestMissionReject CRASHED: ', e messageText) println.
      t assert: false message: 'TestMissionReject crashed'].
    [TestMissionRefusedWhenNotAwaiting run: t] on: Exception do: [:e |
      ('TestMissionRefusedWhenNotAwaiting CRASHED: ', e messageText) println.
      t assert: false message: 'TestMissionRefusedWhenNotAwaiting crashed'].
    [TestMissionMissing run: t] on: Exception do: [:e |
      ('TestMissionMissing CRASHED: ', e messageText) println.
      t assert: false message: 'TestMissionMissing crashed'].
    [TestMissionLoopbackGate run: t] on: Exception do: [:e |
      ('TestMissionLoopbackGate CRASHED: ', e messageText) println.
      t assert: false message: 'TestMissionLoopbackGate crashed'].
    [TestMissionPanelStableOrder run: t] on: Exception do: [:e |
      ('TestMissionPanelStableOrder CRASHED: ', e messageText) println.
      t assert: false message: 'TestMissionPanelStableOrder crashed'].
    [TestMissionPanelArchived run: t] on: Exception do: [:e |
      ('TestMissionPanelArchived CRASHED: ', e messageText) println.
      t assert: false message: 'TestMissionPanelArchived crashed'].
    [TestMissionPanelArchivedOnly run: t] on: Exception do: [:e |
      ('TestMissionPanelArchivedOnly CRASHED: ', e messageText) println.
      t assert: false message: 'TestMissionPanelArchivedOnly crashed'].
    [TestMissionRun run: t] on: Exception do: [:e |
      ('TestMissionRun CRASHED: ', e messageText) println.
      t assert: false message: 'TestMissionRun crashed'].
    [TestMissionTreeRender run: t] on: Exception do: [:e |
      ('TestMissionTreeRender CRASHED: ', e messageText) println.
      t assert: false message: 'TestMissionTreeRender crashed'].
    t report.
    ^t failed
  ]
