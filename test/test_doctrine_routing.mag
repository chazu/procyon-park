"Tests for doctrine routing into agent context (the consumption side of the
 Orient layer). See Role>>activeDoctrineFor:scope:role: and assembleContext:.

 Doctrine used to reach ONLY the planner, but ~80% of synthesized lessons are
 execution-time guidance (IO-boundary guards, fail-safe cleanup, review triage).
 These tests lock the new behavior: ACTIVE, applicable, role-targeted doctrine is
 routed to the execution roles AND the planner, ranked for relevance and capped.

 Invariants under test:
   DRT1  An execution role (implementer) receives applicable ACTIVE doctrine via
         activeDoctrineFor:scope:role: (the IO-boundary entry).
   DRT2  The per-role cap (maxDoctrineEntries = 6) is respected — seeding 8
         applicable active entries yields at most 6.
   DRT3  proposed / retired / rejected doctrine is NEVER surfaced (active gate).
   DRT4  Scope-union {global, this-repo}: global and this-repo entries surface;
         a different repo's entry does not.
   DRT5  The planner STILL receives doctrine (no regression).
   DRT6  Role-tagged entries are surfaced only to their target role; untagged
         entries are universal.
   DRT7  assembleContext: for an execution role (implementer) injects the active
         doctrine entry; consumesDoctrine: gates planner+execution roles only.

 Standalone runner at bottom (DoctrineRoutingMain run)."

DoctrineRoutingRunner subclass: Object
  instanceVars: passed failed failures

  classMethod: new [ ^super new init ]

  method: init [
    passed := 0.
    failed := 0.
    failures := Array new: 0
  ]

  method: assert: cond message: msg [
    cond ifTrue: [
      passed := passed + 1
    ] ifFalse: [
      failed := failed + 1.
      failures := failures copyWith: msg.
      ('FAIL: ', msg) println
    ]
  ]

  method: assertEqual: actual to: expected message: msg [
    (actual = expected) ifTrue: [
      passed := passed + 1
    ] ifFalse: [
      failed := failed + 1.
      failures := failures copyWith: msg.
      ('FAIL: ', msg, ' (got: ', actual printString, ' expected: ', expected printString, ')') println
    ]
  ]

  method: report [
    '=== Doctrine Routing Test Results ===' println.
    ('Passed: ', passed printString) println.
    ('Failed: ', failed printString) println.
    failed > 0 ifTrue: [
      'Failures:' println.
      failures do: [:f | ('  - ', f) println]
    ].
    failed = 0
      ifTrue: ['ALL TESTS PASSED' println]
      ifFalse: ['SOME TESTS FAILED' println]
  ]

  method: failed [ ^failed ]

"--- Helpers ---"
DoctrineRoutingHelper subclass: Object

  classMethod: makeTempDir [
    | proc args |
    proc := ExternalProcess command: '/bin/sh'.
    args := Array new: 0.
    args := args copyWith: '-c'.
    args := args copyWith: 'mktemp -d'.
    proc args: args.
    proc run.
    ^proc stdout trimBoth
  ]

  classMethod: payload: maturity scope: dscope tags: tags principle: principle [
    | p |
    p := Dictionary new.
    p at: 'principle' put: principle.
    p at: 'rationale' put: 'test rationale'.
    p at: 'maturity' put: maturity.
    p at: 'doctrine_scope' put: dscope.
    p at: 'tags' put: tags.
    ^p
  ]

  classMethod: seed: bbs identity: ident maturity: maturity scope: dscope tags: tags principle: principle [
    bbs out: 'doctrine' scope: 'global' identity: ident
      payload: (self payload: maturity scope: dscope tags: tags principle: principle)
  ]

  classMethod: hasIdentity: ident in: tuples [
    tuples do: [:t | ((t at: 'identity' ifAbsent: ['']) = ident) ifTrue: [^true]].
    ^false
  ]

  classMethod: indexOfIdentity: ident in: tuples [
    "1-based position of <ident> in the ordered result, or 0 when absent."
    | i |
    i := 1.
    tuples do: [:t |
      ((t at: 'identity' ifAbsent: ['']) = ident) ifTrue: [^i].
      i := i + 1
    ].
    ^0
  ]

  classMethod: identitySeqOf: tuples [
    "The ordered identity sequence of a result, as a comma-joined string, so two
     runs can be compared for byte-identical ordering (determinism check)."
    | s first |
    s := ''. first := true.
    tuples do: [:t |
      first ifFalse: [s := s, ','].
      s := s, (t at: 'identity' ifAbsent: ['']).
      first := false
    ].
    ^s
  ]

  classMethod: payload: maturity scope: dscope tags: tags principle: principle
      rationale: rationale confidence: confidence [
    "Like payload:scope:tags:principle: but with an explicit rationale and
     confidence, for the relevance-ranking tests."
    | p |
    p := Dictionary new.
    p at: 'principle' put: principle.
    p at: 'rationale' put: rationale.
    p at: 'maturity' put: maturity.
    p at: 'doctrine_scope' put: dscope.
    p at: 'tags' put: tags.
    p at: 'confidence' put: confidence.
    ^p
  ]

  classMethod: seed: bbs identity: ident maturity: maturity scope: dscope tags: tags
      principle: principle rationale: rationale confidence: confidence [
    bbs out: 'doctrine' scope: 'global' identity: ident
      payload: (self payload: maturity scope: dscope tags: tags principle: principle
                  rationale: rationale confidence: confidence)
  ]

  classMethod: link: category scope: lscope identity: lident [
    "A single crystallized_into forward-edge link {category,scope,identity}."
    | l |
    l := Dictionary new.
    l at: 'category' put: category.
    l at: 'scope'    put: lscope.
    l at: 'identity' put: lident.
    ^l
  ]

  classMethod: seedLinked: bbs identity: ident maturity: maturity scope: dscope tags: tags
      principle: principle crystallizedInto: links [
    "Seed a doctrine carrying a crystallized_into forward-edge array (the lineage
     substrate the suppression filter reads)."
    | p |
    p := self payload: maturity scope: dscope tags: tags principle: principle.
    p at: 'crystallized_into' put: links.
    bbs out: 'doctrine' scope: 'global' identity: ident payload: p
  ]

"=== TestDoctrineRouting ==="
TestDoctrineRouting subclass: Object

  classMethod: run: t [
    self testExecutionRoleReceivesDoctrine: t.
    self testCapRespected: t.
    self testNonActiveExcluded: t.
    self testScopeUnion: t.
    self testPlannerNoRegression: t.
    self testRoleTagTargeting: t.
    self testAssembleContextAndGate: t
  ]

  classMethod: testExecutionRoleReceivesDoctrine: t [
    "DRT1: the implementer receives an applicable active doctrine entry."
    | bbs role out |
    '--- DRT1: execution role (implementer) receives active doctrine ---' println.
    bbs := BBS withDataDir: DoctrineRoutingHelper makeTempDir.
    DoctrineRoutingHelper seed: bbs identity: 'io-guard' maturity: 'active'
      scope: 'global' tags: #('concern:io' 'lang:maggie')
      principle: 'Guard Dictionary access at the Maggie IO boundary.'.

    role := Implementer new.
    out := role activeDoctrineFor: bbs scope: 'maggie-repo' role: 'implementer'.
    t assert: (DoctrineRoutingHelper hasIdentity: 'io-guard' in: out)
      message: 'DRT1: implementer sees the active IO-boundary doctrine entry'.
    t assert: out size >= 1
      message: 'DRT1: implementer receives at least one doctrine entry'
  ]

  classMethod: testCapRespected: t [
    "DRT2: at most maxDoctrineEntries (6) returned even with 8 applicable."
    | bbs role out i |
    '--- DRT2: per-role cap (6) is respected ---' println.
    bbs := BBS withDataDir: DoctrineRoutingHelper makeTempDir.
    i := 1.
    [i <= 8] whileTrue: [
      DoctrineRoutingHelper seed: bbs identity: ('u', i printString)
        maturity: 'active' scope: 'global' tags: (Array new: 0)
        principle: ('Universal principle ', i printString).
      i := i + 1
    ].
    t assertEqual: Role maxDoctrineEntries to: 6
      message: 'DRT2: maxDoctrineEntries is 6'.
    role := Reviewer new.
    out := role activeDoctrineFor: bbs scope: 'maggie-repo' role: 'reviewer'.
    t assertEqual: out size to: 6
      message: 'DRT2: 8 applicable active entries are capped to 6'
  ]

  classMethod: testNonActiveExcluded: t [
    "DRT3: proposed/retired/rejected are never surfaced."
    | bbs role out |
    '--- DRT3: non-active doctrine is excluded ---' println.
    bbs := BBS withDataDir: DoctrineRoutingHelper makeTempDir.
    DoctrineRoutingHelper seed: bbs identity: 'd-active' maturity: 'active'
      scope: 'global' tags: (Array new: 0) principle: 'active one'.
    DoctrineRoutingHelper seed: bbs identity: 'd-proposed' maturity: 'proposed'
      scope: 'global' tags: (Array new: 0) principle: 'proposed one'.
    DoctrineRoutingHelper seed: bbs identity: 'd-retired' maturity: 'retired'
      scope: 'global' tags: (Array new: 0) principle: 'retired one'.
    DoctrineRoutingHelper seed: bbs identity: 'd-rejected' maturity: 'rejected'
      scope: 'global' tags: (Array new: 0) principle: 'rejected one'.

    role := Implementer new.
    out := role activeDoctrineFor: bbs scope: 'maggie-repo' role: 'implementer'.
    t assert: (DoctrineRoutingHelper hasIdentity: 'd-active' in: out)
      message: 'DRT3: active entry is surfaced'.
    t assert: (DoctrineRoutingHelper hasIdentity: 'd-proposed' in: out) not
      message: 'DRT3: proposed entry is NOT surfaced'.
    t assert: (DoctrineRoutingHelper hasIdentity: 'd-retired' in: out) not
      message: 'DRT3: retired entry is NOT surfaced'.
    t assert: (DoctrineRoutingHelper hasIdentity: 'd-rejected' in: out) not
      message: 'DRT3: rejected entry is NOT surfaced'.
    t assertEqual: out size to: 1
      message: 'DRT3: only the single active entry survives the gate'
  ]

  classMethod: testScopeUnion: t [
    "DRT4: scope-union {global, this-repo}; other repos excluded."
    | bbs role out |
    '--- DRT4: scope-union (global + this-repo) ---' println.
    bbs := BBS withDataDir: DoctrineRoutingHelper makeTempDir.
    DoctrineRoutingHelper seed: bbs identity: 'g1' maturity: 'active'
      scope: 'global' tags: (Array new: 0) principle: 'global principle'.
    DoctrineRoutingHelper seed: bbs identity: 'r1' maturity: 'active'
      scope: 'maggie-repo' tags: (Array new: 0) principle: 'this-repo principle'.
    DoctrineRoutingHelper seed: bbs identity: 'rp1' maturity: 'active'
      scope: 'maggie-repo:src/io' tags: (Array new: 0) principle: 'this-repo path'.
    DoctrineRoutingHelper seed: bbs identity: 'o1' maturity: 'active'
      scope: 'other-repo' tags: (Array new: 0) principle: 'other repo principle'.

    role := Implementer new.
    out := role activeDoctrineFor: bbs scope: 'maggie-repo' role: 'implementer'.
    t assert: (DoctrineRoutingHelper hasIdentity: 'g1' in: out)
      message: 'DRT4: global entry surfaces'.
    t assert: (DoctrineRoutingHelper hasIdentity: 'r1' in: out)
      message: 'DRT4: this-repo entry surfaces'.
    t assert: (DoctrineRoutingHelper hasIdentity: 'rp1' in: out)
      message: 'DRT4: this-repo:path entry surfaces'.
    t assert: (DoctrineRoutingHelper hasIdentity: 'o1' in: out) not
      message: 'DRT4: a different repo''s entry does NOT surface'
  ]

  classMethod: testPlannerNoRegression: t [
    "DRT5: the planner still receives applicable active doctrine."
    | bbs role out |
    '--- DRT5: planner still receives doctrine (no regression) ---' println.
    bbs := BBS withDataDir: DoctrineRoutingHelper makeTempDir.
    DoctrineRoutingHelper seed: bbs identity: 'plan-doc' maturity: 'active'
      scope: 'global' tags: #('phase:plan') principle: 'Decompose epics into orthogonal stories.'.

    role := Planner new.
    out := role activeDoctrineFor: bbs scope: 'maggie-repo' role: 'planner'.
    t assert: (DoctrineRoutingHelper hasIdentity: 'plan-doc' in: out)
      message: 'DRT5: planner sees the active doctrine entry'
  ]

  classMethod: testRoleTagTargeting: t [
    "DRT6: a role:<name> tag restricts an entry to that role; untagged is universal."
    | bbs impl rev outImpl outRev |
    '--- DRT6: role-tag targeting ---' println.
    bbs := BBS withDataDir: DoctrineRoutingHelper makeTempDir.
    DoctrineRoutingHelper seed: bbs identity: 'rev-only' maturity: 'active'
      scope: 'global' tags: #('role:reviewer' 'concern:triage')
      principle: 'Reviewers triage by blocking severity.'.
    DoctrineRoutingHelper seed: bbs identity: 'impl-only' maturity: 'active'
      scope: 'global' tags: #('role:implementer' 'concern:io')
      principle: 'Verify a change is not already at HEAD before implementing.'.
    DoctrineRoutingHelper seed: bbs identity: 'univ' maturity: 'active'
      scope: 'global' tags: (Array new: 0) principle: 'Cleanup must be fail-safe.'.

    impl := Implementer new.
    outImpl := impl activeDoctrineFor: bbs scope: 'maggie-repo' role: 'implementer'.
    t assert: (DoctrineRoutingHelper hasIdentity: 'impl-only' in: outImpl)
      message: 'DRT6: implementer sees role:implementer entry'.
    t assert: (DoctrineRoutingHelper hasIdentity: 'univ' in: outImpl)
      message: 'DRT6: implementer sees the untagged universal entry'.
    t assert: (DoctrineRoutingHelper hasIdentity: 'rev-only' in: outImpl) not
      message: 'DRT6: implementer does NOT see role:reviewer entry'.

    rev := Reviewer new.
    outRev := rev activeDoctrineFor: bbs scope: 'maggie-repo' role: 'reviewer'.
    t assert: (DoctrineRoutingHelper hasIdentity: 'rev-only' in: outRev)
      message: 'DRT6: reviewer sees role:reviewer entry'.
    t assert: (DoctrineRoutingHelper hasIdentity: 'univ' in: outRev)
      message: 'DRT6: reviewer sees the untagged universal entry'.
    t assert: (DoctrineRoutingHelper hasIdentity: 'impl-only' in: outRev) not
      message: 'DRT6: reviewer does NOT see role:implementer entry'
  ]

  classMethod: testAssembleContextAndGate: t [
    "DRT7: assembleContext: injects doctrine for an execution role; consumesDoctrine:
     gates planner + execution roles only."
    | bbs impl ctx |
    '--- DRT7: assembleContext: injection + consumesDoctrine: gate ---' println.
    bbs := BBS withDataDir: DoctrineRoutingHelper makeTempDir.
    DoctrineRoutingHelper seed: bbs identity: 'io-guard2' maturity: 'active'
      scope: 'global' tags: #('concern:io')
      principle: 'Guard Dictionary access at the Maggie IO boundary.'.

    impl := Implementer new.
    ctx := impl assembleContext: bbs scope: 'maggie-repo' taskId: 'task-1' workflowInstance: ''.
    t assert: (DoctrineRoutingHelper hasIdentity: 'io-guard2' in: ctx)
      message: 'DRT7: assembleContext for implementer includes active doctrine'.

    "Gate: planner + execution roles consume doctrine; others (strategist) do not."
    t assert: (Implementer new consumesDoctrine: 'implementer')
      message: 'DRT7: implementer consumes doctrine'.
    t assert: (Planner new consumesDoctrine: 'planner')
      message: 'DRT7: planner consumes doctrine'.
    t assert: (Reviewer new consumesDoctrine: 'reviewer')
      message: 'DRT7: reviewer consumes doctrine'.
    t assert: (Scout new consumesDoctrine: 'scout')
      message: 'DRT7: scout consumes doctrine'.
    t assert: (Fixer new consumesDoctrine: 'fixer')
      message: 'DRT7: fixer consumes doctrine'.
    t assert: (Strategist new consumesDoctrine: 'strategist') not
      message: 'DRT7: strategist does NOT consume doctrine via the active path'
  ]

"=== TestDoctrineRanking ===
 Relevance-ranked selection: the (<= 6) capped slots go to the doctrine most
 relevant to THIS task's text, deterministically, with a universal floor.

 Invariants under test:
   DRK1  A query mentioning 'dashboard SSE filter' ranks the SSE/dashboard
         entry above unrelated ones.
   DRK2  A query about 'Maggie dictionary parse boundary' ranks the IO-boundary
         entry to the top.
   DRK3  The cap (6) is respected under the query path.
   DRK4  Active-only + scope-union + role gating still hold with a query present.
   DRK5  The universal floor guarantees a high-confidence untagged/global entry
         is present even when many tagged entries out-score it.
   DRK6  Determinism: the same (query, corpus) yields the SAME ordering on
         repeated calls (no randomness).
   DRK7  Helper units: the tokenizer lowercases / splits / strips stopwords, and
         IDF down-weights tokens common across the corpus."
TestDoctrineRanking subclass: Object

  classMethod: run: t [
    self testSseQueryRanksTop: t.
    self testIoBoundaryQueryRanksTop: t.
    self testCapRespectedWithQuery: t.
    self testGatesHoldWithQuery: t.
    self testUniversalFloor: t.
    self testDeterministic: t.
    self testHelperUnits: t
  ]

  classMethod: seedCorpus: bbs [
    "A small seeded ACTIVE corpus spanning unrelated topics."
    DoctrineRoutingHelper seed: bbs identity: 'sse-dash' maturity: 'active'
      scope: 'global' tags: #('concern:dashboard' 'topic:sse')
      principle: 'Dashboard SSE filter updates must reconcile on reconnect.'
      rationale: 'A dropped SSE stream leaves the dashboard filter stale until a full resync.'
      confidence: '0.7'.
    DoctrineRoutingHelper seed: bbs identity: 'io-boundary' maturity: 'active'
      scope: 'global' tags: #('concern:io' 'lang:maggie')
      principle: 'Guard Maggie Dictionary access at every parse boundary.'
      rationale: 'Unchecked dictionary reads at the IO boundary crash on malformed input.'
      confidence: '0.72'.
    DoctrineRoutingHelper seed: bbs identity: 'gc-safe' maturity: 'active'
      scope: 'global' tags: #('concern:gc')
      principle: 'Cleanup of shared worktrees must be fail-safe.'
      rationale: 'A fail-dangerous reaper removes live worktrees on an empty probe.'
      confidence: '0.8'.
    DoctrineRoutingHelper seed: bbs identity: 'index-cat' maturity: 'active'
      scope: 'global' tags: #('concern:performance')
      principle: 'Index hot-path reads by category before volume grows.'
      rationale: 'Flat-index scans are O(total tuples) and tax every per-tick read.'
      confidence: '0.78'
  ]

  classMethod: testSseQueryRanksTop: t [
    "DRK1: the dashboard/SSE entry ranks above unrelated tagged entries."
    | bbs role out idxSse idxGc idxPerf idxIo |
    '--- DRK1: dashboard SSE filter query ranks the SSE entry top ---' println.
    bbs := BBS withDataDir: DoctrineRoutingHelper makeTempDir.
    self seedCorpus: bbs.
    role := Implementer new.
    out := role activeDoctrineFor: bbs scope: 'pp-repo' role: 'implementer'
      query: 'the dashboard SSE filter is stale after a reconnect'.
    idxSse := DoctrineRoutingHelper indexOfIdentity: 'sse-dash' in: out.
    idxGc := DoctrineRoutingHelper indexOfIdentity: 'gc-safe' in: out.
    idxPerf := DoctrineRoutingHelper indexOfIdentity: 'index-cat' in: out.
    idxIo := DoctrineRoutingHelper indexOfIdentity: 'io-boundary' in: out.
    t assert: idxSse > 0 message: 'DRK1: SSE entry is present'.
    t assert: (idxSse < idxGc) message: 'DRK1: SSE ranks above the gc entry'.
    t assert: (idxSse < idxPerf) message: 'DRK1: SSE ranks above the perf entry'.
    t assert: (idxSse < idxIo) message: 'DRK1: SSE ranks above the io entry'
  ]

  classMethod: testIoBoundaryQueryRanksTop: t [
    "DRK2: a Maggie dictionary parse boundary query ranks the IO entry top."
    | bbs role out idxIo idxSse idxGc idxPerf |
    '--- DRK2: maggie dictionary parse boundary query ranks the IO entry top ---' println.
    bbs := BBS withDataDir: DoctrineRoutingHelper makeTempDir.
    self seedCorpus: bbs.
    role := Implementer new.
    out := role activeDoctrineFor: bbs scope: 'pp-repo' role: 'implementer'
      query: 'a Maggie dictionary read at the parse boundary crashed'.
    idxIo := DoctrineRoutingHelper indexOfIdentity: 'io-boundary' in: out.
    idxSse := DoctrineRoutingHelper indexOfIdentity: 'sse-dash' in: out.
    idxGc := DoctrineRoutingHelper indexOfIdentity: 'gc-safe' in: out.
    idxPerf := DoctrineRoutingHelper indexOfIdentity: 'index-cat' in: out.
    t assert: idxIo > 0 message: 'DRK2: IO entry is present'.
    t assert: (idxIo < idxSse) message: 'DRK2: IO ranks above the SSE entry'.
    t assert: (idxIo < idxGc) message: 'DRK2: IO ranks above the gc entry'.
    t assert: (idxIo < idxPerf) message: 'DRK2: IO ranks above the perf entry'
  ]

  classMethod: testCapRespectedWithQuery: t [
    "DRK3: even with 9 applicable active entries, the query path caps at 6."
    | bbs role out i |
    '--- DRK3: cap (6) respected under the query path ---' println.
    bbs := BBS withDataDir: DoctrineRoutingHelper makeTempDir.
    i := 1.
    [i <= 9] whileTrue: [
      DoctrineRoutingHelper seed: bbs identity: ('c', i printString) maturity: 'active'
        scope: 'global' tags: #('concern:dashboard' 'topic:sse')
        principle: ('Dashboard SSE rule ', i printString)
        rationale: 'SSE filter reconcile detail.' confidence: '0.6'.
      i := i + 1
    ].
    role := Reviewer new.
    out := role activeDoctrineFor: bbs scope: 'pp-repo' role: 'reviewer'
      query: 'dashboard SSE filter'.
    t assertEqual: out size to: 6
      message: 'DRK3: 9 applicable active entries capped to 6 under the query'
  ]

  classMethod: testGatesHoldWithQuery: t [
    "DRK4: active-only + scope-union + role gating survive the query path."
    | bbs role out |
    '--- DRK4: hard gates hold with a query present ---' println.
    bbs := BBS withDataDir: DoctrineRoutingHelper makeTempDir.
    "Active + applicable to this repo / global."
    DoctrineRoutingHelper seed: bbs identity: 'g-active' maturity: 'active'
      scope: 'global' tags: #('concern:io')
      principle: 'Guard the IO boundary.' rationale: 'parse safety' confidence: '0.7'.
    DoctrineRoutingHelper seed: bbs identity: 'r-active' maturity: 'active'
      scope: 'pp-repo' tags: #('concern:io')
      principle: 'Guard this repo IO boundary.' rationale: 'parse safety' confidence: '0.7'.
    "Gated OUT: proposed, other-repo, role-tagged for a different role."
    DoctrineRoutingHelper seed: bbs identity: 'g-proposed' maturity: 'proposed'
      scope: 'global' tags: #('concern:io')
      principle: 'Proposed IO rule.' rationale: 'parse safety' confidence: '0.7'.
    DoctrineRoutingHelper seed: bbs identity: 'other-active' maturity: 'active'
      scope: 'other-repo' tags: #('concern:io')
      principle: 'Other repo IO rule.' rationale: 'parse safety' confidence: '0.7'.
    DoctrineRoutingHelper seed: bbs identity: 'rev-tagged' maturity: 'active'
      scope: 'global' tags: #('role:reviewer' 'concern:io')
      principle: 'Reviewer-only IO rule.' rationale: 'parse safety' confidence: '0.7'.

    role := Implementer new.
    out := role activeDoctrineFor: bbs scope: 'pp-repo' role: 'implementer'
      query: 'IO boundary parse safety'.
    t assert: (DoctrineRoutingHelper hasIdentity: 'g-active' in: out)
      message: 'DRK4: global active entry surfaces under query'.
    t assert: (DoctrineRoutingHelper hasIdentity: 'r-active' in: out)
      message: 'DRK4: this-repo active entry surfaces under query'.
    t assert: (DoctrineRoutingHelper hasIdentity: 'g-proposed' in: out) not
      message: 'DRK4: proposed entry is still gated out under query'.
    t assert: (DoctrineRoutingHelper hasIdentity: 'other-active' in: out) not
      message: 'DRK4: other-repo entry is still gated out under query'.
    t assert: (DoctrineRoutingHelper hasIdentity: 'rev-tagged' in: out) not
      message: 'DRK4: role:reviewer entry is still gated out for the implementer'
  ]

  classMethod: testUniversalFloor: t [
    "DRK5: a high-confidence untagged/global entry lands via the universal floor
     even when several tagged entries out-score it on the query."
    | bbs role out i |
    '--- DRK5: universal floor guarantees cross-cutting doctrine lands ---' println.
    bbs := BBS withDataDir: DoctrineRoutingHelper makeTempDir.
    "Six tightly-relevant tagged entries (would otherwise fill all 6 slots)."
    i := 1.
    [i <= 6] whileTrue: [
      DoctrineRoutingHelper seed: bbs identity: ('tag', i printString) maturity: 'active'
        scope: 'global' tags: #('concern:dashboard' 'topic:sse')
        principle: ('Dashboard SSE filter rule ', i printString)
        rationale: 'SSE filter reconcile on reconnect.' confidence: '0.6'.
      i := i + 1
    ].
    "Two cross-cutting untagged universals (high confidence)."
    DoctrineRoutingHelper seed: bbs identity: 'commit-incr' maturity: 'active'
      scope: 'global' tags: (Array new: 0)
      principle: 'Commit incrementally.'
      rationale: 'Small commits keep work recoverable.' confidence: '0.9'.
    DoctrineRoutingHelper seed: bbs identity: 'fail-safe' maturity: 'active'
      scope: 'global' tags: (Array new: 0)
      principle: 'Cleanup must be fail-safe.'
      rationale: 'Keep the resource on any ambiguous signal.' confidence: '0.85'.

    role := Implementer new.
    out := role activeDoctrineFor: bbs scope: 'pp-repo' role: 'implementer'
      query: 'dashboard SSE filter reconcile on reconnect'.
    t assertEqual: out size to: 6 message: 'DRK5: cap still respected'.
    t assert: ((DoctrineRoutingHelper hasIdentity: 'commit-incr' in: out)
      or: [DoctrineRoutingHelper hasIdentity: 'fail-safe' in: out])
      message: 'DRK5: at least one high-confidence universal lands via the floor'
  ]

  classMethod: testDeterministic: t [
    "DRK6: the same (query, corpus) yields byte-identical ordering twice."
    | bbs role q out1 out2 |
    '--- DRK6: determinism (no randomness) ---' println.
    bbs := BBS withDataDir: DoctrineRoutingHelper makeTempDir.
    self seedCorpus: bbs.
    role := Implementer new.
    q := 'dashboard SSE filter and Maggie dictionary parse boundary'.
    out1 := role activeDoctrineFor: bbs scope: 'pp-repo' role: 'implementer' query: q.
    out2 := role activeDoctrineFor: bbs scope: 'pp-repo' role: 'implementer' query: q.
    t assertEqual: (DoctrineRoutingHelper identitySeqOf: out1)
      to: (DoctrineRoutingHelper identitySeqOf: out2)
      message: 'DRK6: identical ordering across repeated calls'
  ]

  classMethod: testHelperUnits: t [
    "DRK7: the pure helpers behave in isolation (tokenizer + IDF)."
    | role toks idf hi lo corpus |
    '--- DRK7: tokenizer + IDF helper units ---' println.
    role := Implementer new.
    toks := role doctrineTokenize: 'The Dashboard-SSE filter, RECONNECTED!'.
    t assert: (toks includes: 'dashboard') message: 'DRK7: tokenizer lowercases + splits on hyphen'.
    t assert: (toks includes: 'sse') message: 'DRK7: tokenizer keeps sse'.
    t assert: (toks includes: 'filter') message: 'DRK7: tokenizer splits on comma/space'.
    t assert: (toks includes: 'the') not message: 'DRK7: tokenizer strips the stopword the'.
    t assert: (toks includes: 'reconnected') message: 'DRK7: tokenizer strips trailing punctuation'.

    "IDF: a token in every doc weighs less than a token in one doc."
    corpus := Array new: 0.
    corpus := corpus copyWith: (self idfDoc: 'common rare1').
    corpus := corpus copyWith: (self idfDoc: 'common rare2').
    corpus := corpus copyWith: (self idfDoc: 'common rare3').
    idf := role doctrineIdf: corpus.
    hi := idf at: 'rare1' ifAbsent: [0].
    lo := idf at: 'common' ifAbsent: [0].
    t assert: (hi > lo) message: 'DRK7: IDF down-weights tokens common across the corpus'
  ]

  classMethod: idfDoc: principle [
    "A minimal doctrine tuple shaped just enough for doctrineIdf:."
    | p tup |
    p := Dictionary new.
    p at: 'principle' put: principle.
    p at: 'rationale' put: ''.
    tup := Dictionary new.
    tup at: 'payload' put: p.
    ^tup
  ]

"=== TestDoctrineCrystallizeSuppression ===
 Double-counting guard at the Orient consumption boundary: a doctrine that has
 crystallized INTO a CONVENTION is unconditional and already lands as a binding
 convention at execution time, so it is SUPPRESSED from advisory injection. A
 doctrine that merely spawned a WORKITEM, or that carries no crystallized_into
 at all, is UNAFFECTED — it never lost its judgment clause.

 Invariants under test:
   DCS1  A doctrine whose crystallized_into includes a convention link is
         EXCLUDED from the injected set.
   DCS2  A doctrine whose crystallized_into has ONLY a workitem link is still
         injected.
   DCS3  A doctrine with no crystallized_into is injected as before.
   DCS4  Suppression frees a slot: an entry that would have been crowded out
         (rank 7 of 7 under the cap of 6) now lands once a convention-linked
         entry is suppressed.
   DCS5  The existing hard gates (active-only, scope-union, role) AND
         determinism still hold alongside the suppression filter."
TestDoctrineCrystallizeSuppression subclass: Object

  classMethod: run: t [
    self testConventionLinkSuppressed: t.
    self testWorkitemLinkStillInjected: t.
    self testNoLinkInjected: t.
    self testSuppressionFreesSlot: t.
    self testGatesAndDeterminismHold: t
  ]

  classMethod: testConventionLinkSuppressed: t [
    "DCS1: a doctrine crystallized into a convention is excluded."
    | bbs role out |
    '--- DCS1: convention-linked doctrine is suppressed from advisory ---' println.
    bbs := BBS withDataDir: DoctrineRoutingHelper makeTempDir.
    DoctrineRoutingHelper seedLinked: bbs identity: 'crystal-conv' maturity: 'active'
      scope: 'global' tags: (Array new: 0)
      principle: 'This lesson crystallized into a binding convention.'
      crystallizedInto: (Array with: (DoctrineRoutingHelper link: 'convention'
                          scope: 'global' identity: 'conv-1')).
    DoctrineRoutingHelper seed: bbs identity: 'plain' maturity: 'active'
      scope: 'global' tags: (Array new: 0) principle: 'A plain advisory lesson.'.

    role := Implementer new.
    out := role activeDoctrineFor: bbs scope: 'maggie-repo' role: 'implementer'.
    t assert: (DoctrineRoutingHelper hasIdentity: 'crystal-conv' in: out) not
      message: 'DCS1: convention-crystallized doctrine is NOT injected'.
    t assert: (DoctrineRoutingHelper hasIdentity: 'plain' in: out)
      message: 'DCS1: the plain advisory doctrine is still injected'
  ]

  classMethod: testWorkitemLinkStillInjected: t [
    "DCS2: a doctrine linked ONLY to a workitem keeps its judgment clause."
    | bbs role out |
    '--- DCS2: workitem-linked doctrine stays in rotation ---' println.
    bbs := BBS withDataDir: DoctrineRoutingHelper makeTempDir.
    DoctrineRoutingHelper seedLinked: bbs identity: 'crystal-wi' maturity: 'active'
      scope: 'global' tags: (Array new: 0)
      principle: 'This lesson spawned a workitem but kept its conditionality.'
      crystallizedInto: (Array with: (DoctrineRoutingHelper link: 'workitem'
                          scope: 'maggie-repo' identity: 'wi-1')).

    role := Implementer new.
    out := role activeDoctrineFor: bbs scope: 'maggie-repo' role: 'implementer'.
    t assert: (DoctrineRoutingHelper hasIdentity: 'crystal-wi' in: out)
      message: 'DCS2: workitem-only-linked doctrine IS still injected'
  ]

  classMethod: testNoLinkInjected: t [
    "DCS3: a doctrine with no crystallized_into is injected as before."
    | bbs role out |
    '--- DCS3: uncrystallized doctrine is unaffected ---' println.
    bbs := BBS withDataDir: DoctrineRoutingHelper makeTempDir.
    DoctrineRoutingHelper seed: bbs identity: 'no-link' maturity: 'active'
      scope: 'global' tags: (Array new: 0) principle: 'No forward edge at all.'.

    role := Implementer new.
    out := role activeDoctrineFor: bbs scope: 'maggie-repo' role: 'implementer'.
    t assert: (DoctrineRoutingHelper hasIdentity: 'no-link' in: out)
      message: 'DCS3: uncrystallized doctrine IS injected'.

    "Belt-and-braces: an empty crystallized_into array is also unsuppressed."
    DoctrineRoutingHelper seedLinked: bbs identity: 'empty-link' maturity: 'active'
      scope: 'global' tags: (Array new: 0) principle: 'Empty forward-edge array.'
      crystallizedInto: (Array new: 0).
    out := role activeDoctrineFor: bbs scope: 'maggie-repo' role: 'implementer'.
    t assert: (DoctrineRoutingHelper hasIdentity: 'empty-link' in: out)
      message: 'DCS3: empty crystallized_into is treated as unsuppressed'
  ]

  classMethod: testSuppressionFreesSlot: t [
    "DCS4: suppressing a convention-linked entry frees a capped slot so an entry
     that would have been crowded out (the 7th of 7 under cap=6) now lands.

     Two parallel corpora (the BBS doctrine store is append-only, so re-seeding an
     identity does not replace it — we vary the corpus across two stores instead):
       Corpus A: 6 high-relevance entries + 1 low-relevance 'loser'. cap=6 → the
                 loser is rank 7 and crowded out.
       Corpus B: identical, except one of the 6 high entries is crystallized into
                 a CONVENTION → it is suppressed, leaving 5 high + loser = 6, so
                 the loser now occupies the freed slot."
    | bbsA bbsB role outA outB i |
    '--- DCS4: suppression frees a capped slot ---' println.
    bbsA := BBS withDataDir: DoctrineRoutingHelper makeTempDir.
    bbsB := BBS withDataDir: DoctrineRoutingHelper makeTempDir.
    role := Implementer new.

    "Corpus A: six plain high-relevance entries + one low-relevance loser."
    i := 1.
    [i <= 6] whileTrue: [
      DoctrineRoutingHelper seed: bbsA identity: ('hi', i printString) maturity: 'active'
        scope: 'global' tags: #('concern:dashboard' 'topic:sse')
        principle: ('Dashboard SSE filter rule ', i printString)
        rationale: 'SSE filter reconcile on reconnect.' confidence: '0.6'.
      i := i + 1
    ].
    DoctrineRoutingHelper seed: bbsA identity: 'loser' maturity: 'active'
      scope: 'global' tags: #('concern:unrelated')
      principle: 'An unrelated lesson about packaging.'
      rationale: 'Has nothing to do with the query.' confidence: '0.5'.

    outA := role activeDoctrineFor: bbsA scope: 'pp-repo' role: 'implementer'
      query: 'dashboard SSE filter reconcile on reconnect'.
    t assertEqual: outA size to: 6 message: 'DCS4: cap respected without suppression'.
    t assert: (DoctrineRoutingHelper hasIdentity: 'loser' in: outA) not
      message: 'DCS4: low-relevance entry is crowded out without suppression'.

    "Corpus B: same, but hi1 is crystallized into a convention (→ suppressed)."
    DoctrineRoutingHelper seedLinked: bbsB identity: 'hi1' maturity: 'active'
      scope: 'global' tags: #('concern:dashboard' 'topic:sse')
      principle: 'Dashboard SSE filter rule 1'
      crystallizedInto: (Array with: (DoctrineRoutingHelper link: 'convention'
                          scope: 'global' identity: 'conv-sse')).
    i := 2.
    [i <= 6] whileTrue: [
      DoctrineRoutingHelper seed: bbsB identity: ('hi', i printString) maturity: 'active'
        scope: 'global' tags: #('concern:dashboard' 'topic:sse')
        principle: ('Dashboard SSE filter rule ', i printString)
        rationale: 'SSE filter reconcile on reconnect.' confidence: '0.6'.
      i := i + 1
    ].
    DoctrineRoutingHelper seed: bbsB identity: 'loser' maturity: 'active'
      scope: 'global' tags: #('concern:unrelated')
      principle: 'An unrelated lesson about packaging.'
      rationale: 'Has nothing to do with the query.' confidence: '0.5'.

    outB := role activeDoctrineFor: bbsB scope: 'pp-repo' role: 'implementer'
      query: 'dashboard SSE filter reconcile on reconnect'.
    t assert: (DoctrineRoutingHelper hasIdentity: 'hi1' in: outB) not
      message: 'DCS4: the convention-crystallized entry is suppressed'.
    t assert: (DoctrineRoutingHelper hasIdentity: 'loser' in: outB)
      message: 'DCS4: the freed slot now lands the previously-excluded entry'.
    t assertEqual: outB size to: 6 message: 'DCS4: slot count still filled to cap'
  ]

  classMethod: testGatesAndDeterminismHold: t [
    "DCS5: active-only + scope-union + role gates AND determinism survive the
     suppression filter."
    | bbs role out seq1 seq2 |
    '--- DCS5: hard gates + determinism hold with suppression ---' println.
    bbs := BBS withDataDir: DoctrineRoutingHelper makeTempDir.
    "Active + applicable, mix of suppressed and not."
    DoctrineRoutingHelper seed: bbs identity: 'g-active' maturity: 'active'
      scope: 'global' tags: #('concern:io') principle: 'Guard the IO boundary.'.
    DoctrineRoutingHelper seedLinked: bbs identity: 'g-conv' maturity: 'active'
      scope: 'global' tags: #('concern:io') principle: 'Crystallized into a convention.'
      crystallizedInto: (Array with: (DoctrineRoutingHelper link: 'convention'
                          scope: 'global' identity: 'conv-io')).
    "Gated OUT by existing hard gates."
    DoctrineRoutingHelper seed: bbs identity: 'g-proposed' maturity: 'proposed'
      scope: 'global' tags: #('concern:io') principle: 'Proposed IO rule.'.
    DoctrineRoutingHelper seed: bbs identity: 'other-active' maturity: 'active'
      scope: 'other-repo' tags: #('concern:io') principle: 'Other repo IO rule.'.
    DoctrineRoutingHelper seed: bbs identity: 'rev-tagged' maturity: 'active'
      scope: 'global' tags: #('role:reviewer' 'concern:io')
      principle: 'Reviewer-only IO rule.'.

    role := Implementer new.
    out := role activeDoctrineFor: bbs scope: 'pp-repo' role: 'implementer'
      query: 'IO boundary'.
    t assert: (DoctrineRoutingHelper hasIdentity: 'g-active' in: out)
      message: 'DCS5: active applicable entry still surfaces'.
    t assert: (DoctrineRoutingHelper hasIdentity: 'g-conv' in: out) not
      message: 'DCS5: convention-crystallized entry suppressed'.
    t assert: (DoctrineRoutingHelper hasIdentity: 'g-proposed' in: out) not
      message: 'DCS5: proposed entry still gated out'.
    t assert: (DoctrineRoutingHelper hasIdentity: 'other-active' in: out) not
      message: 'DCS5: other-repo entry still gated out'.
    t assert: (DoctrineRoutingHelper hasIdentity: 'rev-tagged' in: out) not
      message: 'DCS5: role:reviewer entry still gated out for implementer'.

    "Determinism: same (query, corpus) → identical ordering twice."
    seq1 := DoctrineRoutingHelper identitySeqOf:
      (role activeDoctrineFor: bbs scope: 'pp-repo' role: 'implementer' query: 'IO boundary').
    seq2 := DoctrineRoutingHelper identitySeqOf:
      (role activeDoctrineFor: bbs scope: 'pp-repo' role: 'implementer' query: 'IO boundary').
    t assertEqual: seq1 to: seq2
      message: 'DCS5: ordering is deterministic with suppression active'
  ]

"=== TestDoctrineVotingPrompt ===
 The agent-facing rendering side of the Orient layer: injected doctrine entries
 must surface their dctr- id prominently (so an agent can name one in a vote),
 and consumesDoctrine: roles must receive an OPT-IN, SPARSE invitation to vote.
 Non-consumers must NOT receive the invitation.

 Invariants under test:
   DVP1  primeFor: for an execution role renders each injected doctrine entry's
         dctr- id in the prompt (prominently, not buried in a JSON dump).
   DVP2  A consumesDoctrine: role (implementer) receives the voting instruction
         with both the --up and --down pp doctrine feedback forms.
   DVP3  A non-consumer (strategist) does NOT receive the voting instruction,
         even when doctrine tuples are passed in (id rendering still happens).
   DVP4  The instruction frames voting as OPTIONAL and UNCOMMON — key phrasing is
         asserted so a future edit cannot silently turn it into a mandatory
         rate-all that manufactures sycophantic noise."
TestDoctrineVotingPrompt subclass: Object

  classMethod: run: t [
    self testIdsRendered: t.
    self testConsumerGetsInvitation: t.
    self testNonConsumerNoInvitation: t.
    self testInvitationIsOptionalAndSparse: t
  ]

  classMethod: doctrineTuple: ident principle: principle [
    "A doctrine context tuple shaped as assembleContext: would inject it."
    | p tup |
    p := Dictionary new.
    p at: 'principle' put: principle.
    p at: 'rationale' put: 'a short rationale for ', ident.
    p at: 'maturity' put: 'active'.
    tup := Dictionary new.
    tup at: 'category' put: 'doctrine'.
    tup at: 'identity' put: ident.
    tup at: 'payload' put: p.
    ^tup
  ]

  classMethod: promptFor: role tuples: tuples [
    ^role primeFor: 'implement the widget' context: tuples
  ]

  classMethod: testIdsRendered: t [
    "DVP1: each injected doctrine id appears in the rendered prompt."
    | tuples prompt |
    '--- DVP1: doctrine ids are rendered in the prompt ---' println.
    tuples := Array new: 0.
    tuples := tuples copyWith: (self doctrineTuple: 'dctr-aaa111'
      principle: 'Guard Dictionary access at the IO boundary.').
    tuples := tuples copyWith: (self doctrineTuple: 'dctr-bbb222'
      principle: 'Mint a fresh unique identity per append-only write.').
    prompt := self promptFor: Implementer new tuples: tuples.
    t assert: (prompt includes: 'dctr-aaa111')
      message: 'DVP1: first doctrine id is rendered'.
    t assert: (prompt includes: 'dctr-bbb222')
      message: 'DVP1: second doctrine id is rendered'.
    t assert: (prompt includes: 'cite this id to vote')
      message: 'DVP1: id is surfaced prominently as votable'
  ]

  classMethod: testConsumerGetsInvitation: t [
    "DVP2: a consumesDoctrine: role gets the up/down voting instruction."
    | tuples prompt |
    '--- DVP2: consumer role receives the voting invitation ---' println.
    tuples := Array with: (self doctrineTuple: 'dctr-ccc333'
      principle: 'Hoist a shared constant to one canonical accessor.').
    prompt := self promptFor: Implementer new tuples: tuples.
    t assert: (prompt includes: 'pp doctrine feedback')
      message: 'DVP2: voting command is present for the implementer'.
    t assert: (prompt includes: '--up')
      message: 'DVP2: upvote form is present'.
    t assert: (prompt includes: '--down --reason')
      message: 'DVP2: downvote form with reason is present'
  ]

  classMethod: testNonConsumerNoInvitation: t [
    "DVP3: a non-consumer (strategist) does NOT get the voting instruction,
     even though the doctrine id still renders."
    | tuples prompt |
    '--- DVP3: non-consumer does NOT receive the voting invitation ---' println.
    tuples := Array with: (self doctrineTuple: 'dctr-ddd444'
      principle: 'Validate planning artifacts before dispatch.').
    prompt := self promptFor: Strategist new tuples: tuples.
    t assert: (prompt includes: 'pp doctrine feedback') not
      message: 'DVP3: strategist does NOT see the voting command'.
    t assert: (prompt includes: 'dctr-ddd444')
      message: 'DVP3: id rendering still happens for the strategist'.
    "Sanity: the gate keys on consumesDoctrine: name."
    t assert: (Strategist new consumesDoctrine: 'strategist') not
      message: 'DVP3: strategist is not a doctrine consumer'.
    t assert: (Implementer new consumesDoctrine: 'implementer')
      message: 'DVP3: implementer is a doctrine consumer'
  ]

  classMethod: testInvitationIsOptionalAndSparse: t [
    "DVP4: the invitation must read as optional/uncommon — guard the key phrasing
     so a future edit cannot quietly make it a mandatory rate-all."
    | instr |
    '--- DVP4: invitation is framed as optional + sparse ---' println.
    instr := Role new doctrineVotingInstruction.
    t assert: (instr includes: 'optional')
      message: 'DVP4: instruction is labelled optional'.
    t assert: (instr includes: 'If — and only if — you feel STRONGLY')
      message: 'DVP4: vote only on strong feeling'.
    t assert: (instr includes: 'abstention is the norm')
      message: 'DVP4: abstention is stated to be the norm'.
    t assert: (instr includes: 'Most sessions you will NOT vote')
      message: 'DVP4: most sessions yield no vote (not a rate-all)'.
    t assert: (instr includes: 'never rubber-stamp')
      message: 'DVP4: never rubber-stamp'.
    t assert: (instr includes: 'A downvote needs a one-line reason')
      message: 'DVP4: a downvote requires a reason'
  ]

"=== Main ==="
DoctrineRoutingMain subclass: Object
  classMethod: run [
    | t |
    t := DoctrineRoutingRunner new.
    [TestDoctrineRouting run: t] on: Exception do: [:e |
      ('TestDoctrineRouting CRASHED: ', e messageText) println.
      t assert: false message: 'TestDoctrineRouting crashed'
    ].
    [TestDoctrineRanking run: t] on: Exception do: [:e |
      ('TestDoctrineRanking CRASHED: ', e messageText) println.
      t assert: false message: 'TestDoctrineRanking crashed'
    ].
    [TestDoctrineCrystallizeSuppression run: t] on: Exception do: [:e |
      ('TestDoctrineCrystallizeSuppression CRASHED: ', e messageText) println.
      t assert: false message: 'TestDoctrineCrystallizeSuppression crashed'
    ].
    [TestDoctrineVotingPrompt run: t] on: Exception do: [:e |
      ('TestDoctrineVotingPrompt CRASHED: ', e messageText) println.
      t assert: false message: 'TestDoctrineVotingPrompt crashed'
    ].
    t report.
    ^t failed
  ]
