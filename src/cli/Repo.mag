"Repository registration — manages repos registered with Procyon Park.
 Repos are stored as JSON config files at ~/.pp/repos/<name>.json.
 Worktrees are managed at ~/.pp/worktrees/."

Repo subclass: Object
  instanceVars: ppDir reposDir worktreesDir

  classMethod: new [
    ^super new initialize
  ]

  classMethod: invalidateRepoCache [
    "No-op: repoForName: no longer caches. The former class-var TTL cache
     (CachedConfigs/CachedExpiries) was a data race — repoForName: is called
     concurrently from the dispatcher tick, Scheduler dispatch,
     CreateWorktreeAction, and DispatchWavesAction (separate goroutines), and
     the unsynchronized shared Dictionaries got corrupted. Kept for API
     compatibility with cmdAdd:/cmdRemove: callers."
    ^self
  ]

  method: initialize [
    | home |
    home := System env: 'HOME'.
    (home isNil or: [home isEmpty]) ifTrue: [
      home := '/tmp'
    ].
    ppDir := home, '/.pp'.
    reposDir := ppDir, '/repos'.
    worktreesDir := ppDir, '/worktrees'
  ]

  method: ppDir [ ^ppDir ]
  method: reposDir [ ^reposDir ]
  method: worktreesDir [ ^worktreesDir ]

  method: ensureDirs [
    "Create ~/.pp/, ~/.pp/repos/, ~/.pp/worktrees/ if they don't exist."
    self shellRun: 'mkdir -p "', reposDir, '" "', worktreesDir, '"'
  ]

  method: runWith: args [
    "Dispatch repo subcommands."
    | subcmd |
    args size < 2 ifTrue: [
      self printUsage.
      ^self
    ].

    subcmd := args at: 2.

    subcmd = 'add'    ifTrue: [^self cmdAdd: args].
    subcmd = 'list'   ifTrue: [^self cmdList: args].
    subcmd = 'ls'     ifTrue: [^self cmdList: args].
    subcmd = 'remove' ifTrue: [^self cmdRemove: args].
    subcmd = 'rm'     ifTrue: [^self cmdRemove: args].
    subcmd = 'info'   ifTrue: [^self cmdInfo: args].
    subcmd = 'help'   ifTrue: [^self printUsage].

    subcmd = 'clean-branches' ifTrue: [^self cmdCleanBranches: args].

    subcmd = 'worktree' ifTrue: [
      | wtCmd |
      wtCmd := args size > 2 ifTrue: [args at: 3] ifFalse: [''].
      wtCmd = 'list'  ifTrue: [^self cmdWorktreeList: args].
      wtCmd = 'ls'    ifTrue: [^self cmdWorktreeList: args].
      wtCmd = 'clean' ifTrue: [^self cmdWorktreeClean: args].
      self printWorktreeUsage.
      ^self
    ].

    ('Unknown repo command: ', subcmd) println.
    self printUsage
  ]

  "--- Commands ---"

  method: cmdAdd: args [
    "pp repo add <path> [--name <name>]"
    | rawPath absPath repoName configPath config flagName tmpFile |
    args size < 3 ifTrue: [
      'Usage: pp repo add <path> [--name <name>]' println.
      ^self
    ].

    rawPath := args at: 3.
    tmpFile := '/tmp/pp-repo-tmp-', DateTime now epochSeconds printString.

    "Resolve to absolute path"
    self shellRun: 'cd "', rawPath, '" 2>/dev/null && pwd > "', tmpFile, '"'.
    (File exists: tmpFile) ifFalse: [
      ('Error: path does not exist: ', rawPath) println.
      ^self
    ].
    absPath := self readAndClean: tmpFile.
    absPath isEmpty ifTrue: [
      ('Error: path does not exist: ', rawPath) println.
      ^self
    ].

    "Validate it is a git repo"
    (File exists: absPath, '/.git') ifFalse: [
      ('Error: not a git repository: ', absPath) println.
      ^self
    ].

    "Determine repo name"
    flagName := self flagValue: '--name' in: args.
    flagName notNil
      ifTrue: [repoName := flagName]
      ifFalse: [
        self shellRun: 'basename "', absPath, '" > "', tmpFile, '"'.
        repoName := self readAndClean: tmpFile
      ].

    "Ensure directories exist"
    self ensureDirs.

    "Write config"
    configPath := reposDir, '/', repoName, '.json'.

    config := Dictionary new.
    config at: 'name' put: repoName.
    config at: 'path' put: absPath.
    config at: 'registered_at' put: DateTime now epochSeconds.

    self shellRun: 'cat > "', configPath, '" << ''PPEOF''
', (Json encodePretty: config), '
PPEOF'.

    Repo invalidateRepoCache.
    ('Registered repository: ', repoName) println.
    ('  Path: ', absPath) println.
    ('  Config: ', configPath) println
  ]

  method: cmdList: args [
    "pp repo list"
    | tmpFile fileList count |

    self ensureDirs.
    tmpFile := '/tmp/pp-repo-list-', DateTime now epochSeconds printString.

    self shellRun: 'ls "', reposDir, '/" 2>/dev/null | grep ".json$" > "', tmpFile, '"'.

    (File exists: tmpFile) ifFalse: [
      'No repositories registered.' println.
      'Use: pp repo add <path>' println.
      ^self
    ].

    fileList := File readFileContents: tmpFile.
    self shellRun: 'rm -f "', tmpFile, '"'.

    count := 0.
    (fileList split: '
') do: [:fname |
      | configPath contents config name path valid |
      (fname size > 5 and: [(fname copyFrom: fname size - 4) = '.json']) ifTrue: [
        configPath := reposDir, '/', fname.
        [
          contents := File readFileContents: configPath.
          config := Json decode: contents.
          name := config at: 'name' ifAbsent: ['?'].
          path := config at: 'path' ifAbsent: ['?'].
          valid := File exists: path.
          count := count + 1.
          (name, '  ', path, (valid ifTrue: [''] ifFalse: ['  [MISSING]'])) println
        ] on: Exception do: [:e |
          ('  Error reading ', fname, ': ', e messageText) println
        ]
      ]
    ].

    count = 0 ifTrue: [
      'No repositories registered.' println.
      'Use: pp repo add <path>' println
    ]
  ]

  method: cmdRemove: args [
    "pp repo remove <name>"
    | repoName configPath |
    args size < 3 ifTrue: [
      'Usage: pp repo remove <name>' println.
      ^self
    ].

    repoName := args at: 3.
    configPath := reposDir, '/', repoName, '.json'.

    (File exists: configPath) ifFalse: [
      ('Error: no repository registered with name: ', repoName) println.
      ^self
    ].

    self shellRun: 'rm "', configPath, '"'.
    Repo invalidateRepoCache.
    ('Removed repository: ', repoName) println
  ]

  method: cmdInfo: args [
    "pp repo info <name>"
    | repoName configPath contents config |
    args size < 3 ifTrue: [
      'Usage: pp repo info <name>' println.
      ^self
    ].

    repoName := args at: 3.
    configPath := reposDir, '/', repoName, '.json'.

    (File exists: configPath) ifFalse: [
      ('Error: no repository registered with name: ', repoName) println.
      ^self
    ].

    contents := File readFileContents: configPath.
    config := Json decode: contents.
    (Json encodePretty: config) println
  ]

  "--- Worktree Commands ---"

  method: cmdWorktreeList: args [
    "pp repo worktree list — list all managed worktrees."
    | listFile taskList count taskDir wtList wtPath |

    self ensureDirs.
    count := 0.
    listFile := worktreesDir, '/.pp-ls-tmp'.

    "List task-level directories under worktreesDir"
    self shellRun: 'ls "', worktreesDir, '" > "', listFile, '" 2>/dev/null'.

    (File exists: listFile) ifFalse: [
      'No worktrees found.' println.
      ^self
    ].

    taskList := File readFileContents: listFile.
    self shellRun: 'rm -f "', listFile, '"'.

    (taskList split: '
') do: [:taskName |
      (taskName isEmpty or: [taskName startsWith: '.']) ifFalse: [
        taskDir := worktreesDir, '/', taskName.
        count := count + 1.
        ('  ', taskName) println.

        "List subtask worktree directories within this task dir"
        self shellRun: 'ls "', taskDir, '" > "', listFile, '" 2>/dev/null'.

        (File exists: listFile) ifTrue: [
          wtList := File readFileContents: listFile.
          self shellRun: 'rm -f "', listFile, '"'.

          (wtList split: '
') do: [:wtName |
            (wtName isEmpty or: [wtName startsWith: '.']) ifFalse: [
              ('    ', wtName) println
            ]
          ]
        ]
      ]
    ].

    count = 0
      ifTrue: ['No worktrees found.' println]
      ifFalse: [(count printString, ' worktree dir(s) found.') println]
  ]

  method: cmdWorktreeClean: args [
    "pp repo worktree clean [--dry-run] — remove worktrees for completed/missing
     workflows. Each task is processed inside its own rescue so one bad task
     (malformed listing, stuck git lock) logs and the sweep continues rather
     than aborting the whole command with an uncaught signal.
     Answers a Dictionary {cleaned, failed}."
    | tmpFile taskList taskDirs dryRun cleaned failed ppUrl |

    self ensureDirs.
    cleaned := 0.
    failed := 0.
    dryRun := (args indexOf: '--dry-run') > 0.
    tmpFile := '/tmp/pp-wt-clean-', DateTime now epochSeconds printString.

    "Read PP_URL for API calls"
    ppUrl := System env: 'PP_URL'.
    (ppUrl isNil or: [ppUrl isEmpty]) ifTrue: [ppUrl := 'http://localhost:7777'].

    "List task-level directories under worktreesDir"
    self shellRun: 'ls "', worktreesDir, '/" 2>/dev/null > "', tmpFile, '"'.

    (File exists: tmpFile) ifFalse: [
      'No worktrees to clean.' println.
      ^self cleanResultCleaned: 0 failed: 0
    ].

    taskList := File readFileContents: tmpFile.
    self shellRun: 'rm -f "', tmpFile, '"'.

    taskDirs := taskList split: '
'.

    taskDirs do: [:taskName |
      "Guard the listing entry: a malformed split result can yield a
       non-String, which would crash string concatenation downstream."
      ((taskName isKindOf: String) and: [taskName isEmpty not]) ifTrue: [
        [
          (self cleanWorktreeTask: taskName dryRun: dryRun ppUrl: ppUrl tmpFile: tmpFile)
            ifTrue: [cleaned := cleaned + 1]
        ] on: Exception do: [:e |
          failed := failed + 1.
          ('Skipped (error): ', taskName, ' — ', e messageText) println
        ]
      ]
    ].

    self shellRun: 'rm -f "', tmpFile, '"'.
    ('Cleaned ', cleaned printString, ' worktree(s).') println.
    failed > 0 ifTrue: [
      ('Skipped ', failed printString, ' worktree(s) due to errors.') println
    ].
    ^self cleanResultCleaned: cleaned failed: failed
  ]

  method: cleanResultCleaned: cleaned failed: failed [
    "Small record so callers/tests can inspect the sweep outcome."
    | r |
    r := Dictionary new.
    r at: 'cleaned' put: cleaned.
    r at: 'failed' put: failed.
    ^r
  ]

  method: cleanWorktreeTask: taskName dryRun: dryRun ppUrl: ppUrl tmpFile: tmpFile [
    "Process one worktree task dir: probe workflow status and remove the dir
     when the workflow is completed/not_found/unreachable. Answers true when
     removed (or would be, in dry-run), false when kept. May signal — the
     caller rescues per-task."
    | taskDir shouldRemove statusResponse statusBody wfStatus wtList wtDirs wtPath |
    taskDir := worktreesDir, '/', taskName.
    shouldRemove := false.

    "Check workflow status via HTTP GET"
    [
      self shellRun: 'curl -s "', ppUrl, '/api/v1/workflow/status/', taskName, '" > "', tmpFile, '" 2>/dev/null'.
      (File exists: tmpFile) ifTrue: [
        statusResponse := File readFileContents: tmpFile.
        self shellRun: 'rm -f "', tmpFile, '"'.
        statusResponse isEmpty
          ifTrue: [shouldRemove := true]
          ifFalse: [
            [
              statusBody := Json decode: statusResponse.
              wfStatus := statusBody at: 'status' ifAbsent: [''].
              (wfStatus = 'completed' or: [wfStatus = 'not_found']) ifTrue: [
                shouldRemove := true
              ]
            ] on: Exception do: [:e |
              "JSON parse error — treat as missing"
              shouldRemove := true
            ]
          ]
      ] ifFalse: [
        shouldRemove := true
      ]
    ] on: Exception do: [:e |
      "Network error — treat as missing"
      shouldRemove := true
    ].

    shouldRemove ifFalse: [^false].

    dryRun ifTrue: [
      ('Would remove: ', taskDir) println.
      ^true
    ].

    "Try git worktree remove first, fall back to rm -rf"
    self shellRun: 'ls "', taskDir, '/" 2>/dev/null > "', tmpFile, '"'.
    (File exists: tmpFile) ifTrue: [
      wtList := File readFileContents: tmpFile.
      self shellRun: 'rm -f "', tmpFile, '"'.
      wtDirs := wtList split: '
'.
      wtDirs do: [:wtName |
        "Skip non-String/empty entries — the final rm -rf below still
         removes the whole task dir, so cleanup is never lost."
        ((wtName isKindOf: String) and: [wtName isEmpty not]) ifTrue: [
          wtPath := taskDir, '/', wtName.
          self shellRun: 'git worktree remove "', wtPath, '" 2>/dev/null || rm -rf "', wtPath, '"'
        ]
      ]
    ].
    self shellRun: 'rm -rf "', taskDir, '"'.
    ('Removed: ', taskDir) println.
    ^true
  ]

  "--- Clean Branches Command ---"

  method: cmdCleanBranches: args [
    "pp repo clean-branches [--dry-run] [--all] [--repo <name>] — remove stale impl/feature branches."
    | tmpFile dryRun deleteAll repoName repoConfig repoPath branchOutput branchLines mergedOutput mergedLines branch trimmed isCurrent isMerged deletedMerged deletedForce totalDeleted line mlStr lineStr |

    dryRun := (args indexOf: '--dry-run') > 0.
    deleteAll := (args indexOf: '--all') > 0.
    repoName := self flagValue: '--repo' in: args.
    tmpFile := '/tmp/pp-repo-clean-', DateTime now epochSeconds printString.
    deletedMerged := 0.
    deletedForce := 0.

    "Determine repo path"
    repoPath := nil.
    repoName notNil ifTrue: [
      repoConfig := self repoForName: repoName.
      repoConfig isNil ifTrue: [
        ('Error: no repository registered with name: ', repoName) println.
        ^self
      ].
      repoPath := repoConfig at: 'path' ifAbsent: [nil]
    ].
    repoPath isNil ifTrue: [
      self shellRun: 'pwd > "', tmpFile, '"'.
      repoPath := self readAndClean: tmpFile
    ].

    "Get impl/* and feature/* branches — use sed to strip leading spaces/asterisks"
    self shellRun: 'git -C "', repoPath, '" branch --list "impl/*" "feature/*" 2>/dev/null | sed "s/^[* ]*//" > "', tmpFile, '"'.
    branchOutput := self readAndClean: tmpFile.
    branchOutput isEmpty ifTrue: [
      'No impl/* or feature/* branches found.' println.
      ^self
    ].
    branchLines := branchOutput split: '
'.

    "Get current branch name"
    self shellRun: 'git -C "', repoPath, '" rev-parse --abbrev-ref HEAD > "', tmpFile, '" 2>/dev/null'.
    trimmed := self readAndClean: tmpFile.

    "Get merged branches — use sed to strip leading spaces/asterisks"
    self shellRun: 'git -C "', repoPath, '" branch --merged main 2>/dev/null | sed "s/^[* ]*//" > "', tmpFile, '"'.
    mergedOutput := self readAndClean: tmpFile.
    mergedLines := Array new: 0.
    mergedOutput isEmpty ifFalse: [
      (mergedOutput split: '
') do: [:ml |
        mlStr := '', ml.
        mlStr isEmpty ifFalse: [
          mergedLines := mergedLines copyWith: mlStr
        ]
      ]
    ].

    "Process each branch"
    branchLines do: [:line |
      isCurrent := false.
      lineStr := '', line.
      lineStr isEmpty ifFalse: [
        (lineStr = trimmed) ifTrue: [
          isCurrent := true
        ].
        isCurrent ifTrue: [
          ('Skipping current branch: ', lineStr) println
        ] ifFalse: [
          branch := lineStr.
          isMerged := (mergedLines indexOf: branch) > 0.
          isMerged ifTrue: [
            dryRun ifTrue: [
              ('Would delete (merged): ', branch) println
            ] ifFalse: [
              self shellRun: 'git -C "', repoPath, '" branch -d "', branch, '"'.
              ('Deleted (merged): ', branch) println
            ].
            deletedMerged := deletedMerged + 1
          ] ifFalse: [
            deleteAll ifTrue: [
              dryRun ifTrue: [
                ('Would force-delete (unmerged): ', branch) println
              ] ifFalse: [
                ('⚠ Deleting UNMERGED branch: ', branch) println.
                self shellRun: 'git -C "', repoPath, '" branch -D "', branch, '"'
              ].
              deletedForce := deletedForce + 1
            ] ifFalse: [
              ('Skipping unmerged: ', branch, ' (use --all to force-delete)') println
            ]
          ]
        ]
      ]
    ].

    "Print summary"
    totalDeleted := deletedMerged + deletedForce.
    dryRun ifTrue: [
      ('Dry run: would delete ', totalDeleted printString, ' branches') println
    ] ifFalse: [
      ('Deleted ', totalDeleted printString, ' branches (', deletedMerged printString, ' merged, ', deletedForce printString, ' force-deleted)') println
    ]
  ]

  method: printCleanBranchesUsage [
    'pp repo clean-branches — Remove stale impl/feature branches' println.
    '' println.
    'Usage: pp repo clean-branches [--dry-run] [--all] [--repo <name>]' println.
    '' println.
    'Flags:' println.
    '  --dry-run        Preview mode, no deletions' println.
    '  --all            Also delete unmerged branches (force-delete)' println.
    '  --repo <name>    Operate on a registered repository' println
  ]

  method: printWorktreeUsage [
    'pp repo worktree — Worktree management' println.
    '' println.
    'Usage: pp repo worktree <command> [args...]' println.
    '' println.
    'Commands:' println.
    '  list                 List all managed worktrees' println.
    '  clean [--dry-run]    Remove worktrees for completed/missing workflows' println.
    '' println.
    'Worktrees are stored at ~/.pp/worktrees/' println
  ]

  "--- Validation ---"

  method: validateAll [
    "Validate all registered repos still exist. Print warnings for missing ones."
    | tmpFile fileList |

    (File exists: reposDir) ifFalse: [^self].

    tmpFile := '/tmp/pp-repo-validate-', DateTime now epochSeconds printString.
    self shellRun: 'ls "', reposDir, '/" 2>/dev/null | grep ".json$" > "', tmpFile, '"'.
    (File exists: tmpFile) ifFalse: [^self].

    fileList := File readFileContents: tmpFile.
    self shellRun: 'rm -f "', tmpFile, '"'.

    (fileList split: '
') do: [:fname |
      | configPath contents config name path |
      (fname size > 5 and: [(fname copyFrom: fname size - 4) = '.json']) ifTrue: [
        configPath := reposDir, '/', fname.
        [
          contents := File readFileContents: configPath.
          config := Json decode: contents.
          name := config at: 'name' ifAbsent: ['?'].
          path := config at: 'path' ifAbsent: ['?'].
          (File exists: path) ifFalse: [
            ('WARNING: registered repo missing: ', name, ' (', path, ')') println
          ]
        ] on: Exception do: [:e | "skip bad configs" ]
      ]
    ]
  ]

  method: repoForName: aName [
    "Look up a registered repo by name. Returns config Dictionary or nil.

     §6 hot-path: called from Scheduler>>dispatch (per task),
     WorkflowEngine>>instantiate:, CreateWorktreeAction>>execute:, and
     DispatchWavesAction>>execute: — all on separate dispatcher goroutines.

     NO caching, deliberately. An earlier class-side TTL cache
     (CachedConfigs/CachedExpiries) was a DATA RACE: those plain Dictionaries
     were read and mutated concurrently from the goroutines above with no
     synchronization, corrupting the Dictionary and surfacing as
     'at:ifAbsent:: receiver is not a Dictionary' in scheduler dispatch /
     create-worktree — which intermittently bricked ALL task dispatch (same
     binary works one moment, fails the next). Config files are tiny and read
     at most once per task dispatch, so a fresh stat + parse per call is
     negligible and race-free. Do NOT reintroduce shared mutable caching here
     without a Mutex."
    | configPath contents |
    configPath := reposDir, '/', aName, '.json'.
    (File exists: configPath) ifFalse: [^nil].
    [
      contents := File readFileContents: configPath.
      ^Json decode: contents
    ] on: Exception do: [:e | ^nil]
  ]

  "--- Helpers ---"

  method: shellRun: cmd [
    "Run a shell command (fire and forget, no output capture)."
    | proc shellArgs |
    proc := ExternalProcess command: '/bin/sh'.
    shellArgs := #('-c').
    shellArgs := shellArgs copyWith: cmd.
    proc args: shellArgs.
    proc run
  ]

  method: readAndClean: tmpFile [
    "Read a temp file, delete it, return contents with trailing newline stripped."
    | raw result |
    (File exists: tmpFile) ifFalse: [^''].
    raw := File readFileContents: tmpFile.
    self shellRun: 'rm -f "', tmpFile, '"'.
    "Strip trailing newlines"
    result := raw.
    [result size > 0 and: [(result copyFrom: result size) = '
']] whileTrue: [
      result := result copyFrom: 1 to: result size - 1
    ].
    ^result
  ]

  method: flagValue: flag in: args [
    | idx |
    idx := args indexOf: flag.
    (idx > 0 and: [idx < args size])
      ifTrue: [^args at: idx + 1]
      ifFalse: [^nil]
  ]

  method: printUsage [
    'pp repo — Repository management' println.
    '' println.
    'Usage: pp repo <command> [args...]' println.
    '' println.
    'Commands:' println.
    '  add    <path> [--name <name>]   Register a repository' println.
    '  list                            List registered repositories' println.
    '  remove <name>                   Unregister a repository' println.
    '  info   <name>                   Show repository details' println.
    '  worktree list                   List managed worktrees' println.
    '  worktree clean [--dry-run]      Clean completed worktrees' println.
    '  clean-branches [--dry-run] [--all]  Remove stale impl/feature branches' println.
    '' println.
    'Repositories are stored at ~/.pp/repos/' println.
    'Worktrees are managed at ~/.pp/worktrees/' println
  ]
