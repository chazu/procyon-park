"DoctrineCLI — manage doctrine: the swarm's plan-time 'Orient' layer.

 Doctrine is advisory, contextual (applicability scope + tags), and matured
 proposed -> active -> retired/rejected. It is distinct from execution-time
 conventions (binding) and CUE templates (procedural).

 Built entirely on the generic BBS endpoints — no doctrine-specific server
 routes:
   reads  : POST /api/scan, /api/rdp  (unsigned, non-consuming)
   writes : POST /api/bbs/put          (ed25519-signed via CLIBase)

 Doctrine is LINEAR + DURABLE (Categories>>isDurableCategory:), never pinned —
 writes pass modality:'linear' so entries stay visible to rdp:. Each proposal
 gets a fresh unique identity (dctr-<hex>); the human-readable name lives in
 payload.key. See docs/design-doctrine-layer.md."

DoctrineCLI subclass: Object
  instanceVars: baseUrl scope

  classMethod: new [
    ^super new initialize
  ]

  method: initialize [
    baseUrl := System env: 'PP_URL'.
    (baseUrl isNil or: [baseUrl isEmpty]) ifTrue: [baseUrl := 'http://localhost:7777'].
    scope := System env: 'PP_SCOPE'.
    (scope isNil or: [scope isEmpty]) ifTrue: [scope := nil]
  ]

  method: defaultScope [
    ^scope isNil ifTrue: ['default'] ifFalse: [scope]
  ]

  method: runWith: args [
    "Dispatch pp doctrine subcommands."
    | sub |
    args size < 2 ifTrue: [^self printUsage].
    sub := args at: 2.
    sub = 'list'    ifTrue: [^self cmdList: args].
    sub = 'show'    ifTrue: [^self cmdShow: args].
    sub = 'propose' ifTrue: [^self cmdPropose: args].
    sub = 'feedback' ifTrue: [^self cmdFeedback: args].
    sub = 'synthesize' ifTrue: [^self cmdSynthesize: args].
    sub = 'crystallize' ifTrue: [^self cmdCrystallize: args].
    sub = 'export' ifTrue: [^self cmdExport: args].
    sub = 'promote' ifTrue: [^self cmdSetMaturity: args to: 'active'].
    sub = 'retire'  ifTrue: [^self cmdSetMaturity: args to: 'retired'].
    sub = 'reject'  ifTrue: [^self cmdSetMaturity: args to: 'rejected'].
    sub = 'decrystallize' ifTrue: [^self cmdDecrystallize: args].
    (sub = 'help' or: [sub = '--help']) ifTrue: [^self printUsage].
    ('Unknown doctrine command: ', sub) println.
    self printUsage
  ]

  method: joinArray: arr with: sep [
    "Join an Array of strings with a separator (no Array>>joinWith: in the VM)."
    | s first |
    s := ''.
    first := true.
    arr do: [:x |
      first ifTrue: [s := x. first := false] ifFalse: [s := s, sep, x]
    ].
    ^s
  ]

  method: flagValue: flag in: args [
    "Return the value following <flag> in args, or nil."
    | i |
    i := 1.
    [i < args size] whileTrue: [
      (args at: i) = flag ifTrue: [^args at: i + 1].
      i := i + 1
    ].
    ^nil
  ]

  method: applyScopeFlagFrom: args [
    "Resolve the BBS storage scope from --repo/--scope, mutating `scope`."
    | r |
    r := self flagValue: '--repo' in: args.
    r isNil ifTrue: [r := self flagValue: '--scope' in: args].
    r notNil ifTrue: [scope := r]
  ]

  method: resolveAppliesToScope: applies [
    "Resolve an --applies value to a CONCRETE doctrine_scope. The consumer's
     scope-union check compares doctrine_scope to {global, <concrete-repo>},
     so storing the literal type 'repo' makes the entry match NOTHING and it
     reaches no role. 'global' stays global; 'repo' becomes the resolved repo
     (defaultScope); 'repo:<path>'/'path:<path>' become '<repo>:<path>'; an
     already-concrete value is kept verbatim. Without a concrete repo
     (defaultScope is 'default'/'global'/empty) repo/path forms degrade to
     'global' rather than storing an un-matchable literal."
    | sc |
    applies = 'global' ifTrue: [^'global'].
    sc := self defaultScope.
    (sc isNil or: [sc isEmpty or: [sc = 'default' or: [sc = 'global']]]) ifTrue: [
      ((applies = 'repo') or: [(applies startsWith: 'repo:') or: [applies startsWith: 'path:']])
        ifTrue: [^'global']
        ifFalse: [^applies]
    ].
    applies = 'repo' ifTrue: [^sc].
    (applies startsWith: 'repo:') ifTrue: [^sc, ':', (applies copyFrom: 6 to: applies size)].
    (applies startsWith: 'path:') ifTrue: [^sc, ':', (applies copyFrom: 6 to: applies size)].
    ^applies
  ]

  "--- reads (unsigned) -------------------------------------------------"

  method: scanDoctrine [
    "Return an Array of doctrine tuples in the resolved scope (best-effort)."
    | sc response result |
    sc := self defaultScope.
    [
      response := Shell capture: 'curl -s -X POST ', baseUrl, '/api/scan -H "Content-Type: application/json" -d ''{"category":"doctrine","scope":"', sc, '"}'''.
      (response isNil or: [response isEmpty]) ifTrue: [^Array new: 0].
      result := Json decode: response.
      ^result at: 'tuples' ifAbsent: [Array new: 0]
    ] on: Exception do: [:e | ^Array new: 0]
  ]

  method: rdpDoctrine: id [
    "Return one doctrine tuple by identity, or nil."
    | response result |
    [
      response := Shell capture: 'curl -s -X POST ', baseUrl, '/api/rdp -H "Content-Type: application/json" -d ''{"category":"doctrine","scope":"', self defaultScope, '","identity":"', id, '"}'''.
      (response isNil or: [response isEmpty]) ifTrue: [^nil].
      result := Json decode: response.
      ^result at: 'tuple' ifAbsent: [nil]
    ] on: Exception do: [:e | ^nil]
  ]

  method: rdpTask: id [
    "Return one task tuple by identity (unsigned rdp:), or nil. Used only to
     derive payload.role for feedback attribution; network/parse-tolerant."
    | response result |
    [
      response := Shell capture: 'curl -s -X POST ', baseUrl, '/api/rdp -H "Content-Type: application/json" -d ''{"category":"task","scope":"', self defaultScope, '","identity":"', id, '"}'''.
      (response isNil or: [response isEmpty]) ifTrue: [^nil].
      result := Json decode: response.
      ^result at: 'tuple' ifAbsent: [nil]
    ] on: Exception do: [:e | ^nil]
  ]

  method: scanFeedback: aScope [
    "Return an Array of doctrine-feedback tuples in a CANONICAL doctrine_scope
     (best-effort, unsigned). aScope is the doctrine's own doctrine_scope — the
     scope every vote on that doctrine is written to — never the voter's repo."
    | response result |
    [
      response := Shell capture: 'curl -s -X POST ', baseUrl, '/api/scan -H "Content-Type: application/json" -d ''{"category":"doctrine-feedback","scope":"', aScope, '"}'''.
      (response isNil or: [response isEmpty]) ifTrue: [^Array new: 0].
      result := Json decode: response.
      ^result at: 'tuples' ifAbsent: [Array new: 0]
    ] on: Exception do: [:e | ^Array new: 0]
  ]

  method: cmdList: args [
    "pp doctrine list [--scope S] [--tag T] [--maturity M]"
    | tagFilter matFilter tuples shown |
    self applyScopeFlagFrom: args.
    tagFilter := self flagValue: '--tag' in: args.
    matFilter := self flagValue: '--maturity' in: args.
    tuples := self scanDoctrine.
    shown := 0.
    tuples do: [:t |
      | p mat tags ok |
      p := t at: 'payload' ifAbsent: [Dictionary new].
      mat := p at: 'maturity' ifAbsent: ['?'].
      tags := p at: 'tags' ifAbsent: [Array new: 0].
      ok := true.
      (matFilter notNil and: [(mat = matFilter) not]) ifTrue: [ok := false].
      (tagFilter notNil and: [(tags includes: tagFilter) not]) ifTrue: [ok := false].
      ok ifTrue: [
        | dscope voteCol |
        dscope := p at: 'doctrine_scope' ifAbsent: ['global'].
        (dscope isNil or: [dscope isEmpty]) ifTrue: [dscope := 'global'].
        "Compact vote column (e.g. +3/-1) — surfaces the human/agent verdict at a
         glance. Tally is at the doctrine's CANONICAL doctrine_scope so global
         votes cast from any repo are counted together. Network/parse-tolerant:
         feedbackTallyFor: degrades to zeros on any failure, never breaks the list."
        voteCol := self formatVoteColumn: (self feedbackTallyFor: (t at: 'identity') scope: dscope).
        ((t at: 'identity'), '  [', mat, ']  ', voteCol, '  (', dscope, ')  ', (p at: 'principle' ifAbsent: [''])) println.
        shown := shown + 1
      ]
    ].
    shown = 0 ifTrue: ['(no doctrine matches)' println]
  ]

  method: cmdShow: args [
    "pp doctrine show <id> [--scope S]"
    | id tuple p |
    args size < 3 ifTrue: ['Usage: pp doctrine show <id> [--scope S]' println. ^self].
    id := args at: 3.
    self applyScopeFlagFrom: args.
    tuple := self rdpDoctrine: id.
    tuple isNil ifTrue: ['Not found.' println. ^self].
    p := tuple at: 'payload'.
    ('id:         ', (tuple at: 'identity')) println.
    ('key:        ', (p at: 'key' ifAbsent: [''])) println.
    ('maturity:   ', (p at: 'maturity' ifAbsent: ['?'])) println.
    ('scope:      ', (p at: 'doctrine_scope' ifAbsent: ['global'])) println.
    "Vote tally (up / down / net) — surface the accumulated human/agent verdict.
     Tallied at the doctrine's CANONICAL doctrine_scope so votes cast from any
     repo on a global doctrine converge. Network/parse-tolerant (zeros on fail)."
    self showVoteTally: tuple payload: p.
    ('tags:       ', (self joinArray: (p at: 'tags' ifAbsent: [Array new: 0]) with: ',')) println.
    ('confidence: ', (p at: 'confidence' ifAbsent: ['']) printString) println.
    ('principle:  ', (p at: 'principle' ifAbsent: [''])) println.
    ('rationale:  ', (p at: 'rationale' ifAbsent: [''])) println.
    ('provenance: ', (p at: 'provenance' ifAbsent: [Array new: 0]) printString) println.
    "crystallized_into — the forward C2 edge: downstream artifacts this doctrine
     crystallized into (convention | workitem). NULL-TOLERANT: missing field or a
     dangling target (artifact later removed) renders gracefully, never crashes."
    self showCrystallizedInto: p
  ]

  method: showCrystallizedInto: p [
    "Render the crystallized_into down-stream artifacts of a doctrine payload."
    | links |
    links := DoctrineWriter linksOf: p.
    links isEmpty ifTrue: [
      'crystallized_into: (none)' println.
      ^self
    ].
    'crystallized_into:' println.
    links do: [:l |
      ('  -> ', (DoctrineWriter formatLink: l)) println
    ]
  ]

  "--- writes (signed) --------------------------------------------------"

  method: putDoctrine: id payload: payload [
    "Signed upsert of a doctrine tuple as linear (durable, rdp-visible)."
    | body |
    body := Dictionary new.
    body at: 'category' put: 'doctrine'.
    body at: 'scope' put: self defaultScope.
    body at: 'identity' put: id.
    body at: 'modality' put: 'linear'.
    body at: 'payload' put: payload.
    ^CLIBase signedPost: '/api/bbs/put' body: body baseUrl: baseUrl
  ]

  method: cmdPropose: args [
    "pp doctrine propose <principle> [--rationale R] [--applies global|repo:X|path:X]
                                     [--tags t1,t2] [--confidence C] [--key K] [--repo R]"
    | principle rationale applies tagsArg conf key tags id payload |
    args size < 3 ifTrue: [
      'Usage: pp doctrine propose "<principle>" [--rationale R] [--applies global|repo|repo:path] [--tags t1,t2] [--confidence 0.7] [--key name]' println.
      ^self
    ].
    principle := args at: 3.
    rationale := self flagValue: '--rationale' in: args.
    rationale isNil ifTrue: [rationale := ''].
    applies := self flagValue: '--applies' in: args.
    applies isNil ifTrue: [applies := 'global'].
    "Resolve the applicability TYPE to a concrete scope (repo -> the repo name)."
    self applyScopeFlagFrom: args.
    applies := self resolveAppliesToScope: applies.
    tagsArg := self flagValue: '--tags' in: args.
    conf := self flagValue: '--confidence' in: args.
    key := self flagValue: '--key' in: args.
    key isNil ifTrue: [key := ''].
    self applyScopeFlagFrom: args.

    tags := Array new: 0.
    tagsArg notNil ifTrue: [tags := tagsArg split: ','].

    id := 'dctr-', ((ClaimId generate) at: 'hex').
    payload := Dictionary new.
    payload at: 'key' put: key.
    payload at: 'principle' put: principle.
    payload at: 'rationale' put: rationale.
    payload at: 'doctrine_scope' put: applies.
    payload at: 'tags' put: tags.
    payload at: 'maturity' put: 'proposed'.
    payload at: 'provenance' put: (Array new: 0).
    "crystallized_into — the forward C2 edge (doctrine -> {convention|workitem}).
     Mirror of provenance, opposite direction. Starts empty; the to-convention /
     to-workitem verbs populate it later via DoctrineWriter>>crystallize:..."
    payload at: 'crystallized_into' put: (Array new: 0).
    conf notNil ifTrue: [payload at: 'confidence' put: conf].
    payload at: 'created_at' put: DateTime now epochSeconds.

    self putDoctrine: id payload: payload.
    ('proposed doctrine ', id, ' (', applies, ')') println
  ]

  method: cmdSynthesize: args [
    "pp doctrine synthesize [--repo R] — enqueue a Strategist task that reads
     recent case (AAR) tuples and PROPOSES doctrine (via pp doctrine propose).
     The Strategist is read-only/write-to-KB: no worktree, no merge — it writes
     proposed doctrine straight to the tuplespace."
    | repo taskId body |
    self applyScopeFlagFrom: args.
    repo := self flagValue: '--repo' in: args.
    repo isNil ifTrue: [repo := 'procyon-park'].
    taskId := 'strategist-', ((ClaimId generate) at: 'hex').
    body := Dictionary new.
    body at: 'scope' put: self defaultScope.
    body at: 'identity' put: taskId.
    body at: 'role' put: 'strategist'.
    body at: 'description' put: (Strategist synthesisDescriptionForScope: self defaultScope).
    body at: 'repo' put: repo.
    CLIBase signedPost: '/api/task/create' body: body baseUrl: baseUrl.
    ('Strategist task enqueued: ', taskId, ' (scope ', self defaultScope, ') — watch: pp read doctrine ', self defaultScope) println
  ]

  "--- feedback: the race-free capture layer for votes on doctrine ------

   An agent (or a human) votes up/down on a doctrine entry. Each vote is an
   APPEND-ONLY tuple with a fresh dfb-<hex> identity — never a read-modify-write
   of a shared aggregate (which would race when two agents vote at once, the
   fresh-id-per-write discipline). The vote is written at the doctrine's own
   doctrine_scope (CANONICAL), NOT the voter's repo/workflow scope: a GLOBAL
   doctrine can be voted on from any repo, and the ranker aggregates over
   doctrine_scope, so votes must converge on one scope or they split and
   feedbackTallyFor: silently undercounts."

  method: validateFeedbackUp: up down: down reason: reason [
    "Return an error string when the verdict flags are invalid, else nil.
     Exactly one of --up/--down required (reject both/neither); --down REQUIRES
     --reason (the actionable verdict — friction by design); --reason is
     optional on --up."
    (up and: [down]) ifTrue: [
      ^'--up and --down are mutually exclusive; specify exactly one.'].
    (up or: [down]) ifFalse: [
      ^'specify exactly one of --up / --down.'].
    (down and: [reason isNil or: [reason isEmpty]]) ifTrue: [
      ^'--down requires --reason (the actionable verdict; friction by design).'].
    ^nil
  ]

  method: feedbackEnvWorkflow [
    "PP_WORKFLOW (harness-set; nil when unset). Seam for deterministic tests."
    ^System env: 'PP_WORKFLOW'
  ]

  method: feedbackEnvTask [
    "PP_TASK (harness-set; nil when unset). Seam for deterministic tests."
    ^System env: 'PP_TASK'
  ]

  method: resolveTaskRole [
    "Derive the voter's role from the PP_TASK task tuple payload.role. Degrades
     to 'manual' when PP_TASK is unset OR the task cannot be resolved (env- and
     network-guarded — a missing server never breaks a manual vote)."
    | task tuple p role |
    task := self feedbackEnvTask.
    (task isNil or: [task isEmpty]) ifTrue: [^'manual'].
    tuple := self rdpTask: task.
    tuple isNil ifTrue: [^'manual'].
    p := tuple at: 'payload' ifAbsent: [nil].
    (p isKindOf: Dictionary) ifFalse: [^'manual'].
    role := p at: 'role' ifAbsent: ['manual'].
    (role isNil or: [role isEmpty]) ifTrue: [^'manual'].
    ^role
  ]

  method: feedbackPayloadForDoctrine: doctrineId scope: dscope verdict: verdict
      reason: reason workflow: wf task: task role: role [
    "PURE: build a feedback tuple payload. Every attribution field is
     null-tolerant — a nil env degrades to '' (task/workflow) or 'manual'
     (role), never a crash. doctrine_scope is the CANONICAL scope this vote is
     written/tallied at."
    | p |
    p := Dictionary new.
    p at: 'doctrine_id'       put: doctrineId.
    p at: 'doctrine_scope'    put: dscope.
    p at: 'verdict'           put: verdict.
    p at: 'reason'            put: (reason isNil ifTrue: [''] ifFalse: [reason]).
    p at: 'workflow_instance' put: ((wf isNil or: [wf isEmpty]) ifTrue: [''] ifFalse: [wf]).
    p at: 'task_id'           put: ((task isNil or: [task isEmpty]) ifTrue: [''] ifFalse: [task]).
    p at: 'role'              put: ((role isNil or: [role isEmpty]) ifTrue: ['manual'] ifFalse: [role]).
    p at: 'rated_at'          put: DateTime now epochSeconds.
    ^p
  ]

  method: feedbackPayloadForDoctrine: doctrineId scope: dscope verdict: verdict reason: reason [
    "Auto-attributed wrapper: read PP_WORKFLOW / PP_TASK / derived role from the
     environment, then delegate to the pure builder."
    ^self feedbackPayloadForDoctrine: doctrineId scope: dscope verdict: verdict
        reason: reason
        workflow: self feedbackEnvWorkflow
        task: self feedbackEnvTask
        role: self resolveTaskRole
  ]

  method: writeFeedbackTuple: id scope: dscope payload: payload [
    "Signed APPEND-ONLY write of a doctrine-feedback tuple as linear (durable,
     rdp/scan-visible). Fresh dfb-<hex> identity => never clobbers a prior vote.
     Scope is the CANONICAL doctrine_scope. Overridable seam for tests."
    | body |
    body := Dictionary new.
    body at: 'category' put: 'doctrine-feedback'.
    body at: 'scope'    put: dscope.
    body at: 'identity' put: id.
    body at: 'modality' put: 'linear'.
    body at: 'payload'  put: payload.
    ^CLIBase signedPost: '/api/bbs/put' body: body baseUrl: baseUrl
  ]

  method: tallyDict: up down: down [
    "Assemble the {up, down, net, total} tally Dictionary."
    | d |
    d := Dictionary new.
    d at: 'up'    put: up.
    d at: 'down'  put: down.
    d at: 'net'   put: up - down.
    d at: 'total' put: up + down.
    ^d
  ]

  method: tallyFeedbackTuples: tuples forDoctrine: doctrineId [
    "PURE: count up/down votes for doctrineId across the given tuples. NULL/empty
     tolerant — nil tuples, missing/non-dict payloads, and unknown verdicts are
     skipped; no votes => all zeros."
    | up down |
    up := 0. down := 0.
    tuples isNil ifFalse: [
      tuples do: [:t |
        | p |
        p := (t isKindOf: Dictionary) ifTrue: [t at: 'payload' ifAbsent: [nil]] ifFalse: [nil].
        (p isKindOf: Dictionary) ifTrue: [
          (p at: 'doctrine_id' ifAbsent: [nil]) = doctrineId ifTrue: [
            | v |
            v := p at: 'verdict' ifAbsent: [''].
            v = 'up'   ifTrue: [up := up + 1].
            v = 'down' ifTrue: [down := down + 1]
          ]
        ]
      ]
    ].
    ^self tallyDict: up down: down
  ]

  method: feedbackTallyFor: doctrineId scope: aScope [
    "Tally votes for doctrineId at its CANONICAL doctrine_scope. Callers (surface,
     rank) pass the candidate doctrine's own doctrine_scope so global-doctrine
     votes cast from any repo are counted together, never split. Scans the
     'doctrine-feedback' category in that scope and counts by verdict."
    ^self tallyFeedbackTuples: (self scanFeedback: aScope) forDoctrine: doctrineId
  ]

  method: formatVoteColumn: tally [
    "Compact vote column for list views, e.g. '+3/-1' (up/down). PURE."
    ^'+', (tally at: 'up') printString, '/-', (tally at: 'down') printString
  ]

  method: formatVoteTallyLine: tally [
    "Full vote tally line for show views: 'up N / down M / net K'. PURE."
    ^'up ', (tally at: 'up') printString, ' / down ', (tally at: 'down') printString,
      ' / net ', (tally at: 'net') printString
  ]

  method: showVoteTally: tuple payload: p [
    "Render the vote tally line for a doctrine, computing it at the doctrine's
     canonical doctrine_scope. Tolerant of a missing/empty scope (-> 'global')."
    | dscope tally |
    dscope := p at: 'doctrine_scope' ifAbsent: ['global'].
    (dscope isNil or: [dscope isEmpty]) ifTrue: [dscope := 'global'].
    tally := self feedbackTallyFor: (tuple at: 'identity') scope: dscope.
    ('votes:      ', (self formatVoteTallyLine: tally)) println
  ]

  method: cmdFeedback: args [
    "pp doctrine feedback <id> --up|--down [--reason R] [--repo R]
     Record an APPEND-ONLY vote on a doctrine at the doctrine's CANONICAL
     doctrine_scope, attributed to the current task/workflow (or 'manual')."
    | id up down reason err tuple p dscope verdict payload fbId key |
    args size < 3 ifTrue: [
      'Usage: pp doctrine feedback <id> --up|--down [--reason R]' println.
      ^self
    ].
    id := args at: 3.
    up := self hasFlag: '--up' in: args.
    down := self hasFlag: '--down' in: args.
    reason := self flagValue: '--reason' in: args.
    reason isNil ifTrue: [reason := ''].

    "Validate verdict flags BEFORE any network/write — no orphan/partial vote."
    err := self validateFeedbackUp: up down: down reason: reason.
    err notNil ifTrue: [('Refused: ', err) println. ^self].

    "Resolve the doctrine; refuse to write an orphan vote against an unknown id."
    self applyScopeFlagFrom: args.
    tuple := self rdpDoctrine: id.
    tuple isNil ifTrue: [
      ('Not found: ', id, ' — no vote recorded (refusing to orphan-vote).') println.
      ^self
    ].
    p := tuple at: 'payload' ifAbsent: [Dictionary new].

    "CANONICAL scope := the doctrine's own doctrine_scope (NOT the voter's repo)."
    dscope := p at: 'doctrine_scope' ifAbsent: ['global'].
    (dscope isNil or: [dscope isEmpty]) ifTrue: [dscope := 'global'].

    verdict := up ifTrue: ['up'] ifFalse: ['down'].
    payload := self feedbackPayloadForDoctrine: id scope: dscope verdict: verdict reason: reason.
    fbId := 'dfb-', ((ClaimId generate) at: 'hex').
    self writeFeedbackTuple: fbId scope: dscope payload: payload.

    key := p at: 'key' ifAbsent: [''].
    (key isNil or: [key isEmpty]) ifTrue: [key := id].
    ('recorded ', verdict, ' on doctrine "', key, '" (scope ', dscope, ', ', fbId, ')') println
  ]

  "--- crystallize: the loop-closing forward edge -----------------------

   doctrine --crystallized_into--> workitem. A doctrine entry that exposes a
   gap (or proposes a procedural/TTP/template change) spawns a derivative work
   item. This is the edge that CLOSES the OODA loop: a doctrine-detected gap
   re-enters the work queue, gets executed, generates new cases, and those
   cases feed the next synthesis pass.

   CHEAP + SAFE + REVERSIBLE: spawning a work item changes NOTHING about the
   doctrine's binding status — the doctrine stays exactly as mature/active/
   advisory as it was. The only mutation to the doctrine is an idempotent
   crystallized_into link (the forward provenance edge). To reverse, simply
   cancel the work item (pp workitem delete). No qualification gate is needed
   because no binding status changes."

  method: crystallizeWorkitemTitleFrom: payload doctrineId: id explicit: explicitTitle [
    "Resolve the spawned work item's title. An explicit --title wins; otherwise
     derive from the doctrine key (preferred, human-readable slug) or principle,
     prefixed so the lineage is obvious in a backlog listing."
    | key principle base |
    (explicitTitle notNil and: [explicitTitle isEmpty not]) ifTrue: [^explicitTitle].
    key := (payload at: 'key' ifAbsent: ['']).
    principle := (payload at: 'principle' ifAbsent: ['']).
    base := (key notNil and: [key isEmpty not]) ifTrue: [key] ifFalse: [principle].
    (base isNil or: [base isEmpty]) ifTrue: [base := id].
    ^'Crystallize doctrine: ', base
  ]

  method: crystallizeDescriptionFor: payload doctrineId: id linkScope: linkScope templateChange: templateChange [
    "Build the spawned work item's description. It EMBEDS the doctrine principle
     + rationale + a back-reference to the doctrine id, so the lineage is fully
     bidirectional (workitem -> doctrine -> cases) and an implementer can act on
     the work without re-reading the doctrine tuple."
    | principle rationale d |
    principle := payload at: 'principle' ifAbsent: [''].
    rationale := payload at: 'rationale' ifAbsent: [''].
    d := 'Crystallized from doctrine ', id, ' (the forward OODA-loop edge: a',
      ' doctrine-detected gap re-enters the work queue).', String lf, String lf.
    d := d, 'Principle:', String lf, principle, String lf, String lf.
    d := d, 'Rationale:', String lf, rationale, String lf, String lf.
    d := d, 'Back-reference: doctrine:', linkScope, ':', id, String lf.
    d := d, '(Lineage: workitem -> doctrine -> cases. This work item is cheap and',
      ' reversible — cancel it with `pp workitem delete` to undo. Spawning it does',
      ' NOT change the doctrine''s maturity or binding status.)', String lf.
    templateChange ifTrue: [
      d := d, String lf,
        'TEMPLATE CHANGE: this proposes a CUE template / procedural (TTP) change.',
        ' We do NOT auto-edit CUE templates — a human authors the CUE; this work',
        ' item merely proposes and tracks the change.', String lf].
    ^d
  ]

  method: crystallizeLabels: templateChange [
    "Labels for the spawned work item. Always tagged 'doctrine-crystallization'
     so the loop-closing provenance is filterable; 'template-change' is an extra
     flavor label when --template-change is passed."
    | labels |
    labels := Array new: 0.
    labels := labels copyWith: 'doctrine-crystallization'.
    templateChange ifTrue: [labels := labels copyWith: 'template-change'].
    ^labels
  ]

  method: appendWorkitemLink: payload scope: linkScope identity: wiId [
    "Idempotently append a crystallized_into {workitem, scope, identity} link to
     a doctrine payload, reusing DoctrineWriter>>linksOf: (story:forward-
     provenance) for NULL-TOLERANT reads. Mutates and returns the payload.

     CRITICAL: this touches ONLY crystallized_into (+ updated_at when a new link
     is actually added). It NEVER mutates maturity / promoted_at — crystallizing
     emits derivative work without changing the doctrine's binding status."
    | links exists |
    links := DoctrineWriter linksOf: payload.
    exists := false.
    links do: [:l |
      ((l isKindOf: Dictionary)
        and: [(l at: 'category' ifAbsent: [nil]) = 'workitem'
        and: [(l at: 'scope'    ifAbsent: [nil]) = linkScope
        and: [(l at: 'identity' ifAbsent: [nil]) = wiId]]])
          ifTrue: [exists := true]].
    exists ifFalse: [
      | link |
      link := Dictionary new.
      link at: 'category' put: 'workitem'.
      link at: 'scope'    put: linkScope.
      link at: 'identity' put: wiId.
      links := links copyWith: link.
      payload at: 'crystallized_into' put: links.
      payload at: 'updated_at' put: DateTime now epochSeconds].
    ^payload
  ]

  method: cmdCrystallize: args [
    "pp doctrine crystallize <id> --as workitem [--title T] [--type story|epic]
                                  [--repo R] [--template-change]
     Spawn a derivative work item from a doctrine entry and record the forward
     crystallized_into link on the doctrine. Reuses the workitem-create path
     (WorkItemCLI). Does NOT change the doctrine's maturity / binding status."
    | id as type explicitTitle templateChange tuple payload linkScope
      title desc labels wiId wiArgs |
    args size < 3 ifTrue: [
      'Usage: pp doctrine crystallize <id> --as workitem [--title T] [--type story|epic] [--repo R] [--template-change]' println.
      ^self
    ].
    id := args at: 3.
    as := self flagValue: '--as' in: args.
    as isNil ifTrue: [as := 'workitem'].
    as = 'convention' ifTrue: [^self crystallizeAsConvention: args].
    as = 'workitem' ifFalse: [
      ('Error: unsupported crystallization target --as ', as, '. Use --as workitem or --as convention.') println.
      ^self
    ].
    self applyScopeFlagFrom: args.
    type := self flagValue: '--type' in: args.
    type isNil ifTrue: [type := 'story'].
    (type = 'story' or: [type = 'epic']) ifFalse: [
      ('Error: --type must be story or epic (got ', type, ').') println.
      ^self
    ].
    explicitTitle := self flagValue: '--title' in: args.
    templateChange := args includes: '--template-change'.

    tuple := self rdpDoctrine: id.
    tuple isNil ifTrue: [('Not found: ', id) println. ^self].
    payload := tuple at: 'payload'.
    linkScope := self defaultScope.

    "Build the spawned work item from the doctrine."
    title := self crystallizeWorkitemTitleFrom: payload doctrineId: id explicit: explicitTitle.
    desc := self crystallizeDescriptionFor: payload doctrineId: id linkScope: linkScope templateChange: templateChange.
    labels := self crystallizeLabels: templateChange.
    wiId := 'wi-crystal-', ((ClaimId generate) at: 'hex').

    "Reuse the existing workitem-create plumbing (POST /api/workitem/create)."
    wiArgs := Array new: 0.
    wiArgs := wiArgs copyWith: 'workitem'.
    wiArgs := wiArgs copyWith: 'create'.
    wiArgs := wiArgs copyWith: wiId.
    wiArgs := wiArgs copyWith: '--title'.   wiArgs := wiArgs copyWith: title.
    wiArgs := wiArgs copyWith: '--type'.    wiArgs := wiArgs copyWith: type.
    wiArgs := wiArgs copyWith: '--repo'.    wiArgs := wiArgs copyWith: linkScope.
    wiArgs := wiArgs copyWith: '--description'. wiArgs := wiArgs copyWith: desc.
    wiArgs := wiArgs copyWith: '--label'.   wiArgs := wiArgs copyWith: (self joinArray: labels with: ',').
    WorkItemCLI new runWith: wiArgs.

    "Record the forward crystallized_into edge on the doctrine. Read-modify-write
     via the signed put path (same as maturity transitions), but appending ONLY
     the link — maturity / binding status is left untouched."
    self appendWorkitemLink: payload scope: linkScope identity: wiId.
    self putDoctrine: id payload: payload.

    ('crystallized doctrine ', id, ' -> workitem ', wiId, ' (', type, ', scope ', linkScope, ')',
      (templateChange ifTrue: [' [template-change]'] ifFalse: [''])) println.
    ('  reversible: pp workitem delete ', wiId, ' --repo ', linkScope, ' (doctrine binding status unchanged)') println
  ]

  method: cmdSetMaturity: args to: newMaturity [
    "pp doctrine promote|retire|reject <id> [--repo R] — read-modify-write maturity.
     Promote one + retire/reject duplicates is the human-merge discipline (the
     synthesis loop only ever writes fresh `proposed` entries)."
    | id tuple p now |
    args size < 3 ifTrue: [('Usage: pp doctrine ', newMaturity, ' <id>') println. ^self].
    id := args at: 3.
    self applyScopeFlagFrom: args.
    tuple := self rdpDoctrine: id.
    tuple isNil ifTrue: [('Not found: ', id) println. ^self].
    p := tuple at: 'payload'.
    now := DateTime now epochSeconds.
    p at: 'maturity' put: newMaturity.
    p at: 'updated_at' put: now.
    newMaturity = 'active' ifTrue: [p at: 'promoted_at' put: now].
    self putDoctrine: id payload: p.
    (id, ' -> ', newMaturity) println
  ]

  "--- crystallize: the RARE, human-only advisory -> binding transition -----

   A convention is BINDING (every agent obeys, execution-time, no judgment);
   doctrine is ADVISORY (situational). `crystallize` converts wisdom into law and
   is the ONLY verb that changes binding status. It is gated on a strict
   four-clause QUALIFICATION TEST and is human-only — never auto-fired, never
   Strategist-proposed. The friction is by design: a convention cannot be
   selectively ignored, so a wrong one taxes EVERY agent on EVERY task."

  method: hasFlag: flag in: args [
    "True if `flag` appears anywhere in args (boolean flag, no value).
     Unlike flagValue: this scans the FULL range incl. the last element."
    | i |
    i := 1.
    [i <= args size] whileTrue: [
      (args at: i) = flag ifTrue: [^true].
      i := i + 1
    ].
    ^false
  ]

  method: qualificationClauses [
    "The four-clause QUALIFICATION TEST (JP-1's 'requires judgment' clause
     removed). A doctrine qualifies for convention-hood ONLY if ALL FOUR hold.
     Each clause carries the flag that affirms it non-interactively, a terse
     title, and the longer explanation printed as friction."
    | clauses c |
    clauses := Array new: 0.

    c := Dictionary new.
    c at: 'flag'  put: '--affirm-unconditional'.
    c at: 'title' put: 'UNCONDITIONAL'.
    c at: 'text'  put: 'No situational branching. Contextual doctrine (scope/tag conditionality that affects WHETHER it applies, e.g. desert vs arctic) can NEVER be a convention. Conventions do not branch on situation.'.
    clauses := clauses copyWith: c.

    c := Dictionary new.
    c at: 'flag'  put: '--affirm-no-false-positive'.
    c at: 'title' put: 'ZERO FALSE-POSITIVE COST'.
    c at: 'text'  put: 'A convention cannot be selectively ignored; one that is wrong 10% of the time taxes every agent on every task. Obeying it when it does not strictly apply must cause no harm.'.
    clauses := clauses copyWith: c.

    c := Dictionary new.
    c at: 'flag'  put: '--affirm-mechanical'.
    c at: 'title' put: 'MECHANICALLY OBEYABLE'.
    c at: 'text'  put: 'An agent can comply without weighing tradeoffs. If application needs judgment, that judgment is exactly what a convention cannot carry.'.
    clauses := clauses copyWith: c.

    c := Dictionary new.
    c at: 'flag'  put: '--affirm-evidence'.
    c at: 'title' put: 'HIGH EVIDENCE'.
    c at: 'text'  put: 'Confidence near 1.0, multiple provenance cases, no contradicting cases.'.
    clauses := clauses copyWith: c.

    ^clauses
  ]

  method: missingAffirmations: args [
    "Return an Array of clauses whose affirm flag is NOT present in args."
    | missing |
    missing := Array new: 0.
    self qualificationClauses do: [:c |
      (self hasFlag: (c at: 'flag') in: args) ifFalse: [missing := missing copyWith: c]
    ].
    ^missing
  ]

  method: allAffirmed: args [
    "True only when ALL FOUR qualification clauses are affirmed via their flags."
    ^(self missingAffirmations: args) isEmpty
  ]

  method: printQualificationTest: doctrinePayload [
    "Print the four clauses (always — friction by design) for the operator to
     verify before affirming."
    | n |
    '' println.
    '=== CONVENTION CRYSTALLIZATION — QUALIFICATION TEST (human-only) ===' println.
    'Converting advisory doctrine into a BINDING convention. A convention is obeyed' println.
    'by EVERY agent on EVERY task with NO judgment. ALL FOUR clauses must hold:' println.
    '' println.
    n := 0.
    self qualificationClauses do: [:c |
      n := n + 1.
      ('  (', n printString, ') ', (c at: 'title'), '   [affirm with ', (c at: 'flag'), ']') println.
      ('       ', (c at: 'text')) println.
      '' println
    ]
  ]

  method: printMissingAffirmations: args [
    "Explain the refusal and exactly which flags are missing."
    | missing |
    missing := self missingAffirmations: args.
    'REFUSED: not all qualification clauses were affirmed (friction is by design).' println.
    'Each clause must be affirmed explicitly. Missing:' println.
    missing do: [:c |
      ('  - ', (c at: 'title'), ': re-run with ', (c at: 'flag')) println
    ].
    'Verify EVERY clause holds, then re-run with all four flags, e.g.:' println.
    '  pp doctrine crystallize <id> --as convention \' println.
    '    --affirm-unconditional --affirm-no-false-positive --affirm-mechanical --affirm-evidence' println
  ]

  method: conventionPayloadFrom: doctrinePayload doctrineId: dctrId [
    "Distill a BINDING convention payload from an advisory doctrine. The terse
     binding statement lives in payload.detail — the field the Role consumer
     renders into execution-time context (Role.mag:124) — and is the doctrine's
     principle. The doctrine keeps the 'why' (rationale). A crystallized_from
     back-link records lineage for reversal and provenance display."
    | p from |
    p := Dictionary new.
    p at: 'detail' put: (doctrinePayload at: 'principle' ifAbsent: ['']).
    p at: 'key' put: (doctrinePayload at: 'key' ifAbsent: ['']).
    p at: 'binding' put: true.
    p at: 'source' put: 'crystallized'.
    from := Dictionary new.
    from at: 'category' put: 'doctrine'.
    from at: 'scope'    put: self defaultScope.
    from at: 'identity' put: dctrId.
    p at: 'crystallized_from' put: from.
    p at: 'created_at' put: DateTime now epochSeconds.
    ^p
  ]

  method: putConvention: id scope: convScope payload: payload [
    "Write a BINDING convention via the PINNED put path — the SAME path existing
     conventions use (convention is in Categories>>pinned; Main>>seedConventions:
     writes them via outPinned:). Pinned so it is surfaced by
     `bbs scanAll: convention` (Role.mag:191); a LINEAR write would be invisible
     to the execution-time consumer and 'binding' would be a no-op. From this
     HTTP CLI we mirror that path by setting pinned:true on /api/bbs/put, whose
     handler routes pinned writes through bbs outPinned: (Server>>handleBBSPut:)."
    | body |
    body := Dictionary new.
    body at: 'category' put: 'convention'.
    body at: 'scope' put: convScope.
    body at: 'identity' put: id.
    body at: 'pinned' put: true.
    body at: 'payload' put: payload.
    ^CLIBase signedPost: '/api/bbs/put' body: body baseUrl: baseUrl
  ]

  method: rmConvention: id scope: convScope [
    "Remove a binding convention by composite key via the pinned-rm path."
    | body |
    body := Dictionary new.
    body at: 'category' put: 'convention'.
    body at: 'scope' put: convScope.
    body at: 'identity' put: id.
    ^CLIBase signedPost: '/api/bbs/rm' body: body baseUrl: baseUrl
  ]

  method: linkScopeFor: payload convention: convId [
    "Resolve the storage scope recorded in the crystallized_into link for
     convention `convId`, or nil if no such link exists. Lets decrystallize
     remove the convention at the scope it was written to, even if the operator's
     current --scope differs from the crystallize-time scope."
    | found |
    found := nil.
    (DoctrineWriter linksOf: payload) do: [:l |
      ((l isKindOf: Dictionary)
        and: [(l at: 'category' ifAbsent: [nil]) = 'convention'
        and: [(l at: 'identity' ifAbsent: [nil]) = convId]])
          ifTrue: [found := l at: 'scope' ifAbsent: [nil]]
    ].
    ^found
  ]

  method: crystallizeAsConvention: args [
    "pp doctrine crystallize <id> --as convention
         --affirm-unconditional --affirm-no-false-positive
         --affirm-mechanical --affirm-evidence [--repo R]

     HUMAN-ONLY. The RARE advisory -> binding transition. Refuses unless ALL FOUR
     qualification clauses are affirmed. On pass: writes a pinned convention
     distilled from the doctrine (visible to scanAll: convention) and records the
     forward crystallized_into link doctrine -> convention. The doctrine is NOT
     deleted or re-matured — it stays the rationale/lineage source (maturity
     untouched). This verb never auto-fires and is never Strategist-proposed."
    | id asTarget tuple p convId convPayload |
    args size < 3 ifTrue: [
      'Usage: pp doctrine crystallize <id> --as convention \' println.
      '         --affirm-unconditional --affirm-no-false-positive --affirm-mechanical --affirm-evidence' println.
      ^self
    ].
    id := args at: 3.
    self applyScopeFlagFrom: args.
    asTarget := self flagValue: '--as' in: args.
    asTarget isNil ifTrue: [asTarget := 'convention'].
    asTarget = 'convention' ifFalse: [
      ('Only --as convention is supported (got: ', asTarget, '). Convention is the only binding category.') println.
      ^self
    ].
    tuple := self rdpDoctrine: id.
    tuple isNil ifTrue: [('Not found: ', id) println. ^self].
    p := tuple at: 'payload'.

    "Precondition: only ACTIVE doctrine — matured wisdom — may become law."
    (p at: 'maturity' ifAbsent: ['']) = 'active' ifFalse: [
      ('Refusing: doctrine ', id, ' is not active (maturity=', (p at: 'maturity' ifAbsent: ['?']), ').') println.
      ('Only ACTIVE doctrine may crystallize into binding law. Promote it first: pp doctrine promote ', id) println.
      ^self
    ].

    "Print the four clauses (friction), then gate on full affirmation."
    self printQualificationTest: p.
    (self allAffirmed: args) ifFalse: [
      self printMissingAffirmations: args.
      ^self
    ].

    "PASS. Distill + write the pinned (binding) convention."
    convId := 'conv-', ((ClaimId generate) at: 'hex').
    convPayload := self conventionPayloadFrom: p doctrineId: id.
    self putConvention: convId scope: self defaultScope payload: convPayload.

    "Record the forward provenance edge on the doctrine (read-modify-write). The
     doctrine stays active; only crystallized_into grows."
    (DoctrineWriter appendLink: p category: 'convention' scope: self defaultScope identity: convId)
      ifTrue: [self putDoctrine: id payload: p].

    ('crystallized doctrine ', id, ' -> convention ', convId, ' (BINDING, pinned).') println.
    ('  detail: ', (convPayload at: 'detail')) println.
    'The doctrine remains active as the rationale/lineage source.' println.
    ('Reverse with: pp doctrine decrystallize ', id, ' --convention ', convId) println
  ]

  method: cmdDecrystallize: args [
    "pp doctrine decrystallize <id> --convention <convId> [--repo R]

     REVERSIBILITY: retire/remove the spawned convention AND clear the matching
     crystallized_into link, restoring the doctrine to purely-advisory. The
     doctrine itself is untouched (maturity stays active); only the binding
     artifact and its forward link are removed."
    | id convId tuple p rmScope removed |
    args size < 3 ifTrue: [
      'Usage: pp doctrine decrystallize <id> --convention <convId>' println.
      ^self
    ].
    id := args at: 3.
    self applyScopeFlagFrom: args.
    convId := self flagValue: '--convention' in: args.
    convId isNil ifTrue: [
      'Usage: pp doctrine decrystallize <id> --convention <convId>' println.
      ^self
    ].
    tuple := self rdpDoctrine: id.
    tuple isNil ifTrue: [('Not found: ', id) println. ^self].
    p := tuple at: 'payload'.

    "Remove the binding convention at the scope recorded in its forward link
     (falling back to the resolved scope if the link is absent)."
    rmScope := self linkScopeFor: p convention: convId.
    rmScope isNil ifTrue: [rmScope := self defaultScope].
    self rmConvention: convId scope: rmScope.

    "Clear the forward link (read-modify-write). Tolerate an already-absent link."
    removed := DoctrineWriter removeLink: p category: 'convention' scope: rmScope identity: convId.
    removed ifTrue: [self putDoctrine: id payload: p].

    ('decrystallized: retired convention ', convId, '; doctrine ', id, ' is purely advisory again.') println.
    removed ifFalse: ['(note: no matching crystallized_into link was present.)' println]
  ]

  method: cmdExport: args [
    "pp doctrine export — STUB. Export promoted ('active') doctrine to pudl as a
     downstream sink. Deliberately NOT implemented: there is zero pp->pudl
     integration today and the target tool/protocol is undefined (the on-PATH
     'pudl' is an unrelated data-lake CLI with no doctrine schema). Doctrine stays
     LOOSELY coupled — PP owns it; pudl is a future export sink, never a read
     dependency (preserves plan-time autonomy under comms-denial). See
     docs/design-doctrine-layer.md."
    | active |
    active := 0.
    self scanDoctrine do: [:t |
      ((t at: 'payload' ifAbsent: [Dictionary new]) at: 'maturity' ifAbsent: ['']) = 'active'
        ifTrue: [active := active + 1]
    ].
    'pp doctrine export — STUB (not yet implemented).' println.
    ('Would export ', active printString, ' active doctrine entries from scope ', self defaultScope, ' to pudl.') println.
    'No pp->pudl integration exists yet; target protocol undefined. This is an' println.
    'intentional placeholder so the loose-coupling boundary stays explicit.' println
  ]

  method: printUsage [
    'pp doctrine — manage doctrine (the plan-time Orient layer)' println.
    '' println.
    'Commands:' println.
    '  list [--scope S] [--tag T] [--maturity M]    List doctrine entries' println.
    '  show <id> [--scope S]                         Show one entry' println.
    '  propose "<principle>" [--rationale R] [--applies global|repo|repo:path]' println.
    '                        [--tags t1,t2] [--confidence C] [--key name]' println.
    '  feedback <id> --up|--down [--reason R]       Record an append-only vote on a doctrine. Exactly one of' println.
    '                        --up/--down (--reason REQUIRED on --down); written at the doctrine''s canonical' println.
    '                        doctrine_scope and auto-attributed to PP_TASK/PP_WORKFLOW (or ''manual'').' println.
    '  synthesize [--repo R]                        Enqueue a Strategist to propose doctrine from cases' println.
    '  crystallize <id> --as workitem [--title T] [--type story|epic] [--repo R] [--template-change]' println.
    '                        Spawn a derivative work item from doctrine (the loop-closing forward edge):' println.
    '                        embeds the principle + rationale + a back-ref to <id>, and records the' println.
    '                        crystallized_into link. CHEAP + REVERSIBLE (cancel the work item to undo);' println.
    '                        does NOT change the doctrine''s maturity/binding status. --template-change adds' println.
    '                        a ''template-change'' label — a human writes the CUE, this work item proposes it.' println.
    '  export                                       (stub) export active doctrine to pudl — not yet implemented' println.
    '  promote <id>                                  maturity -> active' println.
    '  retire  <id>                                  maturity -> retired' println.
    '  reject  <id>                                  maturity -> rejected' println.
    '  crystallize <id> --as convention             HUMAN-ONLY: advisory -> BINDING convention' println.
    '       --affirm-unconditional --affirm-no-false-positive' println.
    '       --affirm-mechanical --affirm-evidence    (all four required; friction by design)' println.
    '  decrystallize <id> --convention <convId>     reverse: retire convention + clear link' println.
    ^self
  ]
