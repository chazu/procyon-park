"MissionCLI — manage missions: the high-level Auftragstaktik intent artifact.

 A mission captures an operator's brief, the researched intent, and a
 human-reviewed plan. It matures through a status lifecycle:
   researching -> awaiting-approval -> approved | rejected -> archived
 `archived` is TERMINAL (symmetric with doctrine maturity:retired) — reached via
 `pp mission archive` from approved/rejected/researching (never from
 awaiting-approval). The tuple is preserved (no delete).
 `pp mission start` kicks the 'mission-brief' workflow (added in W2), which
 researches the brief and writes the intent/plan back into THIS mission tuple;
 a human then approves or rejects the resulting plan.

 Built entirely on the generic BBS endpoints — no mission-specific server routes:
   reads  : POST /api/scan, /api/rdp  (unsigned, non-consuming)
   writes : POST /api/bbs/put          (ed25519-signed via CLIBase)

 Mission is LINEAR + DURABLE (Categories>>isDurableCategory:), never pinned —
 writes pass modality:'linear' so entries stay visible to rdp:. Each mission
 gets a fresh unique identity (msn-<hex>). Status flips are read-modify-write
 via the signed put path (upsert keyed by identity), mirroring doctrine."

MissionCLI subclass: Object
  instanceVars: baseUrl scope

  classMethod: new [
    ^super new initialize
  ]

  method: initialize [
    baseUrl := System env: 'PP_URL'.
    (baseUrl isNil or: [baseUrl isEmpty]) ifTrue: [baseUrl := 'http://localhost:7777'].
    scope := System env: 'PP_SCOPE'.
    (scope isNil or: [scope isEmpty]) ifTrue: [scope := nil]
  ]

  method: defaultScope [
    ^scope isNil ifTrue: ['default'] ifFalse: [scope]
  ]

  "--- argument parsing ------------------------------------------------"

  method: flagValue: flag in: args [
    "Return the value following <flag> in args, or nil."
    | i |
    i := 1.
    [i < args size] whileTrue: [
      (args at: i) = flag ifTrue: [^args at: i + 1].
      i := i + 1
    ].
    ^nil
  ]

  method: applyScopeFlagFrom: args [
    "Resolve the BBS storage scope from --repo/--scope, mutating `scope`."
    | r |
    r := self flagValue: '--repo' in: args.
    r isNil ifTrue: [r := self flagValue: '--scope' in: args].
    r notNil ifTrue: [scope := r]
  ]

  method: runWith: args [
    "Dispatch pp mission subcommands."
    | sub |
    args size < 2 ifTrue: [^self printUsage].
    sub := args at: 2.
    sub = 'start'      ifTrue: [^self cmdStart: args].
    sub = 'list'       ifTrue: [^self cmdList: args].
    sub = 'show'       ifTrue: [^self cmdShow: args].
    sub = 'set-intent' ifTrue: [^self cmdSetIntent: args].
    sub = 'set-plan'   ifTrue: [^self cmdSetPlan: args].
    sub = 'set-breakdown' ifTrue: [^self cmdSetBreakdown: args].
    sub = 'approve'    ifTrue: [^self cmdApprove: args].
    sub = 'reject'     ifTrue: [^self cmdReject: args].
    sub = 'archive'    ifTrue: [^self cmdArchive: args].
    sub = 'run'        ifTrue: [^self cmdRun: args].
    sub = 'nuke'       ifTrue: [^self cmdNuke: args].
    (sub = 'help' or: [sub = '--help']) ifTrue: [^self printUsage].
    ('Unknown mission command: ', sub) println.
    self printUsage
  ]

  "--- reads (unsigned, non-consuming) --------------------------------"

  method: scanMissions [
    "Return an Array of mission tuples in the resolved scope (best-effort)."
    | sc response result |
    sc := self defaultScope.
    [
      response := Shell capture: 'curl -s -X POST ', baseUrl, '/api/scan -H "Content-Type: application/json" -d ''{"category":"mission","scope":"', sc, '"}'''.
      (response isNil or: [response isEmpty]) ifTrue: [^Array new: 0].
      result := Json decode: response.
      ^result at: 'tuples' ifAbsent: [Array new: 0]
    ] on: Exception do: [:e | ^Array new: 0]
  ]

  method: rdpMission: id [
    "Return one mission tuple by identity, or nil."
    | response result |
    [
      response := Shell capture: 'curl -s -X POST ', baseUrl, '/api/rdp -H "Content-Type: application/json" -d ''{"category":"mission","scope":"', self defaultScope, '","identity":"', id, '"}'''.
      (response isNil or: [response isEmpty]) ifTrue: [^nil].
      result := Json decode: response.
      ^result at: 'tuple' ifAbsent: [nil]
    ] on: Exception do: [:e | ^nil]
  ]

  method: rdpTemplate: tid scope: aScope [
    "Return one template tuple by identity in aScope, or nil (best-effort)."
    | response result |
    [
      response := Shell capture: 'curl -s -X POST ', baseUrl, '/api/rdp -H "Content-Type: application/json" -d ''{"category":"template","scope":"', aScope, '","identity":"', tid, '"}'''.
      (response isNil or: [response isEmpty]) ifTrue: [^nil].
      result := Json decode: response.
      ^result at: 'tuple' ifAbsent: [nil]
    ] on: Exception do: [:e | ^nil]
  ]

  "--- writes (signed) -------------------------------------------------"

  method: putMission: id payload: payload [
    "Signed upsert of a mission tuple as linear (durable, rdp-visible)."
    | body |
    body := Dictionary new.
    body at: 'category' put: 'mission'.
    body at: 'scope' put: self defaultScope.
    body at: 'identity' put: id.
    body at: 'modality' put: 'linear'.
    body at: 'payload' put: payload.
    ^CLIBase signedPost: '/api/bbs/put' body: body baseUrl: baseUrl
  ]

  "--- workflow launch -------------------------------------------------"

  method: missionTemplatePresent [
    "True when the 'mission-brief' workflow template exists (system scope,
     falling back to the mission's repo scope). Network/parse-tolerant — on any
     failure returns false so `start` degrades to a graceful warning rather than
     a crash. Overridable test seam."
    | t |
    t := self rdpTemplate: 'mission-brief' scope: 'system'.
    t isNil ifTrue: [t := self rdpTemplate: 'mission-brief' scope: self defaultScope].
    ^t notNil
  ]

  method: startWorkflowBrief: brief missionId: id [
    "Signed POST /api/workflow/start for the 'mission-brief' template, passing
     the brief as the `description` param AND the `mission` id (so the workflow's
     agents write their intent/plan back into THIS mission tuple). Returns the
     new workflow instance id, or nil on failure. Overridable test seam."
    | params body response result |
    params := Dictionary new.
    params at: 'description' put: brief.
    params at: 'mission' put: id.
    params at: 'repo' put: self defaultScope.
    body := Dictionary new.
    body at: 'template' put: 'mission-brief'.
    body at: 'scope' put: self defaultScope.
    body at: 'params' put: params.
    response := CLIBase signedPost: '/api/workflow/start' body: body baseUrl: baseUrl.
    (response isNil or: [(response isKindOf: String) not or: [response isEmpty]]) ifTrue: [^nil].
    result := nil.
    [result := Json decode: response] on: Exception do: [:e | ^nil].
    (result isKindOf: Dictionary) ifFalse: [^nil].
    ^result at: 'workflow_id' ifAbsent: [nil]
  ]

  method: launchMissionBrief: brief missionId: id [
    "Kick the 'mission-brief' workflow for this mission. Returns the workflow
     instance id, or nil. If the template is not present (e.g. before the W2
     workflow lands) warn gracefully and return nil rather than crashing."
    self missionTemplatePresent ifFalse: [
      'Note: the ''mission-brief'' workflow template is not present yet — created the' println.
      '      mission but did NOT launch a workflow. Re-run once the template is installed.' println.
      ^nil
    ].
    ^self startWorkflowBrief: brief missionId: id
  ]

  "--- commands --------------------------------------------------------"

  method: cmdStart: args [
    "pp mission start <brief> [--repo R]"
    | brief id payload wfId |
    args size < 3 ifTrue: [
      'Usage: pp mission start "<brief>" [--repo R]' println.
      ^self
    ].
    brief := args at: 3.
    self applyScopeFlagFrom: args.

    id := 'msn-', ((ClaimId generate) at: 'hex').
    payload := Dictionary new.
    payload at: 'brief' put: brief.
    payload at: 'intent' put: nil.
    payload at: 'plan' put: nil.
    payload at: 'status' put: 'researching'.
    payload at: 'workflow_instance' put: nil.
    payload at: 'created_at' put: DateTime now epochSeconds.
    self putMission: id payload: payload.

    "Launch the mission-brief workflow (graceful if the template is absent)."
    wfId := self launchMissionBrief: brief missionId: id.
    wfId notNil ifTrue: [
      "Record the workflow instance on the mission (read-modify-write)."
      payload at: 'workflow_instance' put: wfId.
      self putMission: id payload: payload
    ].

    ('mission ', id, ' created (status researching, scope ', self defaultScope, ')') println.
    wfId notNil ifTrue: [('  workflow: ', wfId) println].
    ('  watch the dashboard: pp dashboard   (or: pp mission show ', id, ')') println
  ]

  method: cmdList: args [
    "pp mission list [--repo R] [--status S]"
    | statusFilter missions shown |
    self applyScopeFlagFrom: args.
    statusFilter := self flagValue: '--status' in: args.
    missions := self scanMissions.
    shown := 0.
    missions do: [:m |
      | p st brief ok |
      p := m at: 'payload' ifAbsent: [Dictionary new].
      st := p at: 'status' ifAbsent: ['?'].
      ok := true.
      (statusFilter notNil and: [(st = statusFilter) not]) ifTrue: [ok := false].
      ok ifTrue: [
        brief := self oneLine: (p at: 'brief' ifAbsent: ['']).
        ((m at: 'identity' ifAbsent: ['?']), '  [', st, ']  ', brief) println.
        shown := shown + 1
      ]
    ].
    shown = 0 ifTrue: ['(no missions match)' println]
  ]

  method: cmdShow: args [
    "pp mission show <id> [--repo R]"
    | id m p |
    args size < 3 ifTrue: ['Usage: pp mission show <id> [--repo R]' println. ^self].
    id := args at: 3.
    self applyScopeFlagFrom: args.
    m := self rdpMission: id.
    m isNil ifTrue: ['Not found.' println. ^self].
    p := m at: 'payload' ifAbsent: [Dictionary new].
    ('id:      ', (m at: 'identity' ifAbsent: [id])) println.
    ('status:  ', (p at: 'status' ifAbsent: ['?'])) println.
    ('brief:   ', (self orNone: (p at: 'brief' ifAbsent: [nil]))) println.
    ('intent:  ', (self orNone: (p at: 'intent' ifAbsent: [nil]))) println.
    ('plan:    ', (self orNone: (p at: 'plan' ifAbsent: [nil]))) println.
    ((p at: 'breakdown' ifAbsent: [nil]) notNil and: [(p at: 'breakdown') isKindOf: Array]) ifTrue: [
      ('breakdown: ', (p at: 'breakdown') size printString, ' item(s)') println
    ].
    (p at: 'epic_id' ifAbsent: [nil]) notNil ifTrue: [
      ('epic:    ', (p at: 'epic_id')) println
    ].
    (p at: 'reason' ifAbsent: [nil]) notNil ifTrue: [
      ('reason:  ', (p at: 'reason')) println
    ]
  ]

  "--- agent writeback (used by the mission-brief workflow) ------------"

  method: cmdSetIntent: args [
    "pp mission set-intent <id> <intent-markdown> [--repo R]
     Read-modify-write of payload.intent — preserves brief/status/plan. Used by
     the mission-brief workflow's interpret-intent (planner) task to record the
     STRUCTURED INTENT it extracted from the brief, back into THIS mission tuple."
    | id intent m p |
    args size < 4 ifTrue: [
      'Usage: pp mission set-intent <id> "<intent markdown>" [--repo R]' println.
      ^self
    ].
    id := args at: 3.
    intent := args at: 4.
    self applyScopeFlagFrom: args.
    m := self rdpMission: id.
    m isNil ifTrue: [('Not found: ', id) println. ^self].
    p := m at: 'payload' ifAbsent: [Dictionary new].
    p at: 'intent' put: intent.
    p at: 'updated_at' put: DateTime now epochSeconds.
    self putMission: id payload: p.
    (id, ' intent updated') println
  ]

  method: cmdSetPlan: args [
    "pp mission set-plan <id> <plan-markdown> [--repo R]
     Read-modify-write that writes payload.plan AND flips status to
     'awaiting-approval' in one step — the terminal write of the mission-brief
     workflow's synthesize-plan (planner) task. Preserves brief/intent. The plan
     is stored AS MARKDOWN so the dashboard renders it without the filesystem."
    | id plan m p |
    args size < 4 ifTrue: [
      'Usage: pp mission set-plan <id> "<plan markdown>" [--repo R]' println.
      ^self
    ].
    id := args at: 3.
    plan := args at: 4.
    self applyScopeFlagFrom: args.
    m := self rdpMission: id.
    m isNil ifTrue: [('Not found: ', id) println. ^self].
    p := m at: 'payload' ifAbsent: [Dictionary new].
    p at: 'plan' put: plan.
    p at: 'status' put: 'awaiting-approval'.
    p at: 'updated_at' put: DateTime now epochSeconds.
    self putMission: id payload: p.
    (id, ' plan written, status -> awaiting-approval') println
  ]

  method: cmdSetBreakdown: args [
    "pp mission set-breakdown <id> <json-array> [--repo R]
     Read-modify-write of payload.breakdown — the STRUCTURED work-item breakdown
     the human reviews at the approval gate and the dispatcher materializes into
     a story tree on approve (D2). <json-array> is a JSON array of objects:
       [{title, description, wave, depends_on:[<1-based idx>...], template, estimate}]
     depends_on entries are 1-based indices into THIS array (a story's
     dependencies on its siblings). Used by the mission-brief workflow's
     synthesize-plan (planner) task, alongside set-plan. Preserves brief/intent/
     plan/status — it does NOT flip the gate."
    | id raw parsed m p |
    args size < 4 ifTrue: [
      'Usage: pp mission set-breakdown <id> ''[{"title":"...","wave":1,"depends_on":[]}]'' [--repo R]' println.
      ^self
    ].
    id := args at: 3.
    raw := args at: 4.
    self applyScopeFlagFrom: args.
    parsed := nil.
    [parsed := Json decode: raw] on: Exception do: [:e |
      ('Refused: breakdown is not valid JSON: ', e messageText) println. ^self
    ].
    (parsed isKindOf: Array) ifFalse: [
      'Refused: breakdown must be a JSON ARRAY of {title,wave,depends_on,...} objects.' println. ^self
    ].
    m := self rdpMission: id.
    m isNil ifTrue: [('Not found: ', id) println. ^self].
    p := m at: 'payload' ifAbsent: [Dictionary new].
    p at: 'breakdown' put: parsed.
    p at: 'updated_at' put: DateTime now epochSeconds.
    self putMission: id payload: p.
    (id, ' breakdown updated (', parsed size printString, ' item(s))') println
  ]

  method: cmdApprove: args [
    "pp mission approve <id> [--repo R] — awaiting-approval -> approved."
    ^self setStatusFor: args to: 'approved' reason: nil action: 'approve' allowedFrom: #('awaiting-approval')
  ]

  method: cmdReject: args [
    "pp mission reject <id> [--reason R] [--repo R] — awaiting-approval -> rejected."
    | reason |
    reason := self flagValue: '--reason' in: args.
    ^self setStatusFor: args to: 'rejected' reason: reason action: 'reject' allowedFrom: #('awaiting-approval')
  ]

  method: cmdArchive: args [
    "pp mission archive <id> [--reason R] [--repo R] — retire a decided/researching
     mission into the terminal `archived` status (symmetric with doctrine
     maturity:retired). Archivable from approved/rejected/researching; NOT from
     awaiting-approval (a pending plan gate must be decided before it is retired).
     The tuple is preserved (no delete) — missions are linear + durable."
    | reason |
    reason := self flagValue: '--reason' in: args.
    ^self setStatusFor: args to: 'archived' reason: reason action: 'archive'
      allowedFrom: #('approved' 'rejected' 'researching' 'done')
  ]

  method: cmdRun: args [
    "pp mission run <id> [--repo R] — execute an approved, decomposed mission.
     The D5 second trigger: dispatch the mission's epic via full-pipeline
     (dispatch-waves over the child stories) and roll the mission to
     'in-progress'. Only an approved mission whose epic has been materialized may
     run. Posts to the loopback-gated /api/mission/run (same posture as the
     dashboard Execute control), so run it against a LOCAL server.

     `sc` (a local), NOT `scope` (the ivar): a local colliding with an ivar is
     invisible inside the block below in this VM."
    | id sc response result |
    args size < 3 ifTrue: ['Usage: pp mission run <id> [--repo R]' println. ^self].
    id := args at: 3.
    self applyScopeFlagFrom: args.
    sc := self defaultScope.
    [
      response := Shell capture: 'curl -s -X POST ''', baseUrl, '/api/mission/run?scope=', sc, '&identity=', id, ''''.
      (response isNil or: [response isEmpty]) ifTrue: [('No response from ', baseUrl) println. ^self].
      result := Json decode: response.
      (result at: 'error' ifAbsent: [nil]) notNil ifTrue: [
        ('Refused: ', (result at: 'error')) println. ^self
      ].
      ((result at: 'status' ifAbsent: [nil]) = 'ok')
        ifTrue: [(id, ' -> in-progress (dispatched via workflow ', (result at: 'workflow' ifAbsent: ['?']), ')') println]
        ifFalse: [('Unexpected response: ', response) println]
    ] on: Exception do: [:e | ('mission run failed: ', e messageText) println]
  ]

  method: cmdNuke: args [
    "pp mission nuke <id> [--repo R] [--confirm]
     Tear down the blast radius a mission spawned: every entity stamped with
     this mission_id. DRY-RUN BY DEFAULT — it prints the full blast radius and
     changes nothing; a real teardown requires the explicit --confirm flag.

     BOUNDARY (Phase B v1): reclaims the mission's UNMERGED planning artifacts —
     the work-items it created (epic + any stories). Merged commits are NEVER
     touched by nuke (reverting merged code is a deliberate `git revert`, not an
     auto-cascade). A real run also archives the mission so reconciliation does
     not re-spawn the epic. Later slices extend the cascade to workflows/tasks/
     worktrees as those become mission-stamped."
    "`msnScope` (a local), NOT `scope` (the instance var): a local that collides
     with the `scope` ivar is not visible inside the `items do:` teardown block
     below in this VM — the block would read the nil ivar and delete with a nil
     scope. Same collision that silently broke workitemsForMission."
    | id confirm m mp msnScope items wfs |
    args size < 3 ifTrue: ['Usage: pp mission nuke <id> [--repo R] [--confirm]' println. ^self].
    id := args at: 3.
    self applyScopeFlagFrom: args.
    confirm := args includes: '--confirm'.
    m := self rdpMission: id.
    m isNil ifTrue: [('Not found: ', id) println. ^self].
    mp := m at: 'payload' ifAbsent: [Dictionary new].
    msnScope := m at: 'scope' ifAbsent: [self defaultScope].

    wfs := self runningWorkflowsForMission: id scope: msnScope.
    items := self workitemsForMission: id scope: msnScope.

    ('Mission ', id, ' blast radius (scope ', msnScope, '):') println.
    wfs do: [:w |
      ('  workflow  ', (w at: 'identity' ifAbsent: ['?']),
        '  [', ((w at: 'payload' ifAbsent: [Dictionary new]) at: 'status' ifAbsent: ['?']), '] -> cancel (+ children)') println
    ].
    items isEmpty
      ifTrue: ['  (no mission-stamped work-items)' println]
      ifFalse: [
        items do: [:t |
          | tp |
          tp := t at: 'payload' ifAbsent: [Dictionary new].
          ('  workitem  ', (t at: 'identity' ifAbsent: ['?']),
            '  [', (tp at: 'type' ifAbsent: ['?']), '] [', (tp at: 'status' ifAbsent: ['?']), ']  ',
            (self oneLine: (tp at: 'title' ifAbsent: ['']))) println
        ]
      ].
    ('  mission tuple ', id, ' -> archived (status ', (mp at: 'status' ifAbsent: ['?']), ')') println.

    confirm ifFalse: [
      '' println.
      ('DRY RUN — nothing changed. Re-run with --confirm to cancel ',
        wfs size printString, ' workflow(s), tear down ',
        items size printString, ' work-item(s), and archive the mission.') println.
      ^self
    ].

    "--- real teardown (--confirm) ---"
    "Cancel running workflows FIRST (cancel cascades to their children), so the
     dispatcher stops advancing them before their work-items vanish."
    wfs do: [:w |
      self cancelMissionWorkflow: (w at: 'identity' ifAbsent: [nil]) scope: msnScope
    ].
    items do: [:t |
      self deleteWorkitem: (t at: 'identity' ifAbsent: [nil]) scope: msnScope
    ].
    "Archive the mission and drop the epic pointer so the reconciliation guard
     (status='approved') no longer fires. archived is terminal; the tuple is
     preserved (missions are never hard-deleted)."
    mp at: 'status' put: 'archived'.
    mp at: 'epic_id' put: nil.
    mp at: 'reason' put: 'nuked'.
    mp at: 'nuked_at' put: DateTime now epochSeconds.
    mp at: 'updated_at' put: DateTime now epochSeconds.
    self putMission: id payload: mp.
    ('Nuked mission ', id, ': ', wfs size printString, ' workflow(s) cancelled, ',
      items size printString, ' work-item(s) deleted, mission archived.') println
  ]

  method: runningWorkflowsForMission: missionId scope: sc [
    "Workflows launched for this mission that are still running. A run-triggered
     full-pipeline carries payload.params.mission = <mission id>; cancelling the
     top-level ones cascades to their child workflows/tasks server-side. Only
     status='running' are returned (terminal ones need no cancel). Best-effort:
     empty on any network/parse error. Params are `missionId`/`sc`, not `scope`,
     to dodge the ivar/block-shadow trap."
    | response result tuples hits |
    hits := Array new: 0.
    [
      response := Shell capture: 'curl -s -X POST ', baseUrl, '/api/scan -H "Content-Type: application/json" -d ''{"category":"workflow","scope":"', sc, '"}'''.
      (response isNil or: [response isEmpty]) ifTrue: [^hits].
      result := Json decode: response.
      tuples := result at: 'tuples' ifAbsent: [Array new: 0].
      tuples do: [:t |
        | tp params |
        tp := t at: 'payload' ifAbsent: [Dictionary new].
        params := tp at: 'params' ifAbsent: [Dictionary new].
        (((params at: 'mission' ifAbsent: [nil]) = missionId)
          and: [(tp at: 'status' ifAbsent: ['?']) = 'running']) ifTrue: [
          hits := hits copyWith: t
        ]
      ]
    ] on: Exception do: [:e | ^hits].
    ^hits
  ]

  method: cancelMissionWorkflow: wfId scope: sc [
    "Signed cancel of one workflow (the server cancels its children recursively).
     No-op on a nil id. Best-effort — a failed cancel is reported but does not
     abort the rest of the teardown. Param is `sc` to avoid the scope-ivar/block
     collision."
    | body |
    wfId isNil ifTrue: [^self].
    body := Dictionary new.
    body at: 'workflow_id' put: wfId.
    body at: 'scope' put: sc.
    body at: 'reason' put: 'mission nuke'.
    [CLIBase signedPost: '/api/workflow/cancel' body: body baseUrl: baseUrl]
      on: Exception do: [:e | ('  (cancel failed for ', wfId, ': ', e messageText, ')') println]
  ]

  method: workitemsForMission: missionId scope: sc [
    "All 'workitem' tuples in `sc` whose payload.mission_id = missionId. Filters
     client-side over a category scan — the ganso ix_mission index backs the
     equivalent server-side query when a later slice needs it. Best-effort:
     returns empty on any network/parse error.

     NB: the params are `missionId`/`sc`, NOT `scope` — a method arg that
     collides with the `scope` INSTANCE VAR is not visible inside a nested block
     in this VM (the block closes over the nil ivar instead), so building the
     curl string here with a `scope` arg silently threw primConcat."
    | response result tuples hits |
    hits := Array new: 0.
    [
      response := Shell capture: 'curl -s -X POST ', baseUrl, '/api/scan -H "Content-Type: application/json" -d ''{"category":"workitem","scope":"', sc, '"}'''.
      (response isNil or: [response isEmpty]) ifTrue: [^hits].
      result := Json decode: response.
      tuples := result at: 'tuples' ifAbsent: [Array new: 0].
      tuples do: [:t |
        ((t at: 'payload' ifAbsent: [Dictionary new]) at: 'mission_id' ifAbsent: [nil]) = missionId ifTrue: [
          hits := hits copyWith: t
        ]
      ]
    ] on: Exception do: [:e | ^hits].
    ^hits
  ]

  method: deleteWorkitem: wid scope: sc [
    "Signed hard-delete of one work-item (cascade: descendants go too). No-op on
     a nil id. Best-effort — a failed delete is reported but does not abort the
     rest of the teardown. Param is `sc` to avoid the `scope`-ivar/block collision."
    | body |
    wid isNil ifTrue: [^self].
    body := Dictionary new.
    body at: 'identity' put: wid.
    body at: 'scope' put: sc.
    body at: 'cascade' put: true.
    [CLIBase signedPost: '/api/workitem/delete' body: body baseUrl: baseUrl]
      on: Exception do: [:e | ('  (delete failed for ', wid, ': ', e messageText, ')') println]
  ]

  method: setStatusFor: args to: newStatus reason: reason action: action allowedFrom: allowedFrom [
    "Guarded read-modify-write of a mission's status. The transition is refused
     unless the mission's CURRENT status is a member of `allowedFrom` — the single
     signed-write path shared by approve/reject (allowedFrom {awaiting-approval})
     and archive (allowedFrom {approved, rejected, researching}). The guard keeps
     the plan gate from being flipped before a plan exists, and keeps `archived`
     terminal (approve/reject never list it in allowedFrom)."
    | id m p cur |
    args size < 3 ifTrue: [
      ('Usage: pp mission ', action, ' <id>',
        ((action = 'reject' or: [action = 'archive']) ifTrue: [' [--reason R]'] ifFalse: [''])) println.
      ^self
    ].
    id := args at: 3.
    self applyScopeFlagFrom: args.
    m := self rdpMission: id.
    m isNil ifTrue: [('Not found: ', id) println. ^self].
    p := m at: 'payload' ifAbsent: [Dictionary new].
    cur := p at: 'status' ifAbsent: ['?'].
    (allowedFrom includes: cur) ifFalse: [
      ('Refused: mission ', id, ' is ', cur, ' — only ',
        (self joinStatuses: allowedFrom), ' missions can be ', newStatus, '.') println.
      ^self
    ].
    p at: 'status' put: newStatus.
    reason notNil ifTrue: [p at: 'reason' put: reason].
    p at: 'updated_at' put: DateTime now epochSeconds.
    self putMission: id payload: p.
    (id, ' -> ', newStatus, (reason notNil ifTrue: [' (', reason, ')'] ifFalse: [''])) println
  ]

  method: joinStatuses: statuses [
    "Human-readable 'a/b/c' join of an allowed-from status set for refusal
     messages — names exactly which statuses permit the requested transition."
    | s first |
    s := ''.
    first := true.
    statuses do: [:st |
      first ifTrue: [s := st. first := false] ifFalse: [s := s, '/', st]
    ].
    ^s
  ]

  "--- helpers ---------------------------------------------------------"

  method: oneLine: s [
    "Collapse a (possibly multi-line) brief to a single truncated line."
    | str cut |
    str := s isNil ifTrue: [''] ifFalse: [s].
    (str isKindOf: String) ifFalse: [str := str printString].
    cut := str indexOf: String lf.
    cut > 0 ifTrue: [str := str copyFrom: 1 to: cut - 1].
    str size > 70 ifTrue: [str := (str copyFrom: 1 to: 67), '...'].
    ^str
  ]

  method: orNone: aVal [
    "Render a payload field for `show`: nil/empty -> '(none)'; a String verbatim;
     anything else via printString (a plan may be a structured value)."
    aVal isNil ifTrue: [^'(none)'].
    (aVal isKindOf: String) ifTrue: [
      aVal isEmpty ifTrue: [^'(none)'].
      ^aVal
    ].
    ^aVal printString
  ]

  method: printUsage [
    'pp mission — manage missions (high-level Auftragstaktik intent artifacts)' println.
    '' println.
    'Commands:' println.
    '  start "<brief>" [--repo R]      Create a mission and kick the mission-brief workflow' println.
    '  list [--repo R] [--status S]    List missions (id, status, one-line brief)' println.
    '  show <id> [--repo R]            Show brief, intent, status, and plan' println.
    '  set-intent <id> "<md>" [--repo R]   Write structured intent (workflow agents)' println.
    '  set-plan <id> "<md>" [--repo R]     Write plan + flip to awaiting-approval (workflow agents)' println.
    '  set-breakdown <id> "<json>" [--repo R]  Write structured work-item breakdown (materialized on approve)' println.
    '  approve <id> [--repo R]         awaiting-approval -> approved' println.
    '  reject <id> [--reason R] [--repo R]   awaiting-approval -> rejected (+ reason)' println.
    '  archive <id> [--reason R] [--repo R]  approved|rejected|researching -> archived (terminal)' println.
    '  run <id> [--repo R]                   Execute an approved+decomposed mission (dispatch via full-pipeline)' println.
    '  nuke <id> [--repo R] [--confirm]      Tear down the mission blast radius (dry-run unless --confirm)' println.
    '' println.
    'Lifecycle: researching -> awaiting-approval -> approved | rejected -> archived' println.
    '           approved -> (run) -> in-progress -> done -> archived' println.
    'On approve the dispatcher materializes an epic + story tree (stamped mission_id);' println.
    '`run` dispatches it; the mission rolls up to done as its work-items complete;' println.
    'nuke reclaims the whole blast radius (cancels workflows + deletes work-items).' println.
    ^self
  ]
