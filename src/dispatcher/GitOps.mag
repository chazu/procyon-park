"GitOps — utility class wrapping common git operations for WorkflowEngine.
 Methods that are critical to workflow correctness signal Error on failure.
 Cleanup helpers only warn.

 Every git invocation is bounded by a wall-clock timeout via
 `Shell runChecked:timeout:` / `Shell capture:timeout:` so a stuck repo
 lock or paused NFS mount cannot stall the dispatcher tick. A timeout
 surfaces as exit 124 and propagates as an Error on `runChecked:timeout:`
 — callers already handle Exception and fail-soft / notify-operator."

GitOps subclass: Object

  "--- Default per-operation timeouts (seconds). Tuned to be generous
   enough for cold-cache local repos but tight enough that a hung git
   process never blocks the tick longer than ~30s. ---"

  classMethod: defaultTimeoutFast [ ^10 ]
  classMethod: defaultTimeoutWrite [ ^30 ]
  classMethod: defaultTimeoutPush [ ^60 ]

  classMethod: createFeatureBranch: branchName in: repoPath [
    "Create <branchName> at the current HEAD WITHOUT checking it out, so the
     dispatcher's primary working tree is never switched out from under the
     server or any concurrent reader. Signals Error on failure."
    Shell runChecked: 'git -C "', repoPath, '" branch "', branchName, '"'
      timeout: self defaultTimeoutWrite
  ]

  classMethod: createFeatureBranch: branchName from: startPoint in: repoPath [
    "git checkout -b <branchName> <startPoint> in repoPath. Signals Error on failure."
    Shell runChecked: 'git -C "', repoPath, '" checkout -b "', branchName, '" "', startPoint, '"'
      timeout: self defaultTimeoutWrite
  ]

  classMethod: createWorktree: worktreeDir branch: implBranch from: startPoint in: repoPath [
    "Create parent dir and git worktree add from a specific start point. Signals Error on failure."
    Shell runChecked: 'mkdir -p "$(dirname "', worktreeDir, '")" && git -C "', repoPath, '" worktree add "', worktreeDir, '" -b "', implBranch, '" "', startPoint, '"'
      timeout: self defaultTimeoutWrite
  ]

  classMethod: createWorktree: worktreeDir branch: implBranch in: repoPath [
    "Create parent dir and git worktree add. Signals Error on failure."
    Shell runChecked: 'mkdir -p "$(dirname "', worktreeDir, '")" && git -C "', repoPath, '" worktree add "', worktreeDir, '" -b "', implBranch, '"'
      timeout: self defaultTimeoutWrite
  ]

  classMethod: checkoutBranch: branchName in: repoPath [
    "git checkout <branchName>. Signals Error on failure."
    Shell runChecked: 'git -C "', repoPath, '" checkout "', branchName, '"'
      timeout: self defaultTimeoutWrite
  ]

  classMethod: mergeBranch: sourceBranch in: repoPath [
    "git merge <sourceBranch> --no-edit. Signals Error on failure."
    Shell runChecked: 'git -C "', repoPath, '" merge "', sourceBranch, '" --no-edit'
      timeout: self defaultTimeoutWrite
  ]

  classMethod: removeWorktree: worktreeDir in: repoPath [
    "git worktree remove. Warns on failure (does not signal)."
    [Shell runChecked: 'git -C "', repoPath, '" worktree remove "', worktreeDir, '"'
       timeout: self defaultTimeoutWrite]
      on: Exception do: [:e |
        ('GitOps warning: worktree remove failed: ', e messageText) println
      ]
  ]

  classMethod: pushBranch: branchName in: repoPath [
    "git push origin <branchName>. Signals Error on failure. Callers typically
     catch so push failures don't break the workflow (not every repo has an
     origin configured)."
    Shell runChecked: 'git -C "', repoPath, '" push origin "', branchName, '"'
      timeout: self defaultTimeoutPush
  ]

  classMethod: deleteBranch: branchName in: repoPath [
    "git branch -d <branchName>. Warns on failure (does not signal)."
    [Shell runChecked: 'git -C "', repoPath, '" branch -d "', branchName, '"'
       timeout: self defaultTimeoutFast]
      on: Exception do: [:e |
        ('GitOps warning: branch delete failed: ', e messageText) println
      ]
  ]

  classMethod: deleteBranchForce: branchName in: repoPath [
    "git branch -D <branchName>. Warns on failure (does not signal).
     Used when cleaning up zero-commit branches left behind by failed workflows
     — the branch may be 'not fully merged' from git's perspective even though
     it has no unique commits."
    [Shell runChecked: 'git -C "', repoPath, '" branch -D "', branchName, '"'
       timeout: self defaultTimeoutFast]
      on: Exception do: [:e |
        ('GitOps warning: branch force-delete failed: ', e messageText) println
      ]
  ]

  classMethod: branchExists: branchName in: repoPath [
    "Returns true if the local branch exists in the given repo."
    | output |
    output := Shell capture: 'git -C "', repoPath, '" rev-parse --verify --quiet "refs/heads/', branchName, '" && echo OK || echo MISSING'
      timeout: self defaultTimeoutFast.
    (output isNil or: [output isEmpty]) ifTrue: [^false].
    ^output trimSeparators endsWith: 'OK'
  ]

  classMethod: commitsAheadOf: base on: branchName in: repoPath [
    "Returns the number of commits on branchName that are not in base.
     Returns 0 if the branch does not exist, or on any git error — callers
     use this to decide whether a branch is worth preserving."
    | output trimmed |
    output := Shell capture: 'git -C "', repoPath, '" rev-list --count "', base, '..', branchName, '"'
      timeout: self defaultTimeoutFast.
    (output isNil or: [output isEmpty]) ifTrue: [^0].
    trimmed := output trimSeparators.
    ^[trimmed asInteger] on: Exception do: [:e | 0]
  ]

  classMethod: changedFileCount: branch since: base in: repoPath [
    "Count the files <branch> changed since it diverged from <base>, using a
     THREE-DOT diff (base...branch). This is the merge-base delta — the same
     semantics the reviewer sees via `git diff --stat main...HEAD`
     (ClaudeHarness.mag:228) — NOT a post-merge HEAD~1..HEAD count, which reads
     0 for fast-forward / merge commits.

     MUST be called BEFORE the branch is force-deleted, or git has no ref to
     diff. Guards the soft-fail behaviour of Shell capture: (nil / '' output)
     by returning 0 — never crashes the merge (Shell capture: is unreliable per
     project_pp_treesafe_merge)."
    | output trimmed |
    "Use plain capture: (NOT capture:timeout:) — the latter backgrounds the
     command and soft-fails to '' (project_pp_treesafe_merge; same reason
     isCleanTree: and mergeBranch:into:'s rev-parse use plain capture:). The
     `diff --name-only | wc -l` is instant and needs no watchdog."
    output := Shell capture: 'git -C "', repoPath, '" diff --name-only "', base, '...', branch, '" 2>/dev/null | wc -l'.
    (output isNil or: [output isEmpty]) ifTrue: [^0].
    trimmed := output trimSeparators.
    ^[trimmed asInteger] on: Exception do: [:e | 0]
  ]

  "--- Tree-safe merging ----------------------------------------------------
   The dispatcher's repoPath is a long-lived checkout (the server runs there).
   Switching its branch via `git checkout` to perform a merge races with and
   clobbers anything else using that tree. These helpers merge WITHOUT ever
   touching the primary working tree. ---"

  classMethod: sanitizeRef: ref [
    "Turn a branch name into a safe single path segment (slashes -> dashes)."
    ^ref replaceAll: '/' with: '-'
  ]

  classMethod: pruneEphemeralWorktree: tmpDir in: repoPath [
    "Best-effort teardown of an ephemeral merge worktree. Never signals — used
     both to clean up after a merge and to clear a stale dir left by a crash.
     Deliberately avoids `git worktree remove`: on an already-missing path it
     hangs under the timeout watchdog. `rm -rf` of the checkout dir followed by
     `git worktree prune` (which deregisters worktrees whose dir is gone) is
     idempotent and never hangs on a missing target. Uses runChecked:timeout:
     (blocking, reliable) wrapped in exception handlers."
    [Shell runChecked: 'rm -rf "', tmpDir, '"' timeout: self defaultTimeoutFast]
      on: Exception do: [:e | nil].
    [Shell runChecked: 'git -C "', repoPath, '" worktree prune' timeout: self defaultTimeoutFast]
      on: Exception do: [:e | nil]
  ]

  classMethod: mergeBranch: sourceBranch into: targetBranch in: repoPath [
    "Merge sourceBranch into targetBranch WITHOUT switching or dirtying the
     primary working tree. The merge runs in an ephemeral detached worktree
     under .git/; on success the targetBranch ref is moved with update-ref
     (safe because targetBranch is never checked out — feature branches live
     only as refs while impl work happens in the impl worktree). Handles
     non-fast-forward merges (real merge commit). On conflict the ephemeral
     worktree is aborted and removed and the targetBranch ref is left
     untouched. Signals Error on any failure."
    | tmpDir mergedSha |
    tmpDir := repoPath, '/.git/pp-merge-', (self sanitizeRef: targetBranch).

    "Clear any stale ephemeral worktree from a previous crashed merge."
    self pruneEphemeralWorktree: tmpDir in: repoPath.

    "1. Ephemeral detached worktree at the target branch tip."
    Shell runChecked: 'git -C "', repoPath, '" worktree add --detach "', tmpDir, '" "', targetBranch, '"'
      timeout: self defaultTimeoutWrite.

    "2. Merge the source branch inside the ephemeral worktree."
    [
      Shell runChecked: 'git -C "', tmpDir, '" merge "', sourceBranch, '" --no-edit'
        timeout: self defaultTimeoutWrite
    ] on: Exception do: [:e |
      "Abort and tear down so the repo is left exactly as before, then re-signal."
      [Shell runChecked: 'git -C "', tmpDir, '" merge --abort' timeout: self defaultTimeoutFast]
        on: Exception do: [:ignored | nil].
      self pruneEphemeralWorktree: tmpDir in: repoPath.
      Error signal: 'merge ', sourceBranch, ' into ', targetBranch, ' conflicted: ', e messageText
    ].

    "3. Move the target ref to the merged commit (target is not checked out,
     so update-ref does not disturb any working tree). Use plain capture:
     here — rev-parse is instant and needs no watchdog, and capture:timeout:
     soft-fails to '' (it backgrounds the command, detaching stdout from the
     capture). An empty sha would make update-ref hang, so guard explicitly."
    mergedSha := (Shell capture: 'git -C "', tmpDir, '" rev-parse HEAD') trimSeparators.
    mergedSha isEmpty ifTrue: [
      self pruneEphemeralWorktree: tmpDir in: repoPath.
      Error signal: 'merge ', sourceBranch, ' into ', targetBranch, ': could not resolve merged commit'
    ].
    Shell runChecked: 'git -C "', repoPath, '" update-ref "refs/heads/', targetBranch, '" "', mergedSha, '"'
      timeout: self defaultTimeoutWrite.

    "4. Tear down the ephemeral worktree."
    self pruneEphemeralWorktree: tmpDir in: repoPath
  ]

  classMethod: isCleanTree: repoPath [
    "Returns true if the primary working tree has no staged or unstaged changes
     to TRACKED files — i.e. a checkout/merge into it cannot clobber committed-
     -in-progress work. Untracked files (--untracked-files=no) are deliberately
     ignored: git preserves them across checkout/merge, and almost every real
     repo carries untracked dirs (.claude/, build artifacts) that must not block
     landing. Uses plain capture: — capture:timeout: soft-fails to '' which
     would misreport a dirty tree as clean and defeat the guard."
    | output |
    output := Shell capture: 'git -C "', repoPath, '" status --porcelain --untracked-files=no'.
    output isNil ifTrue: [^false].
    ^output trimSeparators isEmpty
  ]

  classMethod: fastForwardOrMerge: sourceBranch in: repoPath [
    "Advance the currently checked-out branch to include sourceBranch. Tries a
     fast-forward first (the common case: feature = main + work) and falls back
     to a real merge commit. On conflict the merge is aborted (restoring the
     working tree) and an Error is signalled. Signals Error on failure."
    | ffFailed |
    ffFailed := false.
    [Shell runChecked: 'git -C "', repoPath, '" merge --ff-only "', sourceBranch, '"'
       timeout: self defaultTimeoutWrite]
      on: Exception do: [:e | ffFailed := true].
    ffFailed ifTrue: [
      [Shell runChecked: 'git -C "', repoPath, '" merge "', sourceBranch, '" --no-edit'
         timeout: self defaultTimeoutWrite]
        on: Exception do: [:e |
          [Shell runChecked: 'git -C "', repoPath, '" merge --abort' timeout: self defaultTimeoutFast]
            on: Exception do: [:ignored | nil].
          Error signal: 'merge ', sourceBranch, ' into current branch conflicted: ', e messageText
        ]
    ]
  ]
