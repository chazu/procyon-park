"The dispatcher — runs the tick loop that advances workflows,
 evaluates rules, dispatches tasks, and performs housekeeping."

Dispatcher subclass: Object
  instanceVars: bbs workflowEngine ruleEngine scheduler running tick

  classMethod: on: aBBS harnessFactory: factory [
    ^super new initBBS: aBBS harnessFactory: factory
  ]

  classMethod: on: aBBS harnessFactory: factory maxSlots: max [
    ^super new initBBS: aBBS harnessFactory: factory maxSlots: max
  ]

  method: initBBS: aBBS harnessFactory: factory [
    self initBBS: aBBS harnessFactory: factory maxSlots: 4
  ]

  method: initBBS: aBBS harnessFactory: factory maxSlots: max [
    bbs := aBBS.
    workflowEngine := WorkflowEngine on: aBBS.
    ruleEngine := RuleEngine on: aBBS.
    scheduler := Scheduler on: aBBS maxSlots: max harnessFactory: factory.
    running := false.
    tick := 0
  ]

  method: workflowEngine [ ^workflowEngine ]
  method: ruleEngine [ ^ruleEngine ]
  method: scheduler [ ^scheduler ]

  "--- Lifecycle ---"

  method: start [
    "Start the dispatcher tick loop in a forked process."
    running := true.
    'Dispatcher started.' println.
    [self runLoop] fork
  ]

  method: stop [
    running := false.
    bbs flushIfDirty.
    'Dispatcher stopped.' println
  ]

  method: isRunning [ ^running ]

  "--- Tick Loop ---"

  method: runLoop [
    [running] whileTrue: [
      [self onTick] on: Exception do: [:e |
        ('Dispatcher tick error: ', e messageText) println
      ].
      Process sleep: 10000
    ]
  ]

  method: onTick [
    tick := tick + 1.

    "Every tick (10s): core operations. Each step is wrapped in its own
     exception handler so a single malformed tuple in one step does not
     kill the entire tick — the remaining steps still run."
    [scheduler checkCompleted] on: Exception do: [:e |
      ('Dispatcher tick step error (checkCompleted): ', e messageText) println
    ].
    [workflowEngine advance] on: Exception do: [:e |
      ('Dispatcher tick step error (workflowEngine advance): ', e messageText) println
    ].
    [ruleEngine evaluate] on: Exception do: [:e |
      ('Dispatcher tick step error (ruleEngine evaluate): ', e messageText) println
    ].
    [scheduler dispatch] on: Exception do: [:e |
      ('Dispatcher tick step error (scheduler dispatch): ', e messageText) println
    ].
    [self reapExpiredClaims] on: Exception do: [:e |
      ('Dispatcher tick step error (reapExpiredClaims): ', e messageText) println
    ].
    [self reapStuckDispatched] on: Exception do: [:e |
      ('Dispatcher tick step error (reapStuckDispatched): ', e messageText) println
    ].
    "Async, fenced flush — multi-MB JSON encode + rename must NOT block the
     tick loop. CLI request paths (outSync:/inpSync:, /api/bbs/out, /api/bbs/rm)
     still use the synchronous flushIfDirty when they need durability before ack.
     See docs/scout-perf-survey-2026-04-28.md §1.3."
    [bbs flushAsyncIfDirty] on: Exception do: [:e |
      ('Dispatcher tick step error (flushAsyncIfDirty): ', e messageText) println
    ].

    "Every 30th tick (~5min): housekeeping"
    (tick \\ 30) = 0 ifTrue: [
      [self housekeep] on: Exception do: [:e |
        ('Dispatcher tick step error (housekeep): ', e messageText) println
      ]
    ]
  ]

  "--- Reaper (D6.2 / D6.3) ---"

  method: reapExpiredClaims [
    "Sweep task tuples whose lease has expired. Runs every tick.

     D6.3: lease expiry is the SOLE reap signal — heartbeat gaps MUST NOT
     trigger a reap.
     D6.2: two consecutive sweeps past claim_expires_at are required
     before the task is re-pended or failed (missed_renewals increments
     on each sweep; action fires when it reaches 2).

     For each task tuple with status='claimed' AND claim_expires_at != nil
     AND now > claim_expires_at:
       (1) Atomically bump missed_renewals.
       (2) When missed_renewals reaches 2:
             - Bump retry_count.
             - If retry_count >= max_retries (D6.5 default 3):
                 status=failed, last_failure_reason=reaped, failed_at=now.
             - Else:
                 flip status back to pending, clear worker_id/claim_id/
                 executed_by/claim_expires_at/renewed_at, reset
                 missed_renewals=0.
           Emit a reap event tuple with the previous worker_id and the
           (new) retry_count."
    | now tasks claimed |
    now := DateTime now epochSeconds.
    tasks := bbs scanAll: 'task'.

    "Pre-filter to status='claimed' BEFORE per-tuple processing. Of ~500
     task tuples typically only a handful are claimed, so iterating all
     of them is wasteful and — more importantly — exposes us to panics
     from non-task-shaped payload reads on completed/cancelled tuples
     (see observation procyon-park:src/dispatcher about scanAll-touches-
     completed-tuples). The select itself is wrapped per-tuple so a
     single corrupt payload cannot kill the filter."
    claimed := Array new: 0.
    tasks do: [:t |
      [
        | payload |
        payload := t at: 'payload' ifAbsent: [nil].
        (payload notNil
          and: [(payload at: 'status' ifAbsent: ['']) = 'claimed'])
            ifTrue: [claimed := claimed copyWith: t]
      ] on: Exception do: [:e |
        ('Dispatcher reapExpiredClaims filter skip (',
          (t at: 'identity' ifAbsent: ['?']), '): ', e messageText) println
      ]
    ].

    claimed do: [:t |
      "Defensive per-tuple try/catch: scanAll: returns a snapshot of shared
       index references; another goroutine (Server handleTaskComplete,
       Scheduler checkCompleted) may concurrently rewrite a payload between
       our read of 'payload' and our read of its fields. A single malformed
       or concurrently-mutated tuple must NOT crash the whole sweep."
      [
        | payload expiresAt |
        payload := t at: 'payload' ifAbsent: [nil].
        payload notNil ifTrue: [
          expiresAt := payload at: 'claim_expires_at' ifAbsent: [nil].
          "Belt-and-braces guard: claim_expires_at is normally an Integer
           epoch, but a stale snapshot (post-completion) carries nil and
           a type-confused JSON deser could carry a non-comparable. The
           outer try/catch upgrades any '>' panic to a skip. Status was
           already filtered to 'claimed' upstream — re-check inside
           reapTask:'s atomic update guards against TOCTOU races."
          (expiresAt notNil and: [now > expiresAt]) ifTrue: [
            self reapTask: t now: now
          ]
        ]
      ] on: Exception do: [:e |
        ('Dispatcher reapExpiredClaims tuple skip (',
          (t at: 'identity' ifAbsent: ['?']), '): ', e messageText) println
      ]
    ]
  ]

  method: reapTask: taskTuple now: now [
    "Process a single expired-claim task tuple. The core state change is
     done inside BBS>>update: so the payload rewrite is atomic with the
     status re-check (the task may have been renewed or completed between
     scanAll: and this update). Emits the reap event outside the atomic
     block only if an action was taken."
    | scope taskId outcome |
    scope := taskTuple at: 'scope'.
    taskId := taskTuple at: 'identity'.
    outcome := Dictionary new.
    outcome at: 'reaped' put: false.
    outcome at: 'terminal' put: false.
    outcome at: 'prev_worker' put: nil.
    outcome at: 'retry_count' put: 0.

    bbs update: 'task' scope: scope identity: taskId do: [:p |
      | status expiresAt missed max retryCount |
      status := p at: 'status' ifAbsent: [''].
      expiresAt := p at: 'claim_expires_at' ifAbsent: [nil].
      "Re-check inside the atomic update: the task may have completed or
       been re-pended between scanAll: and here, in which case
       claim_expires_at is now nil (or some non-Number) — skip cleanly."
      (status = 'claimed'
        and: [expiresAt notNil and: [now > expiresAt]]) ifTrue: [
          missed := (p at: 'missed_renewals' ifAbsent: [0]) + 1.
          p at: 'missed_renewals' put: missed.
          missed >= 2 ifTrue: [
            retryCount := (p at: 'retry_count' ifAbsent: [0]) + 1.
            max := p at: 'max_retries' ifAbsent: [3].
            outcome at: 'reaped' put: true.
            outcome at: 'prev_worker' put: (p at: 'worker_id' ifAbsent: [nil]).
            outcome at: 'retry_count' put: retryCount.
            p at: 'retry_count' put: retryCount.
            retryCount >= max ifTrue: [
              "D6.5: exhausted retries — terminal failure."
              p at: 'status' put: 'failed'.
              p at: 'last_failure_reason' put: 'reaped'.
              p at: 'failed_at' put: now.
              outcome at: 'terminal' put: true
            ] ifFalse: [
              "Re-pend for another claim attempt."
              p at: 'status' put: 'pending'.
              p at: 'worker_id' put: nil.
              p at: 'claim_id' put: nil.
              p at: 'executed_by' put: nil.
              p at: 'claim_expires_at' put: nil.
              p at: 'renewed_at' put: nil.
              p at: 'missed_renewals' put: 0
            ]
          ]
      ]
    ].

    (outcome at: 'reaped') ifTrue: [
      | eventPayload |
      eventPayload := Dictionary new.
      eventPayload at: 'type' put: 'reap'.
      eventPayload at: 'task_id' put: taskId.
      eventPayload at: 'worker_id' put: (outcome at: 'prev_worker').
      eventPayload at: 'retry_count' put: (outcome at: 'retry_count').
      eventPayload at: 'terminal' put: (outcome at: 'terminal').
      bbs out: 'event' scope: scope
          identity: 'reap:', taskId
          payload: eventPayload actor: nil
    ]
  ]

  "--- Stuck-Dispatched Reaper ---"

  method: stuckDispatchedThresholdSeconds [
    "Tasks that sit in status='dispatched' with no worker for longer than
     this are considered orphaned. The local Scheduler forks a harness
     synchronously and marks the task 'completed' on success; in
     multiplayer mode a remote worker takes the task to 'claimed' via
     /api/tasks/claim. Either way, a healthy task should leave the
     'dispatched' state within a few seconds. 300s is a generous floor
     to avoid racing slow harness starts."
    ^300
  ]

  method: dispatchOrphanStaleSeconds [
    "Beyond this age, an orphaned dispatched task is considered too stale
     to safely re-pend (the work it described is likely obsolete and
     re-running it would burn API tokens on irrelevant work — observed
     when stuck tasks accumulated over a multi-day server outage and the
     reaper resurrection spun up Claude sessions on long-resolved
     stories). At/above this age the task is marked failed with reason
     'dispatch-orphan-stale' instead of being re-pended."
    ^4 * 3600
  ]

  method: reapStuckDispatched [
    "Sweep task tuples that have been status='dispatched' with no
     worker_id for longer than stuckDispatchedThresholdSeconds.

     Why this exists: the claim-expiry reaper (reapExpiredClaims) only
     handles 'claimed' tasks, because the original design assumed the
     local scheduler's fork would always either complete the task or
     fail it via the wrap-up handler at Scheduler.mag:131-143. In
     practice, harness forks have been observed to die in ways that
     escape that handler (NLR out of fork, panic in primitives, etc.),
     leaving the task permanently in 'dispatched' state — workflows
     wait forever on tokens that never produce. This sweeper closes
     that gap with the same retry semantics as reapExpiredClaims.

     Detection signal: status='dispatched' AND worker_id is nil AND
     dispatched_at older than threshold. We do NOT consult the
     Scheduler's activeSlots map because (a) the dispatcher and
     scheduler are separate objects without a clean coupling for that
     query and (b) by the time the threshold elapses, any healthy fork
     would have advanced the task past 'dispatched'."
    | now threshold tasks orphans |
    now := DateTime now epochSeconds.
    threshold := self stuckDispatchedThresholdSeconds.
    tasks := bbs scanAll: 'task'.

    "Pre-filter to dispatched + orphan candidates BEFORE per-tuple work.
     Same defensive iteration pattern as reapExpiredClaims."
    orphans := Array new: 0.
    tasks do: [:t |
      [
        | payload status workerId dispatchedAt |
        payload := t at: 'payload' ifAbsent: [nil].
        payload notNil ifTrue: [
          status := payload at: 'status' ifAbsent: [''].
          workerId := payload at: 'worker_id' ifAbsent: [nil].
          dispatchedAt := payload at: 'dispatched_at' ifAbsent: [nil].
          (status = 'dispatched'
            and: [workerId isNil
            and: [dispatchedAt notNil
            and: [(now - dispatchedAt) > threshold]]])
              ifTrue: [orphans := orphans copyWith: t]
        ]
      ] on: Exception do: [:e |
        ('Dispatcher reapStuckDispatched filter skip (',
          (t at: 'identity' ifAbsent: ['?']), '): ', e messageText) println
      ]
    ].

    orphans do: [:t |
      [self reapStuckDispatchedTask: t now: now]
        on: Exception do: [:e |
          ('Dispatcher reapStuckDispatched tuple skip (',
            (t at: 'identity' ifAbsent: ['?']), '): ', e messageText) println
        ]
    ]
  ]

  method: reapStuckDispatchedTask: taskTuple now: now [
    "Reap a single orphaned dispatched task. Mirrors reapTask:'s retry
     state machine but driven by the dispatch-orphan signal rather than
     claim expiry. Atomic re-check inside the BBS update guards against
     a worker claiming the task between the snapshot and the rewrite."
    | scope taskId outcome threshold |
    scope := taskTuple at: 'scope'.
    taskId := taskTuple at: 'identity'.
    threshold := self stuckDispatchedThresholdSeconds.
    outcome := Dictionary new.
    outcome at: 'reaped' put: false.
    outcome at: 'terminal' put: false.
    outcome at: 'retry_count' put: 0.

    bbs update: 'task' scope: scope identity: taskId do: [:p |
      | status workerId dispatchedAt retryCount max staleCutoff |
      status := p at: 'status' ifAbsent: [''].
      workerId := p at: 'worker_id' ifAbsent: [nil].
      dispatchedAt := p at: 'dispatched_at' ifAbsent: [nil].
      staleCutoff := self dispatchOrphanStaleSeconds.
      (status = 'dispatched'
        and: [workerId isNil
        and: [dispatchedAt notNil
        and: [(now - dispatchedAt) > threshold]]]) ifTrue: [
          retryCount := (p at: 'retry_count' ifAbsent: [0]) + 1.
          max := p at: 'max_retries' ifAbsent: [3].
          outcome at: 'reaped' put: true.
          outcome at: 'retry_count' put: retryCount.
          p at: 'retry_count' put: retryCount.
          "Staleness short-circuit: orphans older than dispatchOrphanStaleSeconds
           skip the retry ladder entirely and fail terminally. Prevents the
           reaper from resurrecting work that is no longer relevant after a
           long outage."
          ((now - dispatchedAt) > staleCutoff) ifTrue: [
            p at: 'status' put: 'failed'.
            p at: 'last_failure_reason' put: 'dispatch-orphan-stale'.
            p at: 'failed_at' put: now.
            outcome at: 'terminal' put: true
          ] ifFalse: [
            retryCount >= max ifTrue: [
              p at: 'status' put: 'failed'.
              p at: 'last_failure_reason' put: 'dispatch-orphan'.
              p at: 'failed_at' put: now.
              outcome at: 'terminal' put: true
            ] ifFalse: [
              "Re-pend so the scheduler can take another swing at it."
              p at: 'status' put: 'pending'.
              p at: 'dispatched_at' put: nil.
              p at: 'claim_id' put: nil.
              p at: 'claim_expires_at' put: nil.
              p at: 'renewed_at' put: nil.
              p at: 'missed_renewals' put: 0
            ]
          ]
      ]
    ].

    (outcome at: 'reaped') ifTrue: [
      | eventPayload |
      eventPayload := Dictionary new.
      eventPayload at: 'type' put: 'reap'.
      eventPayload at: 'cause' put: 'dispatch-orphan'.
      eventPayload at: 'task_id' put: taskId.
      eventPayload at: 'retry_count' put: (outcome at: 'retry_count').
      eventPayload at: 'terminal' put: (outcome at: 'terminal').
      bbs out: 'event' scope: scope
          identity: 'reap:', taskId
          payload: eventPayload actor: nil.
      bbs notify: ('Reaped orphaned dispatched task: ', taskId,
                   ' (retry ', (outcome at: 'retry_count') printString, ')')
        scope: scope severity: 'warn'
    ]
  ]

  "--- Housekeeping ---"

  method: housekeep [
    "Periodic housekeeping: clean up completed workflows.
     (Affine-tuple expiry is handled natively by TupleSpace's outAffine:ttl:.)"
    self cleanCompletedWorkflows
  ]

  method: cleanCompletedWorkflows [
    "Clean up workflows that have been completed for a while."
    | workflows now |
    workflows := bbs scanAll: 'workflow'.
    now := DateTime now epochSeconds.

    workflows do: [:wf |
      | payload status terminalAt |
      payload := wf at: 'payload'.
      status := payload at: 'status' ifAbsent: [''].
      (status = 'completed' or: [status = 'cancelled']) ifTrue: [
        terminalAt := status = 'completed'
          ifTrue: [payload at: 'completed_at' ifAbsent: [now]]
          ifFalse: [payload at: 'cancelled_at' ifAbsent: [now]].
        "Clean up after 1 hour"
        (now - terminalAt) > 3600 ifTrue: [
          bbs inp: 'workflow' scope: (wf at: 'scope') identity: (wf at: 'identity')
        ]
      ]
    ]
  ]

  "--- Direct Operations ---"

  method: instantiateWorkflow: templateId scope: scope params: params launchedBy: launchedBy overrideAffinity: overrideAffinity [
    "F4.3: instantiate a workflow with a CLI-provided affinity override that
     wins over per-transition and workflow-root CUE affinity for every task
     spawned under the returned instance."
    ^workflowEngine instantiate: templateId scope: scope params: params launchedBy: launchedBy overrideAffinity: overrideAffinity
  ]
