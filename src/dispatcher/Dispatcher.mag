"The dispatcher — runs the tick loop that advances workflows,
 evaluates rules, dispatches tasks, and performs housekeeping."

Dispatcher subclass: Object
  instanceVars: bbs workflowEngine ruleEngine scheduler running tick

  classMethod: on: aBBS harnessFactory: factory [
    ^super new initBBS: aBBS harnessFactory: factory
  ]

  classMethod: on: aBBS harnessFactory: factory maxSlots: max [
    ^super new initBBS: aBBS harnessFactory: factory maxSlots: max
  ]

  method: initBBS: aBBS harnessFactory: factory [
    self initBBS: aBBS harnessFactory: factory maxSlots: 4
  ]

  method: initBBS: aBBS harnessFactory: factory maxSlots: max [
    bbs := aBBS.
    workflowEngine := WorkflowEngine on: aBBS.
    ruleEngine := RuleEngine on: aBBS.
    scheduler := Scheduler on: aBBS maxSlots: max harnessFactory: factory.
    running := false.
    tick := 0
  ]

  method: workflowEngine [ ^workflowEngine ]
  method: ruleEngine [ ^ruleEngine ]
  method: scheduler [ ^scheduler ]

  "--- Lifecycle ---"

  method: start [
    "Start the dispatcher tick loop in a forked process."
    running := true.
    'Dispatcher started.' println.
    [self runLoop] fork
  ]

  method: stop [
    running := false.
    bbs flushIfDirty.
    'Dispatcher stopped.' println
  ]

  method: isRunning [ ^running ]

  "--- Tick Loop ---"

  method: runLoop [
    [running] whileTrue: [
      [self onTick] on: Exception do: [:e |
        ('Dispatcher tick error: ', e messageText) println
      ].
      Process sleep: 10000
    ]
  ]

  method: onTick [
    | taskSnapshot |
    tick := tick + 1.

    "Every tick (10s): core operations. Each step is wrapped in its own
     exception handler so a single malformed tuple in one step does not
     kill the entire tick — the remaining steps still run.

     We take ONE `bbs scanAll: 'task'` snapshot here and thread it through
     scheduler.dispatch / reapExpiredClaims / reapStuckDispatched. Prior
     code took three independent snapshots per tick; under load each scan
     held the BBS mutex while building an O(N) result. Sharing the
     snapshot is safe because the reaper paths re-check status atomically
     inside `bbs update:` — a stale read from the snapshot can only cause
     a no-op update, never an incorrect mutation."
    [scheduler checkCompleted] on: Exception do: [:e |
      ('Dispatcher tick step error (checkCompleted): ', e messageText) println
    ].
    [workflowEngine advance] on: Exception do: [:e |
      ('Dispatcher tick step error (workflowEngine advance): ', e messageText) println
    ].
    [ruleEngine evaluate] on: Exception do: [:e |
      ('Dispatcher tick step error (ruleEngine evaluate): ', e messageText) println
    ].
    "AAR: close the enrichment loop. For any completed archivist task whose
     case is not yet enriched, merge its enrichment into the case. Strictly
     off-critical-path — wrapped here AND internally so it can never gate or
     flip workflow status."
    [workflowEngine applyCompletedArchivistEnrichments] on: Exception do: [:e |
      ('Dispatcher tick step error (applyCompletedArchivistEnrichments): ', e messageText) println
    ].
    taskSnapshot := nil.
    [taskSnapshot := bbs scanAll: 'task'] on: Exception do: [:e |
      ('Dispatcher tick step error (task snapshot): ', e messageText) println
    ].
    [scheduler dispatchTasks: taskSnapshot] on: Exception do: [:e |
      ('Dispatcher tick step error (scheduler dispatch): ', e messageText) println
    ].
    [self reapExpiredClaimsIn: taskSnapshot] on: Exception do: [:e |
      ('Dispatcher tick step error (reapExpiredClaims): ', e messageText) println
    ].
    [self reapStuckDispatchedIn: taskSnapshot] on: Exception do: [:e |
      ('Dispatcher tick step error (reapStuckDispatched): ', e messageText) println
    ].
    "Async, fenced flush — multi-MB JSON encode + rename must NOT block the
     tick loop. CLI request paths (outSync:/inpSync:, /api/bbs/out, /api/bbs/rm)
     still use the synchronous flushIfDirty when they need durability before ack.
     See docs/scout-perf-survey-2026-04-28.md §1.3."
    [bbs flushAsyncIfDirty] on: Exception do: [:e |
      ('Dispatcher tick step error (flushAsyncIfDirty): ', e messageText) println
    ].

    "Every 30th tick (~5min): housekeeping"
    (tick \\ 30) = 0 ifTrue: [
      [self housekeep] on: Exception do: [:e |
        ('Dispatcher tick step error (housekeep): ', e messageText) println
      ].
      "Doctrine auto-synthesis (C2 loop-closure): when enough new case (AAR)
       tuples have accumulated in a scope, enqueue a Strategist task to
       re-orient doctrine — no manual `pp doctrine synthesize` needed. Its OWN
       on:Exception wrapper keeps it strictly off-critical-path: it can never
       gate or flip any tick step."
      [self maybeAutoSynthesize] on: Exception do: [:e |
        ('Dispatcher tick step error (maybeAutoSynthesize): ', e messageText) println
      ]
    ]
  ]

  "--- Doctrine Auto-Synthesis (C2 loop-closure) ---"

  method: autoSynthEnabled [
    "Kill-switch. DOCTRINE_AUTOSYNTH defaults to ENABLED; only the literal
     '0' or 'false' disables it. Guarded for nil/empty."
    | v |
    v := System env: 'DOCTRINE_AUTOSYNTH'.
    (v isNil or: [v isEmpty]) ifTrue: [^true].
    ^(v = '0' or: [v = 'false']) not
  ]

  method: autoSynthThreshold [
    "New cases per scope required to trigger a synthesis. Default 8. Guarded
     for nil/empty/unparseable env."
    | v |
    v := System env: 'DOCTRINE_AUTOSYNTH_THRESHOLD'.
    (v isNil or: [v isEmpty]) ifTrue: [^8].
    ^[v asInteger] on: Exception do: [:e | 8]
  ]

  method: autoSynthCooldownSecs [
    "Minimum seconds between synthesis dispatches per scope. Default 3600.
     Guarded for nil/empty/unparseable env."
    | v |
    v := System env: 'DOCTRINE_AUTOSYNTH_COOLDOWN_SECS'.
    (v isNil or: [v isEmpty]) ifTrue: [^3600].
    ^[v asInteger] on: Exception do: [:e | 3600]
  ]

  method: maybeAutoSynthesize [
    "Off-critical-path sweep (driven from the Dispatcher tick, ~every 5min):
     bucket the 'case' (AAR) tuples by scope and, for any scope that has
     accumulated >= threshold NEW cases (created_at past that scope's
     synthesis watermark) AND is past its cooldown AND has no in-flight
     strategist, enqueue a Strategist task to re-synthesise doctrine.

     V1 design notes:
       - The watermark is a per-scope signal ('doctrine-synth-watermark')
         carrying {last_synth_epoch}. A missing watermark means epoch 0, so
         every case counts as new on the first pass.
       - The watermark is advanced on DISPATCH, not on strategist completion.
         A strategist that fails just means those lessons wait for the next
         threshold batch — we never block the loop on a synthesis outcome.
       - Single-shot threshold trigger; smarter cadence/predicates deferred.

     Each scope is processed in its OWN on:Exception so one malformed case
     tuple can neither abort the sweep nor escape into the tick loop."
    | enabled threshold cooldown now cases countsByScope totalByScope |
    enabled := self autoSynthEnabled.
    enabled ifFalse: [^self].
    threshold := self autoSynthThreshold.
    cooldown := self autoSynthCooldownSecs.
    now := DateTime now epochSeconds.

    cases := bbs scanAll: 'case'.
    "Bucket: per-scope count of NEW cases (created_at > watermark epoch) and
     per-scope total case count (stamped into the advanced watermark)."
    countsByScope := Dictionary new.
    totalByScope := Dictionary new.

    "First pass groups raw case tuples by scope; the watermark lookup happens
     in the second pass so each scope reads its watermark exactly once."
    cases do: [:c |
      [
        | scope |
        scope := c at: 'scope' ifAbsent: [nil].
        scope notNil ifTrue: [
          totalByScope at: scope put: ((totalByScope at: scope ifAbsent: [0]) + 1).
          "Collect created_at values per scope for the new-count computation."
          (countsByScope at: scope ifAbsent: [nil]) isNil ifTrue: [
            countsByScope at: scope put: (Array new: 0)
          ].
          countsByScope at: scope put: ((countsByScope at: scope) copyWith: (c at: 'payload' ifAbsent: [Dictionary new]))
        ]
      ] on: Exception do: [:e |
        bbs logEngine: 'warn' component: 'doctrine' scope: 'system' message: ('auto-synth case bucket skip: ', e messageText)
      ]
    ].

    "Second pass: per scope, read watermark, count new cases, decide & fire."
    countsByScope keysAndValuesDo: [:scope :payloads |
      [
        | wmTuple lastEpoch newCount total |
        wmTuple := bbs rdp: 'signal' scope: scope identity: 'doctrine-synth-watermark'.
        lastEpoch := 0.
        wmTuple notNil ifTrue: [
          lastEpoch := (wmTuple at: 'payload' ifAbsent: [Dictionary new]) at: 'last_synth_epoch' ifAbsent: [0]
        ].
        newCount := 0.
        payloads do: [:p |
          | createdAt |
          createdAt := p at: 'created_at' ifAbsent: [0].
          (createdAt > lastEpoch) ifTrue: [newCount := newCount + 1]
        ].
        total := totalByScope at: scope ifAbsent: [0].
        ((newCount >= threshold) and: [(now - lastEpoch) >= cooldown]) ifTrue: [
          "dispatchStrategist: is itself idempotent (one in-flight strategist
           per scope), so it ALSO guards against a duplicate fire here."
          workflowEngine dispatchStrategist: scope.
          self advanceSynthWatermark: scope epoch: now total: total.
          ('[doctrine] auto-synth fired for scope ', scope, ' (newCount=', newCount printString, ' >= threshold=', threshold printString, ')') println
        ]
      ] on: Exception do: [:e |
        bbs logEngine: 'warn' component: 'doctrine' scope: scope message: ('auto-synth scope skip: ', e messageText)
      ]
    ]
  ]

  method: advanceSynthWatermark: scope epoch: epoch total: total [
    "Upsert the per-scope synthesis watermark to {last_synth_epoch, last_count}.
     Concurrency-safe replace-by-key via BBS>>upsertSignal:. Advancing on
     dispatch (not completion) is intentional for V1 (see maybeAutoSynthesize)."
    | wm |
    wm := Dictionary new.
    wm at: 'last_synth_epoch' put: epoch.
    wm at: 'last_count' put: total.
    bbs upsertSignal: scope identity: 'doctrine-synth-watermark' payload: wm
  ]

  "--- Reaper (D6.2 / D6.3) ---"

  method: reapExpiredClaims [
    "Sweep task tuples whose lease has expired. Runs every tick.

     D6.3: lease expiry is the SOLE reap signal — heartbeat gaps MUST NOT
     trigger a reap.
     D6.2: two consecutive sweeps past claim_expires_at are required
     before the task is re-pended or failed (missed_renewals increments
     on each sweep; action fires when it reaches 2).

     For each task tuple with status='claimed' AND claim_expires_at != nil
     AND now > claim_expires_at:
       (1) Atomically bump missed_renewals.
       (2) When missed_renewals reaches 2:
             - Bump retry_count.
             - If retry_count >= max_retries (D6.5 default 3):
                 status=failed, last_failure_reason=reaped, failed_at=now.
             - Else:
                 flip status back to pending, clear worker_id/claim_id/
                 executed_by/claim_expires_at/renewed_at, reset
                 missed_renewals=0.
           Emit a reap event tuple with the previous worker_id and the
           (new) retry_count."
    ^self reapExpiredClaimsIn: nil
  ]

  method: reapExpiredClaimsIn: maybeTasks [
    "Snapshot-aware variant. If `maybeTasks` is nil, fetches its own
     scanAll: 'task'; otherwise reuses the caller's snapshot (typically
     the per-tick snapshot taken in onTick). Sharing the snapshot is safe
     because the per-tuple state change happens inside `bbs update:`,
     which re-checks status atomically."
    | now tasks claimed |
    now := DateTime now epochSeconds.
    tasks := maybeTasks isNil
      ifTrue: [bbs scanAll: 'task']
      ifFalse: [maybeTasks].

    "Pre-filter to status='claimed' BEFORE per-tuple processing. Of ~500
     task tuples typically only a handful are claimed, so iterating all
     of them is wasteful and — more importantly — exposes us to panics
     from non-task-shaped payload reads on completed/cancelled tuples
     (see observation procyon-park:src/dispatcher about scanAll-touches-
     completed-tuples). The select itself is wrapped per-tuple so a
     single corrupt payload cannot kill the filter.

     GrowableArray (amortized O(1) add:) replaces the prior
     copyWith: accumulator that allocated a fresh Array on every match —
     O(K^2) on K matches."
    claimed := GrowableArray new.
    tasks do: [:t |
      [
        | payload |
        payload := t at: 'payload' ifAbsent: [nil].
        (payload notNil
          and: [(payload at: 'status' ifAbsent: ['']) = 'claimed'])
            ifTrue: [claimed add: t]
      ] on: Exception do: [:e |
        ('Dispatcher reapExpiredClaims filter skip (',
          (t at: 'identity' ifAbsent: ['?']), '): ', e messageText) println
      ]
    ].

    claimed do: [:t |
      "Defensive per-tuple try/catch: scanAll: returns a snapshot of shared
       index references; another goroutine (Server handleTaskComplete,
       Scheduler checkCompleted) may concurrently rewrite a payload between
       our read of 'payload' and our read of its fields. A single malformed
       or concurrently-mutated tuple must NOT crash the whole sweep."
      [
        | payload expiresAt |
        payload := t at: 'payload' ifAbsent: [nil].
        payload notNil ifTrue: [
          expiresAt := payload at: 'claim_expires_at' ifAbsent: [nil].
          "Belt-and-braces guard: claim_expires_at is normally an Integer
           epoch, but a stale snapshot (post-completion) carries nil and
           a type-confused JSON deser could carry a non-comparable. The
           outer try/catch upgrades any '>' panic to a skip. Status was
           already filtered to 'claimed' upstream — re-check inside
           reapTask:'s atomic update guards against TOCTOU races."
          (expiresAt notNil and: [now > expiresAt]) ifTrue: [
            self reapTask: t now: now
          ]
        ]
      ] on: Exception do: [:e |
        ('Dispatcher reapExpiredClaims tuple skip (',
          (t at: 'identity' ifAbsent: ['?']), '): ', e messageText) println
      ]
    ]
  ]

  method: reapTask: taskTuple now: now [
    "Process a single expired-claim task tuple. The core state change is
     done inside BBS>>update: so the payload rewrite is atomic with the
     status re-check (the task may have been renewed or completed between
     scanAll: and this update). Emits the reap event outside the atomic
     block only if an action was taken."
    | scope taskId outcome |
    scope := taskTuple at: 'scope'.
    taskId := taskTuple at: 'identity'.
    outcome := Dictionary new.
    outcome at: 'reaped' put: false.
    outcome at: 'terminal' put: false.
    outcome at: 'prev_worker' put: nil.
    outcome at: 'retry_count' put: 0.

    bbs update: 'task' scope: scope identity: taskId do: [:p |
      | status expiresAt missed max retryCount |
      status := p at: 'status' ifAbsent: [''].
      expiresAt := p at: 'claim_expires_at' ifAbsent: [nil].
      "Re-check inside the atomic update: the task may have completed or
       been re-pended between scanAll: and here, in which case
       claim_expires_at is now nil (or some non-Number) — skip cleanly."
      (status = 'claimed'
        and: [expiresAt notNil and: [now > expiresAt]]) ifTrue: [
          missed := (p at: 'missed_renewals' ifAbsent: [0]) + 1.
          p at: 'missed_renewals' put: missed.
          missed >= 2 ifTrue: [
            retryCount := (p at: 'retry_count' ifAbsent: [0]) + 1.
            max := p at: 'max_retries' ifAbsent: [3].
            outcome at: 'reaped' put: true.
            outcome at: 'prev_worker' put: (p at: 'worker_id' ifAbsent: [nil]).
            outcome at: 'retry_count' put: retryCount.
            p at: 'retry_count' put: retryCount.
            retryCount >= max ifTrue: [
              "D6.5: exhausted retries — terminal failure."
              p at: 'status' put: 'failed'.
              p at: 'last_failure_reason' put: 'reaped'.
              p at: 'failed_at' put: now.
              outcome at: 'terminal' put: true
            ] ifFalse: [
              "Re-pend for another claim attempt."
              p at: 'status' put: 'pending'.
              p at: 'worker_id' put: nil.
              p at: 'claim_id' put: nil.
              p at: 'executed_by' put: nil.
              p at: 'claim_expires_at' put: nil.
              p at: 'renewed_at' put: nil.
              p at: 'missed_renewals' put: 0
            ]
          ]
      ]
    ].

    (outcome at: 'reaped') ifTrue: [
      | eventPayload |
      eventPayload := Dictionary new.
      eventPayload at: 'type' put: 'reap'.
      eventPayload at: 'task_id' put: taskId.
      eventPayload at: 'worker_id' put: (outcome at: 'prev_worker').
      eventPayload at: 'retry_count' put: (outcome at: 'retry_count').
      eventPayload at: 'terminal' put: (outcome at: 'terminal').
      bbs out: 'event' scope: scope
          identity: 'reap:', taskId
          payload: eventPayload actor: nil
    ]
  ]

  "--- Stuck-Dispatched Reaper ---"

  method: stuckDispatchedThresholdSeconds [
    "Tasks that sit in status='dispatched' with no worker_id for longer than
     this are considered orphaned (a fork that died without the wrap-up
     handler firing).

     CRITICAL: a LOCAL harness fork does NOT advance the task past
     'dispatched' while it runs and never sets worker_id (that is
     multiplayer-only, via /api/tasks/claim). The task stays
     'dispatched'/worker_id=nil for the *entire* harness run — up to the
     harness timeout (base 1800s for an implementer). So this threshold
     MUST exceed the longest a healthy fork can run, or live long-running
     tasks get false-positive reaped out from under a working harness
     (observed: an ~8-min implementer reaped at the old 300s floor).

     2400s = 1800s (max harness timeout) + 600s grace. If any role's
     defaultTimeout / transition timeout is raised above 1800s, raise this
     too. Genuinely-dead forks are still reaped (just after ~40min), well
     under dispatchOrphanStaleSeconds (4h). A proper fix would be
     liveness-aware reaping (heartbeat or pid/slot check) instead of a
     time threshold."
    ^2400
  ]

  method: dispatchOrphanStaleSeconds [
    "Beyond this age, an orphaned dispatched task is considered too stale
     to safely re-pend (the work it described is likely obsolete and
     re-running it would burn API tokens on irrelevant work — observed
     when stuck tasks accumulated over a multi-day server outage and the
     reaper resurrection spun up Claude sessions on long-resolved
     stories). At/above this age the task is marked failed with reason
     'dispatch-orphan-stale' instead of being re-pended."
    ^4 * 3600
  ]

  method: reapStuckDispatched [
    "Sweep task tuples that have been status='dispatched' with no
     worker_id for longer than stuckDispatchedThresholdSeconds.

     Why this exists: the claim-expiry reaper (reapExpiredClaims) only
     handles 'claimed' tasks, because the original design assumed the
     local scheduler's fork would always either complete the task or
     fail it via the wrap-up handler at Scheduler.mag:131-143. In
     practice, harness forks have been observed to die in ways that
     escape that handler (NLR out of fork, panic in primitives, etc.),
     leaving the task permanently in 'dispatched' state — workflows
     wait forever on tokens that never produce. This sweeper closes
     that gap with the same retry semantics as reapExpiredClaims.

     Detection signal: status='dispatched' AND worker_id is nil AND
     dispatched_at older than threshold. We do NOT consult the
     Scheduler's activeSlots map because (a) the dispatcher and
     scheduler are separate objects without a clean coupling for that
     query and (b) by the time the threshold elapses, any healthy fork
     would have advanced the task past 'dispatched'."
    ^self reapStuckDispatchedIn: nil
  ]

  method: reapStuckDispatchedIn: maybeTasks [
    "Snapshot-aware variant. See reapExpiredClaimsIn: for rationale."
    | now threshold tasks orphans |
    now := DateTime now epochSeconds.
    threshold := self stuckDispatchedThresholdSeconds.
    tasks := maybeTasks isNil
      ifTrue: [bbs scanAll: 'task']
      ifFalse: [maybeTasks].

    "Pre-filter to dispatched + orphan candidates BEFORE per-tuple work.
     Same defensive iteration pattern as reapExpiredClaims. GrowableArray
     replaces the O(K^2) copyWith: accumulator."
    orphans := GrowableArray new.
    tasks do: [:t |
      [
        | payload status workerId dispatchedAt |
        payload := t at: 'payload' ifAbsent: [nil].
        payload notNil ifTrue: [
          status := payload at: 'status' ifAbsent: [''].
          workerId := payload at: 'worker_id' ifAbsent: [nil].
          dispatchedAt := payload at: 'dispatched_at' ifAbsent: [nil].
          (status = 'dispatched'
            and: [workerId isNil
            and: [dispatchedAt notNil
            and: [(now - dispatchedAt) > threshold]]])
              ifTrue: [orphans add: t]
        ]
      ] on: Exception do: [:e |
        ('Dispatcher reapStuckDispatched filter skip (',
          (t at: 'identity' ifAbsent: ['?']), '): ', e messageText) println
      ]
    ].

    orphans do: [:t |
      [self reapStuckDispatchedTask: t now: now]
        on: Exception do: [:e |
          ('Dispatcher reapStuckDispatched tuple skip (',
            (t at: 'identity' ifAbsent: ['?']), '): ', e messageText) println
        ]
    ]
  ]

  method: reapStuckDispatchedTask: taskTuple now: now [
    "Reap a single orphaned dispatched task. Mirrors reapTask:'s retry
     state machine but driven by the dispatch-orphan signal rather than
     claim expiry. Atomic re-check inside the BBS update guards against
     a worker claiming the task between the snapshot and the rewrite."
    | scope taskId outcome threshold |
    scope := taskTuple at: 'scope'.
    taskId := taskTuple at: 'identity'.
    threshold := self stuckDispatchedThresholdSeconds.
    outcome := Dictionary new.
    outcome at: 'reaped' put: false.
    outcome at: 'terminal' put: false.
    outcome at: 'retry_count' put: 0.

    bbs update: 'task' scope: scope identity: taskId do: [:p |
      | status workerId dispatchedAt retryCount max staleCutoff |
      status := p at: 'status' ifAbsent: [''].
      workerId := p at: 'worker_id' ifAbsent: [nil].
      dispatchedAt := p at: 'dispatched_at' ifAbsent: [nil].
      staleCutoff := self dispatchOrphanStaleSeconds.
      (status = 'dispatched'
        and: [workerId isNil
        and: [dispatchedAt notNil
        and: [(now - dispatchedAt) > threshold]]]) ifTrue: [
          retryCount := (p at: 'retry_count' ifAbsent: [0]) + 1.
          max := p at: 'max_retries' ifAbsent: [3].
          outcome at: 'reaped' put: true.
          outcome at: 'retry_count' put: retryCount.
          p at: 'retry_count' put: retryCount.
          "Staleness short-circuit: orphans older than dispatchOrphanStaleSeconds
           skip the retry ladder entirely and fail terminally. Prevents the
           reaper from resurrecting work that is no longer relevant after a
           long outage."
          ((now - dispatchedAt) > staleCutoff) ifTrue: [
            p at: 'status' put: 'failed'.
            p at: 'last_failure_reason' put: 'dispatch-orphan-stale'.
            p at: 'failed_at' put: now.
            outcome at: 'terminal' put: true
          ] ifFalse: [
            retryCount >= max ifTrue: [
              p at: 'status' put: 'failed'.
              p at: 'last_failure_reason' put: 'dispatch-orphan'.
              p at: 'failed_at' put: now.
              outcome at: 'terminal' put: true
            ] ifFalse: [
              "Re-pend so the scheduler can take another swing at it."
              p at: 'status' put: 'pending'.
              p at: 'dispatched_at' put: nil.
              p at: 'claim_id' put: nil.
              p at: 'claim_expires_at' put: nil.
              p at: 'renewed_at' put: nil.
              p at: 'missed_renewals' put: 0
            ]
          ]
      ]
    ].

    (outcome at: 'reaped') ifTrue: [
      | eventPayload |
      eventPayload := Dictionary new.
      eventPayload at: 'type' put: 'reap'.
      eventPayload at: 'cause' put: 'dispatch-orphan'.
      eventPayload at: 'task_id' put: taskId.
      eventPayload at: 'retry_count' put: (outcome at: 'retry_count').
      eventPayload at: 'terminal' put: (outcome at: 'terminal').
      bbs out: 'event' scope: scope
          identity: 'reap:', taskId
          payload: eventPayload actor: nil.
      bbs notify: ('Reaped orphaned dispatched task: ', taskId,
                   ' (retry ', (outcome at: 'retry_count') printString, ')')
        scope: scope severity: 'warn'
    ]
  ]

  "--- Housekeeping ---"

  method: housekeep [
    "Periodic housekeeping. Single-pass design:

       1. One scanAll: per relevant category (workflow/token/task/signal).
       2. Classify workflow ids into liveWfIds and terminalWfIds.
       3. Bucket tokens/tasks by payload.workflow_instance and signals by
          scope (signals are scoped to the workflow instance directly).
       4. For each terminal workflow id: cascade-delete its bucket plus
          the workflow tuple itself.
       5. Orphan sweep: tuples whose owning workflow id is in neither set
          get removed (covers historical accumulation predating cascade).
       6. Terminal-task orphan sweep: tasks in terminal state whose
          workflow is gone and which are older than the age threshold.

     Why single-pass: the prior implementation issued 3 scanAll: calls per
     terminal workflow (one per category) inside cleanWorkflowCascade:; with
     N terminal workflows and M tuples this was O(N*M). Now it's O(M) total
     plus O(N) bucket lookups.

     (Affine-tuple expiry is handled natively by TupleSpace's outAffine:ttl:.)"
    | now threshold workflows tokens tasks signals
      liveWfIds terminalWfIds wfScope tokensByWf tasksByWf signalsByScope |
    now := DateTime now epochSeconds.
    threshold := self housekeepWorkflowAgeSeconds.

    workflows := bbs scanAll: 'workflow'.
    tokens    := bbs scanAll: 'token'.
    tasks     := bbs scanAll: 'task'.
    signals   := bbs scanAll: 'signal'.

    "Workflow staleness reaper (runs before classification). A workflow
     stuck in a non-terminal status with no live task and past its TTL is
     immortal otherwise: classifyWorkflow: only ages-out ALREADY-terminal
     workflows, so a 'running' tuple is permanently classified live and
     never cascade-removed — shown active forever, never reaped, never
     gc'd. Transition it to 'failed' so the existing terminal cascade /
     pp gc can reclaim it and it moves to Recent Completions. Mutates BBS;
     the in-memory `workflows` snapshot below still carries the old status
     this tick (failed_at=now keeps it inside the age threshold anyway), so
     the cascade picks it up on a later tick, not this one."
    [self reapStaleWorkflows: workflows tasks: tasks tokens: tokens now: now]
      on: Exception do: [:e |
        ('Dispatcher housekeep reapStaleWorkflows error: ', e messageText) println
      ].

    liveWfIds     := Set new.
    terminalWfIds := Set new.
    wfScope       := Dictionary new.
    workflows do: [:wf |
      [self classifyWorkflow: wf
            now: now
            threshold: threshold
            liveSet: liveWfIds
            terminalSet: terminalWfIds
            scopeMap: wfScope]
        on: Exception do: [:e |
          ('Dispatcher housekeep classify skip (',
            (wf at: 'identity' ifAbsent: ['?']), '): ', e messageText) println
        ]
    ].

    tokensByWf     := self bucketTuples: tokens    byPayloadField: 'workflow_instance'.
    tasksByWf      := self bucketTuples: tasks     byPayloadField: 'workflow_instance'.
    signalsByScope := self bucketTuples: signals   byTupleField:    'scope'.

    "Cascade: terminal workflows + their tokens / tasks / signals."
    terminalWfIds do: [:wfId |
      self cascadeRemove: (tokensByWf     at: wfId ifAbsent: [nil]) category: 'token'.
      self cascadeRemove: (tasksByWf      at: wfId ifAbsent: [nil]) category: 'task'.
      self cascadeRemove: (signalsByScope at: wfId ifAbsent: [nil]) category: 'signal'.
      [bbs inp: 'workflow' scope: (wfScope at: wfId ifAbsent: ['default']) identity: wfId]
        on: Exception do: [:_ | nil]
    ].

    "Orphan sweep: workflow_instance points at a workflow id that no longer
     exists (and wasn't in this tick's terminal set, since those are already
     gone). Same for signal scopes that look like workflow instance ids."
    tokensByWf keysDo: [:wfId |
      [(self isOrphanWf: wfId live: liveWfIds terminal: terminalWfIds) ifTrue: [
        self cascadeRemove: (tokensByWf at: wfId) category: 'token'
      ]]
        on: Exception do: [:e |
          ('Dispatcher housekeep token-orphan skip (', wfId printString, '): ', e messageText) println
        ]
    ].
    signalsByScope keysDo: [:sScope |
      [((self looksLikeWorkflowInstanceId: sScope)
        and: [self isOrphanWf: sScope live: liveWfIds terminal: terminalWfIds])
        ifTrue: [
          self cascadeRemove: (signalsByScope at: sScope) category: 'signal'
        ]]
        on: Exception do: [:e |
          ('Dispatcher housekeep signal-orphan skip (', sScope printString, '): ', e messageText) println
        ]
    ].

    "Terminal-task orphan sweep: tasks in terminal status whose workflow
     is gone (or never set) AND whose terminal timestamp is older than the
     age threshold. Tasks bound to live workflows are preserved as audit
     history until the workflow itself is cleaned up."
    tasks do: [:t |
      [self maybeRemoveTerminalOrphanTask: t
            now: now
            threshold: threshold
            live: liveWfIds
            terminal: terminalWfIds]
        on: Exception do: [:_ | nil]
    ]
  ]

  method: housekeepWorkflowAgeSeconds [
    "Workflows in a terminal state older than this are removed (along with
     their tokens, signals, and tasks). 24h gives observers a comfortable
     window to inspect a recently-failed workflow before it disappears,
     while still preventing unbounded accumulation across a multi-day
     server uptime."
    ^24 * 3600
  ]

  method: staleWorkflowTtlSeconds [
    "A workflow in a non-terminal status (running/dispatched) with NO live
     task and started more than this long ago is presumed abandoned and is
     transitioned to failed. Generous enough never to race a just-launched
     workflow whose first task has not been dispatched yet. Kept in sync
     with DashboardSSE>>staleWorkflowWindowSeconds (the cosmetic gate)."
    ^3600
  ]

  method: isLiveTaskStatus: status [
    "Task statuses that count as in-flight work for a workflow."
    ^status = 'pending'
      or: [status = 'dispatched'
      or: [status = 'claimed'
      or: [status = 'running']]]
  ]

  method: isLiveTokenStatus: status [
    "Token statuses that count as live orchestration for a parent workflow.
     A 'waiting' token blocks the workflow on child-workflow / task
     completion (multi-scout.cue, full-pipeline.cue via spawn-workflow); a
     'positive' token is enabled and about to fire. Either means the
     workflow is mid-flight even when it has NO live task of its own —
     without this, a healthy parent waiting on running children is
     false-positive reaped, orphaning the children (review-issue-1)."
    ^status = 'waiting' or: [status = 'positive']
  ]

  method: reapStaleWorkflows: workflows tasks: tasks tokens: tokens now: now [
    "Transition workflows stuck in a non-terminal status with no live task
     and past the staleness TTL into 'failed'. This is the durable fix for
     the immortal-running workflow: the task reapers only ever touch task
     tuples (claims/dispatched), never the parent workflow tuple, so a
     workflow whose status never left 'running' (abandoned, or cancelled
     without the cancel propagating to the workflow tuple) is never reaped.
     Once failed it is eligible for the terminal cascade and pp gc, and the
     dashboard moves it from Active to Recent Completions.

     Liveness is task OR token based: a parent workflow that spawned child
     workflows sits 'running' with a non-terminal 'waiting' token and NO
     live task of its own while the children run. Counting only tasks would
     reap such a healthy parent past the 1h TTL, bricking orchestration
     (waiting tokens never promote -> orphaned children). So a workflow with
     any live token is treated as live too (review-issue-1)."
    | ttl liveWfInstances |
    ttl := self staleWorkflowTtlSeconds.
    "Set of workflow instances with at least one live task OR live token.
     Defensive per-tuple iteration: scanAll: returns shared references that
     may be concurrently rewritten."
    liveWfInstances := Set new.
    tasks do: [:t |
      [
        | p status wfRef |
        p := t at: 'payload' ifAbsent: [nil].
        p notNil ifTrue: [
          status := p at: 'status' ifAbsent: [''].
          (self isLiveTaskStatus: status) ifTrue: [
            wfRef := p at: 'workflow_instance' ifAbsent: [nil].
            wfRef notNil ifTrue: [liveWfInstances add: wfRef]
          ]
        ]
      ] on: Exception do: [:e |
        ('Dispatcher reapStaleWorkflows live-task skip (',
          (t at: 'identity' ifAbsent: ['?']), '): ', e messageText) println
      ]
    ].
    tokens do: [:tok |
      [
        | p status wfRef |
        p := tok at: 'payload' ifAbsent: [nil].
        p notNil ifTrue: [
          status := p at: 'status' ifAbsent: [''].
          (self isLiveTokenStatus: status) ifTrue: [
            wfRef := p at: 'workflow_instance' ifAbsent: [nil].
            wfRef notNil ifTrue: [liveWfInstances add: wfRef]
          ]
        ]
      ] on: Exception do: [:e |
        ('Dispatcher reapStaleWorkflows live-token skip (',
          (tok at: 'identity' ifAbsent: ['?']), '): ', e messageText) println
      ]
    ].

    workflows do: [:wf |
      [self maybeReapStaleWorkflow: wf now: now ttl: ttl live: liveWfInstances]
        on: Exception do: [:e |
          ('Dispatcher reapStaleWorkflows tuple skip (',
            (wf at: 'identity' ifAbsent: ['?']), '): ', e messageText) println
        ]
    ]
  ]

  method: maybeReapStaleWorkflow: wf now: now ttl: ttl live: liveWfInstances [
    "Fail a single stale workflow tuple if: status is running/dispatched,
     it has no live task, and started_at (or created_at fallback) is older
     than ttl. The mutation re-checks status inside the atomic BBS update so
     an engine/worker advancing the tuple between snapshot and rewrite wins."
    | wfId payload status startedAt scope |
    payload := wf at: 'payload' ifAbsent: [nil].
    payload isNil ifTrue: [^self].
    status := payload at: 'status' ifAbsent: [''].
    (status = 'running' or: [status = 'dispatched']) ifFalse: [^self].
    wfId := wf at: 'identity'.
    (liveWfInstances includes: wfId) ifTrue: [^self].
    startedAt := payload at: 'started_at' ifAbsent: [nil].
    "Number, not Integer: persisted tuples round-trip through Json decode
     (GansoStore / loadFromDisk); whole epoch timestamps may come back as
     Float. Accept any Number so a reloaded started_at is still age-able and
     the reaper is not silently no-op'd after a restart."
    (startedAt isKindOf: Number) ifFalse: [startedAt := wf at: 'created_at' ifAbsent: [now]].
    (startedAt isKindOf: Number) ifFalse: [^self].
    ((now - startedAt) > ttl) ifFalse: [^self].

    scope := wf at: 'scope' ifAbsent: ['default'].
    bbs update: 'workflow' scope: scope identity: wfId do: [:p |
      | st |
      st := p at: 'status' ifAbsent: [''].
      (st = 'running' or: [st = 'dispatched']) ifTrue: [
        p at: 'status' put: 'failed'.
        p at: 'last_failure_reason' put: 'workflow-stale'.
        p at: 'failed_at' put: now
      ]
    ].
    bbs notify: ('Reaped stale workflow (no live task, past TTL): ', wfId)
      scope: scope severity: 'warn'
  ]

  method: classifyWorkflow: wf now: now threshold: threshold
          liveSet: liveSet terminalSet: terminalSet scopeMap: scopeMap [
    "Mutates liveSet/terminalSet/scopeMap. A workflow is terminal-aged-out
     iff its status is completed/cancelled/failed AND the corresponding
     terminal timestamp is older than `threshold`. Workflows missing a
     payload (data corruption) are conservatively treated as live so we
     don't cascade-delete based on bad input."
    | wfId payload status terminalAt |
    wfId := wf at: 'identity'.
    scopeMap at: wfId put: (wf at: 'scope' ifAbsent: ['default']).
    payload := wf at: 'payload' ifAbsent: [nil].
    payload isNil ifTrue: [liveSet add: wfId. ^self].
    status := payload at: 'status' ifAbsent: [''].
    (status = 'completed' or: [status = 'cancelled' or: [status = 'failed']])
      ifFalse: [liveSet add: wfId. ^self].
    terminalAt := nil.
    status = 'completed' ifTrue: [terminalAt := payload at: 'completed_at' ifAbsent: [nil]].
    status = 'cancelled' ifTrue: [terminalAt := payload at: 'cancelled_at' ifAbsent: [nil]].
    status = 'failed'    ifTrue: [terminalAt := payload at: 'failed_at'    ifAbsent: [nil]].
    terminalAt isNil ifTrue: [terminalAt := wf at: 'created_at' ifAbsent: [now]].
    (now - terminalAt) > threshold
      ifTrue:  [terminalSet add: wfId]
      ifFalse: [liveSet     add: wfId]
  ]

  method: bucketTuples: tuples byPayloadField: field [
    "Group `tuples` into a Dictionary keyed by the value of payload[field].
     Tuples whose payload is missing or whose field is nil are skipped (no
     bucket key — they cannot be reasoned about as belonging to a workflow).
     Each bucket value is a GrowableArray (amortized O(1) append, replaces
     the legacy `victims := victims copyWith: t` accumulator that was
     O(N^2) on large categories)."
    | buckets |
    buckets := Dictionary new.
    tuples do: [:t |
      [
        | p key bucket |
        p := t at: 'payload' ifAbsent: [nil].
        p notNil ifTrue: [
          key := p at: field ifAbsent: [nil].
          key notNil ifTrue: [
            bucket := buckets at: key ifAbsent: [nil].
            bucket isNil ifTrue: [
              bucket := GrowableArray new.
              buckets at: key put: bucket
            ].
            bucket add: t
          ]
        ]
      ] on: Exception do: [:_ | nil]
    ].
    ^buckets
  ]

  method: bucketTuples: tuples byTupleField: field [
    "Like bucketTuples:byPayloadField: but the bucket key comes from a
     top-level tuple field (e.g. 'scope'), not from the payload."
    | buckets |
    buckets := Dictionary new.
    tuples do: [:t |
      [
        | key bucket |
        key := t at: field ifAbsent: [nil].
        key notNil ifTrue: [
          bucket := buckets at: key ifAbsent: [nil].
          bucket isNil ifTrue: [
            bucket := GrowableArray new.
            buckets at: key put: bucket
          ].
          bucket add: t
        ]
      ] on: Exception do: [:_ | nil]
    ].
    ^buckets
  ]

  method: cascadeRemove: bucket category: category [
    "Issue an inp: per tuple in the bucket. Each call is wrapped so a
     single failure does not abort the rest of the cascade. Bucket may
     be a GrowableArray (from bucketTuples:) or nil (no matching tuples)."
    bucket isNil ifTrue: [^self].
    bucket do: [:t |
      [bbs inp: category
           scope: (t at: 'scope')
           identity: (t at: 'identity')]
        on: Exception do: [:_ | nil]
    ]
  ]

  method: isOrphanWf: wfId live: liveSet terminal: terminalSet [
    "True iff `wfId` is neither a live workflow nor one we just removed
     this tick. Used by the orphan sweep to find tuples whose owning
     workflow vanished in a prior session (legacy accumulation)."
    ^(liveSet includes: wfId) not and: [(terminalSet includes: wfId) not]
  ]

  method: maybeRemoveTerminalOrphanTask: t now: now threshold: threshold
          live: liveSet terminal: terminalSet [
    "Remove `t` if it is in terminal state, its workflow is gone (or its
     workflow_instance was never set), and its terminal timestamp is older
     than `threshold`. The terminal-set check skips tasks already cleaned
     up by the workflow cascade above (cheap: bucket lookup happens
     elsewhere; here we just consult the precomputed sets)."
    | p status wfRef terminalAt belongsToLive |
    p := t at: 'payload' ifAbsent: [nil].
    p isNil ifTrue: [^self].
    status := p at: 'status' ifAbsent: [''].
    (status = 'completed' or: [status = 'cancelled' or: [status = 'failed']])
      ifFalse: [^self].
    wfRef := p at: 'workflow_instance' ifAbsent: [nil].
    "If the task is bound to a live workflow we keep it as audit history."
    belongsToLive := wfRef notNil and: [liveSet includes: wfRef].
    belongsToLive ifTrue: [^self].
    "Already cleaned up via the workflow cascade — don't double-remove."
    (wfRef notNil and: [terminalSet includes: wfRef]) ifTrue: [^self].
    terminalAt := nil.
    status = 'completed' ifTrue: [terminalAt := p at: 'completed_at' ifAbsent: [nil]].
    status = 'cancelled' ifTrue: [terminalAt := p at: 'cancelled_at' ifAbsent: [nil]].
    status = 'failed'    ifTrue: [terminalAt := p at: 'failed_at'    ifAbsent: [nil]].
    terminalAt isNil ifTrue: [terminalAt := t at: 'created_at' ifAbsent: [now]].
    (now - terminalAt) > threshold ifTrue: [
      [bbs inp: 'task' scope: (t at: 'scope') identity: (t at: 'identity')]
        on: Exception do: [:_ | nil]
    ]
  ]

  method: looksLikeWorkflowInstanceId: aString [
    "Heuristic: workflow ids look like 'story-1776355979-3325',
     'full-pipeline-1776355403-3195', etc. — at least two hyphens and
     contains a digit. Conservative; system scopes (default, system,
     scope:foo) won't match."
    | hyphens hasDigit code |
    aString isNil ifTrue: [^false].
    aString isString ifFalse: [^false].
    hyphens := 0.
    hasDigit := false.
    aString do: [:c |
      "Compare by code point. Character has no relational ops in this VM
       (Character >= Character returns nil), and integer char codes are the
       project convention. Codes: '-'=45, '0'=48, '9'=57."
      code := c value.
      code = 45 ifTrue: [hyphens := hyphens + 1].
      (code >= 48 and: [code <= 57]) ifTrue: [hasDigit := true]
    ].
    ^(hyphens >= 2) and: [hasDigit]
  ]

  method: cleanTerminalOrphanTasks [
    "Remove terminal tasks (status in completed/cancelled/failed) whose
     owning workflow is already gone. Tasks bound to live workflows are
     preserved as audit history until the workflow itself is cleaned up
     (cleanWorkflowCascade handles those when the workflow is removed)."
    | workflows wfIds tasks now ageThreshold |
    workflows := bbs scanAll: 'workflow'.
    wfIds := Set new.
    workflows do: [:wf | wfIds add: (wf at: 'identity')].
    tasks := bbs scanAll: 'task'.
    now := DateTime now epochSeconds.
    "Same age window as workflows so reasoning about retention is
     uniform — terminal task lingers up to 24h after workflow vanishes."
    ageThreshold := self housekeepWorkflowAgeSeconds.

    tasks do: [:t |
      [
        | p status wfRef terminalAt |
        p := t at: 'payload' ifAbsent: [nil].
        p notNil ifTrue: [
          status := p at: 'status' ifAbsent: [''].
          ((status = 'completed' or: [status = 'cancelled' or: [status = 'failed']])
            and: [
              wfRef := p at: 'workflow_instance' ifAbsent: [nil].
              wfRef isNil or: [(wfIds includes: wfRef) not]])
          ifTrue: [
            terminalAt := nil.
            status = 'completed' ifTrue: [terminalAt := p at: 'completed_at' ifAbsent: [nil]].
            status = 'cancelled' ifTrue: [terminalAt := p at: 'cancelled_at' ifAbsent: [nil]].
            status = 'failed' ifTrue: [terminalAt := p at: 'failed_at' ifAbsent: [nil]].
            terminalAt isNil ifTrue: [terminalAt := t at: 'created_at' ifAbsent: [now]].
            (now - terminalAt) > ageThreshold ifTrue: [
              [bbs inp: 'task' scope: (t at: 'scope') identity: (t at: 'identity')]
                on: Exception do: [:_ | nil]
            ]
          ]
        ]
      ] on: Exception do: [:_ | nil]
    ]
  ]

  "--- Direct Operations ---"

  method: instantiateWorkflow: templateId scope: scope params: params launchedBy: launchedBy overrideAffinity: overrideAffinity [
    "F4.3: instantiate a workflow with a CLI-provided affinity override that
     wins over per-transition and workflow-root CUE affinity for every task
     spawned under the returned instance."
    ^workflowEngine instantiate: templateId scope: scope params: params launchedBy: launchedBy overrideAffinity: overrideAffinity
  ]
