"Base role definition for Procyon Park agents.
 Each role defines a system prompt, context constraints, and pp commands."

Role subclass: Object
  instanceVars: name description systemPromptTemplate contextConstraints ppCommands

  "--- Class-side protocol: subclasses override these ---"

  classMethod: roleName [ ^'role' ]
  classMethod: roleDescription [ ^'Override roleDescription in subclass.' ]
  classMethod: rolePpCommands [ ^#() ]
  classMethod: hardCategories [ ^#() ]
  classMethod: softCategories [ ^#() ]
  classMethod: contextBudget [ ^50 ]
  classMethod: defaultTimeout [
    "Default wall-clock timeout (seconds) for agent runs under this role.
     Override in subclasses when a role's typical work is shorter or longer
     than the 30-minute default. Transition-level `timeout` in CUE overrides
     this per-transition."
    ^1800
  ]

  classMethod: new [
    "Template method: builds a Role from class-side protocol overrides."
    | r hard soft constraints |
    r := super new.
    r name: self roleName.
    r description: self roleDescription.
    r ppCommands: self rolePpCommands.

    hard := self buildConstraintSpecs: self hardCategories.
    soft := self buildConstraintSpecs: self softCategories.

    constraints := Dictionary new.
    constraints at: 'hard' put: hard.
    constraints at: 'soft' put: soft.
    constraints at: 'budget' put: self contextBudget.
    r contextConstraints: constraints.

    ^r
  ]

  classMethod: buildConstraintSpecs: categories [
    "Convert an array of category strings into constraint spec dictionaries."
    | specs |
    specs := Array new: 0.
    categories do: [:cat |
      | h |
      h := Dictionary new.
      h at: 'category' put: cat.
      specs := specs copyWith: h
    ].
    ^specs
  ]

  "--- Instance accessors ---"

  method: name [ ^name ]
  method: description [ ^description ]
  method: systemPromptTemplate [ ^systemPromptTemplate ]
  method: contextConstraints [ ^contextConstraints ]
  method: ppCommands [ ^ppCommands ]

  method: name: n [ name := n ]
  method: description: d [ description := d ]
  method: systemPromptTemplate: t [ systemPromptTemplate := t ]
  method: contextConstraints: c [ contextConstraints := c ]
  method: ppCommands: p [ ppCommands := p ]

  method: defaultTimeout [
    "Instance-side accessor delegating to the class-side default. Harnesses
     call this to pick a fallback timeout when the transition does not
     specify one."
    ^self class defaultTimeout
  ]

  method: primeFor: taskDescription context: contextTuples [
    "Backward compat: no workdir boundary."
    ^self primeFor: taskDescription context: contextTuples workDir: nil repoName: nil
  ]

  method: primeFor: taskDescription context: contextTuples workDir: aWorkDir repoName: aRepoName [
    "Assemble the full system prompt for this role, given a task and context."
    | prompt |
    prompt := self systemPromptHeader.

    "Repo and workspace boundary"
    aRepoName notNil ifTrue: [
      prompt := prompt, '

## Repository
You are working in repository: **', aRepoName, '**'
    ].
    aWorkDir notNil ifTrue: [
      prompt := prompt, '
Working directory: ', aWorkDir, '

## WORKSPACE BOUNDARY (ENFORCED)
You MUST only create, modify, or delete files within:
  ', aWorkDir, '

You MUST NOT:
- Modify files outside this directory
- Use absolute paths to write elsewhere
- cd to directories outside your workspace
Violations will be detected and reverted.
'
    ].

    prompt := prompt, '

## Your Task
', taskDescription, '

## Context from the Knowledge Base
'.
    contextTuples do: [:t |
      prompt := prompt, (self renderContextTuple: t)
    ].

    "Doctrine voting invitation — ONLY for roles that consume doctrine. The
     doctrine entries above carry their dctr- ids prominently so the agent can
     name one in a vote. The invitation is deliberately opt-in and sparse."
    (self consumesDoctrine: name) ifTrue: [
      prompt := prompt, self doctrineVotingInstruction
    ].

    prompt := prompt, '

## Commands
', self commandReference, '

## Rules (in priority order)
1. MUST commit all code changes before dismissing (git add + git commit).
2. MUST NOT modify files outside your working directory.
3. MUST NOT coordinate with other agents directly — all coordination flows through pp.
4. MUST report unexpected findings via pp observe.
5. MUST follow the completion steps below exactly, in order.

## Completion Steps
', self completionInstructions.

    ^prompt
  ]

  method: commandReference [
    | ref |
    ref := ''.
    ppCommands do: [:cmd |
      ref := ref, '  ', cmd, '
'
    ].
    ^ref
  ]

  method: renderContextTuple: t [
    "Render one context tuple as a prompt section. Doctrine entries get a
     compact, vote-ready rendering (the dctr- id is surfaced prominently so the
     agent can name it in a feedback vote); all other categories keep the
     generic detail/JSON rendering."
    | cat ident payload |
    cat := t at: 'category' ifAbsent: ['?'].
    ident := t at: 'identity' ifAbsent: ['?'].
    payload := t at: 'payload' ifAbsent: [Dictionary new].
    cat = 'doctrine' ifTrue: [^self renderDoctrineEntry: ident payload: payload].
    ^'
### [', cat, '] ', ident, '
', (payload at: 'detail' ifAbsent: [Json encode: payload]), '
'
  ]

  method: renderDoctrineEntry: ident payload: payload [
    "Compact, vote-ready rendering of a single injected doctrine entry. The
     dctr- id (ident) is rendered PROMINENTLY on its own line — the agent cites
     exactly that id to register a vote — followed by the principle and a short
     rationale. Kept tight on purpose so doctrine does not crowd the role's
     actual working context."
    | principle rationale block |
    principle := payload at: 'principle' ifAbsent: [''].
    rationale := payload at: 'rationale' ifAbsent: [''].
    principle isString ifFalse: [principle := ''].
    rationale isString ifFalse: [rationale := ''].
    block := '
### [doctrine] ', ident, '
**doctrine id: ', ident, '**  (cite this id to vote)
', principle.
    rationale isEmpty ifFalse: [
      block := block, '
_why:_ ', rationale
    ].
    ^block, '
'
  ]

  method: doctrineVotingInstruction [
    "Opt-in, SPARSE invitation to vote on the injected doctrine. Deliberately
     framed as OPTIONAL and UNCOMMON: a mandatory rate-all would manufacture
     sycophantic noise. Abstention is the norm — agents should vote only on a
     strong signal, and a downvote must carry a one-line reason. Shown ONLY to
     roles for which consumesDoctrine: is true (see primeFor:)."
    ^'

## Doctrine Feedback (optional)
The doctrine above was selected to guide THIS task. If — and only if — you feel STRONGLY about a specific entry, register it with: pp doctrine feedback <id> --up   (it clearly helped)   OR   pp doctrine feedback <id> --down --reason "<why>"   (it was wrong, misleading, or did not apply here). Most sessions you will NOT vote, and that is correct — abstention is the norm. Vote only on strong signal; never rubber-stamp. A downvote needs a one-line reason.
'
  ]

  method: systemPromptHeader [
    ^'You are a ', name, ' agent in the Procyon Park orchestration system.

', description
  ]

  method: completionInstructions [
    "Subclasses override this for role-specific completion behavior."
    ^'1. git add -A && git commit -m "<summary of changes>"
2. pp dismiss'
  ]

  method: assembleContext: bbs scope: scope taskId: taskId [
    "Backward compat: no workflow filtering."
    ^self assembleContext: bbs scope: scope taskId: taskId workflowInstance: ''
  ]

  method: assembleContext: bbs scope: scope taskId: taskId workflowInstance: wfInstance [
    "Assemble context tuples from the BBS based on this role''s constraints.
     When wfInstance is non-empty, tuples with a workflow_instance field are
     filtered to only include those belonging to this workflow.

     Per-category recency cap: instead of including every tuple in a hard
     category (which lets stale observations from earlier pipeline cycles
     crowd out fresh ones), each category contributes only the N most recent
     tuples. The BBS index is append-ordered by monotonic id, so the tail of
     a scan is the most recent slice. N is computed per category from the
     remaining budget so hard and soft categories share fairly."
    | hard soft budget result conventions remaining totalCats perCatHard perCatSoft take |
    hard := contextConstraints at: 'hard' ifAbsent: [#()].
    soft := contextConstraints at: 'soft' ifAbsent: [#()].
    budget := contextConstraints at: 'budget' ifAbsent: [50].
    result := Array new: 0.

    "Always include conventions (global, not workflow-scoped)"
    conventions := bbs scanAll: 'convention'.
    result := result, conventions.

    "Compute per-category recency cap for hard categories.
     Split the post-conventions budget evenly across all constrained categories
     so a few noisy categories (e.g. observation) cannot starve the rest."
    remaining := budget - result size.
    totalCats := hard size + soft size.
    perCatHard := 3.
    (hard size > 0 and: [remaining > 0]) ifTrue: [
      perCatHard := (remaining + totalCats - 1) // totalCats.
      perCatHard < 3 ifTrue: [perCatHard := 3]
    ].

    "Hard constraints — include N most recent per category, filtered by workflow."
    hard do: [:spec |
      | cat tuples recent |
      cat := spec at: 'category'.
      tuples := bbs scan: cat scope: scope.
      tuples := self filterByWorkflow: tuples instance: wfInstance.
      recent := self mostRecent: tuples count: perCatHard.
      result := result, recent
    ].

    "Soft constraints — N most recent per category, bounded by remaining budget."
    remaining := budget - result size.
    (soft size > 0 and: [remaining > 0]) ifTrue: [
      perCatSoft := (remaining + soft size - 1) // soft size.
      perCatSoft < 1 ifTrue: [perCatSoft := 1].
      soft do: [:spec |
        remaining > 0 ifTrue: [
          | cat tuples recent |
          cat := spec at: 'category'.
          tuples := bbs scan: cat scope: scope.
          tuples := self filterByWorkflow: tuples instance: wfInstance.
          take := perCatSoft.
          take > remaining ifTrue: [take := remaining].
          recent := self mostRecent: tuples count: take.
          result := result, recent.
          remaining := budget - result size
        ]
      ]
    ].

    "Doctrine (the Orient layer): route ACTIVE, applicable doctrine into the
     planner AND the execution roles (implementer/reviewer/scout/fixer). Orient
     should bias every Act, not just every Decide — the synthesized lessons are
     mostly execution-time guidance, so they must reach the roles that write
     code and review it, not only the planner that decomposes epics.

     This BYPASSES the soft-category path on purpose — a generic soft-category
     read would surface proposed/rejected/retired entries and miss global scope,
     defeating the human promotion gate. activeDoctrineFor:scope:role: keeps the
     active-only gate and scope-union, then targets by role-tag and caps the
     number of entries for relevance so agent context does not bloat."
    (self consumesDoctrine: name) ifTrue: [
      | taskTuple queryText |
      "Thread the task's free text into doctrine ranking so the (capped) slots
       go to doctrine relevant to THIS task, not an arbitrary slice. When no
       task description is available (nil tuple / empty field) the query is ''
       and the ranking degrades gracefully to tag-overlap + universals +
       confidence (see rankDoctrine:role:scope:query:cap:)."
      taskTuple := bbs rdp: 'task' scope: scope identity: taskId.
      queryText := taskTuple notNil
        ifTrue: [(taskTuple at: 'payload' ifAbsent: [Dictionary new])
                   at: 'description' ifAbsent: ['']]
        ifFalse: [''].
      result := result, (self activeDoctrineFor: bbs scope: scope role: name query: queryText)
    ].

    ^result
  ]

  method: consumesDoctrine: roleName [
    "Roles whose context is biased by doctrine: the planner consumes it at
     plan-time (Orient -> Decide); the execution roles consume it at act-time
     (Orient -> Act). Other roles (e.g. strategist, archivist, foreman) do not."
    ^#('planner' 'implementer' 'reviewer' 'scout' 'fixer') includes: roleName
  ]

  classMethod: maxDoctrineEntries [
    "Per-role cap on injected doctrine entries. Doctrine is advisory Orient-layer
     bias, not task context — surfacing every applicable entry would crowd out
     the role's actual working context. 6 keeps the most relevant lessons while
     bounding bloat. Override per-role if a role wants a wider/narrower window."
    ^6
  ]

  method: activeDoctrineFor: bbs scope: scope [
    "Backward-compatible entry point: rank for this instance's own role."
    ^self activeDoctrineFor: bbs scope: scope role: name
  ]

  method: activeDoctrineFor: bbs scope: scope role: aRole [
    "Backward-compatible entry point with no task query: rank by tag-overlap
     against the role + repo context, universals, and confidence."
    ^self activeDoctrineFor: bbs scope: scope role: aRole query: ''
  ]

  method: activeDoctrineFor: bbs scope: scope role: aRole query: queryText [
    "Return ACTIVE doctrine tuples applicable to <scope>, targeted at <aRole>,
     ranked for relevance to <queryText> (the task's free text) and capped at
     maxDoctrineEntries.

     Applicability is by payload.doctrine_scope (global | <repo> | <repo>:<path>),
     NOT the BBS storage scope, so doctrine is scanned across all scopes and
     composed by scope-union {global, this-repo}. Maturity is gated to 'active'
     ONLY — proposed/rejected/retired are never surfaced.

     Role targeting: when an entry carries a 'role:<name>' tag it is surfaced
     ONLY to that role (or to all when the tag is 'role:universal'); entries
     with no role: tag are universal. These HARD gates run first; the survivors
     are then SCORED by a deterministic hybrid of tag-overlap + IDF-weighted
     lexical similarity to the task text (see rankDoctrine:role:scope:query:cap:),
     with a small universal floor so cross-cutting wisdom always lands. The cap
     then bounds how many reach the agent so context does not bloat."
    | all candidates |
    all := bbs scanAll: 'doctrine'.
    candidates := Array new: 0.
    all do: [:t |
      | p mat ds applies tags roleTag roleOk notRedundant |
      p := t at: 'payload' ifAbsent: [Dictionary new].
      mat := p at: 'maturity' ifAbsent: ['proposed'].
      ds := p at: 'doctrine_scope' ifAbsent: ['global'].
      applies := (ds = 'global')
        or: [(ds = scope) or: [ds startsWith: (scope, ':')]].
      tags := p at: 'tags' ifAbsent: [#()].
      roleTag := self roleTagOf: tags.
      roleOk := (roleTag = '')
        or: [(roleTag = 'universal') or: [roleTag = aRole]].
      "Double-counting guard: a doctrine that has crystallized INTO a CONVENTION
       is — by the crystallize qualification clause — now UNCONDITIONAL, so as
       advisory it is pure redundancy: the binding convention already lands in
       execution-time context. Suppress it from advisory injection entirely (it
       survives only as the convention's rationale/lineage record), freeing a
       scarce slot for non-redundant guidance. A doctrine that merely spawned a
       WORKITEM (or kept its own conditionality) NEVER lost its judgment clause
       and STAYS in rotation."
      notRedundant := (self doctrineCrystallizedIntoConvention: p) not.
      (mat = 'active' and: [applies and: [roleOk and: [notRedundant]]]) ifTrue: [
        candidates := candidates copyWith: t
      ]
    ].
    ^self rankDoctrine: candidates role: aRole scope: scope query: queryText
        cap: self class maxDoctrineEntries
  ]

  method: roleTagOf: tags [
    "Extract the role target from a doctrine entry's tags: the value of a
     'role:<name>' tag (lowercased), or '' when no role: tag is present (i.e.
     the entry is universal). Only the first role: tag is honored."
    | prefix |
    prefix := 'role:'.
    tags do: [:tag |
      (tag startsWith: prefix) ifTrue: [
        ^(tag copyFrom: prefix size + 1 to: tag size) asLowercase
      ]
    ].
    ^''
  ]

  method: doctrineCrystallizedIntoConvention: payload [
    "True iff this doctrine payload's crystallized_into forward-edge includes a
     link whose category is 'convention'. Such a doctrine has crystallized into a
     BINDING convention and is now unconditional, so re-injecting it as advisory
     double-counts the guidance the convention already supplies at execution time.

     PRECISE: only a category='convention' link suppresses. A 'workitem' link (or
     any other category) does NOT — that doctrine kept its judgment clause and
     stays in advisory rotation.

     NULL-TOLERANT: a missing field, a non-Array value, or non-Dictionary link
     entries are all treated as 'no convention link' (the normal, unsuppressed
     case) — never a crash."
    | links |
    payload isNil ifTrue: [^false].
    links := payload at: 'crystallized_into' ifAbsent: [nil].
    (links isNil or: [(links isKindOf: Array) not]) ifTrue: [^false].
    links do: [:l |
      ((l isKindOf: Dictionary)
        and: [(l at: 'category' ifAbsent: [nil]) = 'convention'])
          ifTrue: [^true]
    ].
    ^false
  ]

  method: doctrineIsUniversal: tags [
    "Universal entries are always relevant to every consuming role: those with
     no tags at all, or whose only role target is 'role:universal'."
    | roleTag |
    tags isEmpty ifTrue: [^true].
    roleTag := self roleTagOf: tags.
    ^roleTag = 'universal'
  ]

  method: doctrineContextTermsFor: aRole scope: scope [
    "Context an entry's tags are scored against for relevance: the consuming
     role and the repo (scope). Tags overlapping these rank ahead of unrelated
     ones when the cap forces a choice."
    | terms |
    terms := Array new: 0.
    terms := terms copyWith: aRole.
    terms := terms copyWith: ('role:', aRole).
    (scope notNil and: [scope isEmpty not]) ifTrue: [
      terms := terms copyWith: scope.
      terms := terms copyWith: ('repo:', scope)
    ].
    ^terms
  ]

  method: doctrineContextTermsFor: aRole scope: scope query: queryText [
    "Tag-match context for relevance scoring: the consuming role, the repo
     (scope), AND keywords tokenized from the task description. A doctrine tag
     (e.g. topic:sse, concern:dashboard) scores when its value matches one of
     these terms, so task-relevant doctrine ranks ahead of unrelated entries."
    | terms toks |
    terms := self doctrineContextTermsFor: aRole scope: scope.
    toks := self doctrineTokenize: queryText.
    toks do: [:tk | terms := terms copyWith: tk].
    ^terms
  ]

  method: tagValue: tag [
    "The value portion of a 'prefix:value' tag, or '' when the tag has no colon."
    | idx |
    idx := tag indexOf: ':'.
    idx <= 0 ifTrue: [^''].
    ^tag copyFrom: idx + 1 to: tag size
  ]

  method: doctrineOverlapScore: tags context: ctx [
    "Count how many of an entry's tags overlap the context terms. A tag overlaps
     when the tag itself, or its value after a ':', matches a context term."
    | score |
    score := 0.
    tags do: [:tag |
      | val |
      (ctx includes: tag)
        ifTrue: [score := score + 1]
        ifFalse: [
          val := self tagValue: tag.
          (val isEmpty not and: [ctx includes: val]) ifTrue: [score := score + 1]
        ]
    ].
    ^score
  ]

  classMethod: doctrineUniversalFloor [
    "How many of the capped slots are reserved for the highest-confidence
     universal/untagged entries, so cross-cutting wisdom (e.g. 'commit
     incrementally', 'cleanup must be fail-safe') always lands regardless of
     how the task-specific score shakes out. 1-2 is the sweet spot: enough to
     guarantee a floor of cross-cutting doctrine without crowding out the
     task-relevant entries the cap is meant to surface."
    ^2
  ]

  method: doctrineUniversalFloor [ ^self class doctrineUniversalFloor ]

  method: rankDoctrine: candidates role: aRole scope: scope query: queryText cap: cap [
    "Pick the (<= cap) most relevant active+applicable doctrine entries for a
     task, deterministically. NO randomness anywhere — the cap exists because
     agent context is scarce, so the slots must go to the most relevant entries.

     SCORING (per survivor of the hard gates):
       tagScore  — number of the entry's tags whose value matches a task-derived
                   context term (role, repo, description keywords). Weighted high
                   (high precision).
       textScore — IDF-weighted, length-normalized lexical overlap between the
                   task query and the entry's principle+rationale, in [0,1000].
                   Verbose rationales do not dominate (union-normalized).
       score = (tagScore * tagWeight) + textScore   (tags somewhat heavier).

     SELECTION:
       1. Reserve up to doctrineUniversalFloor slots for the highest-confidence
          universal/untagged entries (the universal floor).
       2. Fill the remaining slots up to cap by descending score.
       Tie-break is deterministic: score desc, then confidence desc, then
       identity asc (a total order — same (query, corpus) always yields the
       same ordering)."
    | ctx queryTokens idf scored floor out chosen i |
    cap <= 0 ifTrue: [^Array new: 0].

    "Tag-match context = role + repo + task keywords."
    ctx := self doctrineContextTermsFor: aRole scope: scope query: queryText.
    queryTokens := self doctrineUniqueTokens: queryText.

    "IDF computed over the candidate doctrine corpus (down-weights common tokens)."
    idf := self doctrineIdf: candidates.

    "Score every candidate."
    scored := Array new: 0.
    candidates do: [:t |
      | p tags pair |
      p := t at: 'payload' ifAbsent: [Dictionary new].
      tags := p at: 'tags' ifAbsent: [#()].
      pair := Dictionary new.
      pair at: 'tuple' put: t.
      pair at: 'score' put: (self doctrineScoreOf: p context: ctx
                               query: queryTokens idf: idf).
      pair at: 'conf' put: (self doctrineConfidenceMilli: p).
      pair at: 'ident' put: (t at: 'identity' ifAbsent: ['']).
      pair at: 'universal' put: (self doctrineIsUniversal: tags).
      scored := scored copyWith: pair
    ].

    out := Array new: 0.
    chosen := Set new.

    "1. Universal floor: highest-confidence universal/untagged entries first."
    floor := self doctrineUniversalFloor.
    floor > cap ifTrue: [floor := cap].
    floor > 0 ifTrue: [
      | universals |
      universals := scored select: [:e | e at: 'universal'].
      universals := self doctrineSortByConfidence: universals.
      i := 1.
      [i <= universals size and: [out size < floor]] whileTrue: [
        | e |
        e := universals at: i.
        out := out copyWith: (e at: 'tuple').
        chosen add: (e at: 'ident').
        i := i + 1
      ]
    ].

    "2. Fill the remaining slots by descending score."
    scored := self doctrineSortByScore: scored.
    i := 1.
    [i <= scored size and: [out size < cap]] whileTrue: [
      | e |
      e := scored at: i.
      (chosen includes: (e at: 'ident')) ifFalse: [
        out := out copyWith: (e at: 'tuple').
        chosen add: (e at: 'ident')
      ].
      i := i + 1
    ].
    ^out
  ]

  method: doctrineSortByScore: entries [
    "Deterministic total order: score desc, then confidence desc, then identity
     asc. Returns a fresh sorted array (does not mutate the input)."
    | arr |
    arr := entries copyFrom: 1 to: entries size.
    arr sort: [:a :b |
      | sa sb ca cb ida idb |
      sa := a at: 'score'. sb := b at: 'score'.
      sa > sb ifTrue: [-1] ifFalse: [ sa < sb ifTrue: [1] ifFalse: [
        ca := a at: 'conf'. cb := b at: 'conf'.
        ca > cb ifTrue: [-1] ifFalse: [ ca < cb ifTrue: [1] ifFalse: [
          ida := a at: 'ident'. idb := b at: 'ident'.
          ida < idb ifTrue: [-1] ifFalse: [ ida > idb ifTrue: [1] ifFalse: [0] ]
        ]]
      ]]
    ].
    ^arr
  ]

  method: doctrineSortByConfidence: entries [
    "Deterministic total order: confidence desc, then identity asc."
    | arr |
    arr := entries copyFrom: 1 to: entries size.
    arr sort: [:a :b |
      | ca cb ida idb |
      ca := a at: 'conf'. cb := b at: 'conf'.
      ca > cb ifTrue: [-1] ifFalse: [ ca < cb ifTrue: [1] ifFalse: [
        ida := a at: 'ident'. idb := b at: 'ident'.
        ida < idb ifTrue: [-1] ifFalse: [ ida > idb ifTrue: [1] ifFalse: [0] ]
      ]]
    ].
    ^arr
  ]

  method: doctrineScoreOf: payload context: ctx query: queryTokens idf: idf [
    "Hybrid relevance score: tags weighted high (high precision), plus the
     IDF-weighted lexical text score in [0,1000]. Tags are somewhat heavier so
     a tag match outranks pure lexical similarity, but text still discriminates
     between entries with equal tag overlap and contributes cross-boundary signal."
    | tags tagScore textScore |
    tags := payload at: 'tags' ifAbsent: [#()].
    tagScore := self doctrineOverlapScore: tags context: ctx.
    textScore := self doctrineTextScore: queryTokens
                   docText: (self doctrineDocText: payload) idf: idf.
    ^(tagScore * 1500) + textScore
  ]

  method: doctrineDocText: payload [
    "The text an entry is lexically scored against: its principle plus rationale."
    | pr ra |
    pr := payload at: 'principle' ifAbsent: [''].
    ra := payload at: 'rationale' ifAbsent: [''].
    pr isString ifFalse: [pr := ''].
    ra isString ifFalse: [ra := ''].
    ^pr, ' ', ra
  ]

  method: doctrineTextScore: queryTokens docText: docText idf: idf [
    "IDF-weighted, length-normalized lexical similarity in integer milli-units
     [0,1000] (no floats: Maggie '/' truncates and float printing is unreliable).

     Weighted Jaccard: (sum idf over q INTERSECT d) / (sum idf over q UNION d),
     scaled by 1000. Union-normalization length-normalizes — a verbose rationale
     grows the union denominator, so it cannot dominate on sheer length. Empty
     query degrades to 0 (the caller then ranks by tag-overlap + confidence)."
    | docTokens allTokens inter union |
    queryTokens isEmpty ifTrue: [^0].
    docTokens := self doctrineUniqueTokens: docText.
    docTokens isEmpty ifTrue: [^0].
    allTokens := Set new.
    queryTokens do: [:tk | allTokens add: tk].
    docTokens do: [:tk | allTokens add: tk].
    inter := 0. union := 0.
    allTokens do: [:tk |
      | w |
      w := idf at: tk ifAbsent: [1000].
      union := union + w.
      ((queryTokens includes: tk) and: [docTokens includes: tk])
        ifTrue: [inter := inter + w]
    ].
    union <= 0 ifTrue: [^0].
    ^(inter * 1000) // union
  ]

  method: doctrineIdf: candidates [
    "Inverse document frequency (integer, scaled by 1000) over the candidate
     doctrine corpus: idf(t) = 1000 * N / df(t). Rare tokens weigh more; tokens
     common across candidates (e.g. 'must', surviving stopword stripping) weigh
     less, so they do not drive relevance. Pure and deterministic; unit-testable."
    | n df idf |
    n := candidates size.
    df := Dictionary new.
    candidates do: [:t |
      | p toks |
      p := t at: 'payload' ifAbsent: [Dictionary new].
      toks := self doctrineUniqueTokens: (self doctrineDocText: p).
      toks do: [:tk | df at: tk put: ((df at: tk ifAbsent: [0]) + 1) ]
    ].
    idf := Dictionary new.
    df keysAndValuesDo: [:tk :d |
      | denom |
      denom := d.
      denom < 1 ifTrue: [denom := 1].
      idf at: tk put: ((1000 * n) // denom)
    ].
    ^idf
  ]

  method: doctrineUniqueTokens: aString [
    "The deduplicated token set of a string (a Set, so includes:/do:/isEmpty work)."
    | set |
    set := Set new.
    (self doctrineTokenize: aString) do: [:tk | set add: tk].
    ^set
  ]

  method: doctrineTokenize: aString [
    "Tokenizer: lowercase, split on non-alphanumeric, drop a small stopword set
     and 1-character tokens. Returns an Array of tokens in order of appearance.
     Pure and deterministic; unit-testable in isolation."
    | s out n i start code isAlnum stops |
    (aString isNil or: [aString isString not]) ifTrue: [^Array new: 0].
    s := aString asLowercase.
    out := Array new: 0.
    stops := self doctrineStopwords.
    n := s size.
    i := 1.
    start := 0.
    [i <= n] whileTrue: [
      "After lowercasing, ASCII letters are 97..122 and digits 48..57."
      code := (s at: i) value.
      isAlnum := (code >= 97 and: [code <= 122]) or: [(code >= 48) and: [code <= 57]].
      isAlnum
        ifTrue: [ start = 0 ifTrue: [start := i] ]
        ifFalse: [
          start > 0 ifTrue: [
            out := self doctrineEmit: (s copyFrom: start to: i - 1) into: out stops: stops.
            start := 0
          ]
        ].
      i := i + 1
    ].
    start > 0 ifTrue: [
      out := self doctrineEmit: (s copyFrom: start to: n) into: out stops: stops
    ].
    ^out
  ]

  method: doctrineEmit: tok into: out stops: stops [
    "Append a candidate token to the token list unless it is too short or a
     stopword. Helper for doctrineTokenize: (keeps the scan loop readable)."
    (tok size >= 2 and: [(stops includes: tok) not])
      ifTrue: [^out copyWith: tok].
    ^out
  ]

  method: doctrineStopwords [
    "A small stopword set stripped before scoring so ubiquitous glue words do
     not generate spurious lexical overlap. Returns a Set for O(1) membership."
    | s |
    s := Set new.
    #('the' 'and' 'for' 'are' 'but' 'not' 'you' 'all' 'any' 'can' 'was' 'has'
      'had' 'its' 'this' 'that' 'with' 'from' 'they' 'will' 'would' 'there'
      'their' 'what' 'which' 'when' 'them' 'then' 'than' 'into' 'over' 'such'
      'only' 'some' 'must' 'should' 'before' 'after' 'every' 'each' 'been'
      'being' 'have' 'were' 'where' 'while' 'about' 'against' 'across' 'per')
      do: [:w | s add: w].
    ^s
  ]

  method: doctrineConfidenceMilli: payload [
    "Parse a confidence string like '0.72' into integer milli-units (720),
     without floats (Maggie '/' truncates and float printing is unreliable).
     Missing/garbage confidence defaults to 500 (0.5) so unscored entries sort
     in the middle deterministically. Values in [0,1] map to [0,1000]."
    | raw intPart frac fracCount seenDot |
    raw := payload at: 'confidence' ifAbsent: [nil].
    (raw isNil or: [raw isString not]) ifTrue: [^500].
    raw := raw trimBoth.
    raw isEmpty ifTrue: [^500].
    intPart := 0. frac := 0. fracCount := 0. seenDot := false.
    raw do: [:c |
      | code |
      code := c value.
      code = 46
        ifTrue: [seenDot := true]
        ifFalse: [
          (code >= 48 and: [code <= 57]) ifTrue: [
            seenDot
              ifTrue: [ fracCount < 3 ifTrue: [ frac := (frac * 10) + (code - 48). fracCount := fracCount + 1 ] ]
              ifFalse: [ intPart := (intPart * 10) + (code - 48) ]
          ]
        ]
    ].
    [fracCount < 3] whileTrue: [ frac := frac * 10. fracCount := fracCount + 1 ].
    ^(intPart * 1000) + frac
  ]

  method: mostRecent: tuples count: n [
    "Return the n most recently appended tuples from a scan result.
     The BBS index preserves append order (monotonic id), so recency-descending
     means the last n entries. Returns the input unchanged when it already fits."
    | size start |
    n <= 0 ifTrue: [^Array new: 0].
    size := tuples size.
    size <= n ifTrue: [^tuples].
    start := size - n + 1.
    "copyFrom:to: is 1-indexed closed [start, size] (both inclusive)."
    ^tuples copyFrom: start to: size
  ]

  method: filterByWorkflow: tuples instance: wfInstance [
    "Filter tuples: if wfInstance is set, only include tuples that either
     have no workflow_instance field (global) or match this workflow.
     If wfInstance is empty, return all tuples unfiltered."
    wfInstance isEmpty ifTrue: [^tuples].
    ^tuples select: [:t |
      | payload tWf |
      payload := t at: 'payload' ifAbsent: [Dictionary new].
      tWf := payload at: 'workflow_instance' ifAbsent: [''].
      tWf isEmpty or: [tWf = wfInstance]
    ]
  ]
