"Base role definition for Procyon Park agents.
 Each role defines a system prompt, context constraints, and pp commands."

Role subclass: Object
  instanceVars: name description systemPromptTemplate contextConstraints ppCommands

  "--- Class-side protocol: subclasses override these ---"

  classMethod: roleName [ ^'role' ]
  classMethod: roleDescription [ ^'Override roleDescription in subclass.' ]
  classMethod: rolePpCommands [ ^#() ]
  classMethod: hardCategories [ ^#() ]
  classMethod: softCategories [ ^#() ]
  classMethod: contextBudget [ ^50 ]
  classMethod: defaultTimeout [
    "Default wall-clock timeout (seconds) for agent runs under this role.
     Override in subclasses when a role's typical work is shorter or longer
     than the 30-minute default. Transition-level `timeout` in CUE overrides
     this per-transition."
    ^1800
  ]

  classMethod: new [
    "Template method: builds a Role from class-side protocol overrides."
    | r hard soft constraints |
    r := super new.
    r name: self roleName.
    r description: self roleDescription.
    r ppCommands: self rolePpCommands.

    hard := self buildConstraintSpecs: self hardCategories.
    soft := self buildConstraintSpecs: self softCategories.

    constraints := Dictionary new.
    constraints at: 'hard' put: hard.
    constraints at: 'soft' put: soft.
    constraints at: 'budget' put: self contextBudget.
    r contextConstraints: constraints.

    ^r
  ]

  classMethod: buildConstraintSpecs: categories [
    "Convert an array of category strings into constraint spec dictionaries."
    | specs |
    specs := Array new: 0.
    categories do: [:cat |
      | h |
      h := Dictionary new.
      h at: 'category' put: cat.
      specs := specs copyWith: h
    ].
    ^specs
  ]

  "--- Instance accessors ---"

  method: name [ ^name ]
  method: description [ ^description ]
  method: systemPromptTemplate [ ^systemPromptTemplate ]
  method: contextConstraints [ ^contextConstraints ]
  method: ppCommands [ ^ppCommands ]

  method: name: n [ name := n ]
  method: description: d [ description := d ]
  method: systemPromptTemplate: t [ systemPromptTemplate := t ]
  method: contextConstraints: c [ contextConstraints := c ]
  method: ppCommands: p [ ppCommands := p ]

  method: defaultTimeout [
    "Instance-side accessor delegating to the class-side default. Harnesses
     call this to pick a fallback timeout when the transition does not
     specify one."
    ^self class defaultTimeout
  ]

  method: primeFor: taskDescription context: contextTuples [
    "Backward compat: no workdir boundary."
    ^self primeFor: taskDescription context: contextTuples workDir: nil repoName: nil
  ]

  method: primeFor: taskDescription context: contextTuples workDir: aWorkDir repoName: aRepoName [
    "Assemble the full system prompt for this role, given a task and context."
    | prompt |
    prompt := self systemPromptHeader.

    "Repo and workspace boundary"
    aRepoName notNil ifTrue: [
      prompt := prompt, '

## Repository
You are working in repository: **', aRepoName, '**'
    ].
    aWorkDir notNil ifTrue: [
      prompt := prompt, '
Working directory: ', aWorkDir, '

## WORKSPACE BOUNDARY (ENFORCED)
You MUST only create, modify, or delete files within:
  ', aWorkDir, '

You MUST NOT:
- Modify files outside this directory
- Use absolute paths to write elsewhere
- cd to directories outside your workspace
Violations will be detected and reverted.
'
    ].

    prompt := prompt, '

## Your Task
', taskDescription, '

## Context from the Knowledge Base
'.
    contextTuples do: [:t |
      | cat ident payload |
      cat := t at: 'category' ifAbsent: ['?'].
      ident := t at: 'identity' ifAbsent: ['?'].
      payload := t at: 'payload' ifAbsent: [Dictionary new].
      prompt := prompt, '
### [', cat, '] ', ident, '
', (payload at: 'detail' ifAbsent: [Json encode: payload]), '
'
    ].

    prompt := prompt, '

## Commands
', self commandReference, '

## Rules (in priority order)
1. MUST commit all code changes before dismissing (git add + git commit).
2. MUST NOT modify files outside your working directory.
3. MUST NOT coordinate with other agents directly — all coordination flows through pp.
4. MUST report unexpected findings via pp observe.
5. MUST follow the completion steps below exactly, in order.

## Completion Steps
', self completionInstructions.

    ^prompt
  ]

  method: commandReference [
    | ref |
    ref := ''.
    ppCommands do: [:cmd |
      ref := ref, '  ', cmd, '
'
    ].
    ^ref
  ]

  method: systemPromptHeader [
    ^'You are a ', name, ' agent in the Procyon Park orchestration system.

', description
  ]

  method: completionInstructions [
    "Subclasses override this for role-specific completion behavior."
    ^'1. git add -A && git commit -m "<summary of changes>"
2. pp dismiss'
  ]

  method: assembleContext: bbs scope: scope taskId: taskId [
    "Backward compat: no workflow filtering."
    ^self assembleContext: bbs scope: scope taskId: taskId workflowInstance: ''
  ]

  method: assembleContext: bbs scope: scope taskId: taskId workflowInstance: wfInstance [
    "Assemble context tuples from the BBS based on this role''s constraints.
     When wfInstance is non-empty, tuples with a workflow_instance field are
     filtered to only include those belonging to this workflow.

     Per-category recency cap: instead of including every tuple in a hard
     category (which lets stale observations from earlier pipeline cycles
     crowd out fresh ones), each category contributes only the N most recent
     tuples. The BBS index is append-ordered by monotonic id, so the tail of
     a scan is the most recent slice. N is computed per category from the
     remaining budget so hard and soft categories share fairly."
    | hard soft budget result conventions remaining totalCats perCatHard perCatSoft take |
    hard := contextConstraints at: 'hard' ifAbsent: [#()].
    soft := contextConstraints at: 'soft' ifAbsent: [#()].
    budget := contextConstraints at: 'budget' ifAbsent: [50].
    result := Array new: 0.

    "Always include conventions (global, not workflow-scoped)"
    conventions := bbs scanAll: 'convention'.
    result := result, conventions.

    "Compute per-category recency cap for hard categories.
     Split the post-conventions budget evenly across all constrained categories
     so a few noisy categories (e.g. observation) cannot starve the rest."
    remaining := budget - result size.
    totalCats := hard size + soft size.
    perCatHard := 3.
    (hard size > 0 and: [remaining > 0]) ifTrue: [
      perCatHard := (remaining + totalCats - 1) // totalCats.
      perCatHard < 3 ifTrue: [perCatHard := 3]
    ].

    "Hard constraints — include N most recent per category, filtered by workflow."
    hard do: [:spec |
      | cat tuples recent |
      cat := spec at: 'category'.
      tuples := bbs scan: cat scope: scope.
      tuples := self filterByWorkflow: tuples instance: wfInstance.
      recent := self mostRecent: tuples count: perCatHard.
      result := result, recent
    ].

    "Soft constraints — N most recent per category, bounded by remaining budget."
    remaining := budget - result size.
    (soft size > 0 and: [remaining > 0]) ifTrue: [
      perCatSoft := (remaining + soft size - 1) // soft size.
      perCatSoft < 1 ifTrue: [perCatSoft := 1].
      soft do: [:spec |
        remaining > 0 ifTrue: [
          | cat tuples recent |
          cat := spec at: 'category'.
          tuples := bbs scan: cat scope: scope.
          tuples := self filterByWorkflow: tuples instance: wfInstance.
          take := perCatSoft.
          take > remaining ifTrue: [take := remaining].
          recent := self mostRecent: tuples count: take.
          result := result, recent.
          remaining := budget - result size
        ]
      ]
    ].

    "Doctrine (the Orient layer): route ACTIVE, applicable doctrine into the
     planner AND the execution roles (implementer/reviewer/scout/fixer). Orient
     should bias every Act, not just every Decide — the synthesized lessons are
     mostly execution-time guidance, so they must reach the roles that write
     code and review it, not only the planner that decomposes epics.

     This BYPASSES the soft-category path on purpose — a generic soft-category
     read would surface proposed/rejected/retired entries and miss global scope,
     defeating the human promotion gate. activeDoctrineFor:scope:role: keeps the
     active-only gate and scope-union, then targets by role-tag and caps the
     number of entries for relevance so agent context does not bloat."
    (self consumesDoctrine: name) ifTrue: [
      result := result, (self activeDoctrineFor: bbs scope: scope role: name)
    ].

    ^result
  ]

  method: consumesDoctrine: roleName [
    "Roles whose context is biased by doctrine: the planner consumes it at
     plan-time (Orient -> Decide); the execution roles consume it at act-time
     (Orient -> Act). Other roles (e.g. strategist, archivist, foreman) do not."
    ^#('planner' 'implementer' 'reviewer' 'scout' 'fixer') includes: roleName
  ]

  classMethod: maxDoctrineEntries [
    "Per-role cap on injected doctrine entries. Doctrine is advisory Orient-layer
     bias, not task context — surfacing every applicable entry would crowd out
     the role's actual working context. 6 keeps the most relevant lessons while
     bounding bloat. Override per-role if a role wants a wider/narrower window."
    ^6
  ]

  method: activeDoctrineFor: bbs scope: scope [
    "Backward-compatible entry point: rank for this instance's own role."
    ^self activeDoctrineFor: bbs scope: scope role: name
  ]

  method: activeDoctrineFor: bbs scope: scope role: aRole [
    "Return ACTIVE doctrine tuples applicable to <scope>, targeted at <aRole>,
     ranked for relevance and capped at maxDoctrineEntries.

     Applicability is by payload.doctrine_scope (global | <repo> | <repo>:<path>),
     NOT the BBS storage scope, so doctrine is scanned across all scopes and
     composed by scope-union {global, this-repo}. Maturity is gated to 'active'
     ONLY — proposed/rejected/retired are never surfaced.

     Role targeting: when an entry carries a 'role:<name>' tag it is surfaced
     ONLY to that role (or to all when the tag is 'role:universal'); entries
     with no role: tag are universal. Existing entries carry concern:/lang:/
     phase:/topic tags but no role: tag, so they are treated as universal and
     ranked by tag-overlap against the consuming role + repo context. The cap
     then bounds how many reach the agent so context does not bloat."
    | all candidates |
    all := bbs scanAll: 'doctrine'.
    candidates := Array new: 0.
    all do: [:t |
      | p mat ds applies tags roleTag roleOk |
      p := t at: 'payload' ifAbsent: [Dictionary new].
      mat := p at: 'maturity' ifAbsent: ['proposed'].
      ds := p at: 'doctrine_scope' ifAbsent: ['global'].
      applies := (ds = 'global')
        or: [(ds = scope) or: [ds startsWith: (scope, ':')]].
      tags := p at: 'tags' ifAbsent: [#()].
      roleTag := self roleTagOf: tags.
      roleOk := (roleTag = '')
        or: [(roleTag = 'universal') or: [roleTag = aRole]].
      (mat = 'active' and: [applies and: [roleOk]]) ifTrue: [
        candidates := candidates copyWith: t
      ]
    ].
    ^self rankDoctrine: candidates role: aRole scope: scope
        cap: self class maxDoctrineEntries
  ]

  method: roleTagOf: tags [
    "Extract the role target from a doctrine entry's tags: the value of a
     'role:<name>' tag (lowercased), or '' when no role: tag is present (i.e.
     the entry is universal). Only the first role: tag is honored."
    | prefix |
    prefix := 'role:'.
    tags do: [:tag |
      (tag startsWith: prefix) ifTrue: [
        ^(tag copyFrom: prefix size + 1 to: tag size) asLowercase
      ]
    ].
    ^''
  ]

  method: doctrineIsUniversal: tags [
    "Universal entries are always relevant to every consuming role: those with
     no tags at all, or whose only role target is 'role:universal'."
    | roleTag |
    tags isEmpty ifTrue: [^true].
    roleTag := self roleTagOf: tags.
    ^roleTag = 'universal'
  ]

  method: doctrineContextTermsFor: aRole scope: scope [
    "Context an entry's tags are scored against for relevance: the consuming
     role and the repo (scope). Tags overlapping these rank ahead of unrelated
     ones when the cap forces a choice."
    | terms |
    terms := Array new: 0.
    terms := terms copyWith: aRole.
    terms := terms copyWith: ('role:', aRole).
    (scope notNil and: [scope isEmpty not]) ifTrue: [
      terms := terms copyWith: scope.
      terms := terms copyWith: ('repo:', scope)
    ].
    ^terms
  ]

  method: tagValue: tag [
    "The value portion of a 'prefix:value' tag, or '' when the tag has no colon."
    | idx |
    idx := tag indexOf: ':'.
    idx <= 0 ifTrue: [^''].
    ^tag copyFrom: idx + 1 to: tag size
  ]

  method: doctrineOverlapScore: tags context: ctx [
    "Count how many of an entry's tags overlap the context terms. A tag overlaps
     when the tag itself, or its value after a ':', matches a context term."
    | score |
    score := 0.
    tags do: [:tag |
      | val |
      (ctx includes: tag)
        ifTrue: [score := score + 1]
        ifFalse: [
          val := self tagValue: tag.
          (val isEmpty not and: [ctx includes: val]) ifTrue: [score := score + 1]
        ]
    ].
    ^score
  ]

  method: rankDoctrine: candidates role: aRole scope: scope cap: cap [
    "Rank applicable active doctrine for relevance and cap the count.
     Universal/untagged entries are ALWAYS relevant, so they are included first
     (most recent slice if they alone exceed the cap). Remaining slots are
     filled by the tagged entries with the highest tag-overlap against the
     role + repo context (ties broken by recency: higher id first)."
    | ctx universal tagged scored out remaining i |
    cap <= 0 ifTrue: [^Array new: 0].
    ctx := self doctrineContextTermsFor: aRole scope: scope.
    universal := Array new: 0.
    tagged := Array new: 0.
    candidates do: [:t |
      | p tags |
      p := t at: 'payload' ifAbsent: [Dictionary new].
      tags := p at: 'tags' ifAbsent: [#()].
      (self doctrineIsUniversal: tags)
        ifTrue: [universal := universal copyWith: t]
        ifFalse: [tagged := tagged copyWith: t]
    ].

    "Score each tagged entry by tag-overlap with the context."
    scored := Array new: 0.
    tagged do: [:t |
      | p tags pair |
      p := t at: 'payload' ifAbsent: [Dictionary new].
      tags := p at: 'tags' ifAbsent: [#()].
      pair := Dictionary new.
      pair at: 'tuple' put: t.
      pair at: 'score' put: (self doctrineOverlapScore: tags context: ctx).
      pair at: 'id' put: (t at: 'id' ifAbsent: [0]).
      scored := scored copyWith: pair
    ].
    scored sort: [:a :b |
      | sa sb ia ib |
      sa := a at: 'score'. sb := b at: 'score'.
      sa > sb ifTrue: [-1] ifFalse: [
        sa < sb ifTrue: [1] ifFalse: [
          ia := a at: 'id'. ib := b at: 'id'.
          ia > ib ifTrue: [-1] ifFalse: [ia < ib ifTrue: [1] ifFalse: [0]]
        ]
      ]
    ].

    "Universal entries first; then fill remaining slots with top-ranked tagged."
    out := self mostRecent: universal count: cap.
    remaining := cap - out size.
    remaining > 0 ifTrue: [
      i := 1.
      [i <= scored size and: [out size < cap]] whileTrue: [
        out := out copyWith: ((scored at: i) at: 'tuple').
        i := i + 1
      ]
    ].
    ^out
  ]

  method: mostRecent: tuples count: n [
    "Return the n most recently appended tuples from a scan result.
     The BBS index preserves append order (monotonic id), so recency-descending
     means the last n entries. Returns the input unchanged when it already fits."
    | size start |
    n <= 0 ifTrue: [^Array new: 0].
    size := tuples size.
    size <= n ifTrue: [^tuples].
    start := size - n + 1.
    "copyFrom:to: is 1-indexed closed [start, size] (both inclusive)."
    ^tuples copyFrom: start to: size
  ]

  method: filterByWorkflow: tuples instance: wfInstance [
    "Filter tuples: if wfInstance is set, only include tuples that either
     have no workflow_instance field (global) or match this workflow.
     If wfInstance is empty, return all tuples unfiltered."
    wfInstance isEmpty ifTrue: [^tuples].
    ^tuples select: [:t |
      | payload tWf |
      payload := t at: 'payload' ifAbsent: [Dictionary new].
      tWf := payload at: 'workflow_instance' ifAbsent: [''].
      tWf isEmpty or: [tWf = wfInstance]
    ]
  ]
