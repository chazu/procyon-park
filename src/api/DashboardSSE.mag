"DashboardSSE — SSE dashboard broadcasting for the web UI.
 Separated from ApiServer to avoid Maggie compiler bytecode limits.

 Per docs/scout-perf-survey-2026-04-28.md §4: each tick computes ONE
 snapshot (workflow/token/task/notification/worker/workitem/event/watch
 scans + pre-rendered identity-independent HTML) and fans it out to every
 subscriber. Previously each subscriber triggered ~12 full-index scans
 plus N synchronous session-file reads per 5 s tick.

 Token totals are also moved off the broadcast hot path: a background
 [self tokenCacheLoop] fork periodically reads $HOME/.pp/sessions/*.jsonl
 and rebuilds an in-memory taskId -> {input,output} cache. The SSE tick
 reads only from that cache (no disk I/O)."

DashboardSSE subclass: Object
  instanceVars: bbs sseSubscribers tokenCache tokenCacheMtimes tokenCacheOffsets
                watchSetCache watchSetCacheExpiry
                snapshotCache snapshotCacheRev

  classMethod: on: aBBS [
    ^super new initBBS: aBBS
  ]

  method: initBBS: aBBS [
    bbs := aBBS.
    sseSubscribers := #().
    tokenCache := Dictionary new.
    tokenCacheMtimes := Dictionary new.
    "Per-tid byte offset already consumed from the session .jsonl, so a growing
     file for a running task is TAILED (only appended bytes parsed) instead of
     re-read whole every tick. See refreshTokenCache."
    tokenCacheOffsets := Dictionary new.
    "Snapshot cache: computeSnapshot runs ~9 scanAll per call. Recompute only
     when the BBS change counter advanced since the last snapshot (see #tick)."
    snapshotCache := nil.
    snapshotCacheRev := -1.
    "§6 watch-set TTL cache: every SSE tick walks the snapshot watches
     array once per subscriber. Two browsers belonging to the same user
     resolve identical results — cache by identity for 2 s so the
     per-tick cost is paid once per (identity, tick) pair instead of
     per-subscriber."
    watchSetCache := Dictionary new.
    watchSetCacheExpiry := Dictionary new.
    "Token cache refresh used to run in its own [self tokenCacheLoop] fork.
     With petermattis/goid carrying an arm64 ASM fast path the cost of an
     extra permanent goroutine is small, but the work itself (file I/O for
     every task) is wasted whenever no dashboard is connected. We now
     piggy-back refreshTokenCache on the SSE broadcast tick (Server>>startSSETick
     calls #tick which calls #refreshTokenCache) so both share one goroutine
     and both early-return when sseSubscribers is empty."
  ]

  method: onConnect: conn [
    "Backwards-compatible entry point — anonymous subscription."
    ^self onConnect: conn identity: 'anonymous'
  ]

  method: onConnect: conn identity: identity [
    "Register an SSE subscriber along with the verified identity that
     upgraded the stream. Identity is either 'user:<name>', 'admin:<hex>',
     'worker:<name>', or 'anonymous'. The tuple is tracked in-memory so the
     presence panel can render the humans currently watching.

     Each subscriber also gets a bounded SSEQueue and a dedicated drainer
     forked via [block] fork. The tick loop enqueues snapshots (non-
     blocking); the drainer is the only thing that ever calls
     conn send:event:, so a slow client can only stall its own queue —
     never the tick loop serving every other subscriber (§4.11, D6.14)."
    | entry id queue |
    id := identity ifNil: ['anonymous'].
    queue := SSEQueue new.
    entry := Dictionary new.
    entry at: 'conn' put: conn.
    entry at: 'identity' put: id.
    entry at: 'subscribedAt' put: DateTime now epochSeconds.
    entry at: 'queue' put: queue.
    "Per-subscriber last-sent HTML by panel key, consumed by
     sendElements:to:key: for change-detection (skip re-patching unchanged
     panels so scroll + open <details> survive routine ticks)."
    entry at: 'sent' put: Dictionary new.
    sseSubscribers := sseSubscribers copyWith: entry.
    ('SSE dashboard client connected as ', id,
      ', total: ', sseSubscribers size printString) println.
    [self drainLoopFor: entry] fork
  ]

  method: drainLoopFor: entry [
    "Per-connection drainer. Dequeues events and calls conn send:event:.
     Exits when the queue is closed and empty, when the connection
     drops, or when send: raises — in which case the queue is closed
     and the next tick will prune the subscriber. Never throws: any
     exception terminates the drainer, allowing the conn to be reaped."
    | q conn done evt |
    q := entry at: 'queue'.
    conn := entry at: 'conn'.
    done := false.
    [done] whileFalse: [
      evt := q dequeue.
      evt isNil ifTrue: [
        (q isClosed or: [conn isOpen not])
          ifTrue: [done := true]
          ifFalse: [Process sleep: 200]
      ] ifFalse: [
        [conn send: (evt at: 'data') event: (evt at: 'event')]
          on: Exception do: [:e |
            ('SSE drainer: send failed for ', (entry at: 'identity'),
              ': ', e messageText) println.
            q close.
            done := true
          ]
      ]
    ].
    [conn close] on: Exception do: [:e | ]
  ]

  method: tick [
    "Per-tick fan-out. Build ONE snapshot of the BBS state + pre-rendered
     identity-independent HTML, then walk every subscriber and enqueue.
     Identity-dependent rendering (notifications filtered by watches) is
     still per-subscriber but reuses the cached scans from the snapshot."
    | live snapshot rev |
    sseSubscribers isEmpty ifTrue: [^self].
    "Refresh token totals inline now that tokenCacheLoop is gone. The
     mtime cache makes a no-op refresh cheap; both this and the broadcast
     are gated on subscribers, so an idle server with no dashboard open
     does zero work here. A token-total change invalidates the snapshot
     cache below (tailTokensFor: sets snapshotCacheRev := -1)."
    [self refreshTokenCache] on: Exception do: [:e |
      ('SSE token cache refresh failed: ', e messageText) println
    ].
    "Snapshot cache: computeSnapshot runs ~9 scanAll + pre-renders every panel.
     When neither the BBS (changeCount) nor the token totals have changed since
     the last snapshot, reuse it verbatim — an idle-but-connected dashboard then
     does ~zero allocation per tick instead of rebuilding everything every 5 s.
     A single malformed payload that throws here used to take down the broadcast
     fork; on failure we skip the tick and try again next time."
    rev := bbs changeCount.
    (snapshotCache notNil and: [snapshotCacheRev = rev])
      ifTrue: [snapshot := snapshotCache]
      ifFalse: [
        snapshot := [self computeSnapshot] on: Exception do: [:e |
          ('SSE snapshot failed (skipping tick): ', e messageText) println.
          nil
        ].
        snapshot notNil ifTrue: [
          snapshotCache := snapshot.
          snapshotCacheRev := rev
        ]
      ].
    snapshot isNil ifTrue: [^self].
    live := GrowableArray new.
    sseSubscribers do: [:entry |
      | conn q |
      conn := entry at: 'conn'.
      q := entry at: 'queue'.
      ((conn isOpen) and: [q isClosed not]) ifTrue: [
        [self broadcastTo: entry snapshot: snapshot] on: Exception do: [:e |
          ('SSE error: ', e messageText) println
        ].
        "broadcastTo: may have closed the queue on overflow —
         re-check before keeping the subscriber."
        q isClosed ifFalse: [live add: entry]
      ]
    ].
    sseSubscribers := live asArray
  ]

  method: computeSnapshot [
    "Run all index scans once and pre-render every identity-independent
     HTML fragment. Returns a Dictionary the broadcast loop hands to each
     subscriber. With S subscribers the tick now does ~8 BBS scans total
     instead of 6S+. Anonymous subscribers also reuse a single cached
     notifications HTML; signed identities still pay one filter+render
     pass per subscriber, but reuse the cached notification + watch arrays."
    | snap |
    snap := Dictionary new.
    snap at: 'now' put: DateTime now epochSeconds.
    snap at: 'workflows' put: (bbs scanAll: 'workflow').
    snap at: 'tokens' put: (bbs scanAll: 'token').
    snap at: 'tasks' put: (bbs scanAll: 'task').
    snap at: 'workitems' put: (bbs scanAll: 'workitem').
    snap at: 'events' put: (bbs scanAll: 'event').
    snap at: 'workers' put: (bbs scanAll: 'worker').
    snap at: 'notifications' put: (bbs scanAll: 'notification').
    snap at: 'watches' put: (bbs scanAll: 'watch').
    snap at: 'missions' put: (bbs scanAll: 'mission').
    "Each render is wrapped independently so a single bad tuple only
     blanks one panel — not the whole dashboard. The fallback HTML uses
     the same root id the dashboard JS expects so the SSE patch still
     replaces the placeholder cleanly."
    snap at: 'workflowsHtml' put:
      (self safeRender: 'workflows' rootId: 'dashboard-workflows' do: [self renderWorkflowsHtml: snap]).
    snap at: 'completionsHtml' put:
      (self safeRender: 'completions' rootId: 'dashboard-completions' do: [self renderCompletionsHtml: snap]).
    snap at: 'workitemsHtml' put:
      (self safeRender: 'workitems' rootId: 'dashboard-workitems' do: [self renderWorkitemsHtml: snap]).
    snap at: 'scopeViolationsHtml' put:
      (self safeRender: 'scope-violations' rootId: 'dashboard-scope-violations' do: [self renderScopeViolationsHtml: snap]).
    snap at: 'presenceHtml' put:
      (self safeRender: 'presence' rootId: 'dashboard-presence' do: [self renderPresenceHtml: snap]).
    snap at: 'notificationsAnonHtml' put:
      (self safeRender: 'notifications' rootId: 'dashboard-notifications' do: [self renderNotificationsHtml: (snap at: 'notifications')]).
    snap at: 'missionsHtml' put:
      (self safeRender: 'missions' rootId: 'dashboard-missions' do: [self renderMissionsHtml: snap]).
    ^snap
  ]

  method: safeRender: name rootId: rootId do: aBlock [
    "Run a render block; on failure, log which panel and return a
     fallback fragment with the expected root id so the dashboard
     panel renders an error instead of staying stuck on 'Connecting…'.
     Logs include the message text so the offending render is obvious
     from server logs without dashboard guessing."
    ^[aBlock value] on: Exception do: [:e |
      ('SSE render failed for ', name, ': ', e messageText) println.
      '<div id="', rootId, '"><h2>', name, '</h2>',
        '<div class="empty-state">render error: ',
        (self htmlEscape: e messageText),
        '</div></div>'
    ]
  ]

  method: broadcastTo: entry snapshot: snap [
    "Enqueue every panel for one subscriber. All non-notification panels
     reuse pre-rendered HTML from the snapshot; notifications are filtered
     per-identity but built from the cached scan arrays."
    self sendElements: (snap at: 'workflowsHtml') to: entry.
    self sendElements: (snap at: 'completionsHtml') to: entry.
    self sendElements: (snap at: 'workitemsHtml') to: entry.
    self sendElements: (snap at: 'scopeViolationsHtml') to: entry.
    self sendElements: (snap at: 'presenceHtml') to: entry.
    self sendElements: (snap at: 'missionsHtml') to: entry key: 'missions'.
    self sendNotifsTo: entry snapshot: snap
  ]

  method: sendElements: html to: entry key: key [
    "Change-detected send: skip enqueuing when the pre-rendered HTML for <key>
     is byte-identical to what was last sent to THIS subscriber. The dashboard
     client applies each patch as a wholesale element replace
     (target.outerHTML = ...), which resets the page scroll and collapses any
     open <details>. Re-patching an unchanged panel every tick therefore yanks
     a reader out of a long, expanded mission plan. The cache is per-subscriber
     so a freshly-connected client (empty cache) still receives the panel on
     its first tick; only cache after a successful enqueue so an overflow-drop
     (which triggers a client reconnect + resync) is not masked."
    | sent prev |
    sent := entry at: 'sent' ifAbsent: [nil].
    sent isNil ifTrue: [sent := Dictionary new. entry at: 'sent' put: sent].
    prev := sent at: key ifAbsent: [nil].
    (prev notNil and: [prev = html]) ifTrue: [^true].
    (self sendElements: html to: entry) ifTrue: [sent at: key put: html. ^true].
    ^false
  ]

  method: sendElements: html to: entry [
    "Enqueue a datastar-patch-elements event for this subscriber.
     On overflow (queue full, 256 events pending), close the queue
     and drop the connection — the browser will reconnect and replay
     state via /api/scan. Returns true if enqueued, false otherwise."
    | q evt ok conn |
    q := entry at: 'queue'.
    q isClosed ifTrue: [^false].
    evt := Dictionary new.
    evt at: 'data' put: ('elements ', html).
    evt at: 'event' put: 'datastar-patch-elements'.
    ok := q enqueue: evt.
    ok ifFalse: [
      q close.
      conn := entry at: 'conn'.
      [conn close] on: Exception do: [:e | ].
      ('SSE dashboard: queue overflow (cap=', q capacity printString,
        '), dropping client ', (entry at: 'identity')) println.
      ^false
    ].
    ^true
  ]

  method: renderScopeViolationsHtml: snap [
    "Aggregate scope-violation events per role so operators can spot systematic
     prompt issues (e.g. one role consistently editing outside its workdir).
     Each scope-violation event emitted by Scheduler>>validateScope:taskId:scope:
     has identity 'scope-violation:<taskId>' and summary '<n> file(s) modified
     outside workdir'. We join events to tasks by id to recover role."
    | s events tasks taskRoles roleCounts roleFiles roleTasks totalViolations totalFiles prefix |
    events := snap at: 'events'.
    tasks := snap at: 'tasks'.

    "Build taskId -> role map"
    taskRoles := Dictionary new.
    tasks do: [:t |
      | tid p role |
      tid := t at: 'identity' ifAbsent: [''].
      p := t at: 'payload' ifAbsent: [Dictionary new].
      role := p at: 'role' ifAbsent: ['unknown'].
      taskRoles at: tid put: role
    ].

    roleCounts := Dictionary new.
    roleFiles := Dictionary new.
    roleTasks := Dictionary new.
    totalViolations := 0.
    totalFiles := 0.
    prefix := 'scope-violation:'.

    events do: [:e |
      | ep etype eid taskId role summary fileCount existing |
      ep := e at: 'payload' ifAbsent: [Dictionary new].
      etype := ep at: 'type' ifAbsent: [''].
      etype = 'scope-violation' ifTrue: [
        totalViolations := totalViolations + 1.
        eid := e at: 'identity' ifAbsent: [''].
        taskId := (StringUtil stripPrefix: prefix from: eid) ifNil: [eid].
        role := taskRoles at: taskId ifAbsent: ['unknown'].

        "Count files from summary leading integer (e.g. '3 file(s) ...')"
        summary := ep at: 'summary' ifAbsent: [''].
        fileCount := self leadingInteger: summary.
        totalFiles := totalFiles + fileCount.

        roleCounts at: role put: (roleCounts at: role ifAbsent: [0]) + 1.
        roleFiles at: role put: (roleFiles at: role ifAbsent: [0]) + fileCount.
        existing := roleTasks at: role ifAbsent: [Array new: 0].
        (self array: existing includesString: taskId) ifFalse: [
          roleTasks at: role put: (existing copyWith: taskId)
        ]
      ]
    ].

    s := '<div id="dashboard-scope-violations"><h2>Scope Violations</h2>'.
    totalViolations = 0 ifTrue: [
      s := s, '<div class="empty-state">No scope violations recorded</div>'
    ] ifFalse: [
      s := s, '<div class="sv-summary"><b>', totalViolations printString,
            '</b> violation(s), <b>', totalFiles printString,
            '</b> file(s) reverted across <b>', roleCounts size printString, '</b> role(s)</div>'.
      s := s, '<ul class="sv-list">'.
      roleCounts keysAndValuesDo: [:role :count |
        | files taskList taskCount severity |
        files := roleFiles at: role ifAbsent: [0].
        taskList := roleTasks at: role ifAbsent: [Array new: 0].
        taskCount := taskList size.
        "Severity: 3+ violations in a single role = systematic, warn hard"
        severity := count >= 3 ifTrue: ['sv-systematic'] ifFalse: [
          count >= 2 ifTrue: ['sv-repeat'] ifFalse: ['sv-single']
        ].
        s := s, '<li class="sv-role ', severity, '">',
              '<b>', role, '</b>',
              '<img class="role-badge" src="/dashboard/roles/role-', role, '.png" alt="" onerror="this.style.display=''none''"> ',
              '<span class="sv-count">', count printString, ' violation(s)</span>',
              ' <small>', taskCount printString, ' task(s), ',
              files printString, ' file(s) reverted</small>',
              '</li>'
      ].
      s := s, '</ul>'
    ].
    s := s, '</div>'.
    ^s
  ]

  method: renderPresenceHtml: snap [
    "Render the two-column presence panel: humans currently connected to
     the SSE stream (live sseSubscribers) on the left, affine worker tuples
     (active heartbeat, scope='/') on the right. Workers are rendered with
     manifest capability summary (slots, models, drain, operator) and any
     budget state surfaced in the worker payload. §4.7, D6.7."
    | s humanCounts workers humanCount workerCount now |
    now := snap at: 'now'.
    humanCounts := Dictionary new.
    sseSubscribers do: [:sub |
      | id existing |
      id := sub at: 'identity' ifAbsent: ['anonymous'].
      existing := humanCounts at: id ifAbsent: [nil].
      existing isNil ifTrue: [
        | r |
        r := Dictionary new.
        r at: 'count' put: 1.
        r at: 'subscribedAt' put: (sub at: 'subscribedAt' ifAbsent: [now]).
        humanCounts at: id put: r
      ] ifFalse: [
        existing at: 'count' put: (existing at: 'count') + 1.
        ((sub at: 'subscribedAt' ifAbsent: [now]) < (existing at: 'subscribedAt'))
          ifTrue: [existing at: 'subscribedAt' put: (sub at: 'subscribedAt')]
      ]
    ].
    humanCount := humanCounts size.

    workers := snap at: 'workers'.
    workerCount := workers size.

    s := '<section id="dashboard-presence" class="presence"><h2>Presence</h2>'.
    s := s, '<div class="presence-grid">'.

    "--- Humans column ---"
    s := s, '<div class="presence-col presence-humans">'.
    s := s, '<h3>Humans <span class="presence-count">', humanCount printString, '</span></h3>'.
    humanCount = 0 ifTrue: [
      s := s, '<div class="empty-state">No subscribers</div>'
    ] ifFalse: [
      s := s, '<ul class="presence-list">'.
      humanCounts keysAndValuesDo: [:id :r |
        | count dur |
        count := r at: 'count'.
        dur := self formatDuration: (now - (r at: 'subscribedAt')).
        s := s, '<li class="presence-human">',
              '<span class="presence-id">', id, '</span>',
              (count > 1 ifTrue: [' <span class="presence-multi">x', count printString, '</span>'] ifFalse: ['']),
              ' <small>', dur, '</small></li>'
      ].
      s := s, '</ul>'
    ].
    s := s, '</div>'.

    "--- Workers column ---"
    s := s, '<div class="presence-col presence-workers">'.
    s := s, '<h3>Workers <span class="presence-count">', workerCount printString, '</span></h3>'.
    workerCount = 0 ifTrue: [
      s := s, '<div class="empty-state">No workers online</div>'
    ] ifFalse: [
      s := s, '<ul class="presence-list">'.
      workers do: [:w |
        | wid p manifest slots models drain operator digest budget line modelsStr |
        wid := w at: 'identity' ifAbsent: ['worker:?'].
        p := w at: 'payload' ifAbsent: [Dictionary new].
        manifest := p at: 'manifest' ifAbsent: [Dictionary new].
        (manifest isKindOf: Dictionary) ifFalse: [manifest := Dictionary new].
        slots := manifest at: 'slots' ifAbsent: [p at: 'slots' ifAbsent: ['?']].
        models := manifest at: 'models' ifAbsent: [p at: 'models' ifAbsent: #()].
        operator := manifest at: 'operator' ifAbsent: [p at: 'operator' ifAbsent: ['?']].
        drain := p at: 'drain' ifAbsent: [false].
        digest := p at: 'capability_digest' ifAbsent: [
          manifest at: 'capability_digest' ifAbsent: ['']].
        budget := p at: 'budget' ifAbsent: [manifest at: 'budget' ifAbsent: [nil]].
        modelsStr := (models isKindOf: Array)
          ifTrue: [self joinStrings: models with: ','] ifFalse: [models asString].
        line := '<li class="presence-worker', (drain = true ifTrue: [' presence-drain'] ifFalse: ['']), '">',
              '<span class="presence-id">', wid, '</span>',
              ' <small>op=<b>', operator asString, '</b></small>',
              ' <small>slots=', slots printString, '</small>',
              (modelsStr isEmpty ifTrue: [''] ifFalse: [' <small>models=', modelsStr, '</small>']),
              (drain = true ifTrue: [' <span class="presence-badge-drain">drain</span>'] ifFalse: ['']),
              (digest isEmpty ifTrue: [''] ifFalse: [' <small class="presence-digest">',
                 (digest size > 12 ifTrue: [digest copyFrom: 1 to: 12] ifFalse: [digest]), '</small>']).
        (budget notNil and: [budget isKindOf: Dictionary]) ifTrue: [
          | bState bRem bLimit |
          bState := budget at: 'state' ifAbsent: [budget at: 'status' ifAbsent: ['']].
          bRem := budget at: 'remaining' ifAbsent: [nil].
          bLimit := budget at: 'limit' ifAbsent: [nil].
          line := line, ' <small class="presence-budget">budget=', bState asString,
            (bRem notNil ifTrue: [' rem=', bRem printString] ifFalse: ['']),
            (bLimit notNil ifTrue: ['/', bLimit printString] ifFalse: ['']),
            '</small>'
        ].
        line := line, '</li>'.
        s := s, line
      ].
      s := s, '</ul>'
    ].
    s := s, '</div>'.

    s := s, '</div></section>'.
    ^s
  ]

  method: array: anArray includesString: aString [
    "Simple membership test — no Set to rely on."
    anArray do: [:x | x = aString ifTrue: [^true]].
    ^false
  ]

  method: leadingInteger: aString [
    "Parse the leading non-negative integer of aString (e.g. '3 file(s) ...' -> 3).
     Returns 0 if no leading token or it doesn't parse. Uses split-on-space since
     Scheduler emits summaries of the form '<n> file(s) modified outside workdir'."
    | parts first n |
    aString isEmpty ifTrue: [^0].
    parts := aString split: ' '.
    parts isEmpty ifTrue: [^0].
    first := parts first.
    first isEmpty ifTrue: [^0].
    n := [first asInteger] on: Exception do: [:e | 0].
    n isNil ifTrue: [^0].
    ^n
  ]

  method: renderWorkitemsHtml: snap [
    "Broadcast work items grouped by status as a Kanban-style board.
     Columns: backlog, ready, in-progress, done, blocked."
    | s workitems statuses buckets |
    workitems := snap at: 'workitems'.
    statuses := #('backlog' 'ready' 'in-progress' 'done' 'blocked').
    buckets := Dictionary new.
    statuses do: [:st | buckets at: st put: ArrayList new].
    workitems do: [:w |
      | p status bucket |
      p := w at: 'payload' ifAbsent: [Dictionary new].
      status := p at: 'status' ifAbsent: ['backlog'].
      (buckets includesKey: status) ifFalse: [
        buckets at: status put: ArrayList new.
      ].
      "ArrayList add: is O(1) amortized; the prior `copyWith:` reallocated the
       whole bucket every work item, making this loop O(n^2) per snapshot."
      (buckets at: status) add: w
    ].
    s := '<div id="dashboard-workitems"><h2>Work Items</h2><div class="kanban">'.
    statuses do: [:st |
      | items count |
      items := buckets at: st ifAbsent: [#()].
      count := items size.
      s := s, '<div class="kanban-col kanban-', st, '">',
            '<div class="kanban-header">', st, ' <span class="kanban-count">', count printString, '</span></div>'.
      count = 0 ifTrue: [
        s := s, '<div class="empty-state">—</div>'
      ] ifFalse: [
        items do: [:w |
          | p title wid type identity repo wiScope |
          p := w at: 'payload' ifAbsent: [Dictionary new].
          identity := w at: 'identity' ifAbsent: ['?'].
          wiScope := w at: 'scope' ifAbsent: ['default'].
          title := p at: 'title' ifAbsent: [identity].
          type := p at: 'type' ifAbsent: ['story'].
          repo := p at: 'repo' ifAbsent: [w at: 'scope' ifAbsent: ['']].
          wid := identity.
          title size > 60 ifTrue: [title := (title copyFrom: 1 to: 60), '...'].
          "data-wi-id / data-wi-type / data-scope let the Board detail modal
           resolve the item's identity + scope to fetch /api/workitem/detail."
          s := s, '<div class="wi-card wi-', (self htmlEscape: type),
                '" data-wi-id="', (self htmlEscape: identity),
                '" data-wi-type="', (self htmlEscape: type),
                '" data-scope="', (self htmlEscape: wiScope),
                '" data-repo="', (self htmlEscape: repo), '">',
                '<div class="wi-title">', (self htmlEscape: title), '</div>',
                '<div class="wi-meta"><span class="wi-type">', (self htmlEscape: type), '</span> ',
                '<small>', (self htmlEscape: wid), '</small>',
                (repo isEmpty ifTrue: [''] ifFalse: [' <small class="wi-repo">', (self htmlEscape: repo), '</small>']),
                '</div>',
                '</div>'
        ]
      ].
      s := s, '</div>'
    ].
    s := s, '</div></div>'.
    ^s
  ]

  method: renderMissionsHtml: snap [
    "Render the Missions panel — the high-level Auftragstaktik intent artifact.
     Missions awaiting approval are FOREGROUNDED (rendered first, plan expanded,
     approve/reject controls attached); decided/researching missions follow for
     context. Each mission is rendered inside its OWN exception guard so a single
     malformed tuple is SKIPPED — the panel still renders. The panel-level
     safeRender wrap in computeSnapshot is a second backstop."
    | s missions awaiting others done archived workitems |
    missions := snap at: 'missions' ifAbsent: [#()].
    "Reuse the already-cached workitem scan (computeSnapshot ran it once this
     tick) to render each non-archived mission's epic/story tree — ZERO new
     BBS scans, ZERO new SSE channels."
    workitems := snap at: 'workitems' ifAbsent: [#()].
    s := '<div id="dashboard-missions"><h2>Missions</h2>'.
    awaiting := Array new: 0.
    others := Array new: 0.
    done := Array new: 0.
    archived := Array new: 0.
    "Partition by status: awaiting-approval is foregrounded; the two TERMINAL
     states (done, archived) are filed into their own collapsed sections so a
     completed/retired mission never clutters the active 'Other missions' list;
     everything else (researching/approved/in-progress/rejected) is active
     context. Nested ifTrue:/ifFalse: (Maggie has no case)."
    missions do: [:m |
      [
        | p st |
        p := m at: 'payload' ifAbsent: [Dictionary new].
        st := p at: 'status' ifAbsent: ['?'].
        st = 'awaiting-approval'
          ifTrue: [awaiting := awaiting copyWith: m]
          ifFalse: [st = 'archived'
            ifTrue: [archived := archived copyWith: m]
            ifFalse: [st = 'done'
              ifTrue: [done := done copyWith: m]
              ifFalse: [others := others copyWith: m]]]
      ] on: Exception do: [:e |
        ('SSE mission partition skipped a malformed tuple: ', e messageText) println
      ]
    ].
    "Deterministic total order so BBS scanAll bucket-ordering churn cannot
     change the rendered HTML from one tick to the next. Without a stable
     order the panel HTML differs every tick, defeating change-detection and
     forcing a wholesale client-side outerHTML replace — which resets scroll
     and collapses any expanded mission plan the operator is reading."
    awaiting := self sortMissions: awaiting.
    others := self sortMissions: others.
    done := self sortMissions: done.
    archived := self sortMissions: archived.
    "Empty-state guard MUST test ALL buckets (nested and:, never chained —
     `a and: [b] and: [c]` parses as the and:and: selector -> doesNotUnderstand).
     Without every test, a done-only or archived-only scope renders 'No missions
     yet' and that section never appears."
    (awaiting isEmpty and: [others isEmpty and: [done isEmpty and: [archived isEmpty]]]) ifTrue: [
      ^s, '<div class="empty-state">No missions yet.</div></div>'
    ].
    awaiting isEmpty ifFalse: [
      s := s, '<div class="mission-group mission-group--awaiting"><h3>Awaiting approval</h3>'.
      awaiting do: [:m |
        s := s, ([(self renderMissionCard: m awaiting: true),
            (self renderMissionTree: m workitems: workitems)]
          on: Exception do: [:e |
            ('SSE mission card skipped (malformed tuple): ', e messageText) println. ''])
      ].
      s := s, '</div>'
    ].
    others isEmpty ifFalse: [
      s := s, '<div class="mission-group mission-group--decided"><h3>Other missions</h3>'.
      others do: [:m |
        s := s, ([(self renderMissionCard: m awaiting: false),
            (self renderMissionTree: m workitems: workitems)]
          on: Exception do: [:e |
            ('SSE mission card skipped (malformed tuple): ', e messageText) println. ''])
      ].
      s := s, '</div>'
    ].
    "Completed (done) missions are terminal: rendered inside a collapsed
     <details> so they are out of the active list, but with their (all-done)
     epic/story tree available on expand. Distinct from Archived (retired)."
    done isEmpty ifFalse: [
      s := s, '<details class="mission-group mission-group--done"><summary><h3>Completed</h3></summary>'.
      done do: [:m |
        s := s, ([(self renderMissionCard: m awaiting: false),
            (self renderMissionTree: m workitems: workitems)]
          on: Exception do: [:e |
            ('SSE mission card skipped (malformed tuple): ', e messageText) println. ''])
      ].
      s := s, '</details>'
    ].
    "Archived missions are retired: rendered LAST inside a collapsed <details>
     so they are out of the way but the tuple is still visible (never deleted)."
    archived isEmpty ifFalse: [
      s := s, '<details class="mission-group mission-group--archived"><summary><h3>Archived</h3></summary>'.
      archived do: [:m |
        s := s, ([self renderMissionCard: m awaiting: false]
          on: Exception do: [:e |
            ('SSE mission card skipped (malformed tuple): ', e messageText) println. ''])
      ].
      s := s, '</details>'
    ].
    ^s, '</div>'
  ]

  method: sortMissions: arr [
    "Sort missions by identity ascending — a stable, deterministic total order.
     Mutates and returns the array. Used so the pre-rendered Missions HTML is
     byte-identical tick-to-tick when nothing has changed, which lets the
     per-subscriber change-detection in sendElements:to:key: skip re-patching
     an unchanged panel (preserving scroll + open <details>)."
    arr sort: [:a :b |
      | ia ib |
      ia := a at: 'identity' ifAbsent: [''].
      ib := b at: 'identity' ifAbsent: [''].
      ia < ib ifTrue: [-1] ifFalse: [ia > ib ifTrue: [1] ifFalse: [0]]
    ].
    ^arr
  ]

  method: renderMissionTree: m workitems: wis [
    "Render an indented tree of the mission's epic and its child stories,
     built ENTIRELY from the already-cached tick snapshot (the `workitems`
     scan computeSnapshot ran once this tick). ZERO new BBS scans. Only
     called for NON-ARCHIVED missions.

     The epic itself has parent=nil so it is NOT in the story filter; we
     resolve it by identity = mission.payload.epic_id. Stories are the
     workitems whose payload.parent = epic_id. Every user-controlled field
     (title/status/wave/epic title) is HTML-escaped. Any problem — missing
     or empty epic_id, missing epic workitem, malformed rows — renders NO
     tree rather than throwing (the whole body is guarded)."
    ^[
      | p epicId epic stories treeHtml |
      p := m at: 'payload' ifAbsent: [Dictionary new].
      epicId := p at: 'epic_id' ifAbsent: [nil].
      ((epicId isKindOf: String) and: [epicId isEmpty not]) ifFalse: [^''].
      epic := wis detect: [:w | (w at: 'identity' ifAbsent: [nil]) = epicId] ifNone: [nil].
      epic isNil ifTrue: [^''].
      stories := wis select: [:w |
        ((w at: 'payload' ifAbsent: [Dictionary new]) at: 'parent' ifAbsent: [nil]) = epicId].
      stories := self sortStories: stories.
      treeHtml := '<ul class="mission-tree"><li class="mission-epic">',
        (self htmlEscape: ((epic at: 'payload' ifAbsent: [Dictionary new]) at: 'title' ifAbsent: [epicId])),
        '<ul>'.
      stories do: [:st |
        | sp |
        sp := st at: 'payload' ifAbsent: [Dictionary new].
        "wave is an Integer (missionWaveOf:); this VM's htmlEscape asString does
         NOT understand Integer, so render the coerced numeric key's printString
         (always digits — no injection risk) through htmlEscape for uniformity."
        treeHtml := treeHtml, '<li class="mission-story">',
          '<span class="mission-story-title">', (self htmlEscape: (sp at: 'title' ifAbsent: [''])), '</span> ',
          '<span class="mission-story-status">', (self htmlEscape: (sp at: 'status' ifAbsent: [''])), '</span> ',
          '<span class="mission-story-wave">wave ', (self htmlEscape: (self storyWaveKey: st) printString), '</span>',
          '</li>'
      ].
      treeHtml := treeHtml, '</ul></li></ul>'.
      treeHtml
    ] on: Exception do: [:e |
      ('SSE mission tree skipped (malformed tuple): ', e messageText) println. ''
    ]
  ]

  method: sortStories: arr [
    "Sort stories by wave NUMERICALLY, tie-breaking on identity lexicographically.
     wave is an Integer (written via missionWaveOf: in Dispatcher) but a malformed
     tuple could carry a non-integer; the comparator coerces defensively so it can
     never throw. A deterministic TOTAL order is required so the rendered
     missionsHtml is byte-stable tick-to-tick — otherwise sendElements:to:key:
     change-detection re-patches the panel every tick, resetting scroll and
     collapsing any expanded mission plan the operator is reading. Mutates and
     returns the array."
    arr sort: [:a :b |
      | wa wb ia ib |
      wa := self storyWaveKey: a.
      wb := self storyWaveKey: b.
      wa < wb ifTrue: [-1] ifFalse: [wa > wb ifTrue: [1] ifFalse: [
        ia := a at: 'identity' ifAbsent: [''].
        ib := b at: 'identity' ifAbsent: [''].
        ia < ib ifTrue: [-1] ifFalse: [ia > ib ifTrue: [1] ifFalse: [0]]
      ]]
    ].
    ^arr
  ]

  method: storyWaveKey: w [
    "Extract a story's wave as an Integer for numeric sorting. Guards a
     non-integer / missing / malformed wave to 0 so the sortStories:
     comparator can never throw."
    | v |
    v := [(w at: 'payload' ifAbsent: [Dictionary new]) at: 'wave' ifAbsent: [0]]
      on: Exception do: [:e | 0].
    ^((v isKindOf: SmallInteger) or: [(v isKindOf: Integer) or: [v isKindOf: Float]])
      ifTrue: [v]
      ifFalse: [0]
  ]

  method: renderMissionCard: m awaiting: isAwaiting [
    "Render one mission as an expandable card: a one-line brief + the PLAN
     markdown rendered into HTML inside a <details>. awaiting-approval missions
     also carry Approve/Reject controls (data-mission-id + data-scope drive the
     loopback POST in dashboard.html). All user-controlled fields are HTML-escaped."
    | p id scope status brief plan briefLine planHtml controls openAttr |
    p := m at: 'payload' ifAbsent: [Dictionary new].
    id := m at: 'identity' ifAbsent: ['?'].
    scope := m at: 'scope' ifAbsent: ['default'].
    status := p at: 'status' ifAbsent: ['?'].
    brief := p at: 'brief' ifAbsent: [''].
    plan := p at: 'plan' ifAbsent: [nil].
    briefLine := self oneLineBrief: brief.
    ((plan isKindOf: String) and: [plan isEmpty not])
      ifTrue: [planHtml := self renderMarkdownPlan: plan]
      ifFalse: [planHtml := '<div class="empty-state">No plan yet.</div>'].
    controls := ''.
    isAwaiting ifTrue: [
      controls := '<div class="mission-actions">',
        '<button type="button" class="mission-approve" data-mission-id="', (self htmlEscape: id),
          '" data-scope="', (self htmlEscape: scope), '">Approve</button>',
        '<button type="button" class="mission-reject" data-mission-id="', (self htmlEscape: id),
          '" data-scope="', (self htmlEscape: scope), '">Reject</button>',
        '</div>'
    ].
    "Execute (D5 second trigger): an approved mission whose epic has been
     materialized by reconciliation gets a Run control. data-mission-id +
     data-scope drive the loopback POST to /api/mission/run in dashboard.html."
    ((status = 'approved')
      and: [((p at: 'epic_id' ifAbsent: [nil]) isKindOf: String) and: [(p at: 'epic_id') isEmpty not]]) ifTrue: [
      controls := '<div class="mission-actions">',
        '<button type="button" class="mission-execute" data-mission-id="', (self htmlEscape: id),
          '" data-scope="', (self htmlEscape: scope), '">Execute</button>',
        '</div>'
    ].
    openAttr := isAwaiting ifTrue: [' open'] ifFalse: [''].
    ^'<div class="mission-card mission-', (self htmlEscape: status),
      '" data-mission-id="', (self htmlEscape: id),
      '" data-scope="', (self htmlEscape: scope), '">',
      '<div class="mission-head">',
        '<span class="mission-status">', (self htmlEscape: status), '</span> ',
        '<span class="mission-brief">', (self htmlEscape: briefLine), '</span>',
      '</div>',
      '<details class="mission-plan"', openAttr, '>',
        '<summary>Plan</summary>',
        '<div class="mission-plan-body">', planHtml, '</div>',
      '</details>',
      controls,
      '<div class="mission-id"><small>', (self htmlEscape: id), '</small></div>',
      '</div>'
  ]

  method: oneLineBrief: s [
    "Collapse a (possibly multi-line) brief to one truncated line. Returns a
     plain (UNescaped) string — the caller escapes. Non-strings -> ''."
    | str cut |
    (s isKindOf: String) ifFalse: [^''].
    str := s.
    cut := str indexOf: (Character lf) asString.
    cut > 0 ifTrue: [str := str copyFrom: 1 to: cut - 1].
    str size > 90 ifTrue: [str := (str copyFrom: 1 to: 87), '...'].
    ^str
  ]

  method: renderMarkdownPlan: text [
    "Minimal, defensive Markdown -> HTML for a mission plan. EVERY line is
     HTML-escaped before any markup is added, so a plan can never inject raw
     HTML. Recognizes ATX headings (#, ##, ###), bullet lists (- / *), and
     blank-line-separated paragraphs; anything else degrades to an escaped
     paragraph. Non-strings -> ''."
    | out inList lines |
    (text isKindOf: String) ifFalse: [^''].
    text isEmpty ifTrue: [^''].
    out := ''.
    inList := false.
    lines := text split: ((Character lf) asString).
    lines do: [:rawLine |
      | l trimmed |
      l := rawLine.
      (l isEmpty not and: [(l copyFrom: l size to: l size) = ((Character cr) asString)])
        ifTrue: [l := l copyFrom: 1 to: l size - 1].
      trimmed := l trimBoth.
      trimmed isEmpty ifTrue: [
        inList ifTrue: [out := out, '</ul>'. inList := false]
      ] ifFalse: [
        (trimmed startsWith: '### ') ifTrue: [
          inList ifTrue: [out := out, '</ul>'. inList := false].
          out := out, '<h5>', (self htmlEscape: (trimmed copyFrom: 5 to: trimmed size)), '</h5>'
        ] ifFalse: [
        (trimmed startsWith: '## ') ifTrue: [
          inList ifTrue: [out := out, '</ul>'. inList := false].
          out := out, '<h4>', (self htmlEscape: (trimmed copyFrom: 4 to: trimmed size)), '</h4>'
        ] ifFalse: [
        (trimmed startsWith: '# ') ifTrue: [
          inList ifTrue: [out := out, '</ul>'. inList := false].
          out := out, '<h3>', (self htmlEscape: (trimmed copyFrom: 3 to: trimmed size)), '</h3>'
        ] ifFalse: [
        ((trimmed startsWith: '- ') or: [trimmed startsWith: '* ']) ifTrue: [
          inList ifFalse: [out := out, '<ul>'. inList := true].
          out := out, '<li>', (self htmlEscape: (trimmed copyFrom: 3 to: trimmed size)), '</li>'
        ] ifFalse: [
          inList ifTrue: [out := out, '</ul>'. inList := false].
          out := out, '<p>', (self htmlEscape: trimmed), '</p>'
        ]]]]
      ]
    ].
    inList ifTrue: [out := out, '</ul>'].
    ^out
  ]

  method: renderWorkflowsHtml: snap [
    | s workflows allTokens allTasks now |
    workflows := snap at: 'workflows'.
    allTokens := snap at: 'tokens'.
    allTasks := snap at: 'tasks'.
    now := snap at: 'now'.
    s := '<div id="dashboard-workflows"><h2>Active Workflows</h2>'.
    workflows do: [:w |
      | p status template wfId desc label places activeTask taskLine tokenTotals tokenLine launchedBy launchedByLine executedByAttr |
      p := w at: 'payload' ifAbsent: [Dictionary new].
      status := p at: 'status' ifAbsent: ['?'].
      "Active gate: a 'running' tuple is shown only if it has evidence of
       liveness. wfId + activeTask are resolved first so the liveness
       predicate can consult them; a stuck-'running' workflow with no live
       task and past the stale window is a zombie and is hidden here (the
       Dispatcher staleness reaper flips it to failed shortly after)."
      wfId := w at: 'identity' ifAbsent: ['?'].
      activeTask := status = 'running'
        ifTrue: [self activeTaskFor: wfId in: allTasks]
        ifFalse: [nil].
      (status = 'running' and: [self workflowActive: p activeTask: activeTask now: now]) ifTrue: [
        template := p at: 'template' ifAbsent: ['?'].
        desc := (p at: 'params' ifAbsent: [Dictionary new]) at: 'description' ifAbsent: [''].
        desc size > 100 ifTrue: [desc := (desc copyFrom: 1 to: 100), '...'].
        label := desc isEmpty ifTrue: [wfId] ifFalse: [desc].
        places := self placesFor: wfId in: allTokens.
        launchedBy := w at: 'launched_by' ifAbsent: [p at: 'launched_by' ifAbsent: [nil]].
        "Guard non-string launched_by: a numeric/null value would make
         isEmpty / htmlEscape misbehave and feed a non-Boolean to ifTrue:."
        (launchedBy notNil and: [(launchedBy isKindOf: String) not])
          ifTrue: [launchedBy := launchedBy asString].
        launchedByLine := (launchedBy isNil or: [launchedBy isEmpty])
          ifTrue: ['']
          ifFalse: ['<br><small>launched by <b>', (self htmlEscape: launchedBy), '</b></small>'].
        taskLine := ''.
        executedByAttr := ''.
        activeTask notNil ifTrue: [
          | tp role tStatus dispatchedAt durStr executedBy execLine |
          tp := activeTask at: 'payload' ifAbsent: [Dictionary new].
          role := tp at: 'role' ifAbsent: ['?'].
          tStatus := tp at: 'status' ifAbsent: ['?'].
          "Guard: at:ifAbsent: returns an explicit nil if the key is present
           with a nil value (the absent-block does NOT run). nil > 0 then
           sends > to nil -> 'Message not understood' on the ifTrue:. Coerce
           any non-Integer to 0 before the comparison."
          dispatchedAt := tp at: 'dispatched_at' ifAbsent: [0].
          "Number, not Integer: a reloaded dispatched_at is a Float after
           Json decode; an Integer-only guard would zero it and mislabel a
           live dispatched task as 'pending'. Still coerces nil/strings to 0."
          (dispatchedAt isKindOf: Number) ifFalse: [dispatchedAt := 0].
          durStr := dispatchedAt > 0
            ifTrue: [self formatDuration: (now - dispatchedAt)]
            ifFalse: ['pending'].
          executedBy := activeTask at: 'executed_by' ifAbsent: [tp at: 'executed_by' ifAbsent: [nil]].
          (executedBy notNil and: [(executedBy isKindOf: String) not])
            ifTrue: [executedBy := executedBy asString].
          execLine := ''.
          ((tStatus = 'claimed' or: [tStatus = 'dispatched' or: [tStatus = 'running']])
            and: [executedBy notNil and: [executedBy isEmpty not]]) ifTrue: [
              execLine := ' · executed by <b>', (self htmlEscape: executedBy), '</b>'.
              executedByAttr := ' data-executed-by="', (self htmlEscape: executedBy), '"'
          ].
          taskLine := '<br><small>role: <b>', role, '</b>',
            '<img class="role-badge" src="/dashboard/roles/role-', role, '.png" alt="" onerror="this.style.display=''none''">',
            ' · ', tStatus, ' · ', durStr, execLine, '</small>'
        ].
        tokenTotals := self tokenTotalsFor: wfId in: allTasks.
        tokenLine := self renderTokenLine: tokenTotals.
        s := s, '<div class="wf-card" data-launched-by="',
             ((launchedBy isNil or: [launchedBy isEmpty]) ifTrue: [''] ifFalse: [self htmlEscape: launchedBy]),
             '"', executedByAttr, '><b>', template, '</b> ', label,
             '<br><small>place: ', places, '</small>',
             launchedByLine,
             taskLine,
             tokenLine,
             '<br><small>', wfId, '</small></div>'
      ]
    ].
    s := s, '</div>'.
    ^s
  ]

  method: staleWorkflowWindowSeconds [
    "A 'running' workflow with NO live task that started more than this long
     ago is treated as a zombie and hidden from the Active panel. Kept in
     sync with Dispatcher>>staleWorkflowTtlSeconds (the reaper that actually
     transitions such a tuple to failed). Generous enough never to hide a
     freshly launched workflow whose first task has not dispatched yet."
    ^3600
  ]

  method: workflowActive: payload activeTask: activeTask now: now [
    "Liveness predicate for the Active Workflows panel. A workflow is shown
     active iff it has a LIVE task (pending/dispatched/claimed/running) OR it
     is still inside the stale window (started_at recent). This replaces
     trusting the stored status='running' absolutely: nothing ever flips a
     stuck-'running' tuple to terminal until the Dispatcher staleness reaper
     runs, so without this gate an abandoned workflow shows active forever.

     The task must be LIVE, not merely non-terminal: activeTaskFor:in:
     surfaces any non-completed/non-cancelled task INCLUDING 'failed', so a
     workflow whose only task has failed would otherwise show Active until
     the reaper transitions it. Mirror the reaper's isLiveTaskStatus:
     (which excludes 'failed') so the two agree (review-issue-3)."
    | startedAt tStatus |
    activeTask notNil ifTrue: [
      tStatus := (activeTask at: 'payload' ifAbsent: [Dictionary new]) at: 'status' ifAbsent: [''].
      (self isLiveTaskStatus: tStatus) ifTrue: [^true]
    ].
    startedAt := payload at: 'started_at' ifAbsent: [nil].
    "No usable started_at -> cannot age it; show it rather than hide silently.
     Number, not Integer: persisted tuples round-trip through Json decode,
     yielding Float for whole epoch timestamps — an Integer-only guard would
     treat every reloaded workflow as un-ageable and show zombies forever."
    (startedAt isKindOf: Number) ifFalse: [^true].
    ^(now - startedAt) < self staleWorkflowWindowSeconds
  ]

  method: isLiveTaskStatus: status [
    "Task statuses that count as in-flight work for a workflow. Kept in sync
     with Dispatcher>>isLiveTaskStatus: so the Active panel and the staleness
     reaper agree on what 'live' means (notably: 'failed' is NOT live)."
    ^status = 'pending'
      or: [status = 'dispatched'
      or: [status = 'claimed'
      or: [status = 'running']]]
  ]

  method: tokenTotalsFor: wfId in: allTasks [
    "Sum input/output tokens for every task belonging to this workflow
     instance, drawing exclusively from the in-memory tokenCache. The
     cache is rebuilt by tokenCacheLoop in a background fork (see
     refreshTokenCache) so this hot path does ZERO disk I/O — it only
     iterates allTasks and looks up taskId in tokenCache.

     Per docs/scout-perf-survey-2026-04-28.md §4: previously this method
     read $HOME/.pp/sessions/<taskId>.jsonl synchronously per workflow per
     subscriber per 2 s tick, stalling every subscriber on a slow disk."
    | prefix result cache |
    prefix := wfId, ':task:'.
    result := Dictionary new.
    result at: 'input' put: 0.
    result at: 'output' put: 0.
    "Snapshot the cache reference once; the background loop swaps in a
     fresh Dictionary atomically (single var write), so we read a stable
     map even if the loop fires mid-iteration."
    cache := tokenCache.
    allTasks do: [:t |
      | tid totals |
      tid := t at: 'identity' ifAbsent: [''].
      (tid startsWith: prefix) ifTrue: [
        totals := cache at: tid ifAbsent: [nil].
        totals notNil ifTrue: [
          result at: 'input' put: (result at: 'input') + (totals at: 'input' ifAbsent: [0]).
          result at: 'output' put: (result at: 'output') + (totals at: 'output' ifAbsent: [0])
        ]
      ]
    ].
    ^result
  ]

  method: refreshTokenCache [
    "Update the per-task token totals cache by walking task tuples and
     parsing their session JSONL files.

     Two short-circuits that turned this from a memory leak into a
     near-no-op at idle:

     1. Caller (#tick) already gates on sseSubscribers being non-empty,
        so when no dashboard is connected we never get here — previously
        this loop ran every 5 s in its own fork (#tokenCacheLoop) regardless,
        re-reading 400+ session files (~127 MB) per pass. The Go heap
        couldn't return the allocations to the OS fast enough and pp serve
        drifted to 30 GB+ of committed pages over a few hours.

     2. Per-file mtime cache: re-parsing a session file whose mtime hasn't
        changed wastes the same CPU and produces the same totals. Skip it.

     Updates the existing tokenCache in place. Per-tid entries are
     independent, so a concurrent SSE reader can at worst see the old
     totals for one task while a new entry is being written — fine for
     a dashboard."
    | tasks home sessionsDir |
    home := System env: 'HOME'.
    (home isNil or: [home isEmpty]) ifTrue: [home := '/tmp'].
    sessionsDir := home, '/.pp/sessions'.
    tasks := bbs scanAll: 'task'.
    tasks do: [:t |
      | tid filePath curMtime cachedMtime |
      tid := t at: 'identity' ifAbsent: [''].
      tid isEmpty ifFalse: [
        filePath := sessionsDir, '/', tid, '.jsonl'.
        (File exists: filePath) ifTrue: [
          curMtime := File modificationTime: filePath.
          cachedMtime := tokenCacheMtimes at: tid ifAbsent: [nil].
          (curMtime notNil and: [cachedMtime = curMtime]) ifFalse: [
            self tailTokensFor: tid path: filePath.
            curMtime notNil ifTrue: [tokenCacheMtimes at: tid put: curMtime]
          ]
        ]
      ]
    ]
  ]

  method: tailTokensFor: tid path: filePath [
    "Tail the session file from the last consumed byte offset, adding token
     usage from newly-appended COMPLETE lines into the cached totals. The
     File readFrom:offset: primitive returns { completeContent, newByteOffset }
     trimmed to the last newline, so offsets are byte-correct and no partial
     line is ever parsed. This replaces the old whole-file re-read that made a
     running task's growing .jsonl the dominant per-tick allocation."
    | curSize prevOffset totals res content newOffset |
    curSize := File size: filePath.
    prevOffset := tokenCacheOffsets at: tid ifAbsent: [0].
    "Rotated/truncated file → restart from the top."
    (curSize < prevOffset) ifTrue: [
      prevOffset := 0.
      tokenCache removeKey: tid ifAbsent: [nil]
    ].
    totals := tokenCache at: tid ifAbsent: [nil].
    totals isNil ifTrue: [
      totals := Dictionary new.
      totals at: 'input' put: 0.
      totals at: 'output' put: 0
    ].
    res := File readFrom: filePath offset: prevOffset.
    "res is { content<String>, newOffset<Int> }; tolerate a Failure / odd shape."
    (res isKindOf: Array) ifFalse: [^self].
    content := res at: 1.
    newOffset := res at: 2.
    (content notNil and: [content isEmpty not]) ifTrue: [
      self accumulateTokensFromString: content into: totals.
      "Token totals feed the pre-rendered snapshot HTML — force a recompute."
      snapshotCacheRev := -1
    ].
    tokenCache at: tid put: totals.
    newOffset notNil ifTrue: [tokenCacheOffsets at: tid put: newOffset]
  ]

  method: accumulateTokensFromString: text into: result [
    "Parse the given text as JSONL (already trimmed to whole lines by the tail
     primitive); for every entry with a usage block (top-level or nested under
     message), add its input_tokens + output_tokens into the running totals.
     Silently tolerates malformed lines so one bad session can't break the
     dashboard."
    | lines |
    [
      lines := text split: Character lf.
      lines do: [:line |
        line isEmpty ifFalse: [
          [self accumulateLine: line into: result] on: Exception do: [:e | ]
        ]
      ]
    ] on: Exception do: [:e | ]
  ]

  method: accumulateLine: line into: result [
    | entry usage msg inTok outTok |
    entry := Json decode: line.
    (entry isKindOf: Dictionary) ifFalse: [^self].
    usage := entry at: 'usage' ifAbsent: [nil].
    usage isNil ifTrue: [
      msg := entry at: 'message' ifAbsent: [nil].
      (msg notNil and: [msg isKindOf: Dictionary]) ifTrue: [
        usage := msg at: 'usage' ifAbsent: [nil]
      ]
    ].
    usage isNil ifTrue: [^self].
    (usage isKindOf: Dictionary) ifFalse: [^self].
    inTok := usage at: 'input_tokens' ifAbsent: [0].
    outTok := usage at: 'output_tokens' ifAbsent: [0].
    result at: 'input' put: (result at: 'input') + inTok.
    result at: 'output' put: (result at: 'output') + outTok
  ]

  method: renderTokenLine: totals [
    | inTok outTok |
    inTok := totals at: 'input' ifAbsent: [0].
    outTok := totals at: 'output' ifAbsent: [0].
    (inTok = 0 and: [outTok = 0]) ifTrue: [^''].
    ^'<br><small>tokens: in=', (self formatTokens: inTok),
        ' out=', (self formatTokens: outTok),
        ' (total ', (self formatTokens: inTok + outTok), ')</small>'
  ]

  method: formatTokens: n [
    "Compact human display: 1234 → 1.2k, 5,432,100 → 5.4M."
    n < 1000 ifTrue: [^n printString].
    n < 1000000 ifTrue: [
      ^(n // 1000) printString, '.', ((n \\ 1000) // 100) printString, 'k'
    ].
    ^(n // 1000000) printString, '.', ((n \\ 1000000) // 100000) printString, 'M'
  ]

  method: placesFor: instanceId in: allTokens [
    "Return a comma-separated string of place names for positive tokens of the
     given workflow instance."
    | matching names |
    matching := allTokens select: [:t |
      | tp |
      tp := t at: 'payload' ifAbsent: [Dictionary new].
      (tp at: 'workflow_instance' ifAbsent: ['']) = instanceId
        and: [(tp at: 'status' ifAbsent: ['']) = 'positive']
    ].
    matching isEmpty ifTrue: [^'(none)'].
    names := matching collect: [:t | (t at: 'payload') at: 'place' ifAbsent: ['?']].
    ^self joinStrings: names with: ', '
  ]

  method: activeTaskFor: instanceId in: allTasks [
    "Return the most recent non-completed task for this workflow instance, or nil.
     Prefers dispatched tasks; falls back to pending."
    | prefix candidates dispatched pending best bestTime |
    prefix := instanceId, ':task:'.
    candidates := allTasks select: [:t |
      | tp tStatus |
      tp := t at: 'payload' ifAbsent: [Dictionary new].
      tStatus := tp at: 'status' ifAbsent: [''].
      ((t at: 'identity' ifAbsent: ['']) startsWith: prefix)
        and: [(tStatus = 'completed') not and: [(tStatus = 'cancelled') not]]
    ].
    candidates isEmpty ifTrue: [^nil].
    dispatched := candidates select: [:t |
      ((t at: 'payload') at: 'status' ifAbsent: ['']) = 'dispatched'
    ].
    pending := dispatched isEmpty ifTrue: [candidates] ifFalse: [dispatched].
    best := nil.
    bestTime := -1.
    pending do: [:t |
      | tp ts |
      tp := t at: 'payload' ifAbsent: [Dictionary new].
      ts := tp at: 'dispatched_at' ifAbsent: [0].
      ts > bestTime ifTrue: [best := t. bestTime := ts]
    ].
    ^best ifNil: [pending first]
  ]

  method: htmlEscape: aString [
    "Escape HTML metacharacters (ampersand, angle brackets, quotes) so
     user-controlled identity strings cannot break out of attribute or
     element context in the dashboard HTML."
    | s |
    aString isNil ifTrue: [^''].
    s := aString asString.
    s := s replaceAll: '&' with: '&amp;'.
    s := s replaceAll: '<' with: '&lt;'.
    s := s replaceAll: '>' with: '&gt;'.
    s := s replaceAll: '"' with: '&quot;'.
    s := s replaceAll: '''' with: '&#39;'.
    ^s
  ]

  method: joinStrings: aCollection with: sep [
    | s first |
    s := ''.
    first := true.
    aCollection do: [:x |
      first ifTrue: [s := x asString. first := false]
            ifFalse: [s := s, sep, x asString]
    ].
    ^s
  ]

  method: renderCompletionsHtml: snap [
    "Broadcast the most recent completed/failed/cancelled workflows with duration.
     Running workflows are handled by renderWorkflowsHtml: and disappear from the
     active list on completion, so this section gives operators a short-lived
     record of terminal workflows so they don't vanish without a trace."
    | s workflows topN maxCount allTasks |
    maxCount := 10.
    workflows := snap at: 'workflows'.
    allTasks := snap at: 'tasks'.
    topN := Array new: 0.
    workflows do: [:w |
      | p status endedAt startedAt rec |
      p := w at: 'payload' ifAbsent: [Dictionary new].
      status := p at: 'status' ifAbsent: ['?'].
      (status = 'completed' or: [status = 'failed' or: [status = 'cancelled']]) ifTrue: [
        endedAt := p at: 'completed_at' ifAbsent: [
          p at: 'failed_at' ifAbsent: [
            p at: 'cancelled_at' ifAbsent: [0]
          ]
        ].
        startedAt := p at: 'started_at' ifAbsent: [0].
        rec := Dictionary new.
        rec at: 'wf' put: w.
        rec at: 'status' put: status.
        rec at: 'endedAt' put: endedAt.
        rec at: 'startedAt' put: startedAt.
        topN := self insertEntry: rec into: topN maxSize: maxCount
      ]
    ].
    s := '<div id="dashboard-completions"><h2>Recent Completions</h2>'.
    topN isEmpty ifTrue: [
      s := s, '<div class="empty-state">No recent completions</div>'
    ] ifFalse: [
      topN do: [:rec |
        | wf p template wfId status endedAt startedAt duration durationStr tokenTotals tokenLine |
        wf := rec at: 'wf'.
        p := wf at: 'payload' ifAbsent: [Dictionary new].
        template := p at: 'template' ifAbsent: ['?'].
        wfId := wf at: 'identity' ifAbsent: ['?'].
        status := rec at: 'status'.
        endedAt := rec at: 'endedAt'.
        startedAt := rec at: 'startedAt'.
        duration := (startedAt > 0 and: [endedAt > 0])
          ifTrue: [endedAt - startedAt]
          ifFalse: [-1].
        durationStr := self formatDuration: duration.
        tokenTotals := self tokenTotalsFor: wfId in: allTasks.
        tokenLine := self renderTokenLine: tokenTotals.
        s := s, '<div class="wf-card completion-', status, '"><b>', template, '</b> ', wfId,
              '<br><small>[', status, '] ', durationStr, '</small>',
              tokenLine,
              '</div>'
      ]
    ].
    s := s, '</div>'.
    ^s
  ]

  method: insertEntry: entry into: topN maxSize: maxSize [
    "Insert entry into topN, keeping topN sorted descending by endedAt and
     trimmed to at most maxSize elements. topN must already be sorted."
    | entryEnd result inserted |
    entryEnd := entry at: 'endedAt'.
    result := Array new: 0.
    inserted := false.
    topN do: [:e |
      (inserted not and: [entryEnd > (e at: 'endedAt')]) ifTrue: [
        result := result copyWith: entry.
        inserted := true
      ].
      result size < maxSize ifTrue: [
        result := result copyWith: e
      ]
    ].
    (inserted not and: [result size < maxSize]) ifTrue: [
      result := result copyWith: entry
    ].
    ^result
  ]

  method: formatDuration: seconds [
    "Format a duration (seconds, integer) into a short human string like
     '5s', '2m 30s', '1h 23m', '2d 3h'. A negative duration is rendered as '—'."
    seconds < 0 ifTrue: [^'—'].
    seconds < 60 ifTrue: [^seconds printString, 's'].
    seconds < 3600 ifTrue: [
      ^(seconds // 60) printString, 'm ', (seconds \\ 60) printString, 's'
    ].
    seconds < 86400 ifTrue: [
      ^(seconds // 3600) printString, 'h ', ((seconds \\ 3600) // 60) printString, 'm'
    ].
    ^(seconds // 86400) printString, 'd ', ((seconds \\ 86400) // 3600) printString, 'h'
  ]

  method: sendNotifsTo: entry snapshot: snap [
    "Per-subscriber notification fan-out. Anonymous identities get the
     pre-rendered cached HTML (notificationsAnonHtml). Signed identities
     filter the cached notifications array against their watch set, then
     render. Either way, no BBS scans happen here — both the notifications
     and watches arrays come from the snapshot built in computeSnapshot."
    | notifications identity watchSet visible html |
    identity := entry at: 'identity' ifAbsent: ['anonymous'].
    (identity isNil or: [identity = 'anonymous']) ifTrue: [
      ^self sendElements: (snap at: 'notificationsAnonHtml') to: entry
    ].
    notifications := snap at: 'notifications'.
    watchSet := self watchWorkflowsFor: identity in: (snap at: 'watches').
    visible := notifications select: [:n |
      self notification: n visibleTo: identity watches: watchSet
    ].
    html := self renderNotificationsHtml: visible.
    ^self sendElements: html to: entry
  ]

  method: renderNotificationsHtml: visible [
    "Render the activity list HTML from a pre-filtered notifications array.
     Caller is responsible for any per-identity filtering."
    | s recent |
    recent := visible size > 30
      ifTrue: [visible copyFrom: (visible size - 29) to: visible size]
      ifFalse: [visible].
    s := '<div id="dashboard-notifications"><h2>Recent Activity</h2>'.
    recent isEmpty ifTrue: [
      s := s, '<div class="empty-state">No recent activity</div>'
    ] ifFalse: [
      s := s, '<ul>'.
      "Render newest-first: iterate the recent slice from tail to head.
       Maggie arrays are 1-indexed closed, so the valid range is
       [1, size]. Off-by-one regression here was producing a nil at the
       top of the list and silently dropping the freshest notification."
      recent size to: 1 by: -1 do: [:idx |
        | n p message severity createdAt ts scope workflow line |
        line := [
          n := recent at: idx.
          (n isKindOf: Dictionary) ifFalse: [
            ('notif render: tuple not Dictionary at idx=', idx printString,
              ' type=', n class name) println.
            n := Dictionary new
          ].
          p := n at: 'payload' ifAbsent: [Dictionary new].
          (p isKindOf: Dictionary) ifFalse: [
            ('notif render: payload not Dictionary id=',
              (n at: 'identity' ifAbsent: ['?']),
              ' type=', p class name) println.
            p := Dictionary new
          ].
          message := p at: 'message' ifAbsent: [''].
          severity := p at: 'severity' ifAbsent: ['info'].
          createdAt := n at: 'created_at' ifAbsent: [p at: 'created_at' ifAbsent: [0]].
          scope := n at: 'scope' ifAbsent: [''].
          (scope isNil or: [(scope isKindOf: String) not]) ifTrue: [scope := ''].
          workflow := (scope startsWith: 'wf-')
            ifTrue: [scope]
            ifFalse: [p at: 'workflow_instance' ifAbsent: ['']].
          workflow isNil ifTrue: [workflow := ''].
          "JSON-decoded epochs are SmallInteger, which is NOT a subclass of
           Integer — an Integer-only check is always false, so every
           notification rendered a blank time. Match SmallInteger/BigInteger
           explicitly, as storyWaveKey: already does."
          ts := (((createdAt isKindOf: SmallInteger) or: [createdAt isKindOf: BigInteger]) and: [createdAt > 0])
            ifTrue: [(DateTime fromEpoch: createdAt) format: '15:04:05']
            ifFalse: [''].
          '<li class="notif-item sev-', (self htmlEscape: severity),
            '" data-scope="', (self htmlEscape: scope),
            '" data-workflow="', (self htmlEscape: workflow),
            '" data-severity="', (self htmlEscape: severity), '">',
            ts, ' <span class="notif-scope">', (self htmlEscape: scope), '</span>',
            ' [', (self htmlEscape: severity), '] ', (self htmlEscape: message), '</li>'
        ] on: Exception do: [:e |
          ('notif render: row idx=', idx printString,
            ' failed: ', e messageText) println.
          ''
        ].
        s := s, line
      ].
      s := s, '</ul>'
    ].
    s := s, '</div>'.
    ^s
  ]

  method: watchWorkflowsFor: identity in: watches [
    "Resolve active workflow subscriptions for the given identity from a
     pre-fetched watches array. Mirrors ApiServer>>watchWorkflowsFor: so
     SSE filtering matches long-poll filtering one-for-one. Returns an
     empty Array for anonymous/nil.

     §6 short-TTL cache: many subscribers can share the same identity
     (same user, multiple tabs). Cache the resolved Array for 2 s so
     concurrent broadcasts within a single tick window only walk the
     watches array once per identity."
    | result prefix now expires cached |
    (identity isNil or: [identity isEmpty]) ifTrue: [^Array new: 0].
    now := DateTime now epochSeconds.
    expires := watchSetCacheExpiry at: identity ifAbsent: [nil].
    (expires notNil and: [now < expires]) ifTrue: [
      cached := watchSetCache at: identity ifAbsent: [nil].
      cached notNil ifTrue: [^cached]
    ].
    result := ArrayList new.
    prefix := identity, ':'.
    watches do: [:w |
      | p wid wfId owner matches |
      p := w at: 'payload' ifAbsent: [Dictionary new].
      wid := w at: 'identity' ifAbsent: [''].
      wfId := p at: 'workflow_id' ifAbsent: [nil].
      (wfId isNil and: [wid startsWith: prefix]) ifTrue: [
        wfId := wid copyFrom: prefix size + 1 to: wid size
      ].
      owner := p at: 'user' ifAbsent: [nil].
      matches := (owner = identity) or: [wid startsWith: prefix].
      (matches and: [wfId notNil and: [wfId isEmpty not]]) ifTrue: [
        result add: wfId
      ]
    ].
    result := result asArray.
    watchSetCache at: identity put: result.
    watchSetCacheExpiry at: identity put: now + 2.
    watchSetCache size > 1024 ifTrue: [
      watchSetCache := Dictionary new.
      watchSetCacheExpiry := Dictionary new
    ].
    ^result
  ]

  method: watchWorkflowsFor: identity [
    "Backwards-compatible variant that does its own scan. The hot tick
     path goes through watchWorkflowsFor:in: with snapshot-cached watches."
    ^self watchWorkflowsFor: identity in: (bbs scanAll: 'watch')
  ]

  method: notification: n visibleTo: identity watches: watchSet [
    "§4.8 (F8.1) per-identity visibility predicate. identity must be a
     verified signed actor (never nil here — anonymous connections
     bypass this predicate in sendNotifsTo:snapshot:)."
    | p launchedBy observers scope workflow |
    launchedBy := n at: 'launched_by' ifAbsent: [nil].
    launchedBy = identity ifTrue: [^true].
    p := n at: 'payload' ifAbsent: [Dictionary new].
    observers := p at: 'observers' ifAbsent: [nil].
    (observers notNil and: [observers isKindOf: Array]) ifTrue: [
      observers do: [:o | o = identity ifTrue: [^true]]
    ].
    watchSet isEmpty ifFalse: [
      scope := n at: 'scope' ifAbsent: [''].
      scope isNil ifTrue: [scope := ''].
      workflow := (scope startsWith: 'wf-')
        ifTrue: [scope]
        ifFalse: [p at: 'workflow_instance' ifAbsent: ['']].
      (workflow notNil and: [workflow isEmpty not]) ifTrue: [
        watchSet do: [:w | w = workflow ifTrue: [^true]]
      ]
    ].
    ^false
  ]
